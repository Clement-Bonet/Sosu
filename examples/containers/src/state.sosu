// The state of the example: the tab shown, a form, the options of the groups, and a tree of
// folders and files. Its interface is in screen.ui.sosu.
import image.image;
import std.vec;
import ui.widgets;

pub enum Country {
    France,
    Switzerland,
    Belgium,
}

// A file of the tree: its name, the folder that holds it (-1: none) and, for a folder, whether
// it is open.
pub struct Entry {
    pub mut widgets.TextBuffer name = widgets.TextBuffer{ };
    pub mut i32 parent = -1;
    pub mut bool folder = false;
    pub mut bool open = false;
}

pub class Demo {
    pub mut i32 page;
    // The form of the grid.
    pub mut widgets.TextBuffer first_name;
    pub mut widgets.TextBuffer last_name;
    pub mut widgets.TextBuffer email;
    pub mut widgets.TextBuffer notes;
    pub mut Country country;
    pub mut bool newsletter;
    pub mut i32 sent;
    // The groups.
    pub mut bool details_open;
    pub mut bool dark;
    pub mut bool sounds;
    pub mut bool updates;
    // The tree: its entries, a folder after the files it holds, the item chosen, the file opened.
    pub mut vec.Vec<Entry>* entries;  // as many as there are, in the arena of the example (spec §5.4)
    pub mut i32 item;
    pub mut i32 opened;
    // The inputs: a quantity, a price in cents, a due date, a volume, a memo, a dialog to confirm.
    pub mut i64 quantity;
    pub mut i64 price;
    pub mut widgets.Date due;
    pub mut i64 volume;
    pub mut widgets.LongText memo;
    pub mut bool asking;
    pub mut i32 confirmed;
    mut widgets.TextBuffer shown;  // the last number written as text
    // The icons of the tree, drawn here: a folder and a file, 16 pixels.
    // The long tree (spec §10.10): 1 000 folders of 100 files, flattened by the program into its
    // visible rows; `big_start` is the row of each folder.
    pub mut bool[1000] big_open;
    mut i32[1000] big_start;
    pub mut i32 big_rows;
    pub mut i32 big_item;
    mut widgets.TextBuffer big_label;
    pub image.Image folder_icon;
    pub image.Image file_icon;
    mut ui8[12] digits;

    void init(Arena* arena) {
        page = 0;
        folder_icon = icon(arena, true);
        file_icon = icon(arena, false);
        first_name = widgets.TextBuffer{ };
        last_name = widgets.TextBuffer{ };
        email = widgets.TextBuffer{ };
        notes = widgets.TextBuffer{ };
        country = France;
        newsletter = false;
        sent = 0;
        details_open = true;
        dark = true;
        sounds = false;
        updates = true;
        big_open = [false; 1000];
        big_start = [0; 1000];
        big_item = -1;
        big_label = widgets.TextBuffer{ };
        flatten();
        entries = vec.new(arena);
        item = 0;
        opened = -1;
        quantity = 3;
        price = 1999;
        due = widgets.Date{ year: 2026, month: 11, day: 15 };
        volume = 40;
        memo = widgets.long_text();
        memo.set("Several lines,\nwith undo (Ctrl+Z) and redo (Ctrl+Y).");
        asking = false;
        confirmed = 0;
        shown = widgets.TextBuffer{ };
        digits = [0; 12];
        i32 src = add("src", -1, true);
        add("main.sosu", src, false);
        add("screen.ui.sosu", src, false);
        add("state.sosu", src, false);
        i32 assets = add("assets", -1, true);
        i32 icons = add("icons", assets, true);
        add("file.png", icons, false);
        add("folder.png", icons, false);
        add("logo.png", assets, false);
        add("sosu.toml", -1, false);
    }

    // A folder (yellow, with a tab) or a file (a white page, its corner folded), 16 by 16 pixels.
    image.Image icon(Arena* arena, bool folder) {
        mut ui32[] pixels = arena.alloc_slice(ui32, 256);
        for (i32 y in 0..16) {
            for (i32 x in 0..16) {
                mut ui32 c = 0;  // transparent
                if (folder) {
                    bool tab = y >= 2 && y < 4 && x >= 1 && x < 7;
                    bool body = y >= 4 && y < 14 && x >= 1 && x < 15;
                    c = tab || body ? y == 4 ? 0xFFE0A030 : 0xFFF9C74F : 0;
                } else {
                    bool page = y >= 1 && y < 15 && x >= 3 && x < 13 && !(x >= 9 && y < 1 + x - 8);
                    bool line = page && x >= 5 && x < 11 && y >= 6 && y % 3 == 0;
                    c = line ? 0xFF8A8FA3 : page ? 0xFFE8ECF4 : 0;
                }
                pixels[(y * 16 + x) as usize] = c;
            }
        }
        return image.Image{ width: 16, height: 16, pixels: pixels };
    }

    i32 add(str name, i32 parent, bool folder) {
        mut Entry entry = Entry{ parent: parent, folder: folder, open: parent < 0 };
        entry.name.set(name);
        entries.push(entry);
        return count() - 1;
    }

    pub i32 count() {
        return entries.len() as i32;
    }

    pub Entry* entry(i32 i) {
        return entries.at(i as usize);
    }

    // Whether the entry `i` is held by `parent` (-1: at the top), and is a folder or a file.
    pub bool in_folder(i32 i, i32 parent, bool folder) {
        Entry* e = entry(i);
        return e.parent == parent && e.folder == folder;
    }

    pub str name(i32 i) {
        return entry(i).name.text();
    }

    pub void open_file(i32 i) {
        opened = i;
    }

    pub str opened_name() {
        return opened >= 0 ? name(opened) : "";
    }

    // Opens or closes every folder.
    pub void open_all(bool open) {
        for (usize i in 0..entries.len()) {
            Entry* e = entries.at(i);
            if (e.folder) {
                e.open = open;
            }
        }
    }

    // The rows of the long tree: each folder, then its files when it is open.
    void flatten() {
        mut i32 row = 0;
        for (usize i in 0..1000) {
            big_start[i] = row;
            row += big_open[i] ? 101 : 1;
        }
        big_rows = row;
    }

    // The folder of the row `row`: the last one starting at or before it.
    usize folder_at(i32 row) {
        mut usize low = 0;
        mut usize high = 1000;
        while (high - low > 1) {
            usize middle = (low + high) / 2;
            if (big_start[middle] <= row) {
                low = middle;
            } else {
                high = middle;
            }
        }
        return low;
    }

    pub bool big_branch(i32 row) {
        return big_start[folder_at(row)] == row;
    }

    pub i32 big_depth(i32 row) {
        return big_branch(row) ? 0 : 1;
    }

    pub bool big_is_open(i32 row) {
        return big_branch(row) && big_open[folder_at(row)];
    }

    pub void big_toggle(i32 row) {
        usize folder = folder_at(row);
        big_open[folder] = !big_open[folder];
        flatten();
    }

    pub void open_big(bool open) {
        big_open = [open; 1000];
        flatten();
        big_item = -1;
    }

    // "Folder 12", or "File 12.34" for the 34th file of the folder 12.
    pub str big_name(i32 row) {
        usize folder = folder_at(row);
        big_label.set(big_branch(row) ? "Folder " : "File ");
        big_label.append(widgets.format_number(folder as i64, widgets.Number{ }, true).text());
        if (!big_branch(row)) {
            big_label.append(".");
            big_label.append(widgets.format_number((row - big_start[folder]) as i64, widgets.Number{ }, true).text());
        }
        return big_label.text();
    }

    pub str big_rows_text() {
        shown = widgets.format_number(big_rows as i64, widgets.Number{ group: " " }, true);
        return shown.text();
    }

    // The total of the order, in cents.
    pub i64 total() {
        return quantity * price;
    }

    // The total, written as money.
    pub str total_text() {
        shown = widgets.format_number(total(), widgets.Number{ decimals: 2, decimal: ",", group: " ", symbol: "€" }, true);
        return shown.text();
    }

    pub str confirmed_text() {
        shown = widgets.format_number(confirmed as i64, widgets.Number{ }, true);
        return shown.text();
    }

    pub void ask() {
        asking = true;
    }

    pub void confirm() {
        confirmed += 1;
        asking = false;
    }

    pub void cancel() {
        asking = false;
    }

    pub void send() {
        sent += 1;
    }

    // `sent` in decimal digits.
    pub str times() {
        mut usize at = 12;
        mut i32 n = sent;
        while (true) {
            at -= 1;
            digits[at] = (48 + n % 10) as ui8;
            n /= 10;
            if (n == 0 || at == 0) {
                break;
            }
        }
        return match (str.from_bytes(digits[at..12])) {
            ok(text) => text,
            err(e) => "",
        };
    }

    pub void clear() {
        first_name.set("");
        last_name.set("");
        email.set("");
        notes.set("");
        newsletter = false;
    }
}
