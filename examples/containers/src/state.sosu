// The state of the example: the tab shown, a form, the options of the groups, and a tree of
// folders and files. Its interface is in screen.ui.sosu.
import ui.widgets;

pub enum Country {
    France,
    Switzerland,
    Belgium,
}

// A file of the tree: its name, the folder that holds it (-1: none) and, for a folder, whether
// it is open.
pub struct Entry {
    pub mut widgets.TextBuffer name = widgets.TextBuffer{ };
    pub mut i32 parent = -1;
    pub mut bool folder = false;
    pub mut bool open = false;
}

pub class Demo {
    pub mut i32 page;
    // The form of the grid.
    pub mut widgets.TextBuffer first_name;
    pub mut widgets.TextBuffer last_name;
    pub mut widgets.TextBuffer email;
    pub mut widgets.TextBuffer notes;
    pub mut Country country;
    pub mut bool newsletter;
    pub mut i32 sent;
    // The groups.
    pub mut bool details_open;
    pub mut bool dark;
    pub mut bool sounds;
    pub mut bool updates;
    // The tree: its entries, a folder after the files it holds, the item chosen, the file opened.
    pub mut Entry[12] entries;
    pub mut i32 count;
    pub mut i32 item;
    pub mut i32 opened;
    mut u8[12] digits;

    void init() {
        page = 0;
        first_name = widgets.TextBuffer{ };
        last_name = widgets.TextBuffer{ };
        email = widgets.TextBuffer{ };
        notes = widgets.TextBuffer{ };
        country = France;
        newsletter = false;
        sent = 0;
        details_open = true;
        dark = true;
        sounds = false;
        updates = true;
        entries = [Entry{ }; 12];
        count = 0;
        item = 0;
        opened = -1;
        digits = [0; 12];
        i32 src = add("src", -1, true);
        add("main.sosu", src, false);
        add("screen.ui.sosu", src, false);
        add("state.sosu", src, false);
        i32 assets = add("assets", -1, true);
        i32 icons = add("icons", assets, true);
        add("file.png", icons, false);
        add("folder.png", icons, false);
        add("logo.png", assets, false);
        add("sosu.toml", -1, false);
    }

    i32 add(str name, i32 parent, bool folder) {
        usize at = count as usize;
        entries[at].name.set(name);
        entries[at].parent = parent;
        entries[at].folder = folder;
        entries[at].open = parent < 0;
        count += 1;
        return at as i32;
    }

    // Whether the entry `i` is held by `parent` (-1: at the top), and is a folder or a file.
    pub bool in_folder(i32 i, i32 parent, bool folder) {
        Entry e = entries[i as usize];
        return e.parent == parent && e.folder == folder;
    }

    pub str name(i32 i) {
        return entries[i as usize].name.text();
    }

    pub void open_file(i32 i) {
        opened = i;
    }

    pub str opened_name() {
        return opened >= 0 ? name(opened) : "";
    }

    // Opens or closes every folder.
    pub void open_all(bool open) {
        for (usize i in 0..count as usize) {
            if (entries[i].folder) {
                entries[i].open = open;
            }
        }
    }

    pub void send() {
        sent += 1;
    }

    // `sent` in decimal digits.
    pub str times() {
        mut usize at = 12;
        mut i32 n = sent;
        while (true) {
            at -= 1;
            digits[at] = (48 + n % 10) as u8;
            n /= 10;
            if (n == 0 || at == 0) {
                break;
            }
        }
        return match (str.from_bytes(digits[at..12])) {
            ok(text) => text,
            err(e) => "",
        };
    }

    pub void clear() {
        first_name.set("");
        last_name.set("");
        email.set("");
        notes.set("");
        newsletter = false;
    }
}
