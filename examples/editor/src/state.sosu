// The state of the editor, changed by the widgets of its title bar.
import ui.widgets;

pub enum Mode {
    Debug,
    Release,
}

pub class Editor {
    pub mut widgets.TextBuffer search;
    pub mut widgets.TextBuffer output;
    pub mut Mode mode;
    pub mut i32 builds;
    pub mut widgets.LongText document;  // the text being edited (spec §10.9)

    void init() {
        search = widgets.TextBuffer{ };
        output = widgets.TextBuffer{ };
        mode = Debug;
        builds = 0;
        document = widgets.long_text();
        document.set("i32 main() {\n    return 0;\n}\n");
    }

    pub void find() {
        output.set("found ");
        output.append(search.text());
    }

    pub void rebuild() {
        builds += 1;
    }

    pub void run() {
        output.set("run ");
        output.append(search.text());
        output.append(mode == Debug ? " in Debug" : " in Release");
    }
}
