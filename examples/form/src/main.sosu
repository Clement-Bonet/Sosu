// A form (spec §10.4, milestone 3): its interface is in screen.ui.sosu, its state in
// state.sosu. This file runs the window and passes it the input. Closes with Escape.
// On Windows: run packages/platform/fetch-sdl3.ps1 once, then `sosuc run examples/form`
// from the root of the repository, where the font is found.
import std.io;
import platform.app;
import render.canvas;
import render.truetype;
import ui.widgets;
import form.screen;
import form.state;

class App : app.Handler {
    mut widgets.Ui ui;
    state.Form* form;

    void init(state.Form* form) {
        ui = widgets.Ui{ };
        self.form = form;
    }

    // The input goes to the widgets.
    override bool on_event(app.Event e) uses io {
        match (e) {
            Quit => {
                return false;
            },
            Key(code, down) => {
                if (code == 27) {
                    return false;
                }
                ui.key(code, down);
            },
            MouseMove(x, y) => {
                ui.mouse_move(x, y);
            },
            Click(x, y, button) => {
                ui.mouse_move(x, y);
                ui.mouse_button(true);
            },
            Release(x, y, button) => {
                ui.mouse_move(x, y);
                ui.mouse_button(false);
            },
            TextInput(text) => {
                ui.type_text(text);
            },
            _ => { },
        }
        return true;
    }

    override void on_frame(canvas.Canvas* surface) uses io {
        surface.clear(canvas.Color{ r: 30, g: 30, b: 46 });
        mut widgets.Frame f = widgets.begin(&ui, surface, 0.0, 0.0);
        screen.Greeter(&f, form);
        f.finish();
    }
}

i32 main() uses io {
    mut Arena arena = Arena.new(4 * KB);
    defer arena.free();
    state.Form* form = arena.new(state.Form);
    App* handler = arena.new(App, form);
    // the font of the widgets: Noto Sans, or else the built-in 8 by 8 font
    match (truetype.load(&arena, "packages/render/fonts/NotoSans-Regular.ttf")) {
        ok(noto) => {
            handler.ui.font = some(noto);
        },
        err(e) => {
            io.print("Noto Sans not found: the built-in font is used");
        },
    }
    widgets.Window window = screen.GreeterConfig();
    return app.run(app.Config{ title: window.title, width: window.width, height: window.height }, handler as app.Handler*);
}
