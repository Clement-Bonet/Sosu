// The form, described in an interface file (spec §10.2): `sosuc` turns it into the functions
// `Greeter` (the widgets, at each frame) and `GreeterConfig` (the window).
import form.state;

window Greeter(state.Form* form) {
    title: "Sosu form"
    width: 400
    height: 460

    Column(gap: 8, padding: 32) {
        Title("Hello")
        Text("Your name:")
        TextField(bind: form.name, width: 336, on_enter: form.greet)
        Text("Birthday:")
        TextField(bind: form.birthday, width: 160, mask: "99/99/9999")
        Checkbox("Shout", bind: form.shout)
        Space(8)
        Row(gap: 8) {
            Button("Clear", on_click: form.clear)
            Button("Greet", on_click: form.greet, enabled: form.name.count() > 0)
        }
        Space(8)
        Text(form.message.text())
    }
}
