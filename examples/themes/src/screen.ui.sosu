// The window of the example: the choice of the theme and of the size of the texts, and widgets
// of every kind, some of them with a style of look.ui.sosu.
import themes.look;
import themes.state;

window Themes(state.Demo* s) {
    title: "Themes"
    width: 900
    height: 600

    Column(gap: 12, padding: 24) {
        Title("Themes and styles")
        Text("The theme colors every widget; a style changes some of them, as a class of CSS.", style: look.Muted)
        Row(gap: 24) {
            Column(style: s.dark() ? look.CardDark : look.CardLight) {
                Text("Theme")
                Radio("Of the system", bind: s.choice, value: System)
                Radio("Dark", bind: s.choice, value: Dark)
                Radio("Light", bind: s.choice, value: Light)
                Radio("Violet", bind: s.choice, value: Violet)
                Text(s.system_dark ? "The system is dark." : "The system is light.", style: look.Muted)
                Space(6)
                Text("Size of the texts")
                Dropdown(bind: s.size, width: 200) {
                    Option("Small", value: Small)
                    Option("Medium", value: Medium)
                    Option("Large", value: Large)
                }
            }
            Column(style: s.dark() ? look.CardDark : look.CardLight) {
                Text("Name")
                TextField(bind: s.name, width: 320, placeholder: "Your name")
                Checkbox("Notifications", bind: s.notify)
                Checkbox("Compact", bind: s.compact)
                Text("Files")
                List(width: 320, height: 120, selected: s.selected) {
                    Text("report.txt")
                    Text("photo.png")
                    Text("notes.md")
                    Text("budget.csv")
                    Text("logo.svg")
                }
                Row(gap: 8) {
                    Button("Save", on_click: s.save, style: look.Primary)
                    Button("Cancel")
                    Button("Disabled", enabled: false)
                    Button("Delete", on_click: s.delete, style: look.Danger)
                }
                if (s.deleted > 0) {
                    Text("Delete was clicked {times} times.", times: s.times(), style: look.Muted)
                }
            }
        }
    }
}
