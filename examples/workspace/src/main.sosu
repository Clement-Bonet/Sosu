// A workspace in the manner of VS Code (spec §10.5): the program draws the title bar and puts
// its actions in it, while the bar still moves, maximizes and closes the window. Its interface
// is in screen.ui.sosu, its state in state.sosu.
//
// With the environment variable SOSU_SYSTEM_TITLE_BAR set (to anything), the window keeps the
// title bar of the system, as on a platform that has no custom decorations: the bar of the
// program is then a tool bar under it, and the program does not change.
//
// Its texts are in English, translated by the catalogs of locales/ (spec §10.7): French, when
// the user prefers it, or with the environment variable SOSU_LANG=fr (SOSU_LANG=en: English).
//
// On Windows: run packages/platform/fetch-sdl3.ps1 once, then `sosuc run examples/workspace`
// from the root of the repository, where the font is found.
import std.io;
import i18n.catalog;
import platform.app;
import render.canvas;
import render.image;
import render.truetype;
import ui.widgets;
import workspace.screen;
import workspace.state;

extern "C" {
    u8* getenv(u8* name);
}

// Whether the environment variable `name` is set.
bool has_env(Arena* arena, str name) {
    u8* c_name = name.to_cstr(arena);
    unsafe {
        return getenv(c_name) as u64 != 0;
    }
}

// The value of the environment variable `name` (64 bytes at most), or "".
str env(Arena* arena, str name) {
    u8* c_name = name.to_cstr(arena);
    mut u8[64] bytes = [0; 64];
    mut usize length = 0;
    unsafe {
        u8* value = getenv(c_name);
        if (value as u64 == 0) {
            return "";
        }
        while (length < 64 && *(value + length) != 0) {
            bytes[length] = *(value + length);
            length += 1;
        }
    }
    mut u8[] copy = arena.alloc_slice(u8, length);
    for (usize i in 0..length) {
        copy[i] = bytes[i];
    }
    return match (str.from_bytes(copy)) {
        ok(text) => text,
        err(e) => "",
    };
}

// The catalog of the language the user prefers (SOSU_LANG first), or none for English.
catalog.Catalog*? choose_language(Arena* arena) uses io {
    mut str[2] available = ["en", "fr"];
    str forced = env(arena, "SOSU_LANG");
    mut str[1] wanted_one = [forced];
    str[] wanted = forced.len > 0 ? wanted_one[0..1] : app.locales(arena);
    usize chosen = match (catalog.best(available[0..2], wanted)) {
        some(i) => i,
        none => 0,
    };
    if (chosen == 0) {
        return none;
    }
    return match (catalog.load(arena, "examples/workspace/locales/messages.locale.fr.sosu")) {
        ok(c) => some(c),
        err(e) => none,
    };
}

class App : app.Handler, app.TitleBar {
    mut widgets.Ui ui;
    state.Workspace* w;
    Arena* arena;  // of `main`: the catalogs of translations

    void init(state.Workspace* w, Arena* arena) {
        ui = widgets.Ui{ };
        self.w = w;
        self.arena = arena;
    }

    // Asked by the system between two frames: the empty space and the labels of the title
    // bar move the window.
    override bool is_drag_area(f32 x, f32 y) {
        return ui.is_drag_area(x, y);
    }

    override bool on_event(app.Event e) uses io {
        match (e) {
            Quit => {
                return false;
            },
            CustomTitleBar(active) => {
                ui.custom_title_bar = active;  // else the bar of the program is a tool bar
            },
            Maximized(on) => {
                ui.maximized = on;
            },
            LocaleChanged => {
                ui.catalog = choose_language(arena);  // the next frame is in that language
            },
            Key(code, down, mods) => {
                bool ctrl = mods.ctrl || mods.command;  // Cmd on macOS
                if (down && ctrl && code == 118) {  // Ctrl+V: the clipboard, typed
                    mut Arena paste = Arena.new(4 * KB);
                    defer paste.free();
                    ui.type_text(app.clipboard(&paste));
                } else {
                    ui.key(code, down, mods.shift, ctrl);
                }
            },
            MouseMove(x, y) => {
                ui.mouse_move(x, y);
            },
            Click(x, y, button) => {
                ui.mouse_move(x, y);
                match (button) {
                    Left => {
                        ui.mouse_button(true);
                    },
                    Right => {
                        ui.right_button(true);  // context menus
                    },
                    _ => { },
                }
            },
            Release(x, y, button) => {
                ui.mouse_move(x, y);
                match (button) {
                    Left => {
                        ui.mouse_button(false);
                    },
                    Right => {
                        ui.right_button(false);
                    },
                    _ => { },
                }
            },
            TextInput(text) => {
                ui.type_text(text);
            },
            Wheel(x, y) => {
                ui.scroll_wheel(y);
                ui.scroll_wheel_x(x);  // the sideways wheel: `Scroll` areas
            },
            _ => { },
        }
        return true;
    }

    override void on_frame(canvas.Canvas* surface) uses io {
        w.follow_choice();
        surface.clear(canvas.Color{ r: 30, g: 30, b: 46 });
        mut widgets.Frame f = widgets.begin(&ui, surface, 0.0, 0.0);
        screen.Workspace(&f, w);
        f.finish();
        if (w.quitting) {
            app.request_quit();
        }
        // the window buttons of the title bar act through `platform`
        match (ui.take_window_request()) {
            some(request) => {
                match (request) {
                    Minimize => {
                        app.minimize();
                    },
                    ToggleMaximize => {
                        app.toggle_maximize();
                    },
                    Close => {
                        app.request_quit();
                    },
                }
            },
            none => { },
        }
        match (ui.take_copied()) {
            some(text) => {
                mut Arena copy = Arena.new(4 * KB);
                defer copy.free();
                app.set_clipboard(&copy, text);
            },
            none => { },
        }
    }
}

i32 main() uses io {
    mut Arena arena = Arena.new(64 * KB);
    defer arena.free();
    widgets.Window window = screen.WorkspaceConfig();
    // the icon of the window, a PNG file with transparency: for the system, and in the bar
    mut image.Image icon = image.Image{ width: 0, height: 0, pixels: arena.alloc_slice(u32, 0) };
    match (image.load(&arena, window.icon)) {
        ok(found) => {
            icon = found;
        },
        err(e) => {
            io.print("{} not found: the window has no icon", window.icon);
        },
    }
    state.Workspace* w = arena.new(state.Workspace, icon);
    App* handler = arena.new(App, w, &arena);
    handler.ui.catalog = choose_language(&arena);
    match (truetype.load(&arena, "packages/render/fonts/NotoSans-Regular.ttf")) {
        ok(noto) => {
            handler.ui.font = some(noto);
        },
        err(e) => {
            io.print("Noto Sans not found: the built-in font is used");
        },
    }
    bool custom = window.custom_title_bar && !has_env(&arena, "SOSU_SYSTEM_TITLE_BAR");
    app.TitleBar*? bar = custom ? some(handler as app.TitleBar*) : none;
    str title = match (handler.ui.catalog) {
        some(c) => c.text(window.title),
        none => window.title,
    };
    app.Config config = app.Config{ title: title, width: window.width, height: window.height, title_bar: bar, icon: icon.width > 0 ? some(icon) : none };
    return app.run(config, handler as app.Handler*);
}
