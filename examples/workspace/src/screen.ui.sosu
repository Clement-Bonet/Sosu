// A workspace in the manner of VS Code: a title bar drawn by the program, holding its icon, its
// menus, a search field, two dropdowns and buttons, over three panes that use every widget of `ui`: the files
// (a tree), the details of the file chosen in tabs (fields with formats, radios, a dropdown,
// a group of checkboxes, buttons that are enabled or not) and the output (a list of lines), in a
// grid that follows the size of the window.
import workspace.state;

window Workspace(state.Workspace* w) {
    title: "Sosu workspace"
    width: 1280
    height: 720
    icon: "examples/workspace/assets/sosu.png"

    TitleBar(height: 44, gap: 8, padding: 8) {
        Image(w.icon, size: 22)
        MenuBar {
            Menu("File") {
                MenuItem("New file", on_click: w.new_file, shortcut: "Ctrl+N")
                MenuItem("Save", on_click: w.save, shortcut: "Ctrl+S", enabled: w.changed())
                MenuItem("Revert", on_click: w.revert, enabled: w.changed())
                Separator
                Menu("Open recent") {
                    for (i32 i in 0..w.count) {
                        MenuItem(w.files[i].name.text(), on_click: w.choose(i))
                    }
                }
                Separator
                MenuItem("Quit", on_click: w.quit, shortcut: "Ctrl+Q")
            }
            Menu("Edit") {
                MenuItem("Duplicate", on_click: w.duplicate, shortcut: "Ctrl+D", enabled: w.has_choice())
                MenuItem("Remove", on_click: w.remove, shortcut: "Delete", enabled: w.has_choice())
                Separator
                MenuItem("Clear the output", on_click: w.clear_output)
            }
            Menu("Build") {
                MenuItem("Build", on_click: w.build, shortcut: "Ctrl+B")
                MenuItem("Run", on_click: w.run, shortcut: "F5")
                Separator
                Menu("Mode") {
                    MenuItem("Debug", on_click: w.set_mode(state.Mode.Debug))
                    MenuItem("Release", on_click: w.set_mode(state.Mode.Release))
                }
            }
            Menu("Help") {
                MenuItem("About Sosu", on_click: w.about, shortcut: "F1")
            }
        }
        Space(16)
        TextField(bind: w.search, width: 260, on_enter: w.find, placeholder: "Search a file")
        Dropdown(bind: w.mode, width: 140, on_change: w.mode_changed) {
            Option("Debug", value: Debug)
            Option("Release", value: Release)
        }
        Dropdown(bind: w.target, width: 130, on_change: w.target_changed) {
            Option("Windows", value: Windows)
            Option("Linux", value: Linux)
            Option("macOS", value: MacOs)
        }
        Button("Build", on_click: w.build)
        Button("Run", on_click: w.run, tooltip: "Build and run the program (F5)")
    }
    Grid(columns: [260, Fill, 380], rows: [Fill], gap: 24, padding: 16) {
        Column(gap: 8) {
            Text("{count} file", plural: "{count} files", count: w.count)
            Row(gap: 8) {
                Button("Add", on_click: w.new_file)
                Button("Remove", on_click: w.remove, enabled: w.has_choice())
            }
            Tree(width: 260, height: Fill, selected: w.tree_item) {
                Branch("Sources", open: w.open_sources) {
                    for (i32 i in 0..w.count, key: i) {
                        if (w.is(i, Source)) {
                            Leaf(template: FileItem(w, i), on_click: w.choose(i))
                        }
                    }
                }
                Branch("Images", open: w.open_images) {
                    for (i32 i in 0..w.count, key: i) {
                        if (w.is(i, Image)) {
                            Leaf(template: FileItem(w, i), on_click: w.choose(i))
                        }
                    }
                }
                Branch("Binaries", open: w.open_binaries) {
                    for (i32 i in 0..w.count, key: i) {
                        if (w.is(i, Binary)) {
                            Leaf(template: FileItem(w, i), on_click: w.choose(i))
                        }
                    }
                }
            }
            ContextMenu {
                MenuItem("New file", on_click: w.new_file, shortcut: "Ctrl+N")
                MenuItem("Duplicate", on_click: w.duplicate, shortcut: "Ctrl+D", enabled: w.has_choice())
                Separator
                MenuItem("Remove", on_click: w.remove, shortcut: "Delete", enabled: w.has_choice())
            }
        }
        Column(gap: 8) {
            Text(w.chosen_name())
            if (w.has_choice()) {
                Details(w)
            } else {
                Text("Choose a file in the tree.")
            }
        }
        Column(gap: 8) {
            Text("Output")
            Text(w.status.text())
            List(count: w.lines, item: i, width: 380, height: Fill) {
                Text(w.output[i].text())
            }
        }
    }
}

// The details of the file chosen, edited until Save or Revert: in two tabs.
component Details(state.Workspace* w) {
    Tabs(bind: w.page) {
        Tab("General") {
            General(w)
        }
        Tab("Advanced") {
            Advanced(w)
        }
        Tab("Selection") {
            Selection(w)
        }
        Tab("All files") {
            Table(count: w.count, item: i, selected: w.row, sort: w.order, width: Fill, height: 260, on_activate: w.choose_row) {
                Column("Name", width: Fill, sortable: true) {
                    Text(w.files[w.nth(i)].name.text())
                }
                Column("Size (KB)", width: 110, sortable: true, align: End) {
                    Text(w.files[w.nth(i)].size.text())
                }
                Column("Modified", width: Auto) {
                    Text(w.files[w.nth(i)].date.text())
                }
            }
        }
    }
    Row(gap: 8) {
        Button("Save", on_click: w.save, enabled: w.changed())
        Button("Revert", on_click: w.revert, enabled: w.changed())
    }
}

// A file as an item of a list or a tree (spec §10.10): its icon, its name and its size; its look
// follows its state (hover, chosen), and its texts take the color of the item.
component FileItem(state.Workspace* w, i32 i) {
    Item(gap: 8, padding: 2) {
        Image(w.icon, size: 16)
        Text(w.files[i].name.text())
        Space(8)
        Text(w.size_of(i), style: Muted)
    }
}

// Several files chosen at once: Ctrl+click adds or removes one, Shift+click a range, Ctrl+A all.
component Selection(state.Workspace* w) {
    Text("{count} file chosen", plural: "{count} files chosen", count: w.picked_count())
    List(count: w.count, item: i, selection: w.picked, width: Fill, height: 220) {
        FileItem(w, i)
    }
    Row(gap: 8) {
        Button("Remove them", on_click: w.remove_picked, enabled: w.picked_count() > 0)
        Button("Clear", on_click: w.clear_picked, enabled: w.picked_count() > 0)
    }
}

// Its name, its size and dates, its kind.
component General(state.Workspace* w) {
    TextField(bind: w.details.name, width: Fill, placeholder: "File name")
    Row(gap: 16) {
        Column(gap: 4) {
            Text("Size (KB)")
            TextField(bind: w.details.size, width: 120, accept: Integer, max: 7)
        }
        Column(gap: 4) {
            Text("Modified")
            TextField(bind: w.details.date, width: 140, mask: "99/99/9999")
        }
        Column(gap: 4) {
            Text("Licence")
            TextField(bind: w.details.price, width: 108, accept: Decimal, max: 8, placeholder: "0.00")
        }
    }
    Text("Kind")
    Row(gap: 16) {
        Radio("Source", bind: w.details.kind, value: Source)
        Radio("Binary", bind: w.details.kind, value: Binary)
        Radio("Image", bind: w.details.kind, value: Image)
    }
}

// Its encoding and its options.
component Advanced(state.Workspace* w) {
    Text("Encoding")
    Dropdown(bind: w.details.encoding, width: 160) {
        Option("UTF-8", value: Utf8)
        Option("Latin-1", value: Latin1)
        Option("UTF-16", value: Utf16)
    }
    Group("Options") {
        Checkbox("Read only", bind: w.details.read_only)
        Checkbox("Hidden", bind: w.details.hidden)
    }
}

// The size of a file, quieter than its name.
style Muted {
    color: #9399B2
}
