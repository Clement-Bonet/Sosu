// std.random: pseudo-random numbers (spec §8). A generator is a value holding its state: the
// same seed gives the same numbers, without any effect. Only `from_system` takes a seed that
// changes from one run to the next, with the effect `random` (spec §7.4).
// Not for cryptography.

import std.math;

extern "C" {
    ui64 sosu_random_seed() uses random;
}

pub struct Rng {
    mut ui64 state;

    // The next 64 random bits (SplitMix64).
    pub ui64 next() {
        state = wrapping_add(state, 0x9E3779B97F4A7C15);
        mut ui64 z = state;
        z = wrapping_mul(z ^ z >> 30, 0xBF58476D1CE4E5B9);
        z = wrapping_mul(z ^ z >> 27, 0x94D049BB133111EB);
        return z ^ z >> 31;
    }

    // A number from 0 to `bound` - 1. The modulo gives a tiny bias for huge bounds.
    pub ui64 below(ui64 bound)
        requires bound > 0
    {
        return next() % bound;
    }

    // An integer from `low` to `high`, both included.
    pub i64 between(i64 low, i64 high)
        requires low <= high
    {
        ui64 span = wrapping_add(wrapping_sub(high as ui64, low as ui64), 1);
        if (span == 0) {  // the whole range of i64
            return next() as i64;
        }
        return wrapping_add(low as ui64, next() % span) as i64;
    }

    // A float from 0.0 (included) to 1.0 (excluded).
    pub f64 unit() {
        return (next() >> 11) as f64 / 9007199254740992.0;
    }

    // A float from `low` (included) to `high` (excluded).
    pub f64 range(f64 low, f64 high) {
        return low + unit() * (high - low);
    }

    // The same in f32, as games use them.
    pub f32 range_f32(f32 low, f32 high) {
        return low + unit() as f32 * (high - low);
    }

    // True with the probability `p` (0: never, 1: always).
    pub bool chance(f64 p) {
        return unit() < p;
    }

    // A number of the normal law (a bell curve): around `mean`, two in three within `deviation`
    // of it (Box-Muller).
    pub f64 normal(f64 mean, f64 deviation) {
        f64 u = 1.0 - unit();  // in (0, 1]: its logarithm is finite
        f64 v = unit();
        return mean + deviation * math.sqrt(-2.0 * math.log(u)) * math.cos(2.0 * math.PI * v);
    }

    // An index of `weights`, each as likely as its weight (none negative): a loot table, a choice
    // of what to spawn. 0 when they are all 0.
    pub usize weighted(f64[] weights)
        requires weights.len > 0
    {
        mut f64 total = 0.0;
        for (f64 w in weights) {
            total += max(w, 0.0);
        }
        if (total <= 0.0) {
            return 0;
        }
        mut f64 left = unit() * total;
        for (usize i in 0..weights.len) {
            left -= max(weights[i], 0.0);
            if (left < 0.0) {
                return i;
            }
        }
        return weights.len - 1;
    }

    // `items` in a random order, each order as likely (Fisher-Yates).
    pub void shuffle<T>(T[] items) {
        mut usize i = items.len;
        while (i > 1) {
            i -= 1;
            usize j = below((i + 1) as ui64) as usize;
            T kept = items[i];
            items[i] = items[j];
            items[j] = kept;
        }
    }
}

// A generator that gives the same numbers for the same seed.
pub Rng seeded(ui64 seed) {
    return Rng{ state: seed };
}

// A generator seeded differently on each run.
pub Rng from_system() uses random {
    mut ui64 seed = 0;
    unsafe {
        seed = sosu_random_seed();
    }
    return seeded(seed);
}
