// compress: deflate (RFC 1951), and its zlib (RFC 1950) and gzip (RFC 1952) containers, in Sosu
// (spec §8.2). Programs import `compress.zlib`, `compress.gzip`, or `compress.deflate` for the
// bare stream.
import compress.checksum;
import compress.deflate;
import compress.zlib;
import compress.gzip;
