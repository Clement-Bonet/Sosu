// crypto.sha256: the SHA-256 hash (FIPS 180-4). `sum(data)` at once, or a `Sha256` fed by parts
// with `update`, then `finish`.

ui32[64] constants() {
    return [0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2];
}

ui32 rotr(ui32 x, ui32 n) {
    return x >> n | x << 32 - n;
}

// A hash being computed: 64 bytes at a time.
pub struct Sha256 {
    mut ui32[8] state = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
    mut ui8[64] block = [0; 64];
    mut usize filled = 0;
    mut ui64 length = 0;  // in bytes

    void compress() {
        ui32[64] k = constants();
        mut ui32[64] w = [0; 64];
        for (usize i in 0..16) {
            w[i] = block[4 * i] as ui32 << 24 | block[4 * i + 1] as ui32 << 16 | block[4 * i + 2] as ui32 << 8 | block[4 * i + 3] as ui32;
        }
        for (usize i in 16..64) {
            ui32 s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ w[i - 15] >> 3;
            ui32 s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ w[i - 2] >> 10;
            w[i] = wrapping_add(wrapping_add(w[i - 16], s0), wrapping_add(w[i - 7], s1));
        }
        mut ui32 a = state[0];
        mut ui32 b = state[1];
        mut ui32 c = state[2];
        mut ui32 d = state[3];
        mut ui32 e = state[4];
        mut ui32 f = state[5];
        mut ui32 g = state[6];
        mut ui32 h = state[7];
        for (usize i in 0..64) {
            ui32 s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
            ui32 ch = e & f ^ ~e & g;
            ui32 t1 = wrapping_add(wrapping_add(wrapping_add(h, s1), wrapping_add(ch, k[i])), w[i]);
            ui32 s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
            ui32 maj = a & b ^ a & c ^ b & c;
            ui32 t2 = wrapping_add(s0, maj);
            h = g;
            g = f;
            f = e;
            e = wrapping_add(d, t1);
            d = c;
            c = b;
            b = a;
            a = wrapping_add(t1, t2);
        }
        state[0] = wrapping_add(state[0], a);
        state[1] = wrapping_add(state[1], b);
        state[2] = wrapping_add(state[2], c);
        state[3] = wrapping_add(state[3], d);
        state[4] = wrapping_add(state[4], e);
        state[5] = wrapping_add(state[5], f);
        state[6] = wrapping_add(state[6], g);
        state[7] = wrapping_add(state[7], h);
    }

    // Adds `data` to what is hashed.
    pub void update(ui8[] data) {
        for (ui8 x in data) {
            block[filled] = x;
            filled += 1;
            if (filled == 64) {
                compress();
                filled = 0;
            }
        }
        length = wrapping_add(length, data.len as ui64);
    }

    // The hash of all that was added: 32 bytes. The `Sha256` is not used afterwards.
    pub ui8[32] finish() {
        ui64 bits = wrapping_mul(length, 8);
        block[filled] = 0x80;
        filled += 1;
        if (filled > 56) {
            while (filled < 64) {
                block[filled] = 0;
                filled += 1;
            }
            compress();
            filled = 0;
        }
        while (filled < 56) {
            block[filled] = 0;
            filled += 1;
        }
        for (usize i in 0..8) {
            block[56 + i] = (bits >> (56 - 8 * i) as ui64 & 0xFF) as ui8;
        }
        compress();
        mut ui8[32] out = [0; 32];
        for (usize i in 0..8) {
            for (usize j in 0..4) {
                out[4 * i + j] = (state[i] >> (24 - 8 * j) as ui32 & 0xFF) as ui8;
            }
        }
        return out;
    }
}

// A hash to feed by parts.
pub Sha256 start() {
    return Sha256{ };
}

// The SHA-256 hash of `data`.
pub ui8[32] sum(ui8[] data) {
    mut Sha256 h = Sha256{ };
    h.update(data);
    return h.finish();
}
