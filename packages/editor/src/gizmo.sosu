// editor.gizmo: the arrows that move the entity chosen, one along each axis of the world (x red, y
// green, z blue), of a size that stays the same on the screen. The mouse near an arrow takes it
// (`hover`); dragged, the entity follows the mouse along that axis only: the point of the axis
// nearest to the ray under the mouse (`Drag`).
import math.linear;
import math.geometry;
import render.canvas;
import editor.marks;

pub enum Axis {
    X,
    Y,
    Z,
}

pub linear.Vec3 direction(Axis a) {
    return match (a) {
        X => linear.vec3(1.0, 0.0, 0.0),
        Y => linear.vec3(0.0, 1.0, 0.0),
        Z => linear.vec3(0.0, 0.0, 1.0),
    };
}

canvas.Color color_of(Axis a, bool lit) {
    return match (a) {
        X => lit ? canvas.Color{ r: 255, g: 150, b: 140 } : canvas.Color{ r: 220, g: 70, b: 60 },
        Y => lit ? canvas.Color{ r: 170, g: 255, b: 150 } : canvas.Color{ r: 90, g: 200, b: 70 },
        Z => lit ? canvas.Color{ r: 150, g: 190, b: 255 } : canvas.Color{ r: 70, g: 120, b: 230 },
    };
}

// The length of the arrows at `origin`, in meters: a seventh of the height of the view there.
pub f32 length_at(marks.View v, linear.Vec3 origin, linear.Vec3 eye) {
    return max(origin.sub(eye).length() * 0.15, 0.01);
}

f32 distance_to_segment(f32 px, f32 py, f32[2] a, f32[2] b) {
    f32 dx = b[0] - a[0];
    f32 dy = b[1] - a[1];
    f32 l2 = dx * dx + dy * dy;
    f32 t = l2 > 0.0 ? max(0.0, min(1.0, ((px - a[0]) * dx + (py - a[1]) * dy) / l2)) : 0.0;
    f32 x = a[0] + dx * t - px;
    f32 y = a[1] + dy * t - py;
    return x * x + y * y;
}

// The arrow under the pixel (px, py), within 7 pixels: the nearest.
pub Axis? hover(marks.View v, linear.Vec3 origin, f32 length, f32 px, f32 py) {
    f32[2] o = match (marks.project(v, origin)) {
        some(p) => p,
        none => {
            return none;
        },
    };
    mut Axis? best = none;
    mut f32 nearest = 49.0;
    mut Axis[3] axes = [Axis.X, Axis.Y, Axis.Z];
    for (Axis a in axes) {
        match (marks.project(v, origin.add(direction(a).scale(length)))) {
            some(tip) => {
                f32 d = distance_to_segment(px, py, o, tip);
                if (d < nearest) {
                    nearest = d;
                    best = some(a);
                }
            },
            none => { },
        }
    }
    return best;
}

// The arrows at `origin`, `lit` the one under the mouse or dragged.
pub void draw(canvas.Canvas* c, marks.View v, linear.Vec3 origin, f32 length, Axis? lit) {
    mut Axis[3] axes = [Axis.X, Axis.Y, Axis.Z];
    for (Axis a in axes) {
        bool on = match (lit) {
            some(l) => match (l) {
                X => match (a) {
                    X => true,
                    _ => false,
                },
                Y => match (a) {
                    Y => true,
                    _ => false,
                },
                Z => match (a) {
                    Z => true,
                    _ => false,
                },
            },
            none => false,
        };
        canvas.Color color = color_of(a, on);
        linear.Vec3 tip = origin.add(direction(a).scale(length));
        // thick: three lines side by side on the screen
        for (i32 k in -1..2) {
            match (marks.project(v, origin)) {
                some(p) => {
                    match (marks.project(v, tip)) {
                        some(q) => {
                            f32 dx = q[0] - p[0];
                            f32 dy = q[1] - p[1];
                            f32 n = max(abs(dx) + abs(dy), 0.001);
                            f32 ox = -dy / n * k as f32;
                            f32 oy = dx / n * k as f32;
                            c.push_clip(canvas.Rect{ x: v.x, y: v.y, w: v.w, h: v.h });
                            c.line((p[0] + ox) as i32, (p[1] + oy) as i32, (q[0] + ox) as i32, (q[1] + oy) as i32, color);
                            c.pop_clip();
                        },
                        none => { },
                    }
                },
                none => { },
            }
        }
        match (marks.project(v, tip)) {
            some(q) => {
                c.fill_circle(q[0], q[1], on ? 6.0 : 5.0, color);
            },
            none => { },
        }
    }
    marks.marker(c, v, origin, canvas.Color{ r: 240, g: 240, b: 240 });
}

// The parameter along the line `origin + t axis` of its point nearest to the ray `r`; none when
// they are parallel (the axis seen end on: it cannot be dragged).
pub f32? along(linear.Vec3 origin, linear.Vec3 axis, geometry.Ray r) {
    linear.Vec3 w = origin.sub(r.origin);
    f32 b = axis.dot(r.direction);
    f32 d = axis.dot(w);
    f32 e = r.direction.dot(w);
    f32 denominator = 1.0 - b * b;  // both are unit vectors
    if (denominator < 0.0001) {
        return none;
    }
    return some((b * e - d) / denominator);
}

// An arrow being dragged: where the entity was, and where along the axis the mouse took it.
pub struct Drag {
    pub Axis axis;
    pub linear.Vec3 start;
    pub f32 grip;
}

pub Drag? begin(Axis a, linear.Vec3 start, geometry.Ray r) {
    return match (along(start, direction(a), r)) {
        some(t) => some(Drag{ axis: a, start: start, grip: t }),
        none => none,
    };
}

// Where the entity is with the mouse under the ray `r`: moved along the axis only.
pub linear.Vec3 moved(Drag d, geometry.Ray r) {
    linear.Vec3 axis = direction(d.axis);
    return match (along(d.start, axis, r)) {
        some(t) => d.start.add(axis.scale(t - d.grip)),
        none => d.start,
    };
}

test "the gizmo: the arrow under the mouse, and a drag along it only" {
    // a camera in front and above, looking at the origin
    marks.View v = marks.View{ view_projection: linear.perspective(1.0, 1.0, 0.1, 100.0).mul(linear.look_at(linear.vec3(4.0, 3.0, 10.0),
            linear.vec3(0.0, 0.0, 0.0), linear.vec3(0.0, 1.0, 0.0))), x: 0.0, y: 0.0, w: 500.0, h: 500.0 };
    linear.Vec3 origin = linear.vec3(0.0, 0.0, 0.0);
    f32 length = 1.5;
    // the mouse on the tip of the x arrow: x
    f32[2] tip = match (marks.project(v, linear.vec3(1.5, 0.0, 0.0))) {
        some(p) => p,
        none => [0.0, 0.0],
    };
    assert(match (hover(v, origin, length, tip[0] + 2.0, tip[1] - 2.0)) {
        some(a) => match (a) {
            X => true,
            _ => false,
        },
        none => false,
    });
    f32[2] up = match (marks.project(v, linear.vec3(0.0, 1.2, 0.0))) {
        some(p) => p,
        none => [0.0, 0.0],
    };
    assert(match (hover(v, origin, length, up[0], up[1])) {
        some(a) => match (a) {
            Y => true,
            _ => false,
        },
        none => false,
    });
    // far from every arrow: none
    assert(match (hover(v, origin, length, 10.0, 10.0)) {
        some(a) => false,
        none => true,
    });
    // dragged along x from its tip to the projection of (3, 0, 0): the entity at (1.5, 0, 0) moves
    // to (3, 0, 0), nothing else changing
    linear.Vec3 start = linear.vec3(1.5, 0.0, 0.0);
    geometry.Ray grab = match (marks.ray_at(v, tip[0], tip[1])) {
        some(r) => r,
        none => geometry.ray(linear.vec3(0.0, 0.0, 0.0), linear.vec3(0.0, 0.0, 1.0)),
    };
    Drag d = match (begin(Axis.X, start, grab)) {
        some(x) => x,
        none => Drag{ axis: Axis.X, start: start, grip: 0.0 },
    };
    f32[2] there = match (marks.project(v, linear.vec3(3.0, 0.0, 0.0))) {
        some(p) => p,
        none => [0.0, 0.0],
    };
    geometry.Ray now = match (marks.ray_at(v, there[0], there[1])) {
        some(r) => r,
        none => grab,
    };
    linear.Vec3 to = moved(d, now);
    assert(to.near(linear.vec3(3.0, 0.0, 0.0), 0.02));
    // the mouse dragged off the axis: still on it
    geometry.Ray off = match (marks.ray_at(v, there[0], there[1] - 80.0)) {
        some(r) => r,
        none => grab,
    };
    linear.Vec3 kept = moved(d, off);
    assert(abs(kept.y) < 0.0001 && abs(kept.z) < 0.0001);
}
