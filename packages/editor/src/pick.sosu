// editor.pick: which entity is under the mouse. A ray (`geometry.ray_from_screen`) is tested
// against the box of each entity, in its own space: the bounds of the meshes of its model (each
// placed by its node), else the shape of its body, else a small box around where it is (a light, a
// camera, a sound, an emitter: what has no size of its own). The nearest hit wins.
import std.vec;
import math.linear;
import math.geometry;
import model.model;
import scene.scene;
import engine.components;
import engine.engine;
import render3d.render3d;

// The half side of the box of an entity without a size of its own.
pub f32 MARKER = 0.3;

pub struct Hit {
    pub scene.Entity entity;
    pub f32 distance;  // along the ray, in meters
}

// The box of `e` in its own space (scaled by its transform), none when it has nothing to show.
pub geometry.Aabb? local_box(Arena* scratch, engine.Engine* g, scene.Entity e) uses io, threads {
    components.Components* c = g.c;
    match (c.meshes.get(e)) {
        some(m) => {
            match (g.model_of(m.model)) {
                some(loaded) => {
                    linear.Mat4[] places = model.world_matrices(scratch, loaded, linear.identity4());
                    mut geometry.Aabb? box = none;
                    for (usize n in 0..loaded.nodes.len) {
                        for (usize k in loaded.nodes[n].meshes) {
                            if (k < loaded.meshes.len) {
                                geometry.Aabb b = loaded.meshes[k].bounds.transformed(places[n]);
                                box = match (box) {
                                    some(x) => some(x.union(b)),
                                    none => some(b),
                                };
                            }
                        }
                    }
                    match (box) {
                        some(b) => {
                            return some(b);
                        },
                        none => { },
                    }
                },
                none => { },
            }
        },
        none => { },
    }
    match (c.bodies.get(e)) {
        some(b) => {
            linear.Vec3 s = b.size;
            linear.Vec3 half = match (b.shape) {
                Box => s,
                Sphere => linear.vec3(s.x, s.x, s.x),
                Capsule => linear.vec3(s.x, s.y + s.x, s.x),
                Cylinder => linear.vec3(s.x, s.y, s.x),
            };
            // a body is not scaled by its entity: its box is given in the space of the entity
            return some(geometry.aabb(half.scale(-1.0), half));
        },
        none => { },
    }
    if (c.lights.has(e) || c.views.has(e) || c.sounds.has(e) || c.emitters.has(e)) {
        linear.Vec3 m = linear.vec3(MARKER, MARKER, MARKER);
        return some(geometry.aabb(m.scale(-1.0), m));
    }
    return none;
}

// The nearest entity the ray `r` meets, with the distance along it.
pub Hit? pick(engine.Engine* g, geometry.Ray r) uses io, threads {
    mut Arena scratch = Arena.new(16 * KB);
    defer scratch.free();
    mut Hit? best = none;
    for (scene.Entity e in g.world.entities(&scratch)) {
        mut geometry.Aabb? found = local_box(&scratch, g, e);
        if (match (found) {
            some(b) => false,
            none => true,
        }) {
            continue;
        }
        geometry.Aabb box = match (found) {
            some(b) => b,
            none => geometry.aabb(linear.vec3(0.0, 0.0, 0.0), linear.vec3(0.0, 0.0, 0.0)),
        };
        mut linear.Mat4 m = g.matrix_of(e);
        // a body ignores the scale of its entity: its box is in the space of its position and turn
        if (!g.c.meshes.has(e) && g.c.bodies.has(e)) {
            linear.Transform t = linear.decompose(m);
            m = linear.translation(t.position).mul(t.rotation.to_mat4());
        }
        if (!g.c.meshes.has(e) && !g.c.bodies.has(e)) {
            m = linear.translation(m.transform_point(linear.vec3(0.0, 0.0, 0.0)));  // a marker keeps its size
        }
        linear.Mat4? inverted = m.inverse();
        if (match (inverted) {
            some(x) => false,
            none => true,
        }) {
            continue;
        }
        linear.Mat4 inverse = match (inverted) {
            some(x) => x,
            none => linear.identity4(),
        };
        // the ray in the space of the entity; a hit taken back to the world for its distance
        linear.Vec3 origin = inverse.transform_point(r.origin);
        linear.Vec3 toward = inverse.transform_vector(r.direction);
        if (toward.length() < 0.000001) {
            continue;
        }
        if (box.contains(origin)) {
            continue;  // the eye is inside it (a camera of the scene where the editor's is): not chosen
        }
        geometry.Ray local = geometry.ray(origin, toward);
        match (geometry.ray_box(local, box)) {
            some(d) => {
                f32 distance = m.transform_point(local.at(d)).sub(r.origin).length();
                bool nearer = match (best) {
                    some(h) => distance < h.distance,
                    none => true,
                };
                if (nearer) {
                    best = some(Hit{ entity: e, distance: distance });
                }
            },
            none => { },
        }
    }
    return best;
}

scene.Entity placed(scene.World* w, keeps str name, linear.Vec3 at, f32 scale) {
    return w.spawn_at(name, linear.Transform{ position: at, rotation: linear.identity_quat(), scale: linear.vec3(scale, scale, scale) },
            none);
}

test "picking: the nearest entity on the ray, by its mesh, its body, or its place" {
    mut Arena arena = Arena.new(1 * MB);
    defer arena.free();
    scene.World* w = scene.world(&arena);
    components.Components* c = components.components(&arena, w);
    engine.Engine* g = engine.engine(&arena, c, none, none, none, none);
    defer g.close();
    g.paused = true;  // an editor: nothing falls
    g.adopt_model("crate", render3d.cube(&arena, [1.0, 1.0, 1.0, 1.0]));
    scene.Entity front = placed(w, "front", linear.vec3(0.0, 1.0, 0.0), 0.4);
    c.meshes.set(front, components.Mesh{ model: "crate" });
    scene.Entity back = placed(w, "back", linear.vec3(0.0, 1.0, -5.0), 0.4);
    c.meshes.set(back, components.Mesh{ model: "crate" });
    scene.Entity lamp = placed(w, "lamp", linear.vec3(3.0, 2.0, 0.0), 1.0);
    c.lights.set(lamp, components.Light{ });
    scene.Entity ground = placed(w, "ground", linear.vec3(0.0, -0.5, 0.0), 1.0);
    c.bodies.set(ground, components.Body{ kind: components.BodyKind.Static, size: linear.vec3(10.0, 0.5, 10.0) });
    g.update(0.0);
    // along -z through both crates: the front one, at 10 - 0.4 m
    match (pick(g, geometry.ray(linear.vec3(0.0, 1.0, 10.0), linear.vec3(0.0, 0.0, -1.0)))) {
        some(h) => {
            assert(h.entity.same(front) && abs(h.distance - 9.6) < 0.001);
        },
        none => assert(false),
    }
    // from behind: the back one
    match (pick(g, geometry.ray(linear.vec3(0.0, 1.0, -10.0), linear.vec3(0.0, 0.0, 1.0)))) {
        some(h) => {
            assert(h.entity.same(back) && abs(h.distance - 4.6) < 0.001);
        },
        none => assert(false),
    }
    // the lamp, by its marker
    match (pick(g, geometry.ray(linear.vec3(3.0, 2.0, 10.0), linear.vec3(0.0, 0.0, -1.0)))) {
        some(h) => {
            assert(h.entity.same(lamp) && abs(h.distance - (10.0 - MARKER)) < 0.001);
        },
        none => assert(false),
    }
    // the ground, by its body, from above
    match (pick(g, geometry.ray(linear.vec3(5.0, 5.0, 5.0), linear.vec3(0.0, -1.0, 0.0)))) {
        some(h) => {
            assert(h.entity.same(ground) && abs(h.distance - 5.0) < 0.001);
        },
        none => assert(false),
    }
    // the sky: nothing
    assert(match (pick(g, geometry.ray(linear.vec3(0.0, 5.0, 0.0), linear.vec3(0.0, 1.0, 0.0)))) {
        some(h) => false,
        none => true,
    });
}
