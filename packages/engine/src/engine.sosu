// engine.engine: what makes the common components run. An `Engine` gives each entity of a world
// what its components ask of the packages: a body of `physics` for a `Body`, a system of
// `particles` for an `Emitter`, a source of `audio.spatial` for a `Sound`, a model loaded by
// `assets` (and on the GPU, by `render3d`) for a `Mesh`, a skeleton and a clip of `anim` for an
// `Animator`. Each frame, `update(dt)`:
//
// - loads what is asked (the store of assets), uploads the models that are ready;
// - moves the kinematic bodies to their entities, steps the physics, and moves the entities of the
//   dynamic bodies to them;
// - computes the world matrices (`scene.World.propagate`);
// - moves the emitters, the sounds and the listener (the active `View`), and runs the animators.
//
// `render(frame)` draws the meshes with the lights, seen through the active view, then the
// particles. Drawing and sound are optional: without a GPU or a mixer, the rest runs the same (the
// tests, a server). What an entity is given is made when it is first seen with its component, and
// made again after `refresh(e)` (an editor changed the component). `adopt_model` and `adopt_sound`
// give a model or a sound made in code for a path, without a file.
import std.vec;
import std.text;
import std.io;
import std.os;
import std.time;
import std.random;
import math.linear;
import math.curve;
import math.geometry;
import image.image;
import model.model;
import scene.scene;
import gpu.gpu;
import render3d.render3d;
import physics.physics;
import audio.audio;
import audio.mixer;
import audio.spatial;
import particles.particles;
import particles.draw;
import anim.anim;
import assets.assets;
import assets.ids;
import std.fs;
import engine.components;
import render.truetype;
import render3d.text3d;

bool present<T>(T? x) {
    return match (x) {
        some(v) => true,
        none => false,
    };
}

// The space the box of an entity lies in (`Engine.bounds_of`).
pub enum BoxSpace {
    Scaled,  // its own: placed by its world matrix (a mesh)
    Turned,  // its place and its turn, not its scale (a body)
    Placed,  // its place alone: a marker keeps its size
}

pub struct Bounds {
    pub geometry.Aabb box;
    pub BoxSpace space;
}

// The half side of the box of what has no size of its own.
pub f32 MARKER = 0.3;

// The matrix that places a box lying in `space` for an entity whose world matrix is `world`.
pub linear.Mat4 box_matrix(linear.Mat4 world, BoxSpace space) {
    return match (space) {
        Scaled => world,
        Turned => {
            linear.Transform t = linear.decompose(world);
            return linear.translation(t.position).mul(t.rotation.to_mat4());
        },
        Placed => linear.translation(world.transform_point(linear.vec3(0.0, 0.0, 0.0))),
    };
}

// A model of the project: loaded once for every mesh that names it.
struct ModelSlot {
    str path;
    mut assets.Handle? handle;          // none: adopted (made in code)
    mut model.Model? loaded;
    mut render3d.Uploaded*? uploaded;
    mut bool failed;
}

struct SoundSlot {
    str path;
    mut assets.Handle? handle;
    mut audio.Sound? loaded;
    mut bool failed;
}

// What an animator plays.
struct Playing {
    anim.Skeleton skeleton;
    anim.Clip* clip;
    anim.Pose pose;
    linear.Mat4[] palette;
    mut f32 time;
}

// What an entity was given.
struct Live {
    mut physics.Body? body;
    mut bool kinematic;
    mut bool dynamic;
    mut spatial.Source? source;
    mut bool played;
    mut particles.System*? system;
    mut Playing? playing;
    mut bool animation_tried;  // its model was ready and gave no clip: not tried again
}

// The model of a text (`components.Text`): made again when what it shows changes (`key`), its
// memory freed then.
class TextMade {
    mut str key;
    mut Arena memory;
    mut model.Model? made;
    mut render3d.Uploaded*? uploaded;

    void init() {
        key = "";
        memory = Arena.new(4 * KB);
        made = none;
        uploaded = none;
    }
}

// A font a text names, read once.
struct FontSlot {
    str path;
    truetype.Font*? font;
}

pub class Engine {
    Arena* arena;
    pub components.Components* c;
    pub scene.World* world;
    pub physics.World* physics_world;
    assets.Assets*? store;
    render3d.Renderer*? renderer;
    draw.Drawer*? drawer;
    pub spatial.Space*? space;
    scene.Table<Live>* live;
    vec.Vec<ModelSlot>* models;
    vec.Vec<SoundSlot>* sounds;
    scene.Table<TextMade*>* texts_made;
    vec.Vec<FontSlot>* fonts;
    // The camera the scene is seen through in place of its active view: that of an editor.
    pub mut render3d.Camera? looking;
    // Paused (an editor that edits): the files still load and the world matrices follow the
    // transforms, but nothing moves, burns, plays or is given a body until it is not.
    pub mut bool paused;
    // Where the files of the project are (`use_files`): the folder relative paths start from, and
    // the identities of its files, whose GUIDs the components name.
    mut str root;
    mut ids.Catalog*? catalog;

    void init(keeps Arena* arena, keeps components.Components* c, keeps assets.Assets*? store,
            keeps render3d.Renderer*? renderer, keeps draw.Drawer*? drawer, keeps mixer.Mixer*? mix) {
        self.arena = arena;
        self.c = c;
        world = c.world;
        physics_world = physics.world(arena, physics.options());
        self.store = store;
        self.renderer = renderer;
        self.drawer = drawer;
        space = match (mix) {
            some(m) => some(spatial.space(arena, m)),
            none => none,
        };
        live = world.table<Live>();
        models = vec.new<ModelSlot>(arena);
        sounds = vec.new<SoundSlot>(arena);
        texts_made = world.table<TextMade*>();
        fonts = vec.new<FontSlot>(arena);
        looking = none;
        paused = false;
        root = "";
        catalog = none;
        // the models every scene can name without a file
        adopt_model("crate", render3d.cube(arena, [0.72, 0.52, 0.3, 1.0]));
        adopt_model("ground", render3d.ground(arena, 20.0, [0.34, 0.4, 0.3, 1.0]));
    }

    // The model of `path` once it is loaded (or adopted), none before.
    pub model.Model? model_of(keeps str path) uses io, threads {
        return match (model_slot(path)) {
            some(slot) => slot.loaded,
            none => none,
        };
    }

    // ---- Assets ----

    // The model of `path`, made in code: what a mesh that names it draws.
    pub void adopt_model(keeps str path, keeps model.Model m) {
        for (usize i in 0..models.len()) {
            ModelSlot* s = models.at(i);
            if (s.path == path) {
                s.loaded = some(m);
                s.handle = none;
                s.uploaded = none;
                return;
            }
        }
        models.push(ModelSlot{ path: path, handle: none, loaded: some(m), uploaded: none, failed: false });
    }

    // The names of the models made in code (`adopt_model`), in the order they were given: those of
    // the engine first ("crate", a cube of 2 m; "ground", a square of 40 m), then the game's; what a
    // mesh can name without a file (an editor offers them beside the files of the project).
    pub str[] adopted_models(keeps Arena* into) {
        vec.Vec<str>* out = vec.new<str>(into);
        for (usize i in 0..models.len()) {
            ModelSlot* s = models.at(i);
            bool made_in_code = match (s.handle) {
                some(h) => false,
                none => true,
            };
            if (made_in_code) {
                out.push(text.repeat(into, s.path, 1));  // its own copy: the slot may go
            }
        }
        return out.items();
    }

    // The sound of `path`, made in code.
    pub void adopt_sound(keeps str path, keeps audio.Sound s) {
        for (usize i in 0..sounds.len()) {
            SoundSlot* slot = sounds.at(i);
            if (slot.path == path) {
                slot.loaded = some(s);
                slot.handle = none;
                return;
            }
        }
        sounds.push(SoundSlot{ path: path, handle: none, loaded: some(s), failed: false });
    }

    // The files of a project: `root`, the folder relative paths start from, and `catalog` (none:
    // paths only), the identities of its files (`assets.ids`): a component that names a GUID names
    // the file of that GUID, wherever it was moved since. Before the first file is asked.
    pub void use_files(keeps str root, keeps ids.Catalog*? catalog) {
        self.root = root;
        self.catalog = catalog;
    }

    // The file a component names by `name`: that of its GUID, else `name` from the root of the
    // project (unless it is absolute), else `name` itself.
    pub str located(str name) {
        match (catalog) {
            some(cat) => {
                match (cat.path_of(name)) {
                    some(relative) => {
                        return fs.join(arena, root, relative);
                    },
                    none => { },
                }
            },
            none => { },
        }
        bool absolute = text.starts_with(name, "/") || text.contains(name, ":");
        return root.len > 0 && !absolute ? fs.join(arena, root, name) : text.repeat(arena, name, 1);
    }

    ModelSlot*? model_slot(keeps str path) uses io, threads {
        if (path.len == 0) {
            return none;
        }
        for (usize i in 0..models.len()) {
            if (models.at(i).path == path) {
                return some(models.at(i));
            }
        }
        match (store) {
            some(s) => {
                models.push(ModelSlot{ path: path, handle: some(s.model_file(located(path))), loaded: none, uploaded: none, failed: false });
                return some(models.at(models.len() - 1));
            },
            none => {
                return none;
            },
        }
    }

    SoundSlot*? sound_slot(keeps str path) uses io, threads {
        if (path.len == 0) {
            return none;
        }
        for (usize i in 0..sounds.len()) {
            if (sounds.at(i).path == path) {
                return some(sounds.at(i));
            }
        }
        match (store) {
            some(s) => {
                sounds.push(SoundSlot{ path: path, handle: some(s.sound(located(path))), loaded: none, failed: false });
                return some(sounds.at(sounds.len() - 1));
            },
            none => {
                return none;
            },
        }
    }

    // What the store has finished: the models and sounds ready, the models uploaded.
    void collect() uses io {
        match (store) {
            some(s) => {
                for (usize i in 0..models.len()) {
                    ModelSlot* m = models.at(i);
                    match (m.handle) {
                        some(h) => {
                            if (!present(m.loaded) && !m.failed) {
                                match (s.state(h)) {
                                    Ready => {
                                        m.loaded = s.get_model(h);
                                    },
                                    Failed(why) => {
                                        m.failed = true;
                                    },
                                    Loading => { },
                                }
                            }
                        },
                        none => { },
                    }
                }
                for (usize i in 0..sounds.len()) {
                    SoundSlot* d = sounds.at(i);
                    match (d.handle) {
                        some(h) => {
                            if (!present(d.loaded) && !d.failed) {
                                match (s.state(h)) {
                                    Ready => {
                                        d.loaded = s.get_sound(h);
                                    },
                                    Failed(why) => {
                                        d.failed = true;
                                    },
                                    Loading => { },
                                }
                            }
                        },
                        none => { },
                    }
                }
            },
            none => { },
        }
        match (renderer) {
            some(r) => {
                for (usize i in 0..models.len()) {
                    ModelSlot* m = models.at(i);
                    if (!present(m.uploaded) && !m.failed) {
                        match (m.loaded) {
                            some(loaded) => {
                                match (r.upload(arena, loaded)) {
                                    ok(up) => {
                                        m.uploaded = some(up);
                                    },
                                    err(e) => {
                                        m.failed = true;
                                    },
                                }
                            },
                            none => { },
                        }
                    }
                }
            },
            none => { },
        }
    }

    // ---- What each entity is given ----

    Live* live_of(scene.Entity e) {
        match (live.get(e)) {
            some(l) => {
                return l;
            },
            none => { },
        }
        live.set(e, Live{ body: none, kinematic: false, dynamic: false, source: none, played: false, system: none,
                playing: none, animation_tried: false });
        return match (live.get(e)) {
            some(l) => l,
            none => live_of(e),  // set just above
        };
    }

    // What `e` was given dropped (its body removed, its sound stopped): made again at the next
    // `update`, from its components as they are then. An editor calls it when it changes one.
    pub void refresh(scene.Entity e) {
        match (live.get(e)) {
            some(l) => {
                match (l.body) {
                    some(b) => {
                        physics_world.remove(b);
                    },
                    none => { },
                }
                match (l.source) {
                    some(s) => {
                        match (space) {
                            some(sp) => {
                                sp.stop(s);
                            },
                            none => { },
                        }
                    },
                    none => { },
                }
                live.remove(e);
            },
            none => { },
        }
    }

    // Where `e` is in the world: its world matrix (its transform before the first `update`).
    // The box of `e`, and the space it lies in: the bounds of the meshes of its model (each placed by
    // its node), in its own space; else the shape of its body, in its place and turn (a body is not
    // scaled); else a box of `MARKER` around its place for what has no size of its own (a light, a
    // camera, a sound, an emitter); none for the rest. What an editor picks with the mouse.
    pub Bounds? bounds_of(scene.Entity e) uses io, threads {
        match (c.meshes.get(e)) {
            some(m) => {
                match (model_of(m.model)) {
                    some(loaded) => {
                        mut Arena scratch = Arena.new(4 * KB);
                        defer scratch.free();
                        // the model where its offset puts it in the entity
                        linear.Mat4[] places = model.world_matrices(&scratch, loaded, linear.translation(m.offset));
                        mut geometry.Aabb? box = none;
                        for (usize n in 0..loaded.nodes.len) {
                            for (usize k in loaded.nodes[n].meshes) {
                                if (k < loaded.meshes.len) {
                                    geometry.Aabb b = loaded.meshes[k].bounds.transformed(places[n]);
                                    box = match (box) {
                                        some(x) => some(x.union(b)),
                                        none => some(b),
                                    };
                                }
                            }
                        }
                        match (box) {
                            some(b) => {
                                return some(Bounds{ box: b, space: BoxSpace.Scaled });
                            },
                            none => { },
                        }
                    },
                    none => { },
                }
            },
            none => { },
        }
        match (text_of(e)) {
            some(t) => {
                match (t.made) {
                    some(m) => {
                        return some(Bounds{ box: m.meshes[0].bounds, space: BoxSpace.Scaled });
                    },
                    none => { },
                }
            },
            none => { },
        }
        match (c.bodies.get(e)) {
            some(b) => {
                linear.Vec3 s = b.size;
                linear.Vec3 half = match (b.shape) {
                    Box => s,
                    Sphere => linear.vec3(s.x, s.x, s.x),
                    Capsule => linear.vec3(s.x, s.y + s.x, s.x),
                    Cylinder => linear.vec3(s.x, s.y, s.x),
                };
                // turned and moved in its entity (`Body.rotation`, `center`): the box around it
                linear.Mat4 turn = components.turn_of(*b).to_mat4();
                linear.Vec3 reach = linear.vec3(reach_of(turn, 0, half), reach_of(turn, 1, half), reach_of(turn, 2, half));
                return some(Bounds{ box: geometry.aabb(b.center.sub(reach), b.center.add(reach)), space: BoxSpace.Turned });
            },
            none => { },
        }
        if (c.lights.has(e) || c.views.has(e) || c.sounds.has(e) || c.emitters.has(e)) {
            linear.Vec3 m = linear.vec3(MARKER, MARKER, MARKER);
            return some(Bounds{ box: geometry.aabb(m.scale(-1.0), m), space: BoxSpace.Placed });
        }
        return none;
    }

    pub linear.Mat4 matrix_of(scene.Entity e) {
        return match (world.world_matrices.get(e)) {
            some(m) => *m,
            none => match (world.transforms.get(e)) {
                some(t) => t.to_mat4(),
                none => linear.identity4(),
            },
        };
    }

    // How far a box of half sizes `half`, turned by `turn`, reaches along the axis `row`.
    f32 reach_of(linear.Mat4 turn, usize row, linear.Vec3 half) {
        return abs(turn.at(row, 0)) * half.x + abs(turn.at(row, 1)) * half.y + abs(turn.at(row, 2)) * half.z;
    }

    // The `Body` of `e` (a fresh one when it has none any more).
    components.Body body_desc(scene.Entity e) {
        return match (c.bodies.get(e)) {
            some(x) => *x,
            none => components.Body{ },
        };
    }

    // The bodies of the entities that have a `Body` and none yet.
    void make_bodies() {
        for (scene.Entity e in c.bodies.entities_now()) {
            Live* l = live_of(e);
            if (present(l.body)) {
                continue;
            }
            components.Body b = match (c.bodies.get(e)) {
                some(x) => *x,
                none => components.Body{ },
            };
            linear.Transform at = components.shape_place(b, linear.decompose(matrix_of(e)));
            linear.Vec3 s = b.size;
            physics.Shape shape = match (b.shape) {
                Box => physics.box(linear.vec3(max(s.x, 0.001), max(s.y, 0.001), max(s.z, 0.001))),
                Sphere => physics.sphere(max(s.x, 0.001)),
                Capsule => physics.capsule(max(s.y, 0.001), max(s.x, 0.001)),
                Cylinder => physics.cylinder(max(s.y, 0.001), max(s.x, 0.001)),
            };
            physics.Kind kind = match (b.kind) {
                Static => physics.Kind.Static,
                Dynamic => physics.Kind.Dynamic,
                Kinematic => physics.Kind.Kinematic,
            };
            l.body = some(physics_world.body(physics.BodyDesc{ kind: kind, shape: shape, position: at.position,
                    rotation: at.rotation, mass: b.mass, friction: b.friction, restitution: b.restitution, damping: b.damping,
                    angular_damping: b.damping, gravity_scale: b.gravity_scale, layers: b.layers as ui32,
                    mask: b.mask as ui32, sensor: b.sensor }));
            shape.release();
            l.kinematic = match (b.kind) {
                Kinematic => true,
                _ => false,
            };
            l.dynamic = match (b.kind) {
                Dynamic => true,
                _ => false,
            };
        }
    }

    // The systems of the entities that have an `Emitter` and none yet.
    void make_emitters() {
        for (scene.Entity e in c.emitters.entities_now()) {
            Live* l = live_of(e);
            if (present(l.system)) {
                continue;
            }
            components.Emitter x = match (c.emitters.get(e)) {
                some(v) => *v,
                none => components.Emitter{ },
            };
            f32 spread = max(0.0, min(1.0, x.spread));
            particles.Shape shape = match (x.shape) {
                Point => particles.Shape.Point,
                Sphere => particles.Shape.Sphere(max(x.extent.x, 0.0)),
                Box => particles.Shape.Box(x.extent),
            };
            particles.Emitter p = particles.Emitter{ rate: x.rate, looping: x.looping, shape: shape,
                    life: particles.range(x.life * (1.0 - spread), x.life * (1.0 + spread)),
                    speed: particles.range(x.speed * (1.0 - spread), x.speed * (1.0 + spread)), size: particles.exactly(x.size),
                    gravity: x.gravity, drag: x.drag, color: linear.Vec4{ x: x.color.x, y: x.color.y, z: x.color.z, w: x.alpha },
                    blending: x.additive ? particles.Blending.Additive : particles.Blending.Alpha };
            particles.System* system = particles.system(arena, p);
            system.move_to(matrix_of(e));
            l.system = some(system);
        }
    }

    // The sounds that start: those of `autoplay`, once their file is loaded.
    void start_sounds() uses io, threads {
        spatial.Space* sp = match (space) {
            some(x) => x,
            none => {
                return;
            },
        };
        for (scene.Entity e in c.sounds.entities_now()) {
            Live* l = live_of(e);
            if (l.played) {
                continue;
            }
            components.Sound s = match (c.sounds.get(e)) {
                some(v) => *v,
                none => components.Sound{ },
            };
            if (!s.autoplay) {
                l.played = true;
                continue;
            }
            match (sound_slot(s.sound)) {
                some(slot) => {
                    match (slot.loaded) {
                        some(sound) => {
                            linear.Vec3 at = matrix_of(e).transform_point(linear.vec3(0.0, 0.0, 0.0));
                            l.source = some(sp.play(sound, spatial.Placed{ position: at, volume: s.volume, looping: s.looping,
                                    near: s.near, far: s.far, reverb: s.reverb }));
                            l.played = true;
                        },
                        none => {
                            if (slot.failed) {
                                l.played = true;  // its file is not there: never
                            }
                        },
                    }
                },
                none => {
                    l.played = true;
                },
            }
        }
    }

    // The clips of the animators whose model is ready.
    void make_animators() uses io, threads {
        for (scene.Entity e in c.animators.entities_now()) {
            Live* l = live_of(e);
            if (present(l.playing) || l.animation_tried) {
                continue;
            }
            components.Animator a = match (c.animators.get(e)) {
                some(v) => *v,
                none => components.Animator{ },
            };
            str path = match (c.meshes.get(e)) {
                some(m) => m.model,
                none => "",
            };
            mut model.Model? ready = none;
            match (model_slot(path)) {
                some(slot) => {
                    ready = slot.loaded;
                    if (slot.failed) {
                        l.animation_tried = true;
                    }
                },
                none => {
                    l.animation_tried = true;
                },
            }
            match (ready) {
                some(m) => {
                    l.animation_tried = true;  // its model is there: tried once
                    match (anim.skeleton(arena, m, 0)) {
                        some(s) => {
                            match (m.animation(a.clip)) {
                                some(found) => {
                                    l.playing = some(Playing{ skeleton: s, clip: anim.clip(arena, s, found),
                                            pose: anim.rest_pose(arena, s), palette: arena.alloc_slice(linear.Mat4, s.count()), time: 0.0 });
                                },
                                none => { },  // no clip of that name
                            }
                        },
                        none => { },  // no skin: nothing to play
                    }
                },
                none => { },
            }
        }
    }

    // ---- Each frame ----

    // The world `dt` seconds later.
    pub void update(f32 dt) uses io, threads {
        match (store) {
            some(s) => {
                s.update(4);
            },
            none => { },
        }
        collect();
        world.propagate();
        if (paused) {
            return;
        }
        make_bodies();
        make_emitters();
        make_animators();
        // the kinematic bodies go where their entities are, then the physics steps
        for (scene.Entity e in live.entities_now()) {
            Live* l = live_of(e);
            if (l.kinematic) {
                match (l.body) {
                    some(b) => {
                        linear.Transform at = components.shape_place(body_desc(e), linear.decompose(matrix_of(e)));
                        b.move_to(at.position, at.rotation, max(dt, 0.0001));
                    },
                    none => { },
                }
            }
        }
        physics_world.advance(dt);
        // the entities of the dynamic bodies go where their bodies are (in the space of their parent)
        mut bool moved = false;
        for (scene.Entity e in live.entities_now()) {
            Live* l = live_of(e);
            if (!l.dynamic) {
                continue;
            }
            moved = true;
            match (l.body) {
                some(b) => {
                    physics.State s = b.state();
                    linear.Transform there = components.entity_place(body_desc(e), s.position, s.rotation);
                    linear.Mat4 placed = linear.translation(there.position).mul(there.rotation.to_mat4());
                    linear.Mat4 local = match (world.parent_of(e)) {
                        some(p) => match (matrix_of(p).inverse()) {
                            some(inv) => inv.mul(placed),
                            none => placed,
                        },
                        none => placed,
                    };
                    linear.Transform t = linear.decompose(local);
                    mut linear.Transform kept = match (world.transforms.get(e)) {
                        some(x) => *x,
                        none => linear.transform(),
                    };
                    kept.position = t.position;
                    kept.rotation = t.rotation;
                    world.transforms.set(e, kept);
                },
                none => { },
            }
        }
        if (moved) {
            world.propagate();  // the world matrices of what the bodies moved, and under them
        }
        // the emitters where their entities are
        for (scene.Entity e in c.emitters.entities_now()) {
            Live* l = live_of(e);
            match (l.system) {
                some(s) => {
                    s.move_to(matrix_of(e));
                    s.advance(dt);
                },
                none => { },
            }
        }
        // the animators
        for (scene.Entity e in c.animators.entities_now()) {
            Live* l = live_of(e);
            components.Animator a = match (c.animators.get(e)) {
                some(v) => *v,
                none => components.Animator{ },
            };
            match (l.playing) {
                some(p) => {
                    mut Playing now = p;
                    if (a.playing) {
                        now.time += dt * a.speed;
                    }
                    f32 length = now.clip.duration;
                    f32 t = a.looping && length > 0.0 ? now.time - length * (now.time / length) as i64 as f32 : min(now.time, length);
                    now.clip.sample(now.pose, max(t, 0.0));
                    anim.palette(now.skeleton, now.pose, now.palette);
                    l.playing = some(now);
                },
                none => { },
            }
        }
        // the sounds, and the listener at the active view
        start_sounds();
        match (space) {
            some(sp) => {
                match (active_view()) {
                    some(v) => {
                        sp.listener(linear.decompose(matrix_of(v)), linear.vec3(0.0, 0.0, 0.0));
                    },
                    none => { },
                }
                for (scene.Entity e in c.sounds.entities_now()) {
                    Live* l = live_of(e);
                    match (l.source) {
                        some(s) => {
                            sp.move(s, matrix_of(e).transform_point(linear.vec3(0.0, 0.0, 0.0)), linear.vec3(0.0, 0.0, 0.0));
                        },
                        none => { },
                    }
                }
                sp.update();
            },
            none => { },
        }
    }

    // The first active view, none when the scene has none.
    pub scene.Entity? active_view() {
        for (scene.Entity e in c.views.entities_now()) {
            match (c.views.get(e)) {
                some(v) => {
                    if (v.active) {
                        return some(e);
                    }
                },
                none => { },
            }
        }
        return none;
    }

    // The camera of the active view (its forward: -z of its entity), or one that looks at the
    // origin from above and behind when there is none.
    pub render3d.Camera camera() {
        match (looking) {
            some(c) => {
                return c;
            },
            none => { },
        }
        match (active_view()) {
            some(e) => {
                linear.Mat4 m = matrix_of(e);
                components.View v = match (c.views.get(e)) {
                    some(x) => *x,
                    none => components.View{ },
                };
                linear.Vec3 at = m.transform_point(linear.vec3(0.0, 0.0, 0.0));
                linear.Vec3 forward = m.transform_vector(linear.vec3(0.0, 0.0, -1.0)).normalized();
                linear.Vec3 up = m.transform_vector(linear.vec3(0.0, 1.0, 0.0)).normalized();
                return render3d.Camera{ position: at, target: at.add(forward), up: up, fov_y: v.fov * 0.017453292,
                        near: v.near, far: v.far };
            },
            none => {
                return render3d.Camera{ position: linear.vec3(0.0, 6.0, 12.0), target: linear.vec3(0.0, 0.0, 0.0) };
            },
        }
    }

    // The items the meshes ready give: where their entities are, with the palettes of their
    // animators.
    pub render3d.Item[] items(Arena* into) uses io, threads {
        vec.Vec<render3d.Item>* out = vec.new<render3d.Item>(into);
        for (scene.Entity e in c.meshes.entities_now()) {
            components.Mesh m = match (c.meshes.get(e)) {
                some(x) => *x,
                none => components.Mesh{ },
            };
            if (!m.visible) {
                continue;
            }
            match (model_slot(m.model)) {
                some(slot) => {
                    match (slot.uploaded) {
                        some(up) => {
                            linear.Mat4[]? palette = match (live.get(e)) {
                                some(l) => match (l.playing) {
                                    some(p) => some(p.palette),
                                    none => none,
                                },
                                none => none,
                            };
                            linear.Mat4 at = matrix_of(e).mul(linear.translation(m.offset));  // its pivot, then its offset
                            out.push(render3d.Item{ model: up, transform: at, palette: palette });
                        },
                        none => { },
                    }
                },
                none => { },
            }
        }
        // the texts: no shadow; turned toward the camera when they face it
        for (scene.Entity e in c.texts.entities_now()) {
            match (text_of(e)) {
                some(t) => {
                    match (t.uploaded) {
                        some(up) => {
                            bool facing = match (c.texts.get(e)) {
                                some(x) => x.face_camera,
                                none => false,
                            };
                            out.push(render3d.Item{ model: up, transform: facing ? facing_camera(e) : matrix_of(e), shadows: false });
                        },
                        none => { },
                    }
                },
                none => { },
            }
        }
        return out.items();
    }

    // ---- Texts ----

    // The model of the text of `e`, made again when what it shows changed, sent to the GPU when
    // there is a renderer; none without a text, or with nothing to show.
    TextMade*? text_of(scene.Entity e) uses io, threads {
        components.Text t = match (c.texts.get(e)) {
            some(x) => *x,
            none => {
                return none;
            },
        };
        if (!texts_made.has(e)) {
            texts_made.set(e, arena.new(TextMade));
        }
        TextMade* made = match (texts_made.get(e)) {
            some(x) => *x,
            none => {
                return none;
            },
        };
        mut Arena scratch = Arena.new(1 * KB);
        defer scratch.free();
        text.TextBuilder* k = text.builder(&scratch);
        k.push(t.text);
        k.push("\u{0}");
        k.push(t.font);
        k.push("\u{0}");
        for (f32 x in [t.height, t.depth, t.color.x, t.color.y, t.color.z]) {
            k.push_f64(x as f64, 4);
            k.push(" ");
        }
        k.push(match (t.align) {
            Left => "l",
            Center => "c",
            Right => "r",
        });
        k.push(t.lit ? "1" : "0");
        str key = k.text();
        if (key != made.key) {
            match (made.uploaded) {
                some(up) => {
                    match (renderer) {
                        some(r) => {
                            r.release(up);
                        },
                        none => { },
                    }
                },
                none => { },
            }
            made.memory.free();
            made.memory = Arena.new(4 * KB);
            made.key = text.repeat(&made.memory, key, 1);
            made.uploaded = none;
            text3d.TextLook look = text3d.TextLook{
                height: max(t.height, 0.001),
                align: match (t.align) {
                    Left => text3d.Align.Left,
                    Center => text3d.Align.Center,
                    Right => text3d.Align.Right,
                },
                color: [t.color.x, t.color.y, t.color.z, 1.0],
                unlit: !t.lit,
                depth: max(t.depth, 0.0)
            };
            made.made = text3d.text_model(&made.memory, font_of(t.font), t.text, look);
        }
        match (made.made) {
            some(m) => {
                if (!present(made.uploaded)) {
                    match (renderer) {
                        some(r) => {
                            made.uploaded = match (r.upload(&made.memory, m)) {
                                ok(up) => some(up),
                                err(failed) => none,
                            };
                        },
                        none => { },
                    }
                }
            },
            none => { },
        }
        return some(made);
    }

    // The font of the file `name` (a GUID or a path of the project), read once; none for "" (the
    // built-in font) or a file that is not one.
    truetype.Font*? font_of(str name) uses io {
        if (name.len == 0) {
            return none;
        }
        for (usize i in 0..fonts.len()) {
            if (fonts.items()[i].path == name) {
                return fonts.items()[i].font;
            }
        }
        truetype.Font*? read = match (truetype.load(arena, located(name))) {
            ok(f) => some(f),
            err(e) => none,
        };
        fonts.push(FontSlot{ path: text.repeat(arena, name, 1), font: read });
        return read;
    }

    // Where `e` is, turned so that its +z looks at the camera (its up kept up), at its scale.
    linear.Mat4 facing_camera(scene.Entity e) {
        linear.Mat4 m = matrix_of(e);
        linear.Vec3 at = m.transform_point(linear.vec3(0.0, 0.0, 0.0));
        render3d.Camera cam = camera();
        linear.Vec3 away = at.add(at.sub(cam.position));  // its -z from the camera
        linear.Vec3 size = linear.vec3(
            m.transform_vector(linear.vec3(1.0, 0.0, 0.0)).length(),
            m.transform_vector(linear.vec3(0.0, 1.0, 0.0)).length(),
            m.transform_vector(linear.vec3(0.0, 0.0, 1.0)).length()
        );
        return match (linear.look_at(at, away, cam.up).inverse()) {
            some(turned) => turned.mul(linear.scaling(size)),
            none => m,
        };
    }

    // The lights of the scene given to the renderer: the first sun, and the first point lights
    // (as many as it draws).
    pub void light(render3d.Renderer* r) {
        vec.Vec<render3d.PointLight>* points = vec.new<render3d.PointLight>(arena);
        mut bool sun = false;
        for (scene.Entity e in c.lights.entities_now()) {
            components.Light l = match (c.lights.get(e)) {
                some(x) => *x,
                none => components.Light{ },
            };
            linear.Mat4 m = matrix_of(e);
            match (l.kind) {
                Sun => {
                    if (!sun) {
                        r.sun.direction = m.transform_vector(linear.vec3(0.0, 0.0, -1.0)).normalized();
                        r.sun.color = l.color;
                        r.sun.intensity = l.intensity;
                        r.sun.shadows = l.shadows;
                        sun = true;
                    }
                },
                Point => {
                    points.push(render3d.PointLight{ position: m.transform_point(linear.vec3(0.0, 0.0, 0.0)), color: l.color,
                            intensity: l.intensity, range: l.range });
                },
            }
        }
        if (!sun) {
            r.sun.intensity = 0.0;
        }
        r.set_lights(points.items());
    }

    // The scene drawn into `frame`: the meshes, then the particles, seen through the active view.
    pub void render(gpu.Frame frame) uses io, threads {
        drawn(frame, none);
    }

    // The same into `target` (a texture of `gpu.Device.target`), for a picture or a view of an
    // editor.
    pub void render_into(gpu.Frame frame, gpu.Texture target) uses io, threads {
        drawn(frame, some(target));
    }

    void drawn(gpu.Frame frame, gpu.Texture? target) uses io, threads {
        render3d.Renderer* r = match (renderer) {
            some(x) => x,
            none => {
                return;
            },
        };
        mut Arena scratch = Arena.new(16 * KB);
        defer scratch.free();
        render3d.Camera cam = camera();
        light(r);
        match (target) {
            some(t) => {
                r.draw_into(frame, t, cam, items(&scratch));
            },
            none => {
                r.draw(frame, cam, items(&scratch));
            },
        }
        match (drawer) {
            some(d) => {
                vec.Vec<draw.Sprite>* sprites = vec.new<draw.Sprite>(&scratch);
                for (scene.Entity e in c.emitters.entities_now()) {
                    match (live.get(e)) {
                        some(l) => {
                            match (l.system) {
                                some(s) => {
                                    sprites.push(draw.sprite(s, none));
                                },
                                none => { },
                            }
                        },
                        none => { },
                    }
                }
                match (target) {
                    some(t) => {
                        match (d.draw_into(frame, t, cam, sprites.items())) {
                            ok => { },
                            err(e) => { },
                        }
                    },
                    none => {
                        match (d.draw(frame, cam, sprites.items())) {
                            ok => { },
                            err(e) => { },
                        }
                    },
                }
            },
            none => { },
        }
    }

    // What an entity was given: its body (for a program that pushes it), its system of particles.
    pub physics.Body? body_of(scene.Entity e) {
        return match (live.get(e)) {
            some(l) => l.body,
            none => none,
        };
    }

    pub particles.System*? system_of(scene.Entity e) {
        return match (live.get(e)) {
            some(l) => l.system,
            none => none,
        };
    }

    pub spatial.Source? source_of(scene.Entity e) {
        return match (live.get(e)) {
            some(l) => l.source,
            none => none,
        };
    }

    pub linear.Mat4[]? palette_of(scene.Entity e) {
        return match (live.get(e)) {
            some(l) => match (l.playing) {
                some(p) => some(p.palette),
                none => none,
            },
            none => none,
        };
    }

    pub void close() {
        physics_world.close();
        for (scene.Entity e in texts_made.entities_now()) {
            match (texts_made.get(e)) {
                some(t) => {
                    (*t).memory.free();
                },
                none => { },
            }
        }
    }
}

// An engine for the components `c`: `store` loads the files of the project (none: only what is
// adopted), `renderer` and `drawer` draw (none: nothing is drawn), `mix` plays the sounds (none:
// silent).
pub Engine* engine(keeps Arena* arena, keeps components.Components* c, keeps assets.Assets*? store,
        keeps render3d.Renderer*? renderer, keeps draw.Drawer*? drawer, keeps mixer.Mixer*? mix) {
    return arena.new(Engine, arena, c, store, renderer, drawer, mix);
}

// ---- Tests: without a window nor a sound card ----

scene.Entity placed(scene.World* w, keeps str name, linear.Vec3 at) {
    mut linear.Transform t = linear.transform();
    t.position = at;
    return w.spawn_at(name, t, none);
}

test "bodies: a crate falls on a floor, a kinematic one follows its entity, a child keeps its parent" {
    mut Arena arena = Arena.new(1 * MB);
    defer arena.free();
    scene.World* w = scene.world(&arena);
    components.Components* c = components.components(&arena, w);
    Engine* g = engine(&arena, c, none, none, none, none);
    defer g.close();
    scene.Entity floor = placed(w, "floor", linear.vec3(0.0, 0.0, 0.0));
    c.bodies.set(floor, components.Body{ kind: components.BodyKind.Static, size: linear.vec3(10.0, 0.5, 10.0) });
    scene.Entity crate = placed(w, "crate", linear.vec3(0.0, 5.0, 0.0));
    c.bodies.set(crate, components.Body{ size: linear.vec3(0.5, 0.5, 0.5) });
    scene.Entity pusher = placed(w, "pusher", linear.vec3(6.0, 1.0, 0.0));
    c.bodies.set(pusher, components.Body{ kind: components.BodyKind.Kinematic, shape: components.ShapeKind.Sphere });
    // a ball under a frame moved 20 m away: it falls in the world, and its entity stays a child
    scene.Entity frame = placed(w, "frame", linear.vec3(20.0, 0.0, 0.0));
    scene.Entity ball = w.spawn_at("ball", linear.Transform{ position: linear.vec3(0.0, 3.0, 0.0), rotation: linear.identity_quat(),
            scale: linear.vec3(1.0, 1.0, 1.0) }, some(frame));
    c.bodies.set(ball, components.Body{ shape: components.ShapeKind.Sphere, size: linear.vec3(0.25, 0.25, 0.25) });
    for (i32 i in 0..120) {
        g.update(1.0 / 60.0);
    }
    // the crate rests on the floor: its center half a meter above the top of the floor
    f32 y = match (w.transforms.get(crate)) {
        some(t) => t.position.y,
        none => 99.0,
    };
    assert(abs(y - 1.0) < 0.05);
    // the kinematic body goes where its entity is moved
    mut linear.Transform moved = linear.transform();
    moved.position = linear.vec3(6.0, 1.0, 2.0);
    w.transforms.set(pusher, moved);
    for (i32 i in 0..3) {
        g.update(1.0 / 60.0);
    }
    linear.Vec3 there = match (g.body_of(pusher)) {
        some(b) => b.position(),
        none => linear.vec3(0.0, 0.0, 0.0),
    };
    assert(there.near(linear.vec3(6.0, 1.0, 2.0), 0.01));
    // the ball fell in two seconds, in the world at x = 20, and its entity is still a child
    linear.Vec3 b = match (g.body_of(ball)) {
        some(x) => x.position(),
        none => linear.vec3(0.0, 0.0, 0.0),
    };
    assert(abs(b.x - 20.0) < 0.01 && b.y < -10.0);
    assert(match (w.parent_of(ball)) {
        some(p) => p.same(frame),
        none => false,
    });
    linear.Vec3 drawn = g.matrix_of(ball).transform_point(linear.vec3(0.0, 0.0, 0.0));
    assert(drawn.near(b, 0.01) && match (w.transforms.get(ball)) {
        some(t) => abs(t.position.x) < 0.01,
        none => false,
    });
}

test "an emitter at its entity; a sound placed, heard on the right of the active view" {
    mut Arena arena = Arena.new(1 * MB);
    defer arena.free();
    scene.World* w = scene.world(&arena);
    components.Components* c = components.components(&arena, w);
    mixer.Mixer* m = mixer.create(&arena, 48000, 2);
    Engine* g = engine(&arena, c, none, none, none, some(m));
    defer g.close();
    g.adopt_sound("sounds/hum", audio.tone(&arena, 48000, 220.0, 1.0, 0.5));
    scene.Entity fire = placed(w, "fire", linear.vec3(0.0, 2.0, 0.0));
    c.emitters.set(fire, components.Emitter{ rate: 200.0, speed: 0.5, life: 2.0 });
    scene.Entity eye = placed(w, "eye", linear.vec3(0.0, 0.0, 0.0));
    c.views.set(eye, components.View{ });
    scene.Entity radio = placed(w, "radio", linear.vec3(5.0, 0.0, 0.0));
    c.sounds.set(radio, components.Sound{ sound: "sounds/hum", looping: true, near: 1.0 });
    for (i32 i in 0..30) {
        g.update(1.0 / 60.0);
    }
    // particles born around the fire
    particles.System* s = match (g.system_of(fire)) {
        some(x) => x,
        none => {
            assert(false);
            return;
        },
    };
    assert(s.count() > 50);
    for (particles.Particle p in s.particles()) {
        assert(p.position.sub(linear.vec3(0.0, 2.0, 0.0)).length() < 1.0);
    }
    // the radio, on the right of the view (which faces -z)
    spatial.Source source = match (g.source_of(radio)) {
        some(x) => x,
        none => {
            assert(false);
            return;
        },
    };
    match (g.space) {
        some(sp) => {
            assert(sp.playing(source) && sp.heard(source).pan > 0.99);
            // the view turned to face +x: the radio is ahead
            mut linear.Transform turned = linear.transform();
            turned.rotation = linear.from_axis_angle(linear.vec3(0.0, 1.0, 0.0), -1.5707964);
            w.transforms.set(eye, turned);
            g.update(1.0 / 60.0);
            assert(abs(sp.heard(source).pan) < 0.01);
            // refreshed: stopped, then played again
            g.refresh(radio);
            assert(!sp.playing(source));
            g.update(1.0 / 60.0);
            assert(match (g.source_of(radio)) {
                some(again) => sp.playing(again),
                none => false,
            });
        },
        none => assert(false),
    }
}

test "an animator plays a clip of the model of its mesh" {
    mut Arena arena = Arena.new(1 * MB);
    defer arena.free();
    // a skin of one joint, the hip under an armature, and a clip that slides it 2 m along x in 1 s
    mut model.Node[] nodes = arena.alloc_slice(model.Node, 2);
    mut usize[] under = arena.alloc_slice(usize, 1);
    under[0] = 1;
    nodes[0] = model.Node{ name: "armature", local: linear.identity4(), meshes: arena.alloc_slice(usize, 0), children: under,
            transform: some(linear.transform()) };
    nodes[1] = model.Node{ name: "hip", local: linear.identity4(), meshes: arena.alloc_slice(usize, 0),
            children: arena.alloc_slice(usize, 0), transform: some(linear.transform()) };
    mut usize[] joints = arena.alloc_slice(usize, 1);
    joints[0] = 1;
    mut linear.Mat4[] binds = arena.alloc_slice(linear.Mat4, 1);
    binds[0] = linear.identity4();
    mut model.Skin[] skins = arena.alloc_slice(model.Skin, 1);
    skins[0] = model.Skin{ name: "rig", joints: joints, inverse_binds: binds };
    mut f32[] times = arena.alloc_slice(f32, 2);
    times[1] = 1.0;
    mut f32[] values = arena.alloc_slice(f32, 6);
    values[3] = 2.0;
    mut model.Channel[] channels = arena.alloc_slice(model.Channel, 1);
    channels[0] = model.Channel{ node: 1, target: model.Target.Translation, mode: curve.Interpolation.Linear, times: times, values: values };
    mut model.Animation[] animations = arena.alloc_slice(model.Animation, 1);
    animations[0] = model.Animation{ name: "slide", channels: channels, duration: 1.0 };
    mut usize[] roots = arena.alloc_slice(usize, 1);
    roots[0] = 0;
    model.Model rig = model.Model{ meshes: arena.alloc_slice(model.Mesh, 0), materials: arena.alloc_slice(model.Material, 0),
            images: arena.alloc_slice(image.Image, 0), nodes: nodes, roots: roots, skins: some(skins), animations: some(animations) };
    scene.World* w = scene.world(&arena);
    components.Components* c = components.components(&arena, w);
    Engine* g = engine(&arena, c, none, none, none, none);
    defer g.close();
    g.adopt_model("models/rig", rig);
    str[] made = g.adopted_models(&arena);
    assert(made.len == 3 && made[0] == "crate" && made[1] == "ground" && made[2] == "models/rig");
    scene.Entity hero = placed(w, "hero", linear.vec3(0.0, 0.0, 0.0));
    c.meshes.set(hero, components.Mesh{ model: "models/rig" });
    c.animators.set(hero, components.Animator{ clip: "slide" });
    for (i32 i in 0..30) {
        g.update(1.0 / 60.0);
    }
    linear.Mat4[] palette = match (g.palette_of(hero)) {
        some(p) => p,
        none => {
            assert(false);
            return;
        },
    };
    // half a second: the hip 1 m along
    assert(palette[0].transform_point(linear.vec3(0.0, 0.0, 0.0)).near(linear.vec3(1.0, 0.0, 0.0), 0.05));
    // looping: after its end it starts again (1.5 s: half a second into its second turn)
    for (i32 i in 0..60) {
        g.update(1.0 / 60.0);
    }
    f32 x = palette[0].transform_point(linear.vec3(0.0, 0.0, 0.0)).x;
    assert(x > 0.8 && x < 1.2);
    // a clip the model does not have: nothing played, no stop
    scene.Entity other = placed(w, "other", linear.vec3(0.0, 0.0, 0.0));
    c.meshes.set(other, components.Mesh{ model: "models/rig" });
    c.animators.set(other, components.Animator{ clip: "dance" });
    g.update(1.0 / 60.0);
    assert(match (g.palette_of(other)) {
        some(p) => false,
        none => true,
    });
}

test "a body moved and turned in its entity: it falls and rests so, its entity following; its box" {
    mut Arena arena = Arena.new(1 * MB);
    defer arena.free();
    scene.World* w = scene.world(&arena);
    components.Components* c = components.components(&arena, w);
    Engine* g = engine(&arena, c, none, none, none, none);
    defer g.close();
    scene.Entity floor = placed(w, "floor", linear.vec3(0.0, 0.0, 0.0));
    c.bodies.set(floor, components.Body{ kind: components.BodyKind.Static, size: linear.vec3(10.0, 0.5, 10.0) });
    // a crate whose collider is a meter above its entity: the entity rests a meter lower
    scene.Entity raised = placed(w, "raised", linear.vec3(0.0, 4.0, 0.0));
    c.bodies.set(raised, components.Body{ size: linear.vec3(0.5, 0.5, 0.5), center: linear.vec3(0.0, 1.0, 0.0) });
    // a plank lying along x, its collider turned a quarter about z: it stands, 2 m high
    scene.Entity plank = placed(w, "plank", linear.vec3(5.0, 4.0, 0.0));
    c.bodies.set(plank, components.Body{ size: linear.vec3(1.0, 0.25, 0.25), rotation: linear.vec3(0.0, 0.0, 90.0) });
    // a kinematic body moved off its entity: the body is there
    scene.Entity pusher = placed(w, "pusher", linear.vec3(-5.0, 3.0, 0.0));
    c.bodies.set(pusher, components.Body{ kind: components.BodyKind.Kinematic, shape: components.ShapeKind.Sphere,
            center: linear.vec3(0.0, 0.0, 2.0) });
    // the boxes: around the collider moved, around the collider turned
    match (g.bounds_of(raised)) {
        some(b) => {
            assert(b.box.min.near(linear.vec3(-0.5, 0.5, -0.5), 0.001) && b.box.max.near(linear.vec3(0.5, 1.5, 0.5), 0.001));
        },
        none => assert(false),
    }
    match (g.bounds_of(plank)) {
        some(b) => {
            assert(b.box.max.near(linear.vec3(0.25, 1.0, 0.25), 0.001));
        },
        none => assert(false),
    }
    for (i32 i in 0..240) {
        g.update(1.0 / 60.0);
    }
    f32 y = match (w.transforms.get(raised)) {
        some(t) => t.position.y,
        none => 99.0,
    };
    assert(abs(y - 0.0) < 0.05);  // its collider on the floor (0.5 + 0.5), the entity a meter under it
    linear.Transform p = match (w.transforms.get(plank)) {
        some(t) => *t,
        none => linear.transform(),
    };
    assert(abs(p.position.y - 1.5) < 0.05 && p.rotation.near(linear.identity_quat(), 0.05));  // standing, unturned
    linear.Vec3 there = match (g.body_of(pusher)) {
        some(b) => b.position(),
        none => linear.vec3(0.0, 0.0, 0.0),
    };
    assert(there.near(linear.vec3(-5.0, 3.0, 2.0), 0.01));
    // saved and read back with them
    str saved = components.save_scene(&arena, c);
    assert(text.contains(saved, "\"center\"") && text.contains(saved, "\"rotation\""));
}

test "the box of each entity: its model's, its body's, a marker, none; the models of the engine" {
    mut Arena arena = Arena.new(1 * MB);
    defer arena.free();
    scene.World* w = scene.world(&arena);
    components.Components* c = components.components(&arena, w);
    Engine* g = engine(&arena, c, none, none, none, none);
    defer g.close();
    str[] made = g.adopted_models(&arena);
    assert(made.len == 2 && made[0] == "crate" && made[1] == "ground");
    scene.Entity crate = placed(w, "crate", linear.vec3(0.0, 1.0, 0.0));
    c.meshes.set(crate, components.Mesh{ model: "crate" });
    scene.Entity floor = placed(w, "floor", linear.vec3(0.0, 0.0, 0.0));
    c.bodies.set(floor, components.Body{ kind: components.BodyKind.Static, shape: components.ShapeKind.Capsule, size: linear.vec3(0.5, 1.0, 0.5) });
    scene.Entity lamp = placed(w, "lamp", linear.vec3(3.0, 2.0, 0.0));
    c.lights.set(lamp, components.Light{ });
    scene.Entity empty = placed(w, "empty", linear.vec3(0.0, 0.0, 0.0));
    g.update(0.0);
    match (g.bounds_of(crate)) {
        some(b) => {
            assert(b.box.min.near(linear.vec3(-1.0, -1.0, -1.0), 0.001) && b.box.max.near(linear.vec3(1.0, 1.0, 1.0), 0.001));
            assert(match (b.space) {
                Scaled => true,
                _ => false,
            });
        },
        none => assert(false),
    }
    match (g.bounds_of(floor)) {
        some(b) => {
            assert(b.box.max.near(linear.vec3(0.5, 1.5, 0.5), 0.001));
            assert(match (b.space) {
                Turned => true,
                _ => false,
            });
        },
        none => assert(false),
    }
    match (g.bounds_of(lamp)) {
        some(b) => {
            assert(b.box.max.x == MARKER);
            // a marker keeps its size, wherever its entity is and however it is scaled
            linear.Mat4 m = box_matrix(linear.translation(linear.vec3(3.0, 2.0, 0.0)).mul(linear.scaling(linear.vec3(5.0, 5.0, 5.0))), b.space);
            assert(m.transform_point(linear.vec3(1.0, 0.0, 0.0)).near(linear.vec3(4.0, 2.0, 0.0), 0.0001));
        },
        none => assert(false),
    }
    assert(match (g.bounds_of(empty)) {
        some(b) => false,
        none => true,
    });
}

test "the files of a project: a model named by its GUID loaded, found again after it moved" {
    mut Arena arena = Arena.new(1 * MB);
    defer arena.free();
    str temp = match (os.env(&arena, "TEMP")) {
        some(t) => t,
        none => match (os.env(&arena, "TMPDIR")) {
            some(t) => t,
            none => "/tmp",
        },
    };
    mut random.Rng rng = random.from_system();
    text.TextBuilder* b = text.builder(&arena);
    b.push("sosu-engine-files-");
    b.push_u64(rng.next());
    str root = fs.join(&arena, temp, b.text());
    str folder = fs.join(&arena, root, "assets");
    match (fs.create_dirs(&arena, folder)) {
        ok => { },
        err(e) => { },
    }
    match (io.write_file(&arena, fs.join(&arena, folder, "wedge.obj"), "v 0 0 0\nv 2 0 0\nv 0 3 0\nf 1 2 3\n")) {
        ok => { },
        err(e) => {
            assert(false);
        },
    }
    ids.Catalog* cat = ids.catalog(&arena, root, ".asset.sozo");
    defer cat.close();
    cat.scan();
    str guid = match (cat.guid_of("assets/wedge.obj")) {
        some(x) => text.repeat(&arena, x, 1),
        none => {
            assert(false);
            return;
        },
    };
    assets.Assets* store = assets.open(&arena, none, 1);
    defer store.close();
    scene.World* w = scene.world(&arena);
    components.Components* c = components.components(&arena, w);
    Engine* g = engine(&arena, c, some(store), none, none, none);
    defer g.close();
    g.use_files(root, some(cat));
    scene.Entity wedge = placed(w, "wedge", linear.vec3(0.0, 0.0, 0.0));
    c.meshes.set(wedge, components.Mesh{ model: guid });
    mut bool loaded = false;
    for (i32 i in 0..2000) {
        g.update(0.0);
        match (g.model_of(guid)) {
            some(m) => {
                loaded = true;
                break;
            },
            none => {
                time.sleep_ms(1);
            },
        }
    }
    assert(loaded);
    match (g.bounds_of(wedge)) {
        some(bx) => {
            assert(bx.box.max.near(linear.vec3(2.0, 3.0, 0.0), 0.001));
        },
        none => assert(false),
    }
    // moved with its companion: the same GUID names it where it is now; a plain path starts from
    // the root of the project
    assert(cat.move("assets/wedge.obj", "assets/shapes/wedge.obj"));
    assert(text.ends_with(g.located(guid), "wedge.obj") && text.contains(g.located(guid), "shapes"));
    assert(g.located("assets/x.png") == fs.join(&arena, root, "assets/x.png"));
    // a path given by an arena that goes before the store (the world of an editor made again): the
    // store keeps its own copy, which it looks at when it watches the files
    store.watch(true);
    mut Arena brief = Arena.new(1 * KB);
    str cone = fs.join(&brief, root, "assets/shapes/wedge.obj");
    store.model_file(text.repeat(&brief, cone, 1));
    brief.free();
    time.sleep_ms(600);
    store.update(4);  // the files watched: their paths read

    match (fs.remove_all(&arena, root)) {
        ok => { },
        err(e) => { },
    }
}

test "a mesh drawn from its offset: its pivot elsewhere, its box and its item moved with it" {
    mut Arena arena = Arena.new(1 * MB);
    defer arena.free();
    scene.World* w = scene.world(&arena);
    components.Components* c = components.components(&arena, w);
    Engine* g = engine(&arena, c, none, none, none, none);
    defer g.close();
    scene.Entity crate = placed(w, "crate", linear.vec3(0.0, 1.0, 0.0));
    // the pivot at the bottom of the crate: the model drawn a meter above it
    c.meshes.set(crate, components.Mesh{ model: "crate", offset: linear.vec3(0.0, 1.0, 0.0) });
    g.update(0.0);
    match (g.bounds_of(crate)) {
        some(b) => {
            assert(b.box.min.near(linear.vec3(-1.0, 0.0, -1.0), 0.001) && b.box.max.near(linear.vec3(1.0, 2.0, 1.0), 0.001));
        },
        none => assert(false),
    }
    // saved and read back: older scenes without it read as no offset
    str saved = components.save_scene(&arena, c);
    assert(text.contains(saved, "\"offset\""));
}

test "a text: its box as high as its lines, made again when it changes, saved and read back" {
    mut Arena arena = Arena.new(1 * MB);
    defer arena.free();
    scene.World* w = scene.world(&arena);
    components.Components* c = components.components(&arena, w);
    Engine* g = engine(&arena, c, none, none, none, none);
    defer g.close();
    scene.Entity sign = placed(w, "sign", linear.vec3(0.0, 2.0, 0.0));
    c.texts.set(sign, components.Text{ text: "Lantern", height: 0.5 });
    g.update(0.0);
    mut f32 wide = 0.0;
    match (g.bounds_of(sign)) {
        some(b) => {
            assert(b.box.max.y - b.box.min.y > 0.5 && b.box.max.y - b.box.min.y < 0.6);
            assert(abs(b.box.min.x + b.box.max.x) < 0.001);  // centered
            wide = b.box.max.x - b.box.min.x;
        },
        none => assert(false),
    }
    // two lines, aligned on the left: twice as high, from its point
    c.texts.set(sign, components.Text{ text: "Lantern\nOn", height: 0.5, align: components.TextAlign.Left });
    match (g.bounds_of(sign)) {
        some(b) => {
            assert(b.box.max.y - b.box.min.y > 1.0 && abs(b.box.min.x) < 0.05 && abs(b.box.max.x - b.box.min.x - wide) < 0.01);
        },
        none => assert(false),
    }
    // solid: as deep as it says, behind its face
    c.texts.set(sign, components.Text{ text: "Lantern", height: 0.5, depth: 0.2 });
    match (g.bounds_of(sign)) {
        some(b) => {
            assert(abs(b.box.max.z - b.box.min.z - 0.2) < 0.001);
        },
        none => assert(false),
    }
    // nothing to show: no box
    c.texts.set(sign, components.Text{ text: "" });
    assert(match (g.bounds_of(sign)) {
        some(b) => false,
        none => true,
    });
    c.texts.set(sign, components.Text{ text: "Exit", face_camera: true, lit: true });
    str saved = components.save_scene(&arena, c);
    assert(text.contains(saved, "\"text\"") && text.contains(saved, "\"face_camera\": true"));
}
