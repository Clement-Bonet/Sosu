// engine.host: a game loaded by an editor (Sozo) as a shared library, the world held by the game,
// in edit mode as in play. Its `export "C"` functions (`sozo_...`, the contract of Sozo) are those
// of every game that imports this module: built with `sosuc build --lib=shared`, a game offers
// them without writing them. The game writes one export of its own, `sozo_setup`, which says what
// it adds to each world: its kinds of components (`engine.kinds`), the tables it saves, what it
// does each step of Play.
//
//   export "C" void sozo_setup(host.Game* g) {     // in the game: its only export
//       host.on_world(g, add_mine);                 // called for each world made
//       host.on_step(g, move_mine);                 // each step of Play
//   }
//
// Only numbers, structs of numbers, `str`, views and opaque pointers cross: an entity is the
// struct `scene.Entity`, a value of a field the C struct `Value` (a tag and a field by kind). A text
// returned (a scene saved, the logs, a name) stays valid until the next call of the same export,
// or until the entity or the game is gone: the editor copies it. A failed check of the game (and a
// fault of the processor) comes back through `<package>_error()` of the library (spec §9.2); what
// the host says itself (a scene that does not read) through `sozo_message`.
import std.vec;
import std.json;
import std.text;
import std.io;
import std.fs;
import std.os;
import std.time;
import std.random;
import math.linear;
import math.geometry;
import scene.scene;
import scene.save;
import engine.describe;
import engine.components;
import engine.kinds;
import engine.engine;
import gpu.gpu;
import render3d.render3d;
import particles.draw;
import assets.assets;
import assets.ids;

// The version of the contract: the editor refuses a library of another one.
pub ui32 CONTRACT = 8;

// ---- What crosses to C ----

pub enum Tag {
    Empty,   // no value: the entity has no such component, or no such field
    Number,  // `number`
    Whole,   // `whole`
    Flag,    // `flag`
    Text,    // `text`: a text or the path of an asset
    Vector,  // `x`, `y`, `z`: a vector or a color
    Choice,  // `choice`, the index of one of the choices of the field
    Key,     // contract 8: a key of a curve, `number` its time, `x` its value, `y` and `z` its tangents
    Stop,    // contract 8: a stop of a gradient, `number` where it is, `x`, `y`, `z`, `w` its color
}

// A value of a field, as C sees it: a tag and the field of its kind.
pub struct Value {
    pub mut Tag tag = Tag.Empty;
    pub mut f32 number = 0.0;
    pub mut i64 whole = 0;
    pub mut bool flag = false;
    pub mut str text = "";
    pub mut f32 x = 0.0;
    pub mut f32 y = 0.0;
    pub mut f32 z = 0.0;
    pub mut usize choice = 0;
    pub mut f32 w = 0.0;  // contract 8: the alpha of a stop
}

// A field of a kind of component, as C sees it: its choices are read by `sozo_choice`.
pub struct FieldInfo {
    pub str name;
    pub str label;
    pub describe.Kind kind;
    pub f32 low;
    pub f32 high;
    pub usize choices;
    pub str unit = "";  // contract 6: what `describe.Field` says of it beyond its kind
    pub str group = "";
    pub str tooltip = "";
    pub bool hidden = false;
    pub describe.Kind item = describe.Kind.Number;  // contract 7: a list, the kind of its items
}

// `v` as C sees it.
pub Value to_c(describe.Value v) {
    return match (v) {
        Number(x) => Value{ tag: Tag.Number, number: x },
        Whole(n) => Value{ tag: Tag.Whole, whole: n },
        Flag(on) => Value{ tag: Tag.Flag, flag: on },
        Text(s) => Value{ tag: Tag.Text, text: s },
        Vector(p) => Value{ tag: Tag.Vector, x: p.x, y: p.y, z: p.z },
        Choice(i) => Value{ tag: Tag.Choice, choice: i },
        Key(time, value, a, b) => Value{ tag: Tag.Key, number: time, x: value, y: a, z: b },
        Stop(at, c) => Value{ tag: Tag.Stop, number: at, x: c.x, y: c.y, z: c.z, w: c.w },
    };
}

// The value `v` of C, none when it is empty.
pub describe.Value? from_c(Value v) {
    return match (v.tag) {
        Empty => none,
        Number => some(describe.Value.Number(v.number)),
        Whole => some(describe.Value.Whole(v.whole)),
        Flag => some(describe.Value.Flag(v.flag)),
        Text => some(describe.Value.Text(v.text)),
        Vector => some(describe.Value.Vector(linear.vec3(v.x, v.y, v.z))),
        Choice => some(describe.Value.Choice(v.choice)),
        Key => some(describe.Value.Key(v.number, v.x, v.y, v.z)),
        Stop => some(describe.Value.Stop(v.number, linear.Vec4{ x: v.x, y: v.y, z: v.z, w: v.w })),
    };
}

// ---- A world ----

// Tables of the game saved with the scene beside the common components: `write` adds them to the
// writer (`out.add(table, codec)`), `read` to the reader.
// Where a kind of the game is written (`Level.add_source`): its file, relative to the project, and
// the line of its struct.
struct Source {
    str name;
    str file;
    i64 line;
}

pub interface Saved {
    void write(save.Writer* out);
    bool read(save.Reader* r);
}

// What the game writes for the editor to show (`sozo_logs`): kept from one world to the next.
pub class Logs {
    mut Arena arena;
    mut text.TextBuilder* lines;

    void init() {
        arena = Arena.new(4 * KB);
        lines = text.builder(&arena);
    }

    // A line written.
    pub void write(str line) {
        lines.push(line);
        lines.push("\n");
    }

    // What was written since the last time, copied into `into`; then nothing.
    str take(Arena* into) {
        str written = text.repeat(into, lines.text(), 1);
        arena.free();
        arena = Arena.new(4 * KB);
        lines = text.builder(&arena);
        return written;
    }

    void free() {
        arena.free();
    }
}

// A world of the game: its entities, the common components and those of the game, the engine that
// runs them. Made again by a scene loaded and by Stop: what the game keeps of it (its tables, its
// kinds) is made by its `on_world` for each.
pub class Level {
    pub Arena* arena;
    pub scene.World* world;
    pub components.Components* c;
    pub kinds.Kinds* registry;
    pub engine.Engine* runner;
    pub Logs* logs;
    vec.Vec<Saved*>* saved;
    vec.Vec<Source>* sources;

    void init(keeps Arena* arena, keeps Logs* logs, keeps render3d.Renderer*? renderer, keeps draw.Drawer*? drawer,
            keeps assets.Assets*? store, keeps str root, keeps ids.Catalog*? catalog) keeps self {
        self.arena = arena;
        self.logs = logs;
        world = scene.world(arena);
        c = components.components(arena, world);
        registry = kinds.common(arena, c);
        runner = engine.engine(arena, c, store, renderer, drawer, none);
        runner.use_files(root, catalog);
        runner.paused = true;
        saved = vec.new<Saved*>(arena);
        sources = vec.new<Source>(arena);
    }

    // A kind of component of the game, shown and changed by the editor (one of the same name
    // replaces it).
    pub void add(keeps kinds.Kind* k) {
        registry.add(k);
    }

    // A table of the game saved and read with the scene.
    pub void add_saved(keeps Saved* s) {
        saved.push(s);
    }

    // The kind named `name` written at `line` of `file` (relative to the project): what the editor
    // opens from it (`sozo_kind_file`).
    pub void add_source(keeps str name, keeps str file, i64 line) {
        sources.push(Source{ name: name, file: file, line: line });
    }

    Source? source_of(str name) {
        for (Source s in sources.items()) {
            if (s.name == name) {
                return some(s);
            }
        }
        return none;
    }

    // The whole world as a scene file.
    str written(keeps Arena* into) keeps self {
        save.Writer* out = save.writer(into, world);
        c.add_to(out);
        for (Saved* s in saved.items()) {
            s.write(out);
        }
        return out.written();
    }

    // `e` and those under it as a prefab (`scene.save.prefab`), the tables of the game with them.
    str branch(keeps Arena* into, scene.Entity e) keeps self {
        save.Writer* out = save.prefab(into, world, e);
        c.add_to(out);
        for (Saved* s in saved.items()) {
            s.write(out);
        }
        return out.written();
    }

    // The prefab `source` placed under `parent` (none: at the root): its entities, its root first;
    // none when it does not read.
    scene.Entity[]? place(str source, scene.Entity? parent) {
        str copy = text.repeat(arena, source, 1);  // the names stay in the world
        return match (save.instantiate(arena, world, copy, parent)) {
            ok(r) => {
                c.read_from(r);
                for (Saved* s in saved.items()) {
                    s.read(r);
                }
                world.propagate();
                return some(r.entities());
            },
            err(e) => none,
        };
    }

    // The entities of the scene file `source` spawned into it: none, or what is wrong.
    str? read(str source) {
        return match (save.read(arena, world, source, none)) {
            ok(r) => {
                mut bool good = c.read_from(r);
                for (Saved* s in saved.items()) {
                    good = s.read(r) && good;
                }
                return good ? none : some("scene: a component of the scene is damaged");
            },
            err(e) => some(save.message(e)),
        };
    }
}

void nothing(Level* l) { }

void standing(Level* l, f32 dt) uses io { }

// A game: the world it holds, and what the editor asked of it. It owns the arena it lies in
// (`sozo_open`, `sozo_close`).
pub class Game {
    mut Arena home;
    mut Arena place;  // the world: freed and made again with it
    pub mut Level* level;
    pub Logs* logs;
    mut Arena kept;  // the scene saved by Play, which Stop brings back
    mut str before;
    mut Arena out;  // the texts returned to the editor
    mut Arena said;
    mut str message;
    pub mut bool playing;
    pub mut bool paused;
    mut fn(Level*) -> void setup;
    mut fn(Level*, f32) -> void uses io stepper;
    // The device of the editor (`sozo_gpu`), and what draws with it: each world made has them.
    mut gpu.Device*? device;
    mut render3d.Renderer*? renderer;
    mut draw.Drawer*? drawer;
    // The files of the project (`sozo_assets`): its folder, the identities of its files, the store
    // that loads them (watched: a file changed is loaded again).
    mut str root;
    mut ids.Catalog*? catalog;
    mut assets.Assets*? store;

    void init(Arena arena) keeps self {
        home = arena;
        logs = home.new(Logs);
        place = Arena.new(64 * KB);
        kept = Arena.new(1 * KB);
        before = "";
        out = Arena.new(1 * KB);
        said = Arena.new(1 * KB);
        message = "";
        playing = false;
        paused = false;
        setup = nothing;
        stepper = standing;
        device = none;
        renderer = none;
        drawer = none;
        root = "";
        catalog = none;
        store = none;
        level = place.new(Level, &place, logs, renderer, drawer, store, root, catalog);
    }

    // A new world from the scene file `source` (empty: an empty world), in place of the one held;
    // false, and an empty world, when it does not read (`message` says why).
    bool remake(str source) keeps self uses io, threads {
        level.runner.close();
        place.free();
        place = Arena.new(64 * KB);
        level = place.new(Level, &place, logs, renderer, drawer, store, root, catalog);
        setup(level);
        mut bool good = true;
        if (source.len > 0) {
            // the world keeps texts of the file (its names): a copy where it lives, since the source
            // is the memory of the host, or the scene saved by Play, freed by the next
            str copy = text.repeat(&place, source, 1);
            match (level.read(copy)) {
                some(problem) => {
                    say(problem);
                    good = false;
                    level.runner.close();
                    place.free();
                    place = Arena.new(64 * KB);
                    level = place.new(Level, &place, logs, renderer, drawer, store, root, catalog);
                    setup(level);
                },
                none => { },
            }
        }
        level.runner.paused = !playing || paused;
        level.runner.update(0.0);
        return good;
    }

    void say(str m) {
        said.free();
        said = Arena.new(1 * KB);
        message = text.repeat(&said, m, 1);
    }

    // Play: the scene saved, then run.
    void play() keeps self {
        if (playing) {
            return;
        }
        kept.free();
        kept = Arena.new(4 * KB);
        before = level.written(&kept);
        playing = true;
        paused = false;
        level.runner.paused = false;
    }

    // The device of the editor shared (`sozo_gpu`).
    bool share_gpu(ui8* native, i32 format) keeps self uses io, threads {
        match (device) {
            some(d) => {
                return true;
            },
            none => { },
        }
        gpu.Device* d = gpu.adopt(&home, native, format);
        render3d.Renderer* r = match (render3d.create(&home, d, render3d.Options{ })) {
            ok(x) => x,
            err(e) => {
                say("the game cannot draw: its renderer was not made");
                d.close();
                return false;
            },
        };
        device = some(d);
        renderer = some(r);
        drawer = match (draw.drawer(&home, d)) {
            ok(x) => some(x),
            err(e) => none,
        };
        if (root.len > 0) {
            open_store();  // with the device now: its textures go to the GPU
        }
        str now = level.written(fresh_out());
        remake(now);
        return true;
    }

    // The store of the files of the project, made again (with the device when there is one).
    void open_store() keeps self uses io, threads {
        match (store) {
            some(st) => {
                st.close();  // what it loaded goes with it: the world is made again just after
            },
            none => { },
        }
        assets.Assets* st = assets.open(&home, device, 1);
        st.watch(true);
        store = some(st);
    }

    // The files of the project in `folder` (`sozo_assets`): looked at again when it is the same.
    bool use_files(str folder) keeps self uses io, threads, random {
        match (catalog) {
            some(cat) => {
                if (folder == root) {
                    cat.scan();
                    return true;
                }
                cat.close();
            },
            none => { },
        }
        root = text.repeat(&home, folder, 1);
        ids.Catalog* cat = ids.catalog(&home, root, ".asset.sozo");
        cat.scan();
        catalog = some(cat);
        open_store();
        str now = level.written(fresh_out());
        remake(now);
        return true;
    }

    // An arena for a text returned now: the one before is gone.
    Arena* fresh_out() {
        out.free();
        out = Arena.new(1 * KB);
        return &out;
    }
}

// ---- What the game writes in Sosu ----

// `make` called for each world made (now for the one held): it adds the kinds and the saved
// tables of the game.
pub void on_world(Game* g, keeps fn(Level*) -> void make) {
    g.setup = make;
    make(g.level);
}

// `step` called at each step of Play, after the engine, with the seconds since the last.
pub void on_step(Game* g, keeps fn(Level*, f32) -> void uses io step) {
    g.stepper = step;
}

// ---- The exports: the contract of Sozo ----

export "C" ui32 sozo_contract() {
    return CONTRACT;
}

// A game with an empty world, in edit mode.
export "C" Game* sozo_open() {
    mut Arena arena = Arena.new(4 * KB);
    return arena.new(Game, arena);
}

// The game and all it holds freed: nothing it returned stays valid.
export "C" void sozo_close(Game* g) uses io, threads {
    g.level.runner.close();
    match (g.store) {
        some(st) => {
            st.close();
        },
        none => { },
    }
    match (g.catalog) {
        some(cat) => {
            cat.close();
        },
        none => { },
    }
    match (g.drawer) {
        some(d) => {
            d.close();
        },
        none => { },
    }
    match (g.renderer) {
        some(r) => {
            r.close();
        },
        none => { },
    }
    match (g.device) {
        some(d) => {
            d.close();  // adopted: the device itself stays the editor's
        },
        none => { },
    }
    g.place.free();
    g.kept.free();
    g.out.free();
    g.said.free();
    g.logs.free();
    g.home.free();
}

// What the host said last (a scene that does not read), "" when nothing went wrong.
export "C" str sozo_message(Game* g) {
    return g.message;
}

// The scene file `source` in place of the world held; false, and an empty world, when it does
// not read.
export "C" bool sozo_load(Game* g, str source) uses io, threads {
    g.say("");
    return g.remake(source);
}

// The world as a scene file.
export "C" str sozo_save(Game* g) {
    return g.level.written(g.fresh_out());
}

// An empty world.
export "C" void sozo_clear(Game* g) uses io, threads {
    g.remake("");
}

// ---- Entities ----

export "C" usize sozo_count(Game* g) {
    return g.level.world.count();
}

// Every living entity, in the order of their indices.
// The living entities, siblings in their order (`World.in_order`).
export "C" scene.Entity[] sozo_entities(Game* g) {
    return g.level.world.in_order(g.fresh_out());
}

export "C" bool sozo_alive(Game* g, scene.Entity e) {
    return g.level.world.alive(e);
}

// A new entity named `name`, at the root, at the origin.
export "C" scene.Entity sozo_spawn(Game* g, str name) {
    str kept = text.repeat(g.level.arena, name, 1);
    return g.level.world.spawn_at(kept, linear.transform(), none);
}

// `e` and its children despawned, with what the engine had given them.
export "C" void sozo_despawn(Game* g, scene.Entity e) {
    forget(g.level, e);
    g.level.world.despawn(e);
}

void forget(Level* l, scene.Entity e) {
    mut Arena scratch = Arena.new(1 * KB);
    defer scratch.free();
    for (scene.Entity child in l.world.children(&scratch, e)) {
        forget(l, child);
    }
    l.runner.refresh(e);
}

// The parent of `e` written into `parent`; false when it is at the root.
export "C" bool sozo_parent_of(Game* g, scene.Entity e, scene.Entity* parent) {
    return match (g.level.world.parent_of(e)) {
        some(p) => {
            *parent = p;
            return true;
        },
        none => false,
    };
}

// The living children of `e`.
export "C" scene.Entity[] sozo_children(Game* g, scene.Entity e) {
    return g.level.world.children(g.fresh_out(), e);
}

// `e` placed under `parent`, where it stays in the world when `keep_world` (its transform made
// relative to its new parent), else at the same local transform; false when it would be a cycle.
export "C" bool sozo_set_parent(Game* g, scene.Entity e, scene.Entity parent, bool keep_world) {
    linear.Mat4 was = world_of(g.level, e);
    if (!g.level.world.set_parent(e, parent)) {
        return false;
    }
    if (keep_world) {
        keep_at(g.level, e, was);
    }
    return true;
}

// The camera the game is seen through, as it draws itself (its active view), whatever camera the
// editor gives `sozo_render` (contract 5): the editor draws over it, and picks through it, in Play.
export "C" render3d.Camera sozo_camera(Game* g) {
    render3d.Camera? was = g.level.runner.looking;
    g.level.runner.looking = none;
    render3d.Camera c = g.level.runner.camera();
    g.level.runner.looking = was;
    return c;
}

// `e` placed among its siblings just before `next`, or after all of them when `last` (contract 5).
export "C" void sozo_move_before(Game* g, scene.Entity e, scene.Entity next, bool last) {
    g.level.world.move_before(e, last ? none : some(next));
}

// `e` at the root again, where it is in the world when `keep_world`.
export "C" void sozo_clear_parent(Game* g, scene.Entity e, bool keep_world) {
    linear.Mat4 was = world_of(g.level, e);
    g.level.world.clear_parent(e);
    if (keep_world) {
        keep_at(g.level, e, was);
    }
}

linear.Mat4 world_of(Level* l, scene.Entity e) {
    l.world.propagate();
    return match (l.world.world_matrices.get(e)) {
        some(m) => *m,
        none => linear.identity4(),
    };
}

// The local transform of `e` that puts it at `world` under its parent.
void keep_at(Level* l, scene.Entity e, linear.Mat4 world) {
    linear.Mat4 local = match (l.world.parent_of(e)) {
        some(p) => match (world_of(l, p).inverse()) {
            some(inverse) => inverse.mul(world),
            none => world,
        },
        none => world,
    };
    l.world.transforms.set(e, linear.decompose(local));
}

export "C" str sozo_name_of(Game* g, scene.Entity e) {
    return match (g.level.world.names.get(e)) {
        some(n) => *n,
        none => "",
    };
}

export "C" void sozo_set_name(Game* g, scene.Entity e, str name) {
    if (g.level.world.alive(e)) {
        g.level.world.names.set(e, text.repeat(g.level.arena, name, 1));
    }
}

// ---- Transforms ----

// The transform of `e`, relative to its parent (the identity when it has none).
export "C" linear.Transform sozo_transform(Game* g, scene.Entity e) {
    return match (g.level.world.transforms.get(e)) {
        some(t) => *t,
        none => linear.transform(),
    };
}

export "C" void sozo_set_transform(Game* g, scene.Entity e, linear.Transform t) {
    if (g.level.world.alive(e)) {
        g.level.world.transforms.set(e, t);
    }
}

// Where `e` is in the world, its parents applied.
export "C" linear.Mat4 sozo_world_matrix(Game* g, scene.Entity e) {
    return world_of(g.level, e);
}

// ---- Components ----

// The kinds of components, those of `engine` first, then those of the game; each is named by
// its index.
export "C" usize sozo_kind_count(Game* g) {
    return g.level.registry.count();
}

export "C" str sozo_kind_name(Game* g, usize kind) {
    return kind < g.level.registry.count() ? g.level.registry.at(kind).name() : "";
}

// The file where `kind` is written, relative to the project: "" for those of `engine`, or a kind
// added without `add_source`.
export "C" str sozo_kind_file(Game* g, usize kind) {
    return match (g.level.source_of(sozo_kind_name(g, kind))) {
        some(s) => s.file,
        none => "",
    };
}

// The line of its struct in that file, 0 without one.
export "C" i64 sozo_kind_line(Game* g, usize kind) {
    return match (g.level.source_of(sozo_kind_name(g, kind))) {
        some(s) => s.line,
        none => 0,
    };
}

export "C" usize sozo_field_count(Game* g, usize kind) {
    return kind < g.level.registry.count() ? g.level.registry.at(kind).count() : 0;
}

export "C" FieldInfo sozo_field(Game* g, usize kind, usize field) {
    if (field >= sozo_field_count(g, kind)) {
        return FieldInfo{ name: "", label: "", kind: describe.Kind.Number, low: 0.0, high: 0.0, choices: 0 };
    }
    describe.Field f = g.level.registry.at(kind).field(field);
    usize choices = match (f.choices) {
        some(c) => c.len,
        none => 0,
    };
    return FieldInfo{ name: f.name, label: f.label, kind: f.kind, low: f.low, high: f.high, choices: choices,
            unit: f.unit, group: f.group, tooltip: f.tooltip, hidden: f.hidden, item: f.item };
}

// The name of the choice `choice` of a field of kind `Choice`.
export "C" str sozo_choice(Game* g, usize kind, usize field, usize choice) {
    if (field >= sozo_field_count(g, kind)) {
        return "";
    }
    return match (g.level.registry.at(kind).field(field).choices) {
        some(c) => choice < c.len ? c[choice] : "",
        none => "",
    };
}

export "C" bool sozo_has(Game* g, scene.Entity e, usize kind) {
    return kind < g.level.registry.count() && g.level.registry.at(kind).has(e);
}

// A new component of `kind` given to `e` (its fields as it is made new), unless it has one.
export "C" void sozo_add(Game* g, scene.Entity e, usize kind) {
    if (kind < g.level.registry.count() && g.level.world.alive(e)) {
        g.level.registry.at(kind).add(e);
        g.level.runner.refresh(e);
    }
}

export "C" void sozo_remove(Game* g, scene.Entity e, usize kind) {
    if (kind < g.level.registry.count()) {
        g.level.registry.at(kind).remove(e);
        g.level.runner.refresh(e);
    }
}

// The field `field` of the component `kind` of `e`; `Empty` when it has none.
export "C" Value sozo_get(Game* g, scene.Entity e, usize kind, usize field) {
    if (kind >= g.level.registry.count()) {
        return Value{ };
    }
    return match (g.level.registry.at(kind).get(e, field)) {
        some(v) => to_c(v),
        none => Value{ },
    };
}

// The field `field` of the component `kind` as it is made new: what a field is reset to; `Empty`
// past its fields.
export "C" Value sozo_fresh(Game* g, usize kind, usize field) {
    if (kind >= g.level.registry.count()) {
        return Value{ };
    }
    return match (g.level.registry.at(kind).fresh(field)) {
        some(v) => to_c(v),
        none => Value{ },
    };
}

// `v` given to the field `field` of the component `kind` of `e`, held within its bounds, a text
// copied; false when it has none (or `v` is empty). What the engine gave `e` is made again.
export "C" bool sozo_set(Game* g, scene.Entity e, usize kind, usize field, Value v) {
    if (kind >= g.level.registry.count()) {
        return false;
    }
    describe.Value given = match (from_c(v)) {
        some(x) => x,
        none => {
            return false;
        },
    };
    bool done = g.level.registry.at(kind).set(e, field, given);
    if (done) {
        g.level.runner.refresh(e);
    }
    return done;
}

// A list (contract 7): the number of the items of the field `field` of the component `kind` of `e`
// (0 without it, or for a field that is not a list).
export "C" usize sozo_item_count(Game* g, scene.Entity e, usize kind, usize field) {
    return kind < g.level.registry.count() ? g.level.registry.at(kind).item_count(e, field) : 0;
}

// Its item `index`; `Empty` past its items.
export "C" Value sozo_item(Game* g, scene.Entity e, usize kind, usize field, usize index) {
    if (kind >= g.level.registry.count()) {
        return Value{ };
    }
    return match (g.level.registry.at(kind).item(e, field, index)) {
        some(v) => to_c(v),
        none => Value{ },
    };
}

// All its items given at once, each held within the bounds of the field, texts copied; false when
// it has none, the field is not a list, or an item is empty. What the engine gave `e` is made again.
export "C" bool sozo_set_items(Game* g, scene.Entity e, usize kind, usize field, Value[] values) {
    if (kind >= g.level.registry.count()) {
        return false;
    }
    mut Arena scratch = Arena.new(1 * KB);
    defer scratch.free();
    describe.Value[] given = scratch.alloc_slice(describe.Value, values.len);
    for (usize j in 0..values.len) {
        given[j] = match (from_c(values[j])) {
            some(x) => x,
            none => {
                return false;
            },
        };
    }
    bool done = g.level.registry.at(kind).set_items(e, field, given);
    if (done) {
        g.level.runner.refresh(e);
    }
    return done;
}

// ---- Running ----

// Play: the scene saved, then run as the game runs it.
export "C" void sozo_play(Game* g) {
    g.play();
}

// Stop: the world made again from the scene saved by Play.
export "C" void sozo_stop(Game* g) uses io, threads {
    if (!g.playing) {
        return;
    }
    g.playing = false;
    g.paused = false;
    g.remake(g.before);
}

export "C" void sozo_pause(Game* g, bool on) {
    g.paused = on;
    g.level.runner.paused = !g.playing || on;
}

export "C" bool sozo_playing(Game* g) {
    return g.playing;
}

// A step of `dt` seconds: in Play, the engine moves the world and the game steps; in edit mode
// (and paused), the files still load and the world matrices follow the transforms.
export "C" void sozo_step(Game* g, f32 dt) uses io, threads {
    bool running = g.playing && !g.paused;
    g.level.runner.paused = !running;
    g.level.runner.update(running ? dt : 0.0);
    if (running) {
        g.stepper(g.level, dt);
    }
}

// ---- Logs ----

// What the game wrote (`Logs.write`) since the last call.
export "C" str sozo_logs(Game* g) {
    return g.logs.take(g.fresh_out());
}

// ---- Drawing, with the device of the editor ----

// The GPU of the editor shared (`gpu.adopt`: its native device and the format of its targets): the
// game draws with it from now on, the world held made again so that it does. False when the
// renderer cannot be made (the game then draws nothing); true at once when it already shares one.
export "C" bool sozo_gpu(Game* g, ui8* device, i32 format) uses io, threads {
    return g.share_gpu(device, format);
}

// The world drawn into the texture `target` of the editor (its native texture, `width` by `height`),
// seen through `camera` when `editor_view` (else through the active view of the scene, in Play),
// with the lines `lines` hidden behind it: ten numbers each (from x y z, to x y z, a color r g b a,
// linear). The commands are sent at once, before the editor's own: it then shows the texture. False
// when the game has no device (`sozo_gpu`).
export "C" bool sozo_render(Game* g, ui8* target, ui32 width, ui32 height, render3d.Camera camera, bool editor_view, f32[] lines) uses io, threads {
    gpu.Device* d = match (g.device) {
        some(x) => x,
        none => {
            return false;
        },
    };
    match (g.renderer) {
        some(r) => {
            usize n = lines.len / 10;
            for (usize i in 0..n) {
                usize k = i * 10;
                r.line(linear.vec3(lines[k], lines[k + 1], lines[k + 2]), linear.vec3(lines[k + 3], lines[k + 4], lines[k + 5]),
                        [lines[k + 6], lines[k + 7], lines[k + 8], lines[k + 9]]);
            }
        },
        none => {
            return false;
        },
    }
    gpu.Texture into = d.adopt_texture(target, width, height);
    gpu.Frame frame = match (d.commands()) {
        ok(f) => f,
        err(e) => {
            d.release_texture(into);
            return false;
        },
    };
    g.level.runner.looking = editor_view ? some(camera) : none;
    g.level.runner.render_into(frame, into);
    frame.submit();
    d.release_texture(into);  // forgotten: it is the editor's
    return true;
}

// The box of `e` written into `box` (`Engine.bounds_of`), and the space it lies in: 1 its own (a
// mesh), 2 its place and turn (a body), 3 its place alone (a marker); 0, and nothing written, when
// it has none.
export "C" ui32 sozo_bounds(Game* g, scene.Entity e, geometry.Aabb* box) uses io, threads {
    return match (g.level.runner.bounds_of(e)) {
        some(b) => {
            *box = b.box;
            return match (b.space) {
                Scaled => 1,
                Turned => 2,
                Placed => 3,
            };
        },
        none => 0,
    };
}

// ---- The files of the project ----

// The files of the project in the folder `root` (since contract 4): the identities of its files
// read (`assets.ids`: a component names a file by its GUID, wherever it moved), a store that loads
// them, watched (a file changed outside is loaded again), the world made again with them. Called
// again with the same folder, its files are looked at again (a file imported, moved or renamed).
export "C" bool sozo_assets(Game* g, str root) uses io, threads, random {
    return g.use_files(root);
}

// ---- Branches: copy, paste, duplicate ----

// `e` and those under it as a prefab, the tables of the game with them.
export "C" str sozo_branch(Game* g, scene.Entity e) {
    return g.level.branch(g.fresh_out(), e);
}

// The prefab `source` placed under `parent` (at the root when `at_root`): its entities, its root
// first; none (an empty view) when it does not read.
export "C" scene.Entity[] sozo_place_branch(Game* g, str source, scene.Entity parent, bool at_root) {
    return match (g.level.place(source, at_root ? none : some(parent))) {
        some(all) => {
            scene.Entity[] copy = g.fresh_out().alloc_slice(scene.Entity, all.len);
            for (usize i in 0..all.len) {
                copy[i] = all[i];
            }
            return copy;
        },
        none => g.fresh_out().alloc_slice(scene.Entity, 0),
    };
}

// ---- Tests: the contract called as the editor calls it ----

// A component of a game: a spin around y, in degrees per second.
pub struct Spin {
    pub mut f32 speed = 90.0;
    pub mut bool on = true;
    pub mut f32[] stops = [];  // a list: where it stops, in degrees
}

class SpinFields : describe.Describe<Spin>, save.Codec<Spin> {
    Arena* arena;  // where its lists are made

    void init(keeps Arena* arena) {
        self.arena = arena;
    }

    override str name() {
        return "spin";
    }

    override Spin fresh() {
        return Spin{ };
    }

    override usize count() {
        return 3;
    }

    override describe.Field field(usize i) {
        if (i == 2) {
            return describe.list("stops", "Stops", describe.number("", "", 0.0, 360.0));
        }
        return i == 0 ? describe.number("speed", "Speed", -720.0, 720.0) : describe.flag("on", "On");
    }

    override describe.Value get(Spin* s, usize i) {
        if (i == 2) {
            return describe.Value.Whole(s.stops.len as i64);
        }
        return i == 0 ? describe.Value.Number(s.speed) : describe.Value.Flag(s.on);
    }

    override void set(Spin* s, usize i, describe.Value v) {
        if (i == 0) {
            s.speed = describe.number_of(v, s.speed);
        } else if (i == 1) {
            s.on = describe.flag_of(v, s.on);
        }
    }

    override void write(text.TextBuilder* out, Spin* value) {
        describe.write_object(out, self as describe.Describe<Spin>*, value);
    }

    override Spin? read(Arena* arena, json.Value v) {
        return describe.read_object(arena, self as describe.Describe<Spin>*, v);
    }
    override usize items(Spin* c, usize i) {
        return i == 2 ? c.stops.len : 0;
    }

    override describe.Value item(Spin* c, usize i, usize j) {
        return describe.Value.Number(c.stops[j]);
    }

    override void set_items(Spin* c, usize i, describe.Value[] values) keeps self {
        if (i == 2) {
            f32[] made = arena.alloc_slice(f32, values.len);
            for (usize j in 0..values.len) {
                made[j] = describe.number_of(values[j], 0.0);
            }
            c.stops = made;
        }
    }
}

class SpinKind : kinds.Kind, Saved {
    Arena* arena;
    scene.Table<Spin>* spins;
    SpinFields* fields;

    void init(keeps Arena* arena, keeps scene.Table<Spin>* spins) {
        self.arena = arena;
        self.spins = spins;
        fields = arena.new(SpinFields, arena);
    }

    describe.Describe<Spin>* d() {
        return fields as describe.Describe<Spin>*;
    }

    override str name() {
        return d().name();
    }

    override usize count() {
        return d().count();
    }

    override describe.Field field(usize i) {
        return d().field(i);
    }

    override bool has(scene.Entity e) {
        return spins.has(e);
    }

    override void add(scene.Entity e) {
        kinds.table_add(spins, d(), e);
    }

    override void remove(scene.Entity e) {
        spins.remove(e);
    }

    override describe.Value? get(scene.Entity e, usize i) {
        return kinds.table_get(spins, d(), e, i);
    }

    override describe.Value? fresh(usize i) {
        return kinds.table_fresh(d(), i);
    }

    override bool set(scene.Entity e, usize i, describe.Value v) {
        return kinds.table_set(arena, spins, d(), e, i, v);
    }

    override usize item_count(scene.Entity e, usize i) {
        return kinds.table_item_count(spins, d(), e, i);
    }

    override describe.Value? item(scene.Entity e, usize i, usize j) {
        return kinds.table_item(spins, d(), e, i, j);
    }

    override bool set_items(scene.Entity e, usize i, describe.Value[] values) {
        return kinds.table_set_items(arena, spins, d(), e, i, values);
    }

    override void write(save.Writer* out) {
        out.add(spins, fields as save.Codec<Spin>*);
    }

    override bool read(save.Reader* r) {
        return r.add(spins, fields as save.Codec<Spin>*);
    }
}

// What a game does in `on_world`: its table and its kind.
void add_spin(Level* l) {
    SpinKind* k = l.arena.new(SpinKind, l.arena, l.world.table<Spin>());
    l.add(k as kinds.Kind*);
    l.add_saved(k as Saved*);
    l.add_source("spin", "src/spin.sosu", 12);
}

// What it does each step: what spins turns, and it says so once.
void turn(Level* l, f32 dt) uses io {
    for (usize i in 0..l.registry.count()) {
        kinds.Kind* k = l.registry.at(i);
        if (k.name() == "spin") {
            l.logs.write("spinning");
        }
    }
}

usize kind_named(Game* g, str name) {
    for (usize i in 0..sozo_kind_count(g)) {
        if (sozo_kind_name(g, i) == name) {
            return i;
        }
    }
    return sozo_kind_count(g);
}

usize field_named(Game* g, usize kind, str name) {
    for (usize i in 0..sozo_field_count(g, kind)) {
        if (sozo_field(g, kind, i).name == name) {
            return i;
        }
    }
    return sozo_field_count(g, kind);
}

test "the contract: entities, components of engine and of the game, saved, played and stopped" {
    Game* g = sozo_open();
    defer sozo_close(g);
    assert(sozo_contract() == CONTRACT && sozo_count(g) == 0 && sozo_kind_count(g) == 8);
    on_world(g, add_spin);
    on_step(g, turn);
    assert(sozo_kind_count(g) == 9 && sozo_kind_name(g, 8) == "spin");
    assert(sozo_kind_file(g, 8) == "src/spin.sosu" && sozo_kind_line(g, 8) == 12);
    assert(sozo_kind_file(g, 0) == "" && sozo_kind_line(g, 0) == 0 && sozo_kind_file(g, 99) == "");
    // entities, names, parents
    scene.Entity crate = sozo_spawn(g, "crate");
    scene.Entity lid = sozo_spawn(g, "lid");
    assert(sozo_count(g) == 2 && sozo_name_of(g, lid) == "lid" && sozo_entities(g).len == 2);
    mut linear.Transform up = linear.transform();
    up.position = linear.vec3(0.0, 5.0, 0.0);
    sozo_set_transform(g, crate, up);
    assert(sozo_set_parent(g, lid, crate, true));
    assert(!sozo_set_parent(g, crate, lid, false));  // a cycle
    mut scene.Entity found = crate;
    assert(sozo_parent_of(g, lid, &found) && found.same(crate) && sozo_children(g, crate).len == 1);
    // kept where it was in the world: its local transform now under the crate
    assert(sozo_transform(g, lid).position.near(linear.vec3(0.0, -5.0, 0.0), 0.0001));
    assert(sozo_world_matrix(g, lid).at(1, 3) == 0.0 && sozo_world_matrix(g, crate).at(1, 3) == 5.0);
    sozo_set_name(g, lid, "top");
    assert(sozo_name_of(g, lid) == "top");
    // components of engine: a body, its mass, a choice
    usize body = kind_named(g, "body");
    sozo_add(g, crate, body);
    assert(sozo_has(g, crate, body) && !sozo_has(g, lid, body));
    usize mass = field_named(g, body, "mass");
    assert(sozo_set(g, crate, body, mass, Value{ tag: Tag.Number, number: 12.5 }));
    assert(sozo_get(g, crate, body, mass).number == 12.5);
    assert(!sozo_set(g, crate, body, mass, Value{ }));  // empty
    usize kind = field_named(g, body, "kind");
    FieldInfo info = sozo_field(g, body, kind);
    assert(info.kind == describe.Kind.Choice && info.choices == 3 && sozo_choice(g, body, kind, 1) == "dynamic");
    match (sozo_get(g, lid, body, mass).tag) {
        Empty => { },
        _ => {
            assert(false);
        },
    }
    // a component of the game
    usize spin = kind_named(g, "spin");
    sozo_add(g, lid, spin);
    sozo_set(g, lid, spin, 0, Value{ tag: Tag.Number, number: 1000.0 });
    assert(sozo_get(g, lid, spin, 0).number == 720.0);  // its bounds
    assert(sozo_fresh(g, spin, 0).number == 90.0 && sozo_fresh(g, spin, 1).flag);  // what a reset gives
    // a list (contract 7): its items given at once, each held within its bounds, read one by one
    FieldInfo stops = sozo_field(g, spin, 2);
    assert(stops.kind == describe.Kind.List && stops.item == describe.Kind.Number && stops.high == 360.0);
    assert(sozo_item_count(g, lid, spin, 2) == 0 && sozo_item_count(g, lid, spin, 0) == 0);
    mut Value[3] given = [Value{ tag: Tag.Number, number: 90.0 }, Value{ tag: Tag.Number, number: 500.0 }, Value{ tag: Tag.Number, number: 45.0 }];
    assert(sozo_set_items(g, lid, spin, 2, given[0..3]));
    assert(sozo_item_count(g, lid, spin, 2) == 3 && sozo_item(g, lid, spin, 2, 1).number == 360.0);
    assert(!sozo_set_items(g, lid, spin, 0, given[0..3]));  // not a list
    assert(text.contains(sozo_save(g), "\"stops\": [90, 360, 45]"));
    match (sozo_fresh(g, spin, 3).tag) {
        Empty => { },
        _ => {
            assert(false);
        },
    }
    // saved, cleared, loaded back: the game's table with the rest
    mut Arena keep = Arena.new(4 * KB);
    defer keep.free();
    str saved = text.repeat(&keep, sozo_save(g), 1);
    sozo_clear(g);
    assert(sozo_count(g) == 0 && sozo_kind_count(g) == 9);
    assert(sozo_load(g, saved) && sozo_count(g) == 2 && sozo_message(g) == "");
    scene.Entity[] back = sozo_entities(g);
    assert(sozo_name_of(g, back[1]) == "top" && sozo_get(g, back[1], kind_named(g, "spin"), 0).number == 720.0);
    assert(sozo_get(g, back[0], kind_named(g, "body"), mass).number == 12.5);
    // played: the crate falls; stopped: it is back where it was
    sozo_play(g);
    assert(sozo_playing(g));
    for (i32 i in 0..30) {
        sozo_step(g, 1.0 / 30.0);
    }
    scene.Entity fallen = sozo_entities(g)[0];
    assert(sozo_transform(g, fallen).position.y < 4.0);
    assert(text.contains(sozo_logs(g), "spinning") && sozo_logs(g) == "");
    sozo_stop(g);
    assert(!sozo_playing(g) && sozo_count(g) == 2);
    assert(sozo_transform(g, sozo_entities(g)[0]).position.y == 5.0);
    // in edit mode, steps move nothing
    sozo_step(g, 1.0);
    assert(sozo_transform(g, sozo_entities(g)[0]).position.y == 5.0);
    // played again (the scene of the first Play gone, the names read from it kept), paused, stopped
    sozo_play(g);
    sozo_pause(g, true);
    sozo_step(g, 1.0);
    assert(sozo_transform(g, sozo_entities(g)[0]).position.y == 5.0 && sozo_name_of(g, sozo_entities(g)[1]) == "top");
    sozo_pause(g, false);
    sozo_step(g, 0.5);
    assert(sozo_transform(g, sozo_entities(g)[0]).position.y < 5.0);
    sozo_stop(g);
    assert(sozo_transform(g, sozo_entities(g)[0]).position.y == 5.0);
    // the boxes picked by the editor: the body of the crate, in its place and turn; the top has none
    scene.Entity box_of = sozo_entities(g)[0];
    mut geometry.Aabb box = geometry.aabb(linear.vec3(0.0, 0.0, 0.0), linear.vec3(0.0, 0.0, 0.0));
    assert(sozo_bounds(g, box_of, &box) == 2 && box.max.near(linear.vec3(0.5, 0.5, 0.5), 0.0001));
    assert(sozo_bounds(g, sozo_entities(g)[1], &box) == 0);
    // a branch copied and placed again at the root: the crate and the top under it, with the game's
    // table (the spin)
    str branch = text.repeat(&keep, sozo_branch(g, box_of), 1);
    scene.Entity[] placed = sozo_place_branch(g, branch, box_of, true);
    assert(placed.len == 2 && sozo_count(g) == 4);
    scene.Entity copy = placed[0];  // the view is gone at the next call that returns one
    scene.Entity copy_top = placed[1];
    mut scene.Entity under = copy;
    assert(!sozo_parent_of(g, copy, &under) && sozo_parent_of(g, copy_top, &under) && under.same(copy));
    assert(sozo_get(g, copy_top, kind_named(g, "spin"), 0).number == 720.0);
    assert(sozo_place_branch(g, "{ not json", box_of, true).len == 0);
    sozo_despawn(g, copy);
    // without the device of an editor, nothing is drawn
    mut f32[10] line = [0.0; 10];
    mut ui8 nothing = 0;
    assert(!sozo_render(g, &nothing, 16, 16, render3d.Camera{ position: linear.vec3(0.0, 0.0, 5.0), target: linear.vec3(0.0, 0.0, 0.0) },
            true, line[0..10]));
    // the files of a project: a model named by its GUID, loaded by the store of the game
    str root = engine_test_folder(&keep);
    match (io.write_file(&keep, fs.join(&keep, root, "wedge.obj"), "v 0 0 0\nv 2 0 0\nv 0 3 0\nf 1 2 3\n")) {
        ok => { },
        err(e) => {
            assert(false);
        },
    }
    assert(sozo_assets(g, root) && sozo_assets(g, root));  // the second time, looked at again
    ids.Catalog* cat = ids.catalog(&keep, root, ".asset.sozo");
    cat.scan();
    str guid = match (cat.guid_of("wedge.obj")) {
        some(x) => text.repeat(&keep, x, 1),
        none => "",
    };
    cat.close();
    scene.Entity wedge = sozo_spawn(g, "wedge");
    sozo_add(g, wedge, kind_named(g, "mesh"));
    sozo_set(g, wedge, kind_named(g, "mesh"), 0, Value{ tag: Tag.Text, text: guid });
    mut ui32 space = 0;
    for (i32 i in 0..2000) {
        sozo_step(g, 0.0);
        space = sozo_bounds(g, wedge, &box);
        if (space == 1) {
            break;
        }
        time.sleep_ms(1);
    }
    assert(space == 1 && box.max.near(linear.vec3(2.0, 3.0, 0.0), 0.001));
    sozo_despawn(g, wedge);
    match (fs.remove_all(&keep, root)) {
        ok => { },
        err(e) => { },
    }
    // despawned with its children
    sozo_despawn(g, sozo_entities(g)[0]);
    assert(sozo_count(g) == 0);
    // a scene that does not read: an empty world, and why
    assert(!sozo_load(g, "{ not json") && sozo_count(g) == 0 && sozo_message(g).len > 0);
}

// A folder of its own for a test, under the temporary folder of the system.
str engine_test_folder(Arena* arena) uses io, random {
    str temp = match (os.env(arena, "TEMP")) {
        some(t) => t,
        none => match (os.env(arena, "TMPDIR")) {
            some(t) => t,
            none => "/tmp",
        },
    };
    mut random.Rng rng = random.from_system();
    text.TextBuilder* b = text.builder(arena);
    b.push("sosu-host-files-");
    b.push_u64(rng.next());
    str folder = fs.join(arena, temp, b.text());
    match (fs.create_dirs(arena, folder)) {
        ok => { },
        err(e) => { },
    }
    return folder;
}
