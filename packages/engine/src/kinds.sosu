// ---- Tests ----

// A component of a game, outside of engine: a speed and a tag.
pub struct Speed {
    pub mut f32 value = 1.0;
    pub mut str tag = "slow";
}

class SpeedFields : describe.Describe<Speed> {
    void init() { }

    override str name() {
        return "speed";
    }

    override Speed fresh() {
        return Speed{ };
    }

    override usize count() {
        return 2;
    }

    override describe.Field field(usize i) {
        return i == 0 ? describe.number("value", "Value", 0.0, 10.0) : describe.text_field("tag", "Tag");
    }

    override describe.Value get(Speed* s, usize i) {
        return i == 0 ? describe.Value.Number(s.value) : describe.Value.Text(s.tag);
    }

    override void set(Speed* s, usize i, describe.Value v) {
        if (i == 0) {
            s.value = describe.number_of(v, s.value);
        } else {
            s.tag = describe.text_of(v, s.tag);
        }
    }
}

class SpeedKind : Kind {
    Arena* arena;
    scene.Table<Speed>* speeds;
    SpeedFields* fields;

    void init(keeps Arena* arena, keeps scene.Table<Speed>* speeds) {
        self.arena = arena;
        self.speeds = speeds;
        fields = arena.new(SpeedFields);
    }

    describe.Describe<Speed>* d() {
        return fields as describe.Describe<Speed>*;
    }

    override str name() {
        return d().name();
    }

    override usize count() {
        return d().count();
    }

    override describe.Field field(usize i) {
        return d().field(i);
    }

    override bool has(scene.Entity e) {
        return speeds.has(e);
    }

    override void add(scene.Entity e) {
        table_add(speeds, d(), e);
    }

    override void remove(scene.Entity e) {
        speeds.remove(e);
    }

    override describe.Value? get(scene.Entity e, usize i) {
        return table_get(speeds, d(), e, i);
    }

    override bool set(scene.Entity e, usize i, describe.Value v) {
        return table_set(arena, speeds, d(), e, i, v);
    }
}

// The index of the field `name` of `k`.
usize field_named(Kind* k, str name) {
    for (usize i in 0..k.count()) {
        if (k.field(i).name == name) {
            return i;
        }
    }
    return k.count();
}

f32 number_in(describe.Value? v) {
    return match (v) {
        some(x) => describe.number_of(x, -1.0),
        none => -2.0,
    };
}

str text_in(describe.Value? v) {
    return match (v) {
        some(x) => describe.text_of(x, "?"),
        none => "none",
    };
}

test "the kinds of components: the common ones and one of a game, each read and written alike" {
    mut Arena arena = Arena.new(64 * KB);
    defer arena.free();
    scene.World* w = scene.world(&arena);
    components.Components* c = components.components(&arena, w);
    Kinds* all = common(&arena, c);
    assert(all.count() == 7 && all.at(0).name() == "mesh");
    scene.Entity crate = w.spawn_at("crate", linear.transform(), none);
    Kind* body = match (all.named("body")) {
        some(k) => k,
        none => {
            assert(false);
            return;
        },
    };
    Kind* mesh = match (all.named("mesh")) {
        some(k) => k,
        none => {
            assert(false);
            return;
        },
    };
    assert(!body.has(crate) && number_in(body.get(crate, 0)) == -2.0);
    body.add(crate);
    mesh.add(crate);
    assert(body.has(crate) && c.bodies.has(crate));
    // a number, and one held within its bounds
    assert(body.set(crate, field_named(body, "mass"), describe.Value.Number(12.5)));
    assert(number_in(body.get(crate, field_named(body, "mass"))) == 12.5);
    body.set(crate, field_named(body, "restitution"), describe.Value.Number(5.0));
    assert(number_in(body.get(crate, field_named(body, "restitution"))) <= 1.0);
    // a text, copied where the world lives: still there when what it came from is gone
    mut Arena brief = Arena.new(1 * KB);
    str given = text.repeat(&brief, "models/crate.glb", 1);
    assert(mesh.set(crate, 0, describe.Value.Text(given)));
    brief.free();
    assert(text_in(mesh.get(crate, 0)) == "models/crate.glb");
    mut Arena names = Arena.new(1 * KB);
    defer names.free();
    str[] has = all.of(&names, crate);
    assert(has.len == 2 && has[0] == "mesh" && has[1] == "body");
    // removed
    body.remove(crate);
    assert(!body.has(crate) && !body.set(crate, 0, describe.Value.Number(1.0)));
    // a kind of the game, added to them
    scene.Table<Speed>* speeds = w.table<Speed>();
    all.add(arena.new(SpeedKind, &arena, speeds) as Kind*);
    assert(all.count() == 8);
    Kind* speed = match (all.named("speed")) {
        some(k) => k,
        none => {
            assert(false);
            return;
        },
    };
    speed.add(crate);
    assert(text_in(speed.get(crate, 1)) == "slow");
    speed.set(crate, 0, describe.Value.Number(25.0));
    assert(number_in(speed.get(crate, 0)) == 10.0);  // its bounds
    assert(match (speeds.get(crate)) {
        some(s) => s.value == 10.0,
        none => false,
    });
}
