// engine.kinds: the kinds of components of a world, each seen the same way whatever its type: its
// name and fields (from its `Describe`), whether an entity has one, adding and removing it,
// reading and writing a field through a `describe.Value`. What an editor needs to show and change
// every component, the common ones of `engine` and those of a game alike, and what a graph of Kumi
// will call. A generic class cannot implement an interface in Sosu, so each kind is a small class
// of its own, whose methods call the generic functions of this module (`table_get`...); a game
// writes one for each of its components (later, `sosuc describe` writes them).
//
//   kinds.Kinds* all = kinds.common(arena, components);   // the seven of engine
//   all.add(arena.new(SpeedKind, arena, speeds));           // one of the game
//   kinds.Kind* k = all.named("body");
//   k.set(crate, 3, describe.Value.Number(12.5));           // its mass
import std.vec;
import std.text;
import math.linear;
import scene.scene;
import engine.describe;
import engine.components;

// A kind of component of a world.
pub interface Kind {
    // The name of its table in a scene file (`Describe.name`).
    str name();
    usize count();
    describe.Field field(usize i);
    bool has(scene.Entity e);
    // A new one (`Describe.fresh`) given to `e`, unless it has one.
    void add(scene.Entity e);
    void remove(scene.Entity e);
    // The field `i` of the component of `e`, none if it has none.
    describe.Value? get(scene.Entity e, usize i);
    // `v` given to the field `i` of the component of `e`, held within its bounds, a text copied
    // where the world lives: false if it has none.
    bool set(scene.Entity e, usize i, describe.Value v);
}

// What every kind does, on its table and its description.

pub describe.Value? table_get<T>(scene.Table<T>* table, describe.Describe<T>* d, scene.Entity e, usize i) {
    if (i >= d.count()) {
        return none;
    }
    return match (table.get(e)) {
        some(c) => some(d.get(c, i)),
        none => none,
    };
}

pub bool table_set<T>(
    Arena* texts,
    scene.Table<T>* table,
    describe.Describe<T>* d,
    scene.Entity e,
    usize i,
    describe.Value v
) {
    if (i >= d.count()) {
        return false;
    }
    match (table.get(e)) {
        some(c) => {
            describe.Value kept = match (v) {
                Text(s) => describe.Value.Text(text.repeat(texts, s, 1)),
                _ => v,
            };
            d.set(c, i, describe.bounded(d.field(i), kept));
            return true;
        },
        none => {
            return false;
        },
    }
}

pub void table_add<T>(scene.Table<T>* table, keeps describe.Describe<T>* d, scene.Entity e) {
    if (!table.has(e)) {
        table.set(e, d.fresh());
    }
}

// The kinds of a world: those of `engine`, then those a game adds.
pub class Kinds {
    vec.Vec<Kind*>* all;

    void init(keeps Arena* arena) {
        all = vec.new<Kind*>(arena);
    }

    // `k` added (a kind of the game); one of the same name replaces it.
    pub void add(keeps Kind* k) {
        for (usize i in 0..all.len()) {
            if (all.items()[i].name() == k.name()) {
                all.set(i, k);
                return;
            }
        }
        all.push(k);
    }

    pub usize count() {
        return all.len();
    }

    pub Kind* at(usize i) {
        return all.items()[i];
    }

    // The kind named `name`, none if there is none.
    pub Kind*? named(str name) {
        for (Kind* k in all.items()) {
            if (k.name() == name) {
                return some(k);
            }
        }
        return none;
    }

    // The names of the kinds `e` has, in the order of the kinds.
    pub str[] of(Arena* into, scene.Entity e) {
        vec.Vec<str>* out = vec.new<str>(into);
        for (Kind* k in all.items()) {
            if (k.has(e)) {
                out.push(text.repeat(into, k.name(), 1));
            }
        }
        return out.items();
    }
}

// An empty registry of kinds.
pub Kinds* kinds(keeps Arena* arena) {
    return arena.new(Kinds, arena);
}

// The seven common kinds of `engine`, on the tables of `c`; texts set are copied into `arena`, which
// must live as long as the world.
pub Kinds* common(keeps Arena* arena, keeps components.Components* c) {
    Kinds* k = kinds(arena);
    k.add(arena.new(MeshKind, arena, c) as Kind*);
    k.add(arena.new(LightKind, arena, c) as Kind*);
    k.add(arena.new(ViewKind, arena, c) as Kind*);
    k.add(arena.new(BodyKind, arena, c) as Kind*);
    k.add(arena.new(SoundKind, arena, c) as Kind*);
    k.add(arena.new(EmitterKind, arena, c) as Kind*);
    k.add(arena.new(AnimatorKind, arena, c) as Kind*);
    return k;
}

// ---- The kinds of the common components ----

class MeshKind : Kind {
    Arena* arena;
    components.Components* c;

    void init(keeps Arena* arena, keeps components.Components* c) {
        self.arena = arena;
        self.c = c;
    }

    describe.Describe<components.Mesh>* d() {
        return c.mesh_fields as describe.Describe<components.Mesh>*;
    }

    override str name() {
        return d().name();
    }

    override usize count() {
        return d().count();
    }

    override describe.Field field(usize i) {
        return d().field(i);
    }

    override bool has(scene.Entity e) {
        return c.meshes.has(e);
    }

    override void add(scene.Entity e) {
        table_add(c.meshes, d(), e);
    }

    override void remove(scene.Entity e) {
        c.meshes.remove(e);
    }

    override describe.Value? get(scene.Entity e, usize i) {
        return table_get(c.meshes, d(), e, i);
    }

    override bool set(scene.Entity e, usize i, describe.Value v) {
        return table_set(arena, c.meshes, d(), e, i, v);
    }
}

