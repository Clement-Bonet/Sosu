// math.color: the conversions of colors. RGB to HSV and HSL and back, for a color picker and
// for hues that turn (all of them 0 to 1, the hue a fraction of the circle); sRGB to linear and
// back, since the light is summed in linear and the screen and the images are in sRGB; Oklab,
// where colors mix as the eye expects.
//
//   linear.Vec3 red = color.hsv_to_rgb(linear.vec3(0.0, 1.0, 1.0));
//   linear.Vec4 lit = color.to_linear(picked);   // what a shader adds up
import std.math;
import math.linear;

// The hue, the saturation and the value of `rgb`; a grey has a hue of 0.
pub linear.Vec3 rgb_to_hsv(linear.Vec3 rgb) {
    f32 high = max(rgb.x, max(rgb.y, rgb.z));
    f32 low = min(rgb.x, min(rgb.y, rgb.z));
    f32 span = high - low;
    return linear.vec3(hue(rgb, high, span), high == 0.0 ? 0.0 : span / high, high);
}

// The color of a hue, a saturation and a value.
pub linear.Vec3 hsv_to_rgb(linear.Vec3 hsv) {
    f32 c = hsv.z * hsv.y;
    return from_hue(hsv.x, c, hsv.z - c);
}

// The hue, the saturation and the lightness of `rgb`.
pub linear.Vec3 rgb_to_hsl(linear.Vec3 rgb) {
    f32 high = max(rgb.x, max(rgb.y, rgb.z));
    f32 low = min(rgb.x, min(rgb.y, rgb.z));
    f32 span = high - low;
    f32 l = (high + low) / 2.0;
    f32 s = span == 0.0 ? 0.0 : span / (1.0 - abs(2.0 * l - 1.0));
    return linear.vec3(hue(rgb, high, span), s, l);
}

// The color of a hue, a saturation and a lightness.
pub linear.Vec3 hsl_to_rgb(linear.Vec3 hsl) {
    f32 c = (1.0 - abs(2.0 * hsl.z - 1.0)) * hsl.y;
    return from_hue(hsl.x, c, hsl.z - c / 2.0);
}

f32 hue(linear.Vec3 rgb, f32 high, f32 span) {
    if (span == 0.0) {
        return 0.0;
    }
    mut f32 h = 0.0;
    if (high == rgb.x) {
        h = (rgb.y - rgb.z) / span;
    } else if (high == rgb.y) {
        h = (rgb.z - rgb.x) / span + 2.0;
    } else {
        h = (rgb.x - rgb.y) / span + 4.0;
    }
    h = h / 6.0;
    return h < 0.0 ? h + 1.0 : h;
}

// The color of hue `h` and chroma `c`, `low` added to its three parts.
linear.Vec3 from_hue(f32 h, f32 c, f32 low) {
    f32 turn = (h - math.floor(h as f64) as f32) * 6.0;  // 0 to 6, a hue of 1 being that of 0
    f32 x = c * (1.0 - abs(turn - 2.0 * math.floor((turn / 2.0) as f64) as f32 - 1.0));
    mut linear.Vec3 rgb = linear.vec3(c, 0.0, x);
    if (turn < 1.0) {
        rgb = linear.vec3(c, x, 0.0);
    } else if (turn < 2.0) {
        rgb = linear.vec3(x, c, 0.0);
    } else if (turn < 3.0) {
        rgb = linear.vec3(0.0, c, x);
    } else if (turn < 4.0) {
        rgb = linear.vec3(0.0, x, c);
    } else if (turn < 5.0) {
        rgb = linear.vec3(x, 0.0, c);
    }
    return rgb.add(linear.vec3(low, low, low));
}

// A part of a color in sRGB (0 to 1), in linear light (the curve of the standard, exactly).
pub f32 srgb_to_linear(f32 v) {
    if (v <= 0.04045) {
        return v / 12.92;
    }
    return math.pow(((v + 0.055) / 1.055) as f64, 2.4) as f32;
}

// A part of a color in linear light, in sRGB.
pub f32 linear_to_srgb(f32 v) {
    if (v <= 0.0031308) {
        return v * 12.92;
    }
    return 1.055 * math.pow(v as f64, 1.0 / 2.4) as f32 - 0.055;
}

// A color of sRGB (a picker, a texture, a page) in linear light, its alpha unchanged.
pub linear.Vec4 to_linear(linear.Vec4 c) {
    return linear.vec4(srgb_to_linear(c.x), srgb_to_linear(c.y), srgb_to_linear(c.z), c.w);
}

// A color in linear light in sRGB, its alpha unchanged.
pub linear.Vec4 to_srgb(linear.Vec4 c) {
    return linear.vec4(linear_to_srgb(c.x), linear_to_srgb(c.y), linear_to_srgb(c.z), c.w);
}

// ---- Oklab ----

// A color in linear light in Oklab (Björn Ottosson, 2020): `x` its lightness (0 black, 1 white),
// `y` and `z` how green-red and blue-yellow it is. Steps of the same size in it look the same
// size to the eye, which RGB and HSV do not: gradients without a grey or too bright middle, a
// lightness that a hue does not change.
pub linear.Vec3 linear_to_oklab(linear.Vec3 c) {
    f32 l = cbrt32(0.4122214708 * c.x + 0.5363325363 * c.y + 0.0514459929 * c.z);
    f32 m = cbrt32(0.2119034982 * c.x + 0.6806995451 * c.y + 0.1073969566 * c.z);
    f32 s = cbrt32(0.0883024619 * c.x + 0.2817188376 * c.y + 0.6299787005 * c.z);
    return linear.vec3(
        0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
        1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
        0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s
    );
}

// A color of Oklab in linear light.
pub linear.Vec3 oklab_to_linear(linear.Vec3 lab) {
    f32 l = 0.3963377774 * lab.y + 0.2158037573 * lab.z + lab.x;
    f32 m = lab.x - 0.1055613458 * lab.y - 0.0638541728 * lab.z;
    f32 s = lab.x - 0.0894841775 * lab.y - 1.2914855480 * lab.z;
    f32 l3 = l * l * l;
    f32 m3 = m * m * m;
    f32 s3 = s * s * s;
    return linear.vec3(
        4.0767416621 * l3 - 3.3077115913 * m3 + 0.2309699292 * s3,
        -1.2684380046 * l3 + 2.6097574011 * m3 - 0.3413193965 * s3,
        -0.0041960863 * l3 - 0.7034186147 * m3 + 1.7076147010 * s3
    );
}

// The color at `t` from `a` (0) to `b` (1), two colors in linear light mixed in Oklab, their
// alphas in a straight line: a gradient as the eye expects it.
pub linear.Vec4 mix_oklab(linear.Vec4 a, linear.Vec4 b, f32 t) {
    linear.Vec3 la = linear_to_oklab(a.xyz());
    linear.Vec3 lb = linear_to_oklab(b.xyz());
    linear.Vec3 c = oklab_to_linear(la.lerp(lb, t));
    return linear.vec4(c.x, c.y, c.z, a.w + (b.w - a.w) * t);
}

f32 cbrt32(f32 x) {
    return math.cbrt(x as f64) as f32;
}

test "Oklab: white, black, and back; mixes of an even lightness" {
    assert(linear_to_oklab(linear.vec3(1.0, 1.0, 1.0)).near(linear.vec3(1.0, 0.0, 0.0), 0.001));
    assert(linear_to_oklab(linear.vec3(0.0, 0.0, 0.0)).near(linear.vec3(0.0, 0.0, 0.0), 0.0001));
    // the red of sRGB: the values Ottosson gives
    assert(linear_to_oklab(linear.vec3(1.0, 0.0, 0.0)).near(linear.vec3(0.6279554, 0.2248631, 0.1258463), 0.001));
    linear.Vec3[4] colors = [linear.vec3(1.0, 0.0, 0.0), linear.vec3(0.1, 0.6, 0.2), linear.vec3(0.05, 0.1, 0.9), linear.vec3(0.5, 0.5, 0.5)];
    for (linear.Vec3 c in colors) {
        assert(oklab_to_linear(linear_to_oklab(c)).near(c, 0.0005));
    }
    // between blue and yellow: no grey in the middle, as an RGB mix gives
    linear.Vec4 blue = linear.vec4(0.0, 0.0, 1.0, 1.0);
    linear.Vec4 yellow = linear.vec4(1.0, 1.0, 0.0, 0.0);
    linear.Vec4 middle = mix_oklab(blue, yellow, 0.5);
    linear.Vec3 lab = linear_to_oklab(middle.xyz());
    f32 la = linear_to_oklab(blue.xyz()).x;
    f32 lb = linear_to_oklab(yellow.xyz()).x;
    assert(abs(lab.x - (la + lb) / 2.0) < 0.001 && middle.w == 0.5);
    assert(mix_oklab(blue, yellow, 0.0).near(blue, 0.001) && mix_oklab(blue, yellow, 1.0).near(yellow, 0.001));
}

test "colors: hues, saturations, values and lightnesses, sRGB and linear" {
    linear.Vec3[6] colors = [
        linear.vec3(1.0, 0.0, 0.0),
        linear.vec3(0.2, 0.8, 0.4),
        linear.vec3(0.1, 0.3, 0.9),
        linear.vec3(0.9, 0.2, 0.7),
        linear.vec3(0.5, 0.5, 0.5),
        linear.vec3(1.0, 0.9, 0.1),
    ];
    for (linear.Vec3 c in colors) {
        assert(hsv_to_rgb(rgb_to_hsv(c)).near(c, 0.0001));
        assert(hsl_to_rgb(rgb_to_hsl(c)).near(c, 0.0001));
    }
    assert(rgb_to_hsv(linear.vec3(0.0, 1.0, 0.0)).near(linear.vec3(0.33333333, 1.0, 1.0), 0.0001));
    assert(rgb_to_hsl(linear.vec3(0.0, 0.0, 1.0)).near(linear.vec3(0.66666667, 1.0, 0.5), 0.0001));
    assert(rgb_to_hsv(linear.vec3(0.5, 0.5, 0.5)).near(linear.vec3(0.0, 0.0, 0.5), 0.0001));
    assert(hsv_to_rgb(linear.vec3(1.0, 1.0, 1.0)).near(linear.vec3(1.0, 0.0, 0.0), 0.0001));  // a full turn
    assert(hsv_to_rgb(linear.vec3(0.5, 1.0, 1.0)).near(linear.vec3(0.0, 1.0, 1.0), 0.0001));  // cyan
    // the middle grey of sRGB is about a fifth of the light; and back
    assert(abs(srgb_to_linear(0.5) - 0.2140411) < 0.0001 && abs(linear_to_srgb(0.2140411) - 0.5) < 0.0001);
    assert(srgb_to_linear(0.0) == 0.0 && abs(srgb_to_linear(1.0) - 1.0) < 0.0001);
    assert(abs(srgb_to_linear(0.02) - 0.02 / 12.92) < 0.000001);  // the straight part
    linear.Vec4 c = linear.vec4(0.8, 0.3, 0.01, 0.5);
    assert(to_srgb(to_linear(c)).near(c, 0.0001) && to_linear(c).w == 0.5);
}
