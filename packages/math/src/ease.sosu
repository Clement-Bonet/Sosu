// math.ease: the curves of easing, for what moves on a time (a menu that slides in, a door that
// opens, a number that counts up, a camera that changes place): `t` from 0 to 1 gives 0 to 1, the
// way changed. `In` starts slowly, `Out` ends slowly, `InOut` both. Robert Penner's equations, as
// easings.net shows them; `Back` goes a little beyond its ends, `Elastic` and `Bounce` around them.
//
//   f32 x = scalar.remap(ease.apply(ease.Ease.OutBack, elapsed / 0.4), 0.0, 1.0, -300.0, 0.0);
import std.math;

pub enum Ease {
    Linear,
    InSine,
    OutSine,
    InOutSine,
    InQuad,
    OutQuad,
    InOutQuad,
    InCubic,
    OutCubic,
    InOutCubic,
    InQuart,
    OutQuart,
    InOutQuart,
    InQuint,
    OutQuint,
    InOutQuint,
    InExpo,
    OutExpo,
    InOutExpo,
    InCirc,
    OutCirc,
    InOutCirc,
    InBack,
    OutBack,
    InOutBack,
    InElastic,
    OutElastic,
    InOutElastic,
    InBounce,
    OutBounce,
    InOutBounce,
}

f32 PI = 3.14159265;

f32 sin32(f32 x) {
    return math.sin(x as f64) as f32;
}

f32 cos32(f32 x) {
    return math.cos(x as f64) as f32;
}

f32 pow32(f32 x, f32 y) {
    return math.pow(x as f64, y as f64) as f32;
}

f32 sqrt32(f32 x) {
    return math.sqrt(max(x, 0.0) as f64) as f32;
}

// `t` (held within 0..1) eased by `e`: 0 at 0 and 1 at 1, for every easing.
pub f32 apply(Ease e, f32 t) {
    f32 x = t < 0.0 ? 0.0 : t > 1.0 ? 1.0 : t;
    return match (e) {
        Linear => x,
        InSine => 1.0 - cos32(x * PI / 2.0),
        OutSine => sin32(x * PI / 2.0),
        InOutSine => -(cos32(PI * x) - 1.0) / 2.0,
        InQuad => x * x,
        OutQuad => 1.0 - (1.0 - x) * (1.0 - x),
        InOutQuad => x < 0.5 ? 2.0 * x * x : 1.0 - pow32(-2.0 * x + 2.0, 2.0) / 2.0,
        InCubic => x * x * x,
        OutCubic => 1.0 - pow32(1.0 - x, 3.0),
        InOutCubic => x < 0.5 ? 4.0 * x * x * x : 1.0 - pow32(-2.0 * x + 2.0, 3.0) / 2.0,
        InQuart => x * x * x * x,
        OutQuart => 1.0 - pow32(1.0 - x, 4.0),
        InOutQuart => x < 0.5 ? 8.0 * x * x * x * x : 1.0 - pow32(-2.0 * x + 2.0, 4.0) / 2.0,
        InQuint => x * x * x * x * x,
        OutQuint => 1.0 - pow32(1.0 - x, 5.0),
        InOutQuint => x < 0.5 ? 16.0 * x * x * x * x * x : 1.0 - pow32(-2.0 * x + 2.0, 5.0) / 2.0,
        InExpo => x == 0.0 ? 0.0 : pow32(2.0, 10.0 * x - 10.0),
        OutExpo => x == 1.0 ? 1.0 : 1.0 - pow32(2.0, -10.0 * x),
        InOutExpo => in_out_expo(x),
        InCirc => 1.0 - sqrt32(1.0 - x * x),
        OutCirc => sqrt32(1.0 - (x - 1.0) * (x - 1.0)),
        InOutCirc => x < 0.5 ? (1.0 - sqrt32(1.0 - 4.0 * x * x)) / 2.0
                : (sqrt32(1.0 - pow32(-2.0 * x + 2.0, 2.0)) + 1.0) / 2.0,
        InBack => 2.70158 * x * x * x - 1.70158 * x * x,
        OutBack => 1.0 + 2.70158 * pow32(x - 1.0, 3.0) + 1.70158 * pow32(x - 1.0, 2.0),
        InOutBack => in_out_back(x),
        InElastic => in_elastic(x),
        OutElastic => out_elastic(x),
        InOutElastic => in_out_elastic(x),
        InBounce => 1.0 - out_bounce(1.0 - x),
        OutBounce => out_bounce(x),
        InOutBounce => x < 0.5 ? (1.0 - out_bounce(1.0 - 2.0 * x)) / 2.0 : (1.0 + out_bounce(2.0 * x - 1.0)) / 2.0,
    };
}

// The value at `t` from `from` (0) to `to` (1), eased by `e`.
pub f32 between(Ease e, f32 from, f32 to, f32 t) {
    return from + (to - from) * apply(e, t);
}

f32 in_out_expo(f32 x) {
    if (x == 0.0 || x == 1.0) {
        return x;
    }
    return x < 0.5 ? pow32(2.0, 20.0 * x - 10.0) / 2.0 : (2.0 - pow32(2.0, -20.0 * x + 10.0)) / 2.0;
}

f32 in_out_back(f32 x) {
    f32 c = 1.70158 * 1.525;
    if (x < 0.5) {
        return pow32(2.0 * x, 2.0) * ((c + 1.0) * 2.0 * x - c) / 2.0;
    }
    return (pow32(2.0 * x - 2.0, 2.0) * ((c + 1.0) * (x * 2.0 - 2.0) + c) + 2.0) / 2.0;
}

f32 in_elastic(f32 x) {
    if (x == 0.0 || x == 1.0) {
        return x;
    }
    return -pow32(2.0, 10.0 * x - 10.0) * sin32((x * 10.0 - 10.75) * (2.0 * PI / 3.0));
}

f32 out_elastic(f32 x) {
    if (x == 0.0 || x == 1.0) {
        return x;
    }
    return pow32(2.0, -10.0 * x) * sin32((x * 10.0 - 0.75) * (2.0 * PI / 3.0)) + 1.0;
}

f32 in_out_elastic(f32 x) {
    if (x == 0.0 || x == 1.0) {
        return x;
    }
    f32 c = 2.0 * PI / 4.5;
    if (x < 0.5) {
        return -(pow32(2.0, 20.0 * x - 10.0) * sin32((20.0 * x - 11.125) * c)) / 2.0;
    }
    return pow32(2.0, -20.0 * x + 10.0) * sin32((20.0 * x - 11.125) * c) / 2.0 + 1.0;
}

f32 out_bounce(f32 x) {
    f32 n = 7.5625;
    f32 d = 2.75;
    if (x < 1.0 / d) {
        return n * x * x;
    }
    if (x < 2.0 / d) {
        f32 y = x - 1.5 / d;
        return n * y * y + 0.75;
    }
    if (x < 2.5 / d) {
        f32 y = x - 2.25 / d;
        return n * y * y + 0.9375;
    }
    f32 y = x - 2.625 / d;
    return n * y * y + 0.984375;
}

test "easings: from 0 to 1, each with its shape" {
    Ease[31] all = [
        Ease.Linear, Ease.InSine, Ease.OutSine, Ease.InOutSine, Ease.InQuad, Ease.OutQuad, Ease.InOutQuad,
        Ease.InCubic, Ease.OutCubic, Ease.InOutCubic, Ease.InQuart, Ease.OutQuart, Ease.InOutQuart, Ease.InQuint,
        Ease.OutQuint, Ease.InOutQuint, Ease.InExpo, Ease.OutExpo, Ease.InOutExpo, Ease.InCirc, Ease.OutCirc,
        Ease.InOutCirc, Ease.InBack, Ease.OutBack, Ease.InOutBack, Ease.InElastic, Ease.OutElastic,
        Ease.InOutElastic, Ease.InBounce, Ease.OutBounce, Ease.InOutBounce
    ];
    for (Ease e in all) {
        assert(abs(apply(e, 0.0)) < 0.001 && abs(apply(e, 1.0) - 1.0) < 0.001);
        assert(apply(e, -5.0) == apply(e, 0.0) && apply(e, 7.0) == apply(e, 1.0));  // held within 0..1
        // continuous: no jump between two near times (the middle of the InOut ones included)
        for (i32 i in 0..100) {
            f32 t = i as f32 / 100.0;
            assert(abs(apply(e, t + 0.001) - apply(e, t)) < 0.05);
        }
    }
    // the ones that are symmetric pass through the middle
    for (Ease e in [Ease.InOutSine, Ease.InOutQuad, Ease.InOutCubic, Ease.InOutExpo, Ease.InOutCirc, Ease.InOutBack]) {
        assert(abs(apply(e, 0.5) - 0.5) < 0.001);
    }
    assert(apply(Ease.InQuad, 0.5) == 0.25 && apply(Ease.OutQuad, 0.5) == 0.75 && apply(Ease.InCubic, 0.5) == 0.125);
    assert(apply(Ease.InBack, 0.3) < 0.0 && apply(Ease.OutBack, 0.7) > 1.0);  // beyond the ends
    assert(apply(Ease.OutElastic, 0.2) > 1.0 && abs(apply(Ease.OutBounce, 1.0 / 2.75) - 1.0) < 0.001);
    assert(between(Ease.Linear, 10.0, 20.0, 0.25) == 12.5 && between(Ease.InQuad, 0.0, -8.0, 0.5) == -2.0);
}
