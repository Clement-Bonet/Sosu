// platform.app: run a window (spec §10.1). The runtime owns the main loop and calls the
// program back through its `Handler`: on each event, then on each frame, to draw on a
// `render.canvas.Canvas` the size of the window.
import platform.sdl;
import render.canvas;
import render.image;

pub struct Config {
    pub str title;
    pub i32 width;
    pub i32 height;
    // With a title bar, the system draws none: the program draws its own, and says where
    // dragging moves the window (spec §10.5).
    pub TitleBar*? title_bar = none;
    // The icon of the window, for the system: its task bar, Alt+Tab, its title bar.
    pub image.Image? icon = none;
}

// A title bar drawn by the program: the system asks it, point by point, between two frames,
// whether the mouse there moves the window.
pub interface TitleBar {
    bool is_drag_area(f32 x, f32 y);
}

pub enum Button {
    Left,
    Middle,
    Right,
    Other,
}

// The keys held with another key.
pub struct Mods {
    pub bool shift;
    pub bool ctrl;
    pub bool alt;
    pub bool command;  // Cmd on macOS, the Windows key on Windows
}

pub enum Event {
    Quit,
    Resized(i32 width, i32 height),
    // SDL key codes: 27 is Escape, 0x4000004F to 0x40000052 the arrows, `a` to `z` 97 to 122.
    // A key held down repeats its `down` event.
    Key(u32 code, bool down, Mods mods),
    MouseMove(f32 x, f32 y),
    Click(f32 x, f32 y, Button button),  // a button pressed
    Release(f32 x, f32 y, Button button),  // a button released
    TextInput(str text),  // typed text (UTF-8), valid until the end of the frame
    // The text an input method is composing (spec §10.9), not typed yet, and its cursor; an empty
    // text ends the composition.
    TextEditing(str text, i32 cursor),
    Wheel(f32 x, f32 y),  // the mouse wheel, in steps: y > 0 away from the user (up)
    // Once before the first frame, when `Config` has a title bar: true if the system left it
    // to the program, false if it kept its own (the program's bar is then a tool bar).
    CustomTitleBar(bool active),
    Maximized(bool on),  // the window was maximized, or restored
    LocaleChanged,  // the languages the user prefers changed: see `locales`
    SystemThemeChanged(bool dark),  // the user chose a light or a dark theme for the system
}

// What a program implements: its state lives in the class that implements it.
pub interface Handler {
    // Returns false to close the window.
    bool on_event(Event e) uses io;
    void on_frame(canvas.Canvas* surface) uses io;
}

Button button_of(u8 index) {
    return index == 1 ? Left : index == 2 ? Middle : index == 3 ? Right : Other;
}

// The event the program receives, if it is one `platform` handles. Text goes to `frame`.
Event? translate(sdl.Event* event, Arena* frame) uses io {
    u32 kind = event.kind;
    if (kind == 0x100) {  // SDL_EVENT_QUIT
        return some(Quit);
    }
    if (kind == 0x206) {  // SDL_EVENT_WINDOW_RESIZED
        return some(Resized(event.word5 as i32, event.word6 as i32));
    }
    if (kind == 0x107) {  // SDL_EVENT_LOCALE_CHANGED
        return some(LocaleChanged);
    }
    if (kind == 0x108) {  // SDL_EVENT_SYSTEM_THEME_CHANGED
        return some(SystemThemeChanged(sdl.system_theme() == 2));
    }
    if (kind == 0x20A || kind == 0x20B) {  // SDL_EVENT_WINDOW_MAXIMIZED, SDL_EVENT_WINDOW_RESTORED
        return some(Maximized(kind == 0x20A));
    }
    if (kind == 0x300 || kind == 0x301) {  // SDL_EVENT_KEY_DOWN, SDL_EVENT_KEY_UP
        sdl.Keyboard* key = sdl.as_keyboard(event);
        u32 m = key.mods as u32;
        Mods mods = Mods{ shift: m & 0x3 != 0, ctrl: m & 0xC0 != 0, alt: m & 0x300 != 0, command: m & 0xC00 != 0 };
        return some(Key(key.key, kind == 0x300, mods));
    }
    if (kind == 0x400) {  // SDL_EVENT_MOUSE_MOTION
        sdl.MouseMotion* motion = sdl.as_motion(event);
        return some(MouseMove(motion.x, motion.y));
    }
    if (kind == 0x401 || kind == 0x402) {  // SDL_EVENT_MOUSE_BUTTON_DOWN, SDL_EVENT_MOUSE_BUTTON_UP
        sdl.MouseButton* press = sdl.as_button(event);
        Button button = button_of(press.button);
        return some(kind == 0x401 ? Click(press.x, press.y, button) : Release(press.x, press.y, button));
    }
    if (kind == 0x403) {  // SDL_EVENT_MOUSE_WHEEL
        sdl.MouseWheel* wheel = sdl.as_wheel(event);
        f32 sign = wheel.direction == 1 ? -1.0 : 1.0;
        return some(Wheel(wheel.x * sign, wheel.y * sign));
    }
    if (kind == 0x303) {  // SDL_EVENT_TEXT_INPUT
        return some(TextInput(sdl.text_of(frame, event)));
    }
    if (kind == 0x302) {  // SDL_EVENT_TEXT_EDITING
        return some(TextEditing(sdl.editing_text(frame, event), sdl.editing_cursor(event)));
    }
    return none;
}

// The text of the clipboard, copied into `arena`, or "".
pub str clipboard(Arena* arena) uses io {
    return sdl.clipboard_text(arena);
}

// Puts `text` on the clipboard (`arena` holds its C copy).
pub void set_clipboard(Arena* arena, str text) uses io {
    sdl.set_clipboard_text(arena, text);
}

// Asks the window to close: `on_event` then receives `Quit`, as for the window button.
pub void request_quit() uses io {
    sdl.push_quit();
}

// The theme of the system, as the user chose it.
pub enum SystemTheme {
    Unknown,
    Light,
    Dark,
}

pub SystemTheme system_theme() uses io {
    i32 theme = sdl.system_theme();
    return theme == 1 ? Light : theme == 2 ? Dark : Unknown;
}

// The languages the user prefers, the first one first, written `fr-FR` or `fr`, in `arena`
// (spec §10.7): to choose a catalog of translations (`i18n.catalog.best`).
pub str[] locales(Arena* arena) uses io {
    return sdl.preferred_locales(arena);
}

// Minimizes the window (the button of a title bar drawn by the program).
pub void minimize() uses io {
    sdl.push_request(1);
}

// Where the text being typed is, in pixels of the window (spec §10.9): the window of the candidates
// of an input method opens next to it (`ui.caret_area()` gives it).
pub void set_text_input_area(f32 x, f32 y, f32 w, f32 h) uses io {
    sdl.push_area(x as i32, y as i32, w as i32, h as i32);
}

// Shows or hides the keyboard of the system, on a touch screen (`ui.wants_text()` says when).
pub void show_keyboard(bool on) uses io {
    sdl.push_request(on ? 4 : 5);
}

// Maximizes the window, or restores it when it is maximized.
pub void toggle_maximize() uses io {
    sdl.push_request(2);
}

// What the hit test of a window without decorations needs: given to SDL as its data.
struct HitTarget {
    mut TitleBar*? bar;
}

// The hit test of a window whose title bar the program draws: a border resizes it (6 pixels,
// none when it is maximized), the drag area of the program moves it, the rest is the program's.
i32 hit_test(sdl.Window* window, sdl.Point* point, u8* data) uses io {
    mut TitleBar*? bar = none;
    unsafe {
        bar = (data as HitTarget*).bar;
    }
    i32 x = point.x;
    i32 y = point.y;
    if (!sdl.is_maximized(window)) {
        sdl.Point size = sdl.window_size(window);
        i32 edge = 6;
        bool left = x < edge;
        bool right = x >= size.x - edge;
        bool top = y < edge;
        bool bottom = y >= size.y - edge;
        // SDL_HITTEST_RESIZE_TOPLEFT (2) to SDL_HITTEST_RESIZE_LEFT (9), clockwise
        if (top) {
            return left ? 2 : right ? 4 : 3;
        }
        if (bottom) {
            return left ? 8 : right ? 6 : 7;
        }
        if (left) {
            return 9;
        }
        if (right) {
            return 5;
        }
    }
    return match (bar) {
        some(b) => b.is_drag_area(x as f32, y as f32) ? 1 : 0,  // SDL_HITTEST_DRAGGABLE, NORMAL
        none => 0,
    };
}

// What draws the window: its pixels and their texture, rebuilt when its size changes. The
// loop of `run` draws with it, and so does `on_expose` while the system holds that loop.
class Screen {
    Handler* handler;
    sdl.Renderer* renderer;
    mut Arena pixels;
    mut canvas.Canvas surface;
    mut sdl.Texture*? texture;

    void init(Handler* handler, sdl.Renderer* renderer) {
        self.handler = handler;
        self.renderer = renderer;
        pixels = Arena.new(1 * KB);
        surface = canvas.create(&pixels, 0, 0);
        texture = none;
    }

    // The pixels and the texture at `width` by `height`, unless they already are. False if
    // SDL cannot create the texture.
    bool resize(i32 width, i32 height) uses io {
        bool ready = match (texture) {
            some(t) => true,
            none => false,
        };
        if (ready && surface.width == width && surface.height == height) {
            return true;
        }
        pixels.free();
        pixels = Arena.new(1 * MB);
        surface = canvas.create(&pixels, width, height);
        release();
        texture = sdl.create_texture(renderer, max(width, 1), max(height, 1));
        return match (texture) {
            some(t) => true,
            none => false,
        };
    }

    // A frame of the program, shown.
    void draw() uses io {
        handler.on_frame(&surface);
        match (texture) {
            some(t) => {
                sdl.show_pixels(renderer, t, surface.pixels, surface.width);
            },
            none => { },
        }
        sdl.present(renderer);
    }

    void release() uses io {
        match (texture) {
            some(t) => {
                sdl.destroy_texture(t);
            },
            none => { },
        }
        texture = none;
    }
}

// What `on_expose` needs: given to SDL as its data.
struct ExposeTarget {
    mut Screen*? screen;
    mut sdl.Window*? window;
}

// Called by SDL as each event arrives. While a window is resized, Windows holds the loop of
// `run` until the mouse is released: SDL then asks for frames with SDL_EVENT_WINDOW_EXPOSED
// (data1 is 1 during a live resize), drawn here at the new size, or the new part of the
// window would stay black.
bool on_expose(u8* data, sdl.Event* event) uses io {
    if (event.kind != 0x204 || event.word5 != 1) {
        return true;  // the event goes to the queue, as usual
    }
    mut Screen*? screen = none;
    mut sdl.Window*? window = none;
    unsafe {
        screen = (data as ExposeTarget*).screen;
        window = (data as ExposeTarget*).window;
    }
    match (screen) {
        some(s) => {
            match (window) {
                some(w) => {
                    sdl.Point size = sdl.window_size(w);
                    if (s.resize(size.x, size.y)) {
                        s.draw();
                    }
                },
                none => { },
            }
        },
        none => { },
    }
    return true;
}

// Opens the window and runs until `on_event` returns false. Returns the exit code.
pub i32 run(Config config, Handler* handler) uses io {
    mut Arena arena = Arena.new(16 * KB);
    defer arena.free();
    bool wants_bar = match (config.title_bar) {
        some(bar) => true,
        none => false,
    };
    if (!sdl.init_video()) {
        return 1;
    }
    defer sdl.quit();

    sdl.Window* window = match (sdl.create_window(&arena, config.title, config.width, config.height, !wants_bar)) {
        some(created) => created,
        none => {
            return 1;
        },
    };
    defer sdl.destroy_window(window);
    match (config.icon) {
        some(icon) => {
            sdl.set_icon(window, icon.pixels, icon.width, icon.height);
        },
        none => { },
    }
    // A title bar drawn by the program, if the system accepts the hit test; else its own.
    mut bool custom = false;
    match (config.title_bar) {
        some(bar) => {
            HitTarget* target = arena.alloc(HitTarget);
            target.bar = some(bar);
            unsafe {
                custom = sdl.set_hit_test(window, hit_test, target as u8*);
            }
            if (!custom) {
                sdl.set_decorated(window, true);
            }
        },
        none => { },
    }
    sdl.start_text_input(window);
    sdl.Renderer* renderer = match (sdl.create_renderer(window)) {
        some(created) => created,
        none => {
            return 1;
        },
    };
    defer sdl.destroy_renderer(renderer);

    // The pixels of the window: rebuilt, with their arena, when its size changes.
    Screen* screen = arena.new(Screen, handler, renderer);
    defer screen.pixels.free();
    defer screen.release();
    if (!screen.resize(config.width, config.height)) {
        return 1;
    }
    // Frames while the window is resized, when the system holds this loop.
    ExposeTarget* expose = arena.alloc(ExposeTarget);
    expose.screen = some(screen);
    expose.window = some(window);
    unsafe {
        sdl.add_event_watch(on_expose, expose as u8*);
    }
    defer remove_watch(expose);

    sdl.Event* event = arena.alloc(sdl.Event);
    // What lives for one frame (the text of the events), emptied before each frame.
    mut Arena frame = Arena.new(4 * KB);
    defer frame.free();
    mut bool running = true;
    if (wants_bar) {
        running = handler.on_event(CustomTitleBar(custom));
    }
    while (running) {
        frame.free();
        frame = Arena.new(4 * KB);
        while (sdl.poll(event)) {
            if (event.kind == 0x8000) {  // SDL_EVENT_USER: a request of `minimize` or `toggle_maximize`
                if (event.word5 == 1) {
                    sdl.minimize(window);
                } else if (event.word5 == 2) {
                    sdl.toggle_maximize(window);
                } else if (event.word5 == 3) {
                    sdl.set_text_input_area(window, event.word6 as i32, event.word7 as i32, sdl.area_w(event), sdl.area_h(event));
                } else if (event.word5 == 4 || event.word5 == 5) {
                    sdl.text_input(window, event.word5 == 4);
                }
                continue;
            }
            match (translate(event, &frame)) {
                some(e) => {
                    match (e) {
                        Resized(width, height) => {
                            if (!screen.resize(width, height)) {
                                return 1;
                            }
                        },
                        _ => { },
                    }
                    if (!handler.on_event(e)) {
                        running = false;
                    }
                },
                none => { },
            }
        }
        if (!running) {
            break;
        }
        screen.draw();
        sdl.delay(16);
    }
    return 0;
}

void remove_watch(ExposeTarget* expose) uses io {
    unsafe {
        sdl.remove_event_watch(on_expose, expose as u8*);
    }
}
