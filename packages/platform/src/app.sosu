// platform.app: run a window (spec §10.1). The runtime owns the main loop and calls the
// program back through its `Handler`: on each event, then on each frame, to draw on a
// `render.canvas.Canvas` the size of the window.
import platform.sdl;
import render.canvas;

pub struct Config {
    pub str title;
    pub i32 width;
    pub i32 height;
}

pub enum Button {
    Left,
    Middle,
    Right,
    Other,
}

pub enum Event {
    Quit,
    Resized(i32 width, i32 height),
    Key(u32 code, bool down),  // SDL key codes: 27 is Escape, 0x4000004F to 0x40000052 the arrows
    MouseMove(f32 x, f32 y),
    Click(f32 x, f32 y, Button button),  // a button pressed
    Release(f32 x, f32 y, Button button),  // a button released
    TextInput(str text),  // typed text (UTF-8), valid until the end of the frame
}

// What a program implements: its state lives in the class that implements it.
pub interface Handler {
    // Returns false to close the window.
    bool on_event(Event e) uses io;
    void on_frame(canvas.Canvas* surface) uses io;
}

Button button_of(u8 index) {
    return index == 1 ? Left : index == 2 ? Middle : index == 3 ? Right : Other;
}

// The event the program receives, if it is one `platform` handles. Text goes to `frame`.
Event? translate(sdl.Event* event, Arena* frame) {
    u32 kind = event.kind;
    if (kind == 0x100) {  // SDL_EVENT_QUIT
        return some(Quit);
    }
    if (kind == 0x206) {  // SDL_EVENT_WINDOW_RESIZED
        return some(Resized(event.word5 as i32, event.word6 as i32));
    }
    if (kind == 0x300 || kind == 0x301) {  // SDL_EVENT_KEY_DOWN, SDL_EVENT_KEY_UP
        return some(Key(event.word7, kind == 0x300));
    }
    if (kind == 0x400) {  // SDL_EVENT_MOUSE_MOTION
        sdl.MouseMotion* motion = sdl.as_motion(event);
        return some(MouseMove(motion.x, motion.y));
    }
    if (kind == 0x401 || kind == 0x402) {  // SDL_EVENT_MOUSE_BUTTON_DOWN, SDL_EVENT_MOUSE_BUTTON_UP
        sdl.MouseButton* press = sdl.as_button(event);
        Button button = button_of(press.button);
        return some(kind == 0x401 ? Click(press.x, press.y, button) : Release(press.x, press.y, button));
    }
    if (kind == 0x303) {  // SDL_EVENT_TEXT_INPUT
        return some(TextInput(sdl.text_of(frame, event)));
    }
    return none;
}

// Asks the window to close: `on_event` then receives `Quit`, as for the window button.
pub void request_quit() uses io {
    sdl.push_quit();
}

// Opens the window and runs until `on_event` returns false. Returns the exit code.
pub i32 run(Config config, Handler* handler) uses io {
    mut Arena arena = Arena.new(16 * KB);
    defer arena.free();
    if (!sdl.init_video()) {
        return 1;
    }
    defer sdl.quit();

    sdl.Window* window = match (sdl.create_window(&arena, config.title, config.width, config.height)) {
        some(created) => created,
        none => {
            return 1;
        },
    };
    defer sdl.destroy_window(window);
    sdl.start_text_input(window);
    sdl.Renderer* renderer = match (sdl.create_renderer(window)) {
        some(created) => created,
        none => {
            return 1;
        },
    };
    defer sdl.destroy_renderer(renderer);

    // The pixels of the window: rebuilt, with their arena, when its size changes.
    mut Arena pixels = Arena.new(1 * MB);
    defer pixels.free();
    mut canvas.Canvas surface = canvas.create(&pixels, config.width, config.height);
    mut sdl.Texture* texture = match (sdl.create_texture(renderer, config.width, config.height)) {
        some(created) => created,
        none => {
            return 1;
        },
    };
    defer sdl.destroy_texture(texture);

    sdl.Event* event = arena.alloc(sdl.Event);
    // What lives for one frame (the text of the events), emptied before each frame.
    mut Arena frame = Arena.new(4 * KB);
    defer frame.free();
    mut bool running = true;
    while (running) {
        frame.free();
        frame = Arena.new(4 * KB);
        while (sdl.poll(event)) {
            match (translate(event, &frame)) {
                some(e) => {
                    match (e) {
                        Resized(width, height) => {
                            pixels.free();
                            pixels = Arena.new(1 * MB);
                            surface = canvas.create(&pixels, width, height);
                            sdl.destroy_texture(texture);
                            texture = match (sdl.create_texture(renderer, max(width, 1), max(height, 1))) {
                                some(created) => created,
                                none => {
                                    return 1;
                                },
                            };
                        },
                        _ => { },
                    }
                    if (!handler.on_event(e)) {
                        running = false;
                    }
                },
                none => { },
            }
        }
        if (!running) {
            break;
        }
        handler.on_frame(&surface);
        sdl.show_pixels(renderer, texture, surface.pixels, surface.width);
        sdl.present(renderer);
        sdl.delay(16);
    }
    return 0;
}
