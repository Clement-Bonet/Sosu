// platform.sdl: the part of SDL3 that `platform` uses, declared by hand (spec §9).
// The C declarations stay private; the functions below wrap them in safe Sosu.

pub struct Window { }
pub struct Renderer { }

// SDL_Event: 128 bytes, read through the fields of the events `platform` handles.
pub struct Event {
    pub u32 kind;  // SDL_EventType
    u32 reserved;
    u64 timestamp;
    u32 window;
    pub u32 word5;  // window events: data1; keyboard events: keyboard id
    pub u32 word6;  // window events: data2; keyboard events: scancode
    pub u32 word7;  // keyboard events: key code
    u8[96] rest;
}

// SDL_MouseMotionEvent, the same 128 bytes seen differently.
pub struct MouseMotion {
    u32 kind;
    u32 reserved;
    u64 timestamp;
    u32 window;
    u32 which;
    u32 state;
    pub f32 x;
    pub f32 y;
    f32 xrel;
    f32 yrel;
}

// SDL_MouseButtonEvent.
pub struct MouseButton {
    u32 kind;
    u32 reserved;
    u64 timestamp;
    u32 window;
    u32 which;
    pub u8 button;  // 1: left, 2: middle, 3: right
    bool down;
    u8 clicks;
    u8 padding;
    pub f32 x;
    pub f32 y;
}

// SDL_TextInputEvent: `text` is a UTF-8 C string owned by SDL until the next event.
struct TextInput {
    u32 kind;
    u32 reserved;
    u64 timestamp;
    u32 window;
    u32 padding;
    u8* text;
}

// SDL_TextEditingEvent: the text being composed by an input method, and its cursor.
struct TextEditing {
    u32 kind;
    u32 reserved;
    u64 timestamp;
    u32 window;
    u32 padding;
    u8* text;
    i32 start;
    i32 length;
}

// SDL_TouchFingerEvent: a finger on a touch screen, its place from 0 to 1.
struct TouchFinger {
    u32 kind;
    u32 reserved;
    u64 timestamp;
    u64 touch;
    u64 finger;
    f32 x;
    f32 y;
    f32 dx;
    f32 dy;
    f32 pressure;
    u32 window;
}

// SDL_DropEvent: a file dropped on the window, from the system.
struct Drop {
    u32 kind;
    u32 reserved;
    u64 timestamp;
    u32 window;
    f32 x;
    f32 y;
    u8* source;
    u8* data;
}

// SDL_Rect.
struct IntRect {
    i32 x;
    i32 y;
    i32 w;
    i32 h;
}

// SDL_KeyboardEvent.
pub struct Keyboard {
    u32 kind;
    u32 reserved;
    u64 timestamp;
    u32 window;
    u32 which;
    u32 scancode;
    pub u32 key;
    pub u16 mods;  // SDL_Keymod: Shift 0x3, Ctrl 0xC0, Alt 0x300, GUI (Cmd, Windows) 0xC00
    u16 raw;
    bool down;
    bool repeat;
}

pub struct Texture { }

// SDL_Locale: a language (`fr`), and a country (`FR`) or NULL.
pub struct Locale {
    u8* language;
    u8* country;
}
pub struct Surface { }

// SDL_Point: a point of a window, for its hit test.
pub struct Point {
    pub i32 x;
    pub i32 y;
}

pub struct FRect {
    f32 x;
    f32 y;
    f32 w;
    f32 h;
}

// A C string (NUL-terminated) built from a `str`.
struct CString {
    mut u8[256] bytes;
}

extern "C" {
    bool SDL_Init(u32 flags) uses io;
    void SDL_Quit() uses io;
    Window* SDL_CreateWindow(u8* title, i32 w, i32 h, u64 flags) uses io;
    void SDL_DestroyWindow(Window* window) uses io;
    Renderer* SDL_CreateRenderer(Window* window, u8* name) uses io;
    void SDL_DestroyRenderer(Renderer* renderer) uses io;
    bool SDL_PollEvent(Event* event) uses io;
    bool SDL_PushEvent(Event* event) uses io;
    bool SDL_SetRenderDrawColor(Renderer* renderer, u8 r, u8 g, u8 b, u8 a) uses io;
    bool SDL_RenderClear(Renderer* renderer) uses io;
    bool SDL_RenderFillRect(Renderer* renderer, FRect* rect) uses io;
    bool SDL_RenderPresent(Renderer* renderer) uses io;
    void SDL_Delay(u32 ms) uses io;
    u64 SDL_GetTicks() uses io;
    Texture* SDL_CreateTexture(Renderer* renderer, u32 format, i32 access, i32 w, i32 h) uses io;
    void SDL_DestroyTexture(Texture* texture) uses io;
    bool SDL_UpdateTexture(Texture* texture, FRect* rect, u8* pixels, i32 pitch) uses io;
    bool SDL_RenderTexture(Renderer* renderer, Texture* texture, FRect* source, FRect* target) uses io;
    bool SDL_StartTextInput(Window* window) uses io;
    bool SDL_StopTextInput(Window* window) uses io;
    bool SDL_GetWindowSafeArea(Window* window, IntRect* rect) uses io;
    f32 SDL_GetWindowDisplayScale(Window* window) uses io;
    bool SDL_SetTextInputArea(Window* window, IntRect* rect, i32 cursor) uses io;
    u8* SDL_GetClipboardText() uses io;  // to free with SDL_free; "" when empty
    bool SDL_SetClipboardText(u8* text) uses io;
    void SDL_free(u8* memory) uses io;
    // SDL_HitTest: what is at a point of the window (an SDL_HitTestResult), asked by the system.
    bool SDL_SetWindowHitTest(Window* window, fn(Window*, Point*, u8*) -> i32 uses io callback, u8* data) uses io;
    bool SDL_SetWindowBordered(Window* window, bool bordered) uses io;
    bool SDL_MinimizeWindow(Window* window) uses io;
    bool SDL_MaximizeWindow(Window* window) uses io;
    bool SDL_RestoreWindow(Window* window) uses io;
    u64 SDL_GetWindowFlags(Window* window) uses io;
    bool SDL_GetWindowSize(Window* window, i32* w, i32* h) uses io;
    Surface* SDL_CreateSurfaceFrom(i32 w, i32 h, u32 format, u8* pixels, i32 pitch) uses io;
    void SDL_DestroySurface(Surface* surface) uses io;
    bool SDL_SetWindowIcon(Window* window, Surface* icon) uses io;
    Locale** SDL_GetPreferredLocales(i32* count) uses io;  // to free with SDL_free
    i32 SDL_GetSystemTheme() uses io;  // 0: unknown, 1: light, 2: dark
    // SDL_EventFilter: called as each event arrives, before the queue.
    bool SDL_AddEventWatch(fn(u8*, Event*) -> bool uses io filter, u8* data) uses io;
    void SDL_RemoveEventWatch(fn(u8*, Event*) -> bool uses io filter, u8* data) uses io;
}

// A copy of the C string `text` in `arena`, `limit` bytes at most; "" if it is not UTF-8.
unsafe str copy_cstring(Arena* arena, u8* text, usize limit) {
    mut usize length = 0;
    mut u8[] bytes = arena.alloc_slice(u8, 0);
    unsafe {
        while (length < limit && *(text + length) != 0) {
            length += 1;
        }
        bytes = arena.alloc_slice(u8, length);
        for (mut usize i = 0; i < length; i += 1) {
            bytes[i] = *(text + i);
        }
    }
    return match (str.from_bytes(bytes)) {
        ok(valid) => valid,
        err(e) => "",
    };
}

// The text of the clipboard, copied into `arena` (at most 64 KB), or "".
pub str clipboard_text(Arena* arena) uses io {
    unsafe {
        u8* text = SDL_GetClipboardText();
        if (text as u64 == 0) {
            return "";
        }
        str copy = copy_cstring(arena, text, 64 * KB);
        SDL_free(text);
        return copy;
    }
}

pub void set_clipboard_text(Arena* arena, str text) uses io {
    u8* c_text = text.to_cstr(arena);
    unsafe {
        SDL_SetClipboardText(c_text);
    }
}

pub Keyboard* as_keyboard(Event* event) {
    unsafe {
        return event as Keyboard*;
    }
}

// Asks for text input events: the typed characters, after the keyboard layout and the
// input methods. On a phone, this shows the virtual keyboard.
pub void start_text_input(Window* window) uses io {
    unsafe {
        SDL_StartTextInput(window);
    }
}

// The text of an SDL_EVENT_TEXT_INPUT, copied into `arena` (at most 255 bytes).
pub str text_of(Arena* arena, Event* event) {
    unsafe {
        return copy_cstring(arena, (event as TextInput*).text, 255);
    }
}

// The text being composed (SDL_EVENT_TEXT_EDITING), and its cursor in characters.
// A finger of a touch screen (SDL_EVENT_FINGER_*): its number, and its place in pixels of a window
// `w` by `h`.
pub i64 finger_of(Event* event) {
    unsafe {
        return (event as TouchFinger*).finger as i64;
    }
}

pub f32 finger_x(Event* event, i32 w) {
    unsafe {
        return (event as TouchFinger*).x * w as f32;
    }
}

pub f32 finger_y(Event* event, i32 h) {
    unsafe {
        return (event as TouchFinger*).y * h as f32;
    }
}

// The safe area of the window: what notches and bars of the system leave, as x, y, w, h.
pub i32[4] safe_area(Window* window) uses io {
    mut IntRect r = IntRect{ x: 0, y: 0, w: 0, h: 0 };
    unsafe {
        SDL_GetWindowSafeArea(window, &r);
    }
    return [r.x, r.y, r.w, r.h];
}

// The display scale of the window: 1 on most screens, 2 on dense ones.
pub f32 display_scale(Window* window) uses io {
    unsafe {
        return SDL_GetWindowDisplayScale(window);
    }
}

// The path of a file dropped on the window (SDL_EVENT_DROP_FILE), and where.
pub str dropped_path(Arena* arena, Event* event) {
    unsafe {
        return copy_cstring(arena, (event as Drop*).data, 4095);
    }
}

pub f32 drop_x(Event* event) {
    unsafe {
        return (event as Drop*).x;
    }
}

pub f32 drop_y(Event* event) {
    unsafe {
        return (event as Drop*).y;
    }
}

// The size of the area of a request of `push_area`.
pub i32 area_w(Event* event) {
    return event.rest[0] as i32 | event.rest[1] as i32 << 8;
}

pub i32 area_h(Event* event) {
    return event.rest[2] as i32 | event.rest[3] as i32 << 8;
}

pub str editing_text(Arena* arena, Event* event) {
    unsafe {
        return copy_cstring(arena, (event as TextEditing*).text, 255);
    }
}

pub i32 editing_cursor(Event* event) {
    unsafe {
        return (event as TextEditing*).start;
    }
}

// Where the text being typed is: the system shows the candidates of an input method next to it.
pub void set_text_input_area(Window* window, i32 x, i32 y, i32 w, i32 h) uses io {
    mut IntRect r = IntRect{ x: x, y: y, w: w, h: h };
    unsafe {
        SDL_SetTextInputArea(window, &r, 0);
    }
}

// Shows (`on`) or hides the keyboard of the system, on a touch screen.
pub void text_input(Window* window, bool on) uses io {
    unsafe {
        if (on) {
            SDL_StartTextInput(window);
        } else {
            SDL_StopTextInput(window);
        }
    }
}

// Queues a request with a rectangle: the area of the text being typed.
pub void push_area(i32 x, i32 y, i32 w, i32 h) uses io {
    mut u8[96] size = [0; 96];  // its width and height, in the first bytes after `word7`
    size[0] = (w & 0xFF) as u8;
    size[1] = (w >> 8 & 0xFF) as u8;
    size[2] = (h & 0xFF) as u8;
    size[3] = (h >> 8 & 0xFF) as u8;
    mut Event event = Event{ kind: 0x8000, reserved: 0, timestamp: 0, window: 0, word5: 3, word6: x as u32, word7: y as u32, rest: size };
    unsafe {
        SDL_PushEvent(&event);
    }
}

// The mouse events, read from the bytes of an SDL_Event.
pub MouseMotion* as_motion(Event* event) {
    unsafe {
        return event as MouseMotion*;
    }
}

pub MouseButton* as_button(Event* event) {
    unsafe {
        return event as MouseButton*;
    }
}

// SDL_MouseWheelEvent.
pub struct MouseWheel {
    u32 kind;
    u32 reserved;
    u64 timestamp;
    u32 window;
    u32 which;
    pub f32 x;  // steps to the right
    pub f32 y;  // steps away from the user
    pub u32 direction;  // 1: flipped (natural scrolling), the steps are the other way
}

pub MouseWheel* as_wheel(Event* event) {
    unsafe {
        return event as MouseWheel*;
    }
}

// A texture of `width * height` pixels 0xAARRGGBB that the program updates, or none.
pub Texture*? create_texture(Renderer* renderer, i32 width, i32 height) uses io {
    unsafe {
        // SDL_PIXELFORMAT_ARGB8888, SDL_TEXTUREACCESS_STREAMING
        Texture* texture = SDL_CreateTexture(renderer, 0x16362004, 1, width, height);
        if (texture as u64 == 0) {
            return none;
        }
        return some(texture);
    }
}

pub void destroy_texture(Texture* texture) uses io {
    unsafe {
        SDL_DestroyTexture(texture);
    }
}

// Copies `pixels` (`width` per row) into the texture, then draws it over the whole window.
pub void show_pixels(Renderer* renderer, Texture* texture, u32[] pixels, i32 width) uses io {
    if (pixels.len == 0) {
        return;
    }
    unsafe {
        SDL_UpdateTexture(texture, 0 as FRect*, &pixels[0] as u8*, width * 4);
        SDL_RenderTexture(renderer, texture, 0 as FRect*, 0 as FRect*);
    }
}

pub bool init_video() uses io {
    mut bool ok = false;
    unsafe {
        ok = SDL_Init(0x20);  // SDL_INIT_VIDEO
    }
    return ok;
}

pub void quit() uses io {
    unsafe {
        SDL_Quit();
    }
}

// A resizable window, or none if SDL cannot create it. Without `decorated`, the system draws
// no title bar and no border: the program draws its own.
pub Window*? create_window(Arena* arena, str title, i32 width, i32 height, bool decorated) uses io {
    CString* text = arena.alloc(CString);
    usize length = min(title.len, 255);
    for (mut usize i = 0; i < length; i += 1) {
        text.bytes[i] = title.bytes[i];
    }
    unsafe {
        // SDL_WINDOW_RESIZABLE, and SDL_WINDOW_BORDERLESS
        Window* window = SDL_CreateWindow(&text.bytes as u8*, width, height, decorated ? 0x20 : 0x30);
        if (window as u64 == 0) {
            return none;
        }
        return some(window);
    }
}

// Asks the system to call `callback` with `data` for each point of the window where the mouse
// acts (to drag it, to resize it). False when the system cannot.
pub bool set_hit_test(Window* window, fn(Window*, Point*, u8*) -> i32 uses io callback, u8* data) uses io {
    mut bool ok = false;
    unsafe {
        ok = SDL_SetWindowHitTest(window, callback, data);
    }
    return ok;
}

// Asks SDL to call `watch` with `data` on each event as it arrives, even while the system
// holds the loop of the program (a window resized on Windows).
pub void add_event_watch(fn(u8*, Event*) -> bool uses io watch, u8* data) uses io {
    unsafe {
        SDL_AddEventWatch(watch, data);
    }
}

pub void remove_event_watch(fn(u8*, Event*) -> bool uses io watch, u8* data) uses io {
    unsafe {
        SDL_RemoveEventWatch(watch, data);
    }
}

// Sets the icon of the window (the task bar, Alt+Tab, the title bar of the system) from
// `width * height` pixels 0xAARRGGBB. SDL copies them.
pub void set_icon(Window* window, u32[] pixels, i32 width, i32 height) uses io {
    if (pixels.len == 0) {
        return;
    }
    unsafe {
        // SDL_PIXELFORMAT_ARGB8888
        Surface* surface = SDL_CreateSurfaceFrom(width, height, 0x16362004, &pixels[0] as u8*, width * 4);
        if (surface as u64 != 0) {
            SDL_SetWindowIcon(window, surface);
            SDL_DestroySurface(surface);
        }
    }
}

// The languages the user prefers, the first one first, written `fr-FR` (or `fr`), in `arena`.
pub str[] preferred_locales(Arena* arena) uses io {
    mut str[] found = arena.alloc_slice(str, 0);
    mut i32 count = 0;
    unsafe {
        Locale** list = SDL_GetPreferredLocales(&count);
        if (list as u64 == 0) {
            return found;
        }
        found = arena.alloc_slice(str, count as usize);
        for (usize i in 0..count as usize) {
            Locale* l = *(list + i);
            str language = copy_cstring(arena, l.language, 16);
            str country = l.country as u64 == 0 ? "" : copy_cstring(arena, l.country, 16);
            found[i] = country.len == 0 ? language : joined(arena, language, country);
        }
        SDL_free(list as u8*);
    }
    return found;
}

// `language-country`, in `arena`.
str joined(Arena* arena, str language, str country) {
    mut u8[] bytes = arena.alloc_slice(u8, language.len + 1 + country.len);
    for (usize i in 0..language.len) {
        bytes[i] = language.bytes[i];
    }
    bytes[language.len] = 45;  // -
    for (usize i in 0..country.len) {
        bytes[language.len + 1 + i] = country.bytes[i];
    }
    return match (str.from_bytes(bytes)) {
        ok(text) => text,
        err(e) => language,
    };
}

// The theme the user chose for the system: 0 unknown, 1 light, 2 dark.
pub i32 system_theme() uses io {
    mut i32 theme = 0;
    unsafe {
        theme = SDL_GetSystemTheme();
    }
    return theme;
}

// Gives the window its title bar and borders back, or takes them away.
pub void set_decorated(Window* window, bool decorated) uses io {
    unsafe {
        SDL_SetWindowBordered(window, decorated);
    }
}

pub void minimize(Window* window) uses io {
    unsafe {
        SDL_MinimizeWindow(window);
    }
}

// Maximizes the window, or restores it when it is maximized.
pub void toggle_maximize(Window* window) uses io {
    bool maximized = is_maximized(window);
    unsafe {
        if (maximized) {
            SDL_RestoreWindow(window);
        } else {
            SDL_MaximizeWindow(window);
        }
    }
}

pub bool is_maximized(Window* window) uses io {
    mut u64 flags = 0;
    unsafe {
        flags = SDL_GetWindowFlags(window);
    }
    return flags & 0x80 != 0;  // SDL_WINDOW_MAXIMIZED
}

// The size of the window, in the coordinates of its events.
pub Point window_size(Window* window) uses io {
    mut i32 w = 0;
    mut i32 h = 0;
    unsafe {
        SDL_GetWindowSize(window, &w, &h);
    }
    return Point{ x: w, y: h };
}

pub void destroy_window(Window* window) uses io {
    unsafe {
        SDL_DestroyWindow(window);
    }
}

pub Renderer*? create_renderer(Window* window) uses io {
    unsafe {
        Renderer* renderer = SDL_CreateRenderer(window, 0 as u8*);
        if (renderer as u64 == 0) {
            return none;
        }
        return some(renderer);
    }
}

pub void destroy_renderer(Renderer* renderer) uses io {
    unsafe {
        SDL_DestroyRenderer(renderer);
    }
}

pub bool poll(Event* event) uses io {
    mut bool found = false;
    unsafe {
        found = SDL_PollEvent(event);
    }
    return found;
}

// Queues an SDL_EVENT_QUIT, as if the user had closed the window.
pub void push_quit() uses io {
    mut Event event = Event{ kind: 0x100, reserved: 0, timestamp: 0, window: 0, word5: 0, word6: 0, word7: 0, rest: [0; 96] };
    unsafe {
        SDL_PushEvent(&event);
    }
}

// Queues an SDL_EVENT_USER with `code`: a request of the program that `run` carries out on
// its window (SDL_UserEvent keeps its code where `word5` is).
pub void push_request(u32 code) uses io {
    mut Event event = Event{ kind: 0x8000, reserved: 0, timestamp: 0, window: 0, word5: code, word6: 0, word7: 0, rest: [0; 96] };
    unsafe {
        SDL_PushEvent(&event);
    }
}

pub void set_color(Renderer* renderer, u8 r, u8 g, u8 b, u8 a) uses io {
    unsafe {
        SDL_SetRenderDrawColor(renderer, r, g, b, a);
    }
}

pub void clear(Renderer* renderer) uses io {
    unsafe {
        SDL_RenderClear(renderer);
    }
}

pub void fill_rect(Renderer* renderer, f32 x, f32 y, f32 w, f32 h) uses io {
    mut FRect rect = FRect{ x: x, y: y, w: w, h: h };
    unsafe {
        SDL_RenderFillRect(renderer, &rect);
    }
}

pub void present(Renderer* renderer) uses io {
    unsafe {
        SDL_RenderPresent(renderer);
    }
}

pub void delay(u32 ms) uses io {
    unsafe {
        SDL_Delay(ms);
    }
}

// Milliseconds since SDL started.
pub u64 ticks() uses io {
    unsafe {
        return SDL_GetTicks();
    }
}
