// platform.sdl: the part of SDL3 that `platform` uses, declared by hand (spec §9).
// The C declarations stay private; the functions below wrap them in safe Sosu.

pub struct Window { }
pub struct Renderer { }

// SDL_Event: 128 bytes, read through the fields of the events `platform` handles.
pub struct Event {
    pub u32 kind;  // SDL_EventType
    u32 reserved;
    u64 timestamp;
    u32 window;
    pub u32 word5;  // window events: data1; keyboard events: keyboard id
    pub u32 word6;  // window events: data2; keyboard events: scancode
    pub u32 word7;  // keyboard events: key code
    u8[96] rest;
}

// SDL_MouseMotionEvent, the same 128 bytes seen differently.
pub struct MouseMotion {
    u32 kind;
    u32 reserved;
    u64 timestamp;
    u32 window;
    u32 which;
    u32 state;
    pub f32 x;
    pub f32 y;
    f32 xrel;
    f32 yrel;
}

// SDL_MouseButtonEvent.
pub struct MouseButton {
    u32 kind;
    u32 reserved;
    u64 timestamp;
    u32 window;
    u32 which;
    pub u8 button;  // 1: left, 2: middle, 3: right
    bool down;
    u8 clicks;
    u8 padding;
    pub f32 x;
    pub f32 y;
}

pub struct Texture { }

pub struct FRect {
    f32 x;
    f32 y;
    f32 w;
    f32 h;
}

// A C string (NUL-terminated) built from a `str`.
struct CString {
    mut u8[256] bytes;
}

extern "C" {
    bool SDL_Init(u32 flags) uses io;
    void SDL_Quit() uses io;
    Window* SDL_CreateWindow(u8* title, i32 w, i32 h, u64 flags) uses io;
    void SDL_DestroyWindow(Window* window) uses io;
    Renderer* SDL_CreateRenderer(Window* window, u8* name) uses io;
    void SDL_DestroyRenderer(Renderer* renderer) uses io;
    bool SDL_PollEvent(Event* event) uses io;
    bool SDL_PushEvent(Event* event) uses io;
    bool SDL_SetRenderDrawColor(Renderer* renderer, u8 r, u8 g, u8 b, u8 a) uses io;
    bool SDL_RenderClear(Renderer* renderer) uses io;
    bool SDL_RenderFillRect(Renderer* renderer, FRect* rect) uses io;
    bool SDL_RenderPresent(Renderer* renderer) uses io;
    void SDL_Delay(u32 ms) uses io;
    Texture* SDL_CreateTexture(Renderer* renderer, u32 format, i32 access, i32 w, i32 h) uses io;
    void SDL_DestroyTexture(Texture* texture) uses io;
    bool SDL_UpdateTexture(Texture* texture, FRect* rect, u8* pixels, i32 pitch) uses io;
    bool SDL_RenderTexture(Renderer* renderer, Texture* texture, FRect* source, FRect* target) uses io;
}

// The mouse events, read from the bytes of an SDL_Event.
pub MouseMotion* as_motion(Event* event) {
    unsafe {
        return event as MouseMotion*;
    }
}

pub MouseButton* as_button(Event* event) {
    unsafe {
        return event as MouseButton*;
    }
}

// A texture of `width * height` pixels 0xAARRGGBB that the program updates, or none.
pub Texture*? create_texture(Renderer* renderer, i32 width, i32 height) uses io {
    unsafe {
        // SDL_PIXELFORMAT_ARGB8888, SDL_TEXTUREACCESS_STREAMING
        Texture* texture = SDL_CreateTexture(renderer, 0x16362004, 1, width, height);
        if (texture as u64 == 0) {
            return none;
        }
        return some(texture);
    }
}

pub void destroy_texture(Texture* texture) uses io {
    unsafe {
        SDL_DestroyTexture(texture);
    }
}

// Copies `pixels` (`width` per row) into the texture, then draws it over the whole window.
pub void show_pixels(Renderer* renderer, Texture* texture, u32[] pixels, i32 width) uses io {
    if (pixels.len == 0) {
        return;
    }
    unsafe {
        SDL_UpdateTexture(texture, 0 as FRect*, &pixels[0] as u8*, width * 4);
        SDL_RenderTexture(renderer, texture, 0 as FRect*, 0 as FRect*);
    }
}

pub bool init_video() uses io {
    mut bool ok = false;
    unsafe {
        ok = SDL_Init(0x20);  // SDL_INIT_VIDEO
    }
    return ok;
}

pub void quit() uses io {
    unsafe {
        SDL_Quit();
    }
}

// A resizable window, or none if SDL cannot create it.
pub Window*? create_window(Arena* arena, str title, i32 width, i32 height) uses io {
    CString* text = arena.alloc(CString);
    usize length = min(title.len, 255);
    for (mut usize i = 0; i < length; i += 1) {
        text.bytes[i] = title.bytes[i];
    }
    unsafe {
        Window* window = SDL_CreateWindow(&text.bytes as u8*, width, height, 0x20);  // SDL_WINDOW_RESIZABLE
        if (window as u64 == 0) {
            return none;
        }
        return some(window);
    }
}

pub void destroy_window(Window* window) uses io {
    unsafe {
        SDL_DestroyWindow(window);
    }
}

pub Renderer*? create_renderer(Window* window) uses io {
    unsafe {
        Renderer* renderer = SDL_CreateRenderer(window, 0 as u8*);
        if (renderer as u64 == 0) {
            return none;
        }
        return some(renderer);
    }
}

pub void destroy_renderer(Renderer* renderer) uses io {
    unsafe {
        SDL_DestroyRenderer(renderer);
    }
}

pub bool poll(Event* event) uses io {
    mut bool found = false;
    unsafe {
        found = SDL_PollEvent(event);
    }
    return found;
}

// Queues an SDL_EVENT_QUIT, as if the user had closed the window.
pub void push_quit() uses io {
    mut Event event = Event{ kind: 0x100, reserved: 0, timestamp: 0, window: 0, word5: 0, word6: 0, word7: 0, rest: [0; 96] };
    unsafe {
        SDL_PushEvent(&event);
    }
}

pub void set_color(Renderer* renderer, u8 r, u8 g, u8 b, u8 a) uses io {
    unsafe {
        SDL_SetRenderDrawColor(renderer, r, g, b, a);
    }
}

pub void clear(Renderer* renderer) uses io {
    unsafe {
        SDL_RenderClear(renderer);
    }
}

pub void fill_rect(Renderer* renderer, f32 x, f32 y, f32 w, f32 h) uses io {
    mut FRect rect = FRect{ x: x, y: y, w: w, h: h };
    unsafe {
        SDL_RenderFillRect(renderer, &rect);
    }
}

pub void present(Renderer* renderer) uses io {
    unsafe {
        SDL_RenderPresent(renderer);
    }
}

pub void delay(u32 ms) uses io {
    unsafe {
        SDL_Delay(ms);
    }
}
