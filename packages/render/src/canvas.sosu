// render.canvas: a buffer of pixels and what draws in it: rectangles, lines, text, blending.
// Coordinates are in pixels, from the top left corner; what falls outside is clipped.
import render.font;
import image.image;
import image.png;
import render.truetype;

pub struct Color {
    pub ui8 r;
    pub ui8 g;
    pub ui8 b;
    pub ui8 a = 255;  // 0: transparent, 255: opaque
}

pub struct Rect {
    pub f32 x;
    pub f32 y;
    pub f32 w;
    pub f32 h;
}

// A rectangle of whole pixels, from (x0, y0) included to (x1, y1) excluded.
struct Clip {
    mut i32 x0 = 0;
    mut i32 y0 = 0;
    mut i32 x1 = 0;
    mut i32 y1 = 0;
}

// `width * height` pixels, row by row, each 0xAARRGGBB.
pub struct Canvas {
    pub i32 width;
    pub i32 height;
    pub ui32[] pixels;
    // Drawing stays inside `clip`: the whole canvas, or the rectangles pushed, intersected.
    mut Clip clip = Clip{ };
    mut Clip[16] saved = [Clip{ }; 16];
    mut usize depth = 0;

    // From now on, drawing stays inside `rect` too, until `pop_clip()`.
    pub void push_clip(Rect rect) {
        if (depth < 16) {
            saved[depth] = clip;
        }
        depth += 1;
        clip = Clip{ x0: max(clip.x0, clamp(rect.x, width)), y0: max(clip.y0, clamp(rect.y, height)), x1: min(clip.x1, clamp(rect.x + rect.w, width)), y1: min(clip.y1, clamp(rect.y + rect.h, height)) };
    }

    pub void pop_clip() {
        if (depth == 0) {
            return;
        }
        depth -= 1;
        clip = depth < 16 ? saved[depth] : clip;
    }

    // Fills the whole canvas, whatever the clip.
    pub void clear(Color color) {
        ui32 value = pack(color);
        for (mut usize i = 0; i < pixels.len; i += 1) {
            pixels[i] = value;
        }
    }

    // Fills a rectangle, blended with what is below when the color is not opaque.
    pub void fill(Rect rect, Color color) {
        i32 x0 = max(clamp(rect.x, width), clip.x0);
        i32 y0 = max(clamp(rect.y, height), clip.y0);
        i32 x1 = min(clamp(rect.x + rect.w, width), clip.x1);
        i32 y1 = min(clamp(rect.y + rect.h, height), clip.y1);
        for (mut i32 y = y0; y < y1; y += 1) {
            for (mut i32 x = x0; x < x1; x += 1) {
                blend(x, y, color);
            }
        }
    }

    // A disc of `radius` pixels around (cx, cy), its edge antialiased: each pixel is covered
    // by the part of its 4 by 4 samples inside the circle.
    pub void fill_circle(f32 cx, f32 cy, f32 radius, Color color) {
        i32 x0 = max(clamp(cx - radius, width), clip.x0);
        i32 y0 = max(clamp(cy - radius, height), clip.y0);
        i32 x1 = min(clamp(cx + radius + 1.0, width), clip.x1);
        i32 y1 = min(clamp(cy + radius + 1.0, height), clip.y1);
        f32 limit = radius * radius;
        for (mut i32 y = y0; y < y1; y += 1) {
            for (mut i32 x = x0; x < x1; x += 1) {
                mut ui32 inside = 0;
                for (mut i32 sy = 0; sy < 4; sy += 1) {
                    for (mut i32 sx = 0; sx < 4; sx += 1) {
                        f32 dx = x as f32 + (sx as f32 + 0.5) / 4.0 - cx;
                        f32 dy = y as f32 + (sy as f32 + 0.5) / 4.0 - cy;
                        inside += dx * dx + dy * dy <= limit ? 1 : 0;
                    }
                }
                if (inside > 0) {
                    blend(x, y, Color{ r: color.r, g: color.g, b: color.b, a: (color.a as ui32 * inside / 16) as ui8 });
                }
            }
        }
    }

    // A rectangle with corners rounded by `radius` pixels, antialiased: a pixel near a corner is
    // covered by the part of its 4 by 4 samples inside the shape. A radius of 0 is `fill`.
    pub void fill_rounded(Rect rect, f32 radius, Color color) {
        f32 r = max(min(radius, min(rect.w, rect.h) / 2.0), 0.0);
        if (r < 0.5) {
            fill(rect, color);
            return;
        }
        rounded(rect, r, 0.0, color);
    }

    // The border of a rounded rectangle, `thickness` pixels wide, inside it.
    pub void stroke_rounded(Rect rect, f32 radius, Color color, f32 thickness) {
        f32 r = max(min(radius, min(rect.w, rect.h) / 2.0), 0.0);
        if (r < 0.5) {
            stroke(rect, color, thickness);
            return;
        }
        rounded(rect, r, max(thickness, 0.0), color);
    }

    // The coverage of a rounded rectangle (`ring` > 0: only its border, that wide), blended.
    // Only the pixels near a corner, or cut by an edge, are sampled (16 samples each); the others
    // are inside or outside whole: the middle of a ring is skipped.
    void rounded(Rect rect, f32 r, f32 ring, Color color) {
        i32 x0 = max(clamp(rect.x, width), clip.x0);
        i32 y0 = max(clamp(rect.y, height), clip.y0);
        // up to the last column and row, which the right and bottom edges cut when they are fractional
        i32 x1 = min(clamp(rect.x + rect.w + 1.0, width), clip.x1);
        i32 y1 = min(clamp(rect.y + rect.h + 1.0, height), clip.y1);
        Rect hole = Rect{ x: rect.x + ring, y: rect.y + ring, w: rect.w - 2.0 * ring, h: rect.h - 2.0 * ring };
        f32 margin = max(r, ring) + 1.0;  // farther from the edges: no corner, no border
        for (mut i32 y = y0; y < y1; y += 1) {
            f32 cy = y as f32 + 0.5;
            f32 dy = min(cy - rect.y, rect.y + rect.h - cy);  // to the top or the bottom
            mut i32 x = x0;
            while (x < x1) {
                f32 cx = x as f32 + 0.5;
                f32 dx = min(cx - rect.x, rect.x + rect.w - cx);
                if (ring > 0.0 && dy > margin && dx > margin) {  // in the hole: to the right border
                    x = max(x + 1, (rect.x + rect.w - margin) as i32);
                    continue;
                }
                mut ui32 inside = 16;
                if (dx <= r + 1.0 && dy <= r + 1.0) {
                    inside = coverage(rect, r, ring, hole, x, y);  // near a corner
                } else {
                    f32 d = min(dx, dy);  // to the nearest straight edge
                    if (d < 0.5 || ring > 0.0 && d > ring - 0.5 && d < ring + 0.5) {
                        inside = coverage(rect, r, ring, hole, x, y);  // cut by an edge
                    } else if (ring > 0.0 && d >= ring + 0.5) {
                        inside = 0;
                    }
                }
                if (inside > 0) {
                    blend(x, y, Color{ r: color.r, g: color.g, b: color.b, a: (color.a as ui32 * inside / 16) as ui8 });
                }
                x += 1;
            }
        }
    }

    // How many of 16 samples of the pixel (x, y) are in the rounded rectangle, and out of its
    // `hole` for a ring.
    ui32 coverage(Rect rect, f32 r, f32 ring, Rect hole, i32 x, i32 y) {
        mut ui32 inside = 0;
        for (mut i32 sy = 0; sy < 4; sy += 1) {
            for (mut i32 sx = 0; sx < 4; sx += 1) {
                f32 px = x as f32 + (sx as f32 + 0.5) / 4.0;
                f32 py = y as f32 + (sy as f32 + 0.5) / 4.0;
                bool outer = in_rounded(rect, r, px, py);
                bool inner = ring > 0.0 && in_rounded(hole, max(r - ring, 0.0), px, py);
                inside += outer && !inner ? 1 : 0;
            }
        }
        return inside;
    }

    // The border of a rectangle, `thickness` pixels wide, inside the rectangle.
    pub void stroke(Rect rect, Color color, f32 thickness) {
        f32 t = min(thickness, min(rect.w, rect.h) / 2.0);
        fill(Rect{ x: rect.x, y: rect.y, w: rect.w, h: t }, color);
        fill(Rect{ x: rect.x, y: rect.y + rect.h - t, w: rect.w, h: t }, color);
        fill(Rect{ x: rect.x, y: rect.y + t, w: t, h: rect.h - 2.0 * t }, color);
        fill(Rect{ x: rect.x + rect.w - t, y: rect.y + t, w: t, h: rect.h - 2.0 * t }, color);
    }

    // A line one pixel wide, from (x0, y0) to (x1, y1) included (Bresenham).
    pub void line(i32 x0, i32 y0, i32 x1, i32 y1, Color color) {
        i32 dx = abs(x1 - x0);
        i32 dy = -abs(y1 - y0);
        i32 sx = x0 < x1 ? 1 : -1;
        i32 sy = y0 < y1 ? 1 : -1;
        mut i32 x = x0;
        mut i32 y = y0;
        mut i32 error = dx + dy;
        while (true) {
            blend(x, y, color);
            if (x == x1 && y == y1) {
                break;
            }
            i32 twice = 2 * error;
            if (twice >= dy) {
                error += dy;
                x += sx;
            }
            if (twice <= dx) {
                error += dx;
                y += sy;
            }
        }
    }

    // `text` in the built-in font, its top left corner at (x, y); each pixel of the font is a
    // square of `scale` pixels. `\n` starts a new line, `font.line_height()` lower.
    pub void text(f32 x, f32 y, str text, Color color, i32 scale) {
        i32 s = max(scale, 1);
        i32 step = font.size() * s;
        i32 left = x as i32;
        mut i32 pen_x = left;
        mut i32 pen_y = y as i32;
        for (char c in text.chars()) {
            if (c == '\n') {
                pen_x = left;
                pen_y += font.line_height() * s;
                continue;
            }
            ui64 glyph = font.glyph(c);
            for (mut i32 row = 0; row < 8; row += 1) {
                ui64 bits = glyph >> (row * 8) as ui64 & 0xFF;
                for (mut i32 col = 0; col < 8; col += 1) {
                    if (bits >> col as ui64 & 1 == 1) {
                        dot(pen_x + col * s, pen_y + row * s, s, color);
                    }
                }
            }
            pen_x += step;
        }
    }

    // `text` in a TrueType font of `size` pixels per em; (x, y) is the top left corner of its
    // first line. `\n` starts a new line, `font.line_height(size)` lower.
    pub void text_with(truetype.Font* face, f32 size, f32 x, f32 y, str text, Color color) {
        mut f32 pen = x;
        mut f32 baseline = y + face.ascent(size);
        mut ui32 previous = 0;  // the glyph before, for kerning (spec §10.10)
        mut truetype.Font* previous_font = face;
        for (char c in text.chars()) {
            if (c == '\n') {
                pen = x;
                baseline += face.line_height(size);
                previous = 0;
                continue;
            }
            truetype.Font* font = face.font_of(c);  // its fallback, for a character it lacks
            ui32 glyph = font.glyph_of(c);
            if (font == previous_font) {
                pen += font.kerning(previous, glyph, size);
            }
            previous = glyph;
            previous_font = font;
            truetype.GlyphImage* image = font.image(glyph, size);
            i32 left = (pen + 0.5) as i32 + image.left;
            i32 top = (baseline + 0.5) as i32 - image.top;
            for (mut i32 row = 0; row < image.height; row += 1) {
                for (mut i32 column = 0; column < image.width; column += 1) {
                    ui32 coverage = image.coverage[(row * image.width + column) as usize] as ui32;
                    if (coverage != 0) {
                        ui8 alpha = (color.a as ui32 * coverage / 255) as ui8;
                        blend(left + column, top + row, Color{ r: color.r, g: color.g, b: color.b, a: alpha });
                    }
                }
            }
            pen += font.advance(glyph, size);
        }
    }

    // The pixel at (x, y), or 0 outside the canvas.
    // `img` scaled into `rect`, blended with what is below. Each pixel of the canvas takes the
    // average of the pixels of the image it covers, weighted by their alpha, or the nearest one
    // when the image is enlarged.
    pub void draw_image(image.Image img, Rect rect) {
        if (img.width <= 0 || img.height <= 0 || rect.w <= 0.0 || rect.h <= 0.0) {
            return;
        }
        i32 x0 = max(clamp(rect.x, width), clip.x0);
        i32 y0 = max(clamp(rect.y, height), clip.y0);
        i32 x1 = min(clamp(rect.x + rect.w, width), clip.x1);
        i32 y1 = min(clamp(rect.y + rect.h, height), clip.y1);
        f32 sx = img.width as f32 / rect.w;
        f32 sy = img.height as f32 / rect.h;
        for (mut i32 y = y0; y < y1; y += 1) {
            i32 top = min(max(((y as f32 - rect.y) * sy) as i32, 0), img.height - 1);
            i32 bottom = min(max(((y as f32 + 1.0 - rect.y) * sy) as i32, top + 1), img.height);
            for (mut i32 x = x0; x < x1; x += 1) {
                i32 left = min(max(((x as f32 - rect.x) * sx) as i32, 0), img.width - 1);
                i32 right = min(max(((x as f32 + 1.0 - rect.x) * sx) as i32, left + 1), img.width);
                mut ui64 n = 0;
                mut ui64 a = 0;
                mut ui64 r = 0;
                mut ui64 g = 0;
                mut ui64 b = 0;
                for (i32 iy in top..bottom) {
                    for (i32 ix in left..right) {
                        ui32 p = img.at(ix, iy);
                        ui64 alpha = (p >> 24) as ui64;
                        n += 1;
                        a += alpha;
                        r += (p >> 16 & 0xFF) as ui64 * alpha;
                        g += (p >> 8 & 0xFF) as ui64 * alpha;
                        b += (p & 0xFF) as ui64 * alpha;
                    }
                }
                if (a > 0) {
                    blend(x, y, Color{ r: (r / a) as ui8, g: (g / a) as ui8, b: (b / a) as ui8, a: (a / n) as ui8 });
                }
            }
        }
    }

    pub ui32 at(i32 x, i32 y) {
        if (x < 0 || y < 0 || x >= width || y >= height) {
            return 0;
        }
        return pixels[(y * width + x) as usize];
    }

    // What the canvas holds, as an image (its pixels, not a copy): to write it with `image.png`,
    // or transform it with `image.ops`.
    pub image.Image image() {
        return image.Image{ width: width, height: height, pixels: pixels };
    }

    // A square of `size` pixels.
    void dot(i32 x, i32 y, i32 size, Color color) {
        for (mut i32 dy = 0; dy < size; dy += 1) {
            for (mut i32 dx = 0; dx < size; dx += 1) {
                blend(x + dx, y + dy, color);
            }
        }
    }

    void blend(i32 x, i32 y, Color color) {
        if (x < clip.x0 || y < clip.y0 || x >= clip.x1 || y >= clip.y1 || color.a == 0) {
            return;
        }
        usize i = (y * width + x) as usize;
        if (color.a == 255) {
            pixels[i] = pack(color);
            return;
        }
        ui32 below = pixels[i];
        ui32 a = color.a as ui32;
        ui32 r = mix(color.r as ui32, below >> 16 & 0xFF, a);
        ui32 g = mix(color.g as ui32, below >> 8 & 0xFF, a);
        ui32 b = mix(color.b as ui32, below & 0xFF, a);
        pixels[i] = 0xFF000000 | r << 16 | g << 8 | b;
    }
}

// The size of `text` drawn by `Canvas.text`: its longest line, and its number of lines.
// Whether (x, y) is inside `rect` with its corners rounded by `r`.
bool in_rounded(Rect rect, f32 r, f32 x, f32 y) {
    if (rect.w <= 0.0 || rect.h <= 0.0 || x < rect.x || y < rect.y || x >= rect.x + rect.w || y >= rect.y + rect.h) {
        return false;
    }
    f32 cx = x < rect.x + r ? rect.x + r : x > rect.x + rect.w - r ? rect.x + rect.w - r : x;
    f32 cy = y < rect.y + r ? rect.y + r : y > rect.y + rect.h - r ? rect.y + rect.h - r : y;
    f32 dx = x - cx;
    f32 dy = y - cy;
    return dx * dx + dy * dy <= r * r;
}

pub Rect text_size(str text, i32 scale) {
    i32 step = font.size() * max(scale, 1);
    mut i32 widest = 0;
    mut i32 column = 0;
    mut i32 lines = 1;
    for (char c in text.chars()) {
        if (c == '\n') {
            lines += 1;
            column = 0;
        } else {
            column += 1;
            widest = max(widest, column);
        }
    }
    return Rect{ x: 0.0, y: 0.0, w: (widest * step) as f32, h: (font.size() + (lines - 1) * font.line_height()) as f32 * max(scale, 1) as f32 };
}

// A canvas of `width * height` pixels in `arena`, transparent black.
pub Canvas create(Arena* arena, i32 width, i32 height) {
    i32 w = max(width, 0);
    i32 h = max(height, 0);
    assert(h == 0 || w <= 2147483647 / h);  // pixel indexes (`at`, `set`) are `y * width + x` in i32
    usize count = (w * h) as usize;
    Clip all = Clip{ x0: 0, y0: 0, x1: max(width, 0), y1: max(height, 0) };
    return Canvas{ width: max(width, 0), height: max(height, 0), pixels: arena.alloc_slice(ui32, count), clip: all };
}

pub ui32 pack(Color color) {
    return color.a as ui32 << 24 | color.r as ui32 << 16 | color.g as ui32 << 8 | color.b as ui32;
}

// `over` drawn with opacity `a` (0 to 255) on `below`, rounded.
ui32 mix(ui32 over, ui32 below, ui32 a) {
    return (over * a + below * (255 - a) + 127) / 255;
}

// A coordinate in [0, limit], rounded down.
i32 clamp(f32 value, i32 limit) {
    if (value <= 0.0) {
        return 0;
    }
    if (value >= limit as f32) {
        return limit;
    }
    return value as i32;
}

test "clear and fill" {
    mut Arena arena = Arena.new(4 * KB);
    defer arena.free();
    Canvas c = create(&arena, 4, 3);
    c.clear(Color{ r: 0, g: 0, b: 0 });
    c.fill(Rect{ x: 1.0, y: 1.0, w: 2.0, h: 5.0 }, Color{ r: 255, g: 0, b: 0 });
    assert(c.at(0, 0) == 0xFF000000);
    assert(c.at(1, 1) == 0xFFFF0000);
    assert(c.at(2, 2) == 0xFFFF0000);
    assert(c.at(3, 2) == 0xFF000000);
    assert(c.at(1, 5) == 0);  // outside
}

test "fill is clipped" {
    mut Arena arena = Arena.new(4 * KB);
    defer arena.free();
    Canvas c = create(&arena, 3, 3);
    c.fill(Rect{ x: -10.0, y: -10.0, w: 100.0, h: 11.0 }, Color{ r: 0, g: 0, b: 255 });
    assert(c.at(0, 0) == 0xFF0000FF);
    assert(c.at(2, 0) == 0xFF0000FF);
    assert(c.at(0, 1) == 0);
    c.fill(Rect{ x: 5.0, y: 5.0, w: 1.0, h: 1.0 }, Color{ r: 0, g: 0, b: 255 });
}

test "blending" {
    mut Arena arena = Arena.new(4 * KB);
    defer arena.free();
    Canvas c = create(&arena, 1, 1);
    c.clear(Color{ r: 0, g: 0, b: 200 });
    c.fill(Rect{ x: 0.0, y: 0.0, w: 1.0, h: 1.0 }, Color{ r: 255, g: 255, b: 0, a: 128 });
    assert(c.at(0, 0) == 0xFF808064);
    c.fill(Rect{ x: 0.0, y: 0.0, w: 1.0, h: 1.0 }, Color{ r: 255, g: 255, b: 255, a: 0 });
    assert(c.at(0, 0) == 0xFF808064);
}

test "lines and strokes" {
    mut Arena arena = Arena.new(4 * KB);
    defer arena.free();
    Canvas c = create(&arena, 5, 5);
    Color white = Color{ r: 255, g: 255, b: 255 };
    c.line(0, 0, 4, 4, white);
    assert(c.at(0, 0) == 0xFFFFFFFF && c.at(2, 2) == 0xFFFFFFFF && c.at(4, 4) == 0xFFFFFFFF);
    assert(c.at(1, 0) == 0);
    c.line(4, 0, -20, 0, white);  // clipped
    assert(c.at(0, 0) == 0xFFFFFFFF && c.at(3, 0) == 0xFFFFFFFF);
    c.clear(Color{ r: 0, g: 0, b: 0, a: 0 });
    c.stroke(Rect{ x: 0.0, y: 0.0, w: 5.0, h: 5.0 }, white, 1.0);
    assert(c.at(0, 2) == 0xFFFFFFFF && c.at(4, 2) == 0xFFFFFFFF && c.at(2, 4) == 0xFFFFFFFF);
    assert(c.at(2, 2) == 0);
}

test "text" {
    mut Arena arena = Arena.new(16 * KB);
    defer arena.free();
    Canvas c = create(&arena, 40, 20);
    Color white = Color{ r: 255, g: 255, b: 255 };
    c.text(0.0, 0.0, "A\nA", white, 1);
    // `A`: rows 0x0C, 0x1E, 0x33...: the top row has pixels 2 and 3
    assert(c.at(2, 0) == 0xFFFFFFFF && c.at(3, 0) == 0xFFFFFFFF);
    assert(c.at(1, 0) == 0 && c.at(4, 0) == 0);
    assert(c.at(0, 2) == 0xFFFFFFFF && c.at(5, 2) == 0xFFFFFFFF && c.at(2, 2) == 0);
    assert(c.at(2, 10) == 0xFFFFFFFF && c.at(2, 8) == 0);  // second line, 2 rows lower
    assert(c.at(0, 7) == 0);  // the last row of `A` is empty

    c.clear(Color{ r: 0, g: 0, b: 0, a: 0 });
    c.text(10.0, 0.0, "A", white, 2);
    assert(c.at(14, 0) == 0xFFFFFFFF && c.at(17, 1) == 0xFFFFFFFF);
    assert(c.at(13, 0) == 0 && c.at(18, 0) == 0);

    c.clear(Color{ r: 0, g: 0, b: 0, a: 0 });
    c.text(0.0, 0.0, "\u{3b1}", white, 1);  // neither ASCII nor Latin (spec §10.9): a box
    assert(c.at(1, 1) == 0xFFFFFFFF && c.at(6, 1) == 0xFFFFFFFF && c.at(3, 3) == 0);
    c.text(35.0, 15.0, "clipped", white, 3);
}

test "text size" {
    Rect size = text_size("ab\nabc", 2);
    assert(size.w == 48.0 && size.h == 36.0);
    Rect empty = text_size("", 1);
    assert(empty.w == 0.0 && empty.h == 8.0);
}

test "clipping" {
    mut Arena arena = Arena.new(4 * KB);
    defer arena.free();
    mut Canvas c = create(&arena, 10, 10);
    Color red = Color{ r: 255, g: 0, b: 0 };
    c.push_clip(Rect{ x: 2.0, y: 2.0, w: 4.0, h: 4.0 });
    c.fill(Rect{ x: 0.0, y: 0.0, w: 10.0, h: 10.0 }, red);
    assert(c.at(2, 2) == 0xFFFF0000 && c.at(5, 5) == 0xFFFF0000);
    assert(c.at(1, 2) == 0 && c.at(6, 5) == 0 && c.at(5, 6) == 0);
    c.push_clip(Rect{ x: 4.0, y: 0.0, w: 10.0, h: 10.0 });  // intersected: x 4 to 6
    c.line(0, 3, 9, 3, Color{ r: 0, g: 0, b: 255 });
    assert(c.at(3, 3) == 0xFFFF0000 && c.at(4, 3) == 0xFF0000FF && c.at(6, 3) == 0);
    c.pop_clip();
    c.text(0.0, 0.0, "AAAA", Color{ r: 0, g: 255, b: 0 }, 1);  // only inside 2 to 6
    assert(c.at(0, 2) == 0);
    c.pop_clip();
    c.pop_clip();  // nothing pushed: ignored
    c.fill(Rect{ x: 8.0, y: 8.0, w: 1.0, h: 1.0 }, red);
    assert(c.at(8, 8) == 0xFFFF0000);
}

test "discs" {
    mut Arena arena = Arena.new(4 * KB);
    defer arena.free();
    mut Canvas c = create(&arena, 20, 20);
    c.fill_circle(10.0, 10.0, 5.0, Color{ r: 255, g: 255, b: 255 });
    assert(c.at(10, 10) == 0xFFFFFFFF && c.at(7, 10) == 0xFFFFFFFF);  // inside
    assert(c.at(2, 2) == 0 && c.at(16, 10) == 0);  // outside
    ui32 edge = c.at(13, 13) & 0xFF;  // across the circle: partly covered
    assert(edge > 0 && edge < 255);
}

test "images are drawn scaled, with their alpha" {
    mut Arena arena = Arena.new(16 * KB);
    defer arena.free();
    mut Canvas c = create(&arena, 20, 20);
    c.clear(Color{ r: 0, g: 0, b: 0 });
    // 4 by 4: the left half opaque red, the right half transparent
    mut ui32[] pixels = arena.alloc_slice(ui32, 16);
    for (usize i in 0..16) {
        pixels[i] = i % 4 < 2 ? 0xFFFF0000 : 0x00FFFFFF;
    }
    image.Image img = image.Image{ width: 4, height: 4, pixels: pixels };
    c.draw_image(img, Rect{ x: 2.0, y: 2.0, w: 8.0, h: 8.0 });  // enlarged twice
    assert(c.at(2, 2) == 0xFFFF0000 && c.at(5, 9) == 0xFFFF0000);
    assert(c.at(6, 2) == 0xFF000000 && c.at(10, 2) == 0xFF000000);  // transparent, then outside
    c.draw_image(img, Rect{ x: 12.0, y: 12.0, w: 2.0, h: 2.0 });  // reduced: 2 by 2 per pixel
    assert(c.at(12, 12) == 0xFFFF0000 && c.at(13, 12) == 0xFF000000);
    c.draw_image(img, Rect{ x: 16.0, y: 16.0, w: 1.0, h: 1.0 });  // red, half covered
    ui32 half = c.at(16, 16);
    assert(half >> 16 & 0xFF > 120 && half >> 16 & 0xFF < 135 && half & 0xFFFF == 0);
    c.push_clip(Rect{ x: 0.0, y: 0.0, w: 3.0, h: 20.0 });
    c.clear(Color{ r: 0, g: 0, b: 0 });
    c.draw_image(img, Rect{ x: 2.0, y: 2.0, w: 8.0, h: 8.0 });
    assert(c.at(2, 2) == 0xFFFF0000 && c.at(3, 2) == 0xFF000000);  // clipped
}

test "rounded rectangles" {
    mut Arena arena = Arena.new(16 * KB);
    defer arena.free();
    mut Canvas c = create(&arena, 40, 40);
    c.fill_rounded(Rect{ x: 0.0, y: 0.0, w: 40.0, h: 20.0 }, 8.0, Color{ r: 255, g: 255, b: 255 });
    assert(c.at(0, 0) == 0 && c.at(20, 10) == 0xFFFFFFFF && c.at(20, 0) == 0xFFFFFFFF);  // the corner left out
    assert(c.at(1, 1) >> 24 < 255 && c.at(4, 4) == 0xFFFFFFFF);
    c.stroke_rounded(Rect{ x: 0.0, y: 20.0, w: 40.0, h: 20.0 }, 6.0, Color{ r: 255, g: 0, b: 0 }, 2.0);
    assert(c.at(20, 20) == 0xFFFF0000 && c.at(20, 30) == 0 && c.at(0, 30) == 0xFFFF0000);
    c.fill_rounded(Rect{ x: 30.0, y: 0.0, w: 10.0, h: 10.0 }, 0.0, Color{ r: 0, g: 0, b: 255 });  // radius 0: square
    assert(c.at(39, 0) == 0xFF0000FF);
}

test "rounded rectangles: the pixels sampled alone are those of every pixel sampled" {
    mut Arena arena = Arena.new(512 * KB);
    defer arena.free();
    mut Rect[5] rects = [Rect{ x: 3.0, y: 2.0, w: 50.0, h: 30.0 }; 5];
    rects[1] = Rect{ x: 2.3, y: 1.6, w: 57.4, h: 41.7 };
    rects[2] = Rect{ x: 5.5, y: 4.25, w: 20.0, h: 52.5 };
    rects[3] = Rect{ x: 0.0, y: 0.0, w: 64.0, h: 64.0 };
    rects[4] = Rect{ x: 10.7, y: 9.2, w: 8.6, h: 7.3 };
    mut f32[4] radii = [0.6, 4.0, 9.5, 30.0];
    mut f32[4] rings = [0.0, 1.0, 2.5, 6.0];
    Color color = Color{ r: 200, g: 120, b: 40, a: 200 };
    for (usize i in 0..5) {
        for (usize k in 0..4) {
            for (usize m in 0..4) {
                Rect rect = rects[i];
                f32 r = max(min(radii[k], min(rect.w, rect.h) / 2.0), 0.0);
                f32 ring = rings[m];
                mut Canvas fast = create(&arena, 64, 64);
                mut Canvas every = create(&arena, 64, 64);
                fast.rounded(rect, r, ring, color);
                Rect hole = Rect{ x: rect.x + ring, y: rect.y + ring, w: rect.w - 2.0 * ring, h: rect.h - 2.0 * ring };
                for (mut i32 y = 0; y < 64; y += 1) {
                    for (mut i32 x = 0; x < 64; x += 1) {
                        ui32 inside = every.coverage(rect, r, ring, hole, x, y);
                        if (inside > 0) {
                            every.blend(x, y, Color{ r: color.r, g: color.g, b: color.b, a: (color.a as ui32 * inside / 16) as ui8 });
                        }
                    }
                }
                for (usize p in 0..64 * 64) {
                    assert(fast.pixels[p] == every.pixels[p]);
                }
            }
        }
    }
}

test "a canvas written as a PNG file is read back" {
    mut Arena arena = Arena.new(64 * KB);
    defer arena.free();
    mut Canvas c = create(&arena, 5, 3);
    c.clear(Color{ r: 10, g: 20, b: 30 });
    c.fill(Rect{ x: 1.0, y: 1.0, w: 2.0, h: 1.0 }, Color{ r: 255, g: 0, b: 7, a: 128 });
    ui8[] file = png.encode(&arena, c.image());
    match (png.decode(&arena, file)) {
        ok(img) => {
            assert(img.width == 5 && img.height == 3);
            for (i32 y in 0..3) {
                for (i32 x in 0..5) {
                    assert(img.at(x, y) == c.at(x, y));
                }
            }
        },
        err(e) => {
            assert(false);
        },
    }
}
