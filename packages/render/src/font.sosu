        73,
        6,
        0,
        0,
        74,
        106,
        75,
        107,
        107,
        76,
        108,
        76,
        108,
        76,
        108,
        76,
        108,
        76,
        108,
        78,
        110,
        78,
        110,
        78,
        110,
        0,
        78,
        110,
        79,
        111,
        79,
        111,
        79,
        111,
        7,
        8,
        82,
        114,
        82,
        114,
        82,
        114,
        83,
        115,
        83,
        115,
        83,
        115,
        83,
        115,
        84,
        116,
        84,
        116,
        84,
        116,
        85,
        117,
        85,
        117,
        85,
        117,
        85,
        117,
        85,
        117,
        85,
        117,
        87,
        119,
        89,
        121,
        89,
        90,
        122,
        90,
        122,
        90,
        122,
        0,
    ];
    u8[192] marks = [
        1,
        2,
        3,
        4,
        5,
        6,
        16,
        7,
        1,
        2,
        3,
        5,
        1,
        2,
