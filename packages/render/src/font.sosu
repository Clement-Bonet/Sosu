        8,
        11,
        11,
        14,
        14,
        2,
        2,
        7,
        7,
        8,
        8,
        0,
        0,
        0,
        9,
        9,
        10,
        10,
        13,
        13,
        16,
        16,
        2,
        2,
        7,
        7,
        8,
        8,
        2,
        2,
        3,
        3,
        7,
        7,
        8,
        8,
        7,
        7,
        8,
        8,
        15,
        15,
        4,
        4,
        9,
        9,
        10,
        10,
        6,
        6,
        13,
        13,
        12,
        12,
        3,
        3,
        3,
        3,
        5,
        2,
        2,
        11,
        11,
        8,
        8,
        0,
    ];
    usize index = (code - 0xC0) as usize;
    u8 letter_of = bases[index];
    u8 mark = marks[index];
    if (mark == 16) {  // a letter of its own: Æ Þ ß æ ð þ ı Œ œ
        mut u64[9] own = [0; 9];
        own[0] = 0x007616163F16167C;  // Æ
        own[1] = 0x0003031F33331F03;  // Þ
        own[2] = 0x031B33331B331E00;  // ß
        own[3] = 0x00760B7E48760000;  // æ
        own[4] = 0x001E3333333E180C;  // ð
        own[5] = 0x03031F33331F0300;  // þ
        own[6] = 0x001E0C0C0C0E0000;  // ı
        own[7] = 0x007E09093909097E;  // Œ
        own[8] = 0x0076097949360000;  // œ
        return own[letter_of as usize];
    }
    if (letter_of == 0) {
        return 0x007E424242427E00;  // a box
    }
    mut u64 letter = glyph(letter_of as char);
    bool capital = letter_of >= 65 && letter_of <= 90;
    bool below = mark == 7 || mark == 12;  // cedilla, ogonek
    bool above = mark != 0 && !below && mark < 14;
    if (letter_of == 105 || letter_of == 106) {  // i and j lose their dot under a mark
        letter = letter & 0xFFFFFFFFFFFF0000;
    }
    if (capital && above) {
        letter = letter << 8;  // a row lower: the mark goes in the top row
    }
    // the marks above: a lower case letter has two free rows, a capital one
    mut u64[14] high = [0; 14];
    high[1] = 0x0804;  // grave
    high[2] = 0x0810;  // acute
    high[3] = 0x1408;  // circumflex
    high[4] = 0x0D16;  // tilde
    high[5] = 0x3600;  // diaeresis
    high[6] = 0x1C14;  // ring
    high[8] = 0x0814;  // caron
    high[9] = 0x1E00;  // macron
    high[10] = 0x1C22;  // breve
    high[11] = 0x0C00;  // dot
    high[13] = 0x2412;  // double acute
    mut u64[14] top = [0; 14];
    top[1] = 0x0C;
    top[2] = 0x18;
    top[3] = 0x1C;
    top[4] = 0x1E;
    top[5] = 0x36;
    top[6] = 0x1C;
    top[8] = 0x1C;
    top[9] = 0x1E;
    top[10] = 0x22;
    top[11] = 0x0C;
    top[13] = 0x36;
    if (above) {
        return letter | (capital ? top[mark as usize] : high[mark as usize]);
    }
    if (mark == 7) {  // cedilla
        return letter | 0x1800000000000000;
    }
    if (mark == 12) {  // ogonek
        return letter | 0x3000000000000000;
    }
    if (mark == 14) {  // stroke: across o, O, l and L
        return letter | (letter_of == 108 || letter_of == 76 ? 0x0000000804100000 : 0x0002040810204000);
    }
    if (mark == 15) {  // bar: D, d, H, h, T, t
        return letter | (letter_of == 68 ? 0x0000000007000000 : capital ? 0x00000000007F0000 : 0x0000000000007800);
    }
    return letter;
}

test "accented letters: their base letter and a mark" {
    // é: e, and an acute in its two free rows; É: E a row lower, its acute in the top row
    assert(glyph('\u{e9}') & 0xFFFFFFFFFFFF0000 == glyph('e') && glyph('\u{e9}') & 0xFFFF == 0x0810);
    assert(glyph('\u{c9}') >> 8 == glyph('E') & 0x00FFFFFFFFFFFFFF && glyph('\u{c9}') & 0xFF == 0x18);
    // ç: c and a cedilla below; ï: i without its dot, and a diaeresis
    assert(glyph('\u{e7}') == glyph('c') | 0x1800000000000000);
    assert(glyph('\u{ef}') & 0xFFFF == 0x3600);
    // ß, Ł, ő; a Greek letter: a box
    assert(glyph('\u{df}') == 0x031B33331B331E00);
    assert(glyph('\u{141}') != glyph('L') && glyph('\u{151}') != glyph('o'));
    assert(glyph('\u{3b1}') == 0x007E424242427E00);
}
