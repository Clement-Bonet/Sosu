// render.image: PNG images, read in Sosu (spec §10.4), for window icons and the `Image`
// widget. The compressed data is inflated by `compress.zlib` (its Adler-32 checked), its rows
// unfiltered, and its pixels made 0xAARRGGBB, whatever their kind: gray, RGB, palette, with or
// without alpha, 1 to 16 bits, interlaced or not. Every read is checked: a damaged file gives
// `Damaged`, never a read outside of its bytes. The CRC of the chunks is not verified.
import std.io;
import compress.zlib;
import compress.checksum;

pub enum ImageError {
    Unreadable,  // the file cannot be read
    NotPng,  // not a PNG file
    Damaged,  // a PNG file, but damaged, or of a kind that does not exist
}

// `width * height` pixels, row by row, each 0xAARRGGBB (alpha not premultiplied).
pub struct Image {
    pub i32 width;
    pub i32 height;
    pub ui32[] pixels;

    // The pixel at (x, y), or 0 (transparent) outside of the image.
    pub ui32 at(i32 x, i32 y) {
        if (x < 0 || y < 0 || x >= width || y >= height) {
            return 0;
        }
        return pixels[(y * width + x) as usize];
    }
}

// ---- PNG: chunks, filters, interlacing and pixels ----

ui32 u32_at(ui8[] data, usize at) {
    if (at + 4 > data.len) {
        return 0;
    }
    return data[at] as ui32 << 24 | data[at + 1] as ui32 << 16 | data[at + 2] as ui32 << 8 | data[at + 3] as ui32;
}

bool is_tag(ui8[] data, usize at, str tag) {
    if (at + 4 > data.len) {
        return false;
    }
    for (usize i in 0..4) {
        if (data[at + i] != tag.bytes[i]) {
            return false;
        }
    }
    return true;
}

// What the header of a PNG file says about its pixels.
struct Header {
    ui32 width;
    ui32 height;
    ui32 depth;  // bits per sample: 1, 2, 4, 8 or 16
    ui32 color;  // 0 gray, 2 RGB, 3 palette, 4 gray and alpha, 6 RGB and alpha
    bool interlaced;

    ui32 channels() {
        return color == 2 ? 3 : color == 4 ? 2 : color == 6 ? 4 : 1;
    }

    // Bits per pixel, and bytes per pixel for the filters (at least 1).
    ui32 pixel_bits() {
        return channels() * depth;
    }

    usize filter_step() {
        return max((pixel_bits() / 8) as usize, 1);
    }

    // The bytes of a row of `w` pixels, its filter byte included.
    usize row_bytes(ui32 w) {
        return ((w as ui64 * pixel_bits() as ui64 + 7) / 8) as usize + 1;
    }

    bool valid() {
        bool small = depth == 1 || depth == 2 || depth == 4;  // gray and palette only
        bool depth_ok = depth == 8 || depth == 16 && color != 3 || small && (color == 0 || color == 3);
        return depth_ok && (color == 0 || color == 2 || color == 3 || color == 4 || color == 6);
    }
}

// The 7 passes of Adam7: where each starts and how far apart its pixels are.
ui32[7] pass_x() {
    return [0, 4, 0, 2, 0, 1, 0];
}

ui32[7] pass_y() {
    return [0, 0, 4, 0, 2, 0, 1];
}

ui32[7] pass_dx() {
    return [8, 8, 4, 4, 2, 2, 1];
}

ui32[7] pass_dy() {
    return [8, 8, 8, 4, 4, 2, 2];
}

// The size of a pass of an image `size` pixels wide (or high).
ui32 pass_size(ui32 size, ui32 start, ui32 step) {
    return size > start ? (size - start + step - 1) / step : 0;
}

i32 paeth(i32 a, i32 b, i32 c) {
    i32 p = a + b - c;
    i32 pa = abs(p - a);
    i32 pb = abs(p - b);
    i32 pc = abs(p - c);
    return pa <= pb && pa <= pc ? a : pb <= pc ? b : c;
}

// Undoes the filters of `rows` rows of `stride` bytes (the filter byte first) at `data`.
bool unfilter(ui8[] data, usize rows, usize stride, usize step) {
    for (usize y in 0..rows) {
        usize row = y * stride;
        ui8 kind = data[row];
        for (usize i in 1..stride) {
            i32 a = i > step ? data[row + i - step] as i32 : 0;
            i32 b = y > 0 ? data[row - stride + i] as i32 : 0;
            i32 c = y > 0 && i > step ? data[row - stride + i - step] as i32 : 0;
            i32 x = data[row + i] as i32;
            i32 value = kind == 0 ? x : kind == 1 ? x + a : kind == 2 ? x + b : kind == 3 ? x + (a + b) / 2 : kind == 4 ? x + paeth(a, b, c) : -1;
            if (value < 0) {
                return false;
            }
            data[row + i] = (value & 0xFF) as ui8;
        }
    }
    return true;
}

// The sample `index` of a row of samples of `depth` bits (16 bits: the whole value).
ui32 sample(ui8[] data, usize row, ui32 index, ui32 depth) {
    if (depth == 16) {
        usize at = row + 2 * index as usize;
        return data[at] as ui32 << 8 | data[at + 1] as ui32;
    }
    if (depth == 8) {
        return data[row + index as usize] as ui32;
    }
    ui32 bit = index * depth;
    ui32 b = data[row + (bit / 8) as usize] as ui32;
    return b >> 8 - depth - bit % 8 & (1 << depth) - 1;
}

// A sample of `depth` bits brought to 8 bits.
ui32 to8(ui32 value, ui32 depth) {
    return depth == 16 ? value >> 8 : value * 255 / ((1 << depth) - 1);
}

// What the pixels need besides their samples: the palette and the transparency (`tRNS`).
struct Extras {
    mut ui32[256] palette = [0xFF000000; 256];
    mut bool keyed = false;  // a gray or RGB value is transparent
    mut ui32[3] key = [0; 3];
}

// The pixel `x` of a row that starts at `row` (after its filter byte).
ui32 pixel(Header h, Extras* e, ui8[] data, usize row, ui32 x) {
    ui32 n = h.channels();
    ui32 d = h.depth;
    if (h.color == 3) {
        return e.palette[sample(data, row, x, d) as usize];
    }
    if (h.color == 0 || h.color == 4) {
        ui32 raw = sample(data, row, x * n, d);
        ui32 v = to8(raw, d);
        ui32 a = h.color == 4 ? to8(sample(data, row, x * n + 1, d), d) : e.keyed && raw == e.key[0] ? 0 : 255;
        return a << 24 | v << 16 | v << 8 | v;
    }
    ui32 r = sample(data, row, x * n, d);
    ui32 g = sample(data, row, x * n + 1, d);
    ui32 b = sample(data, row, x * n + 2, d);
    ui32 a = h.color == 6 ? to8(sample(data, row, x * n + 3, d), d) : e.keyed && r == e.key[0] && g == e.key[1] && b == e.key[2] ? 0 : 255;
    return a << 24 | to8(r, d) << 16 | to8(g, d) << 8 | to8(b, d);
}

// Decodes the PNG file `data`; the pixels are allocated in `arena`.
pub Image!ImageError decode(Arena* arena, ui8[] data) {
    ui8[8] signature = [137, 80, 78, 71, 13, 10, 26, 10];
    if (data.len < 33) {
        return err(NotPng);
    }
    for (usize i in 0..8) {
        if (data[i] != signature[i]) {
            return err(NotPng);
        }
    }
    if (!is_tag(data, 12, "IHDR") || u32_at(data, 8) != 13) {
        return err(Damaged);
    }
    Header h = Header{ width: u32_at(data, 16), height: u32_at(data, 20), depth: data[24] as ui32, color: data[25] as ui32, interlaced: data[28] == 1 };
    if (!h.valid() || h.width == 0 || h.height == 0 || h.width > 16384 || h.height > 16384 || data[26] != 0 || data[27] != 0 || data[28] > 1) {
        return err(Damaged);
    }

    // The chunks: the palette, the transparency, and the compressed data, gathered.
    mut Extras extras = Extras{ };
    mut usize compressed = 0;
    mut usize at = 8;
    while (at + 12 <= data.len) {
        usize length = u32_at(data, at) as usize;
        usize body = at + 8;
        if (length > data.len - body - 4) {  // the CRC must fit too
            return err(Damaged);
        }
        if (is_tag(data, at + 4, "IDAT")) {
            compressed += length;
        } else if (is_tag(data, at + 4, "PLTE")) {
            for (usize i in 0..min(length / 3, 256)) {
                usize p = body + 3 * i;
                extras.palette[i] = 0xFF000000 | data[p] as ui32 << 16 | data[p + 1] as ui32 << 8 | data[p + 2] as ui32;
            }
        } else if (is_tag(data, at + 4, "tRNS")) {
            if (h.color == 3) {
                for (usize i in 0..min(length, 256)) {
                    extras.palette[i] = extras.palette[i] & 0x00FFFFFF | data[body + i] as ui32 << 24;
                }
            } else if (h.color == 0 && length >= 2 || h.color == 2 && length >= 6) {
                extras.keyed = true;
                for (usize i in 0..(h.color == 0 ? 1 : 3)) {
                    extras.key[i] = data[body + 2 * i] as ui32 << 8 | data[body + 2 * i + 1] as ui32;
                }
            }
        } else if (is_tag(data, at + 4, "IEND")) {
            break;
        }
        at = body + length + 4;
    }
    mut ui8[] stream = arena.alloc_slice(ui8, compressed);
    mut usize filled = 0;
    at = 8;
    while (at + 12 <= data.len && filled < compressed) {
        usize length = u32_at(data, at) as usize;
        usize body = at + 8;
        if (is_tag(data, at + 4, "IDAT")) {
            for (usize i in 0..length) {
                stream[filled + i] = data[body + i];
            }
            filled += length;
        }
        at = body + length + 4;
    }

    // The rows of each pass (one pass when not interlaced), their filter bytes included.
    usize passes = h.interlaced ? 7 : 1;
    ui32[7] px = pass_x();
    ui32[7] py = pass_y();
    ui32[7] pdx = pass_dx();
    ui32[7] pdy = pass_dy();
    mut usize expected = 0;
    for (usize p in 0..passes) {
        ui32 w = h.interlaced ? pass_size(h.width, px[p], pdx[p]) : h.width;
        ui32 rows = h.interlaced ? pass_size(h.height, py[p], pdy[p]) : h.height;
        if (w > 0) {
            expected += h.row_bytes(w) * rows as usize;
        }
    }
    mut ui8[] raw = arena.alloc_slice(ui8, expected);
    match (zlib.decompress_into(stream, raw)) {
        ok(written) => {
            if (written != expected) {
                return err(Damaged);
            }
        },
        err(e) => {
            return err(Damaged);
        },
    }

    mut ui32[] pixels = arena.alloc_slice(ui32, (h.width * h.height) as usize);
    mut usize start = 0;
    for (usize p in 0..passes) {
        ui32 w = h.interlaced ? pass_size(h.width, px[p], pdx[p]) : h.width;
        ui32 rows = h.interlaced ? pass_size(h.height, py[p], pdy[p]) : h.height;
        if (w == 0 || rows == 0) {
            continue;
        }
        usize stride = h.row_bytes(w);
        if (!unfilter(raw[start..start + stride * rows as usize], rows as usize, stride, h.filter_step())) {
            return err(Damaged);
        }
        for (ui32 y in 0..rows) {
            usize row = start + y as usize * stride + 1;
            ui32 ty = h.interlaced ? py[p] + y * pdy[p] : y;
            for (ui32 x in 0..w) {
                ui32 tx = h.interlaced ? px[p] + x * pdx[p] : x;
                pixels[(ty * h.width + tx) as usize] = pixel(h, &extras, raw, row, x);
            }
        }
        start += stride * rows as usize;
    }
    return ok(Image{ width: h.width as i32, height: h.height as i32, pixels: pixels });
}

// Reads and decodes the PNG file at `path`.
pub Image!ImageError load(Arena* arena, str path) uses io {
    ui8[] data = match (io.read_bytes(arena, path)) {
        ok(bytes) => bytes,
        err(e) => {
            return err(Unreadable);
        },
    };
    return decode(arena, data);
}

// ---- Tests: real files (dynamic codes, filters), and files built here (stored blocks) ----

// A PNG file being built: its bytes, in an arena.
struct Builder {
    mut ui8[] bytes;
    mut usize len = 0;

    void put(ui32 b) {
        bytes[len] = (b & 0xFF) as ui8;
        len += 1;
    }

    void put32(ui32 v) {
        put(v >> 24);
        put(v >> 16);
        put(v >> 8);
        put(v);
    }

    void tag(str name) {
        for (ui8 b in name.bytes) {
            put(b as ui32);
        }
    }

    // A chunk; its CRC is left 0, since it is not checked.
    void chunk(str name, ui8[] body) {
        put32(body.len as ui32);
        tag(name);
        for (ui8 b in body) {
            put(b as ui32);
        }
        put32(0);
    }

    // The data of the image: `raw` (filter bytes included) in a zlib stream of one stored block.
    void stored(ui8[] raw) {
        put32((raw.len + 11) as ui32);
        tag("IDAT");
        put(0x78);
        put(0x01);
        put(1);  // the last block, stored
        put(raw.len as ui32);
        put(raw.len as ui32 >> 8);
        put(~(raw.len as ui32));
        put(~(raw.len as ui32) >> 8);
        for (ui8 b in raw) {
            put(b as ui32);
        }
        put32(checksum.adler32(raw));
        put32(0);  // CRC
    }

    ui8[] done() {
        return bytes[0..len];
    }
}

Builder png(Arena* arena, ui32 w, ui32 h, ui32 depth, ui32 color, ui32 interlace) {
    mut Builder b = Builder{ bytes: arena.alloc_slice(ui8, 4096) };
    ui8[8] signature = [137, 80, 78, 71, 13, 10, 26, 10];
    for (ui8 s in signature) {
        b.put(s as ui32);
    }
    b.put32(13);
    b.tag("IHDR");
    b.put32(w);
    b.put32(h);
    b.put(depth);
    b.put(color);
    b.put(0);
    b.put(0);
    b.put(interlace);
    b.put32(0);
    return b;
}

Image decoded(Arena* arena, ui8[] data) {
    return match (decode(arena, data)) {
        ok(img) => img,
        err(e) => Image{ width: 0, height: 0, pixels: arena.alloc_slice(ui32, 0) },
    };
}

test "a PNG file with alpha, compressed with dynamic codes" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    Image img = match (load(&arena, "packages/render/images/rgba.png")) {
        ok(found) => found,
        err(e) => Image{ width: 0, height: 0, pixels: arena.alloc_slice(ui32, 0) },
    };
    assert(img.width == 48 && img.height == 40);
    mut bool all = true;
    for (i32 y in 0..40) {
        for (i32 x in 0..48) {
            ui32 expected = (x * 5) as ui32 << 24 | (y * 6) as ui32 << 16 | 100 << 8 | 200;
            all = all && img.at(x, y) == expected;
        }
    }
    assert(all);
    assert(img.at(-1, 0) == 0 && img.at(48, 0) == 0);
}

test "a palette, with a transparent entry" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    Image img = match (load(&arena, "packages/render/images/palette.png")) {
        ok(found) => found,
        err(e) => Image{ width: 0, height: 0, pixels: arena.alloc_slice(ui32, 0) },
    };
    assert(img.width == 30 && img.height == 20);
    assert(img.at(5, 5) == 0xFFFF0000 && img.at(15, 5) == 0xFF00FF00 && img.at(15, 15) == 0xFF0000FF);
    assert(img.at(25, 15) >> 24 == 0);
}

test "gray of 1 bit, and of 16 bits with a transparent value" {
    mut Arena arena = Arena.new(64 * KB);
    defer arena.free();
    // 10 pixels of 1 bit: 2 bytes a row, the last 6 bits unused
    mut Builder b = png(&arena, 10, 2, 1, 0, 0);
    mut ui8[6] rows = [0, 0b10100000, 0b10000000, 0, 0xFF, 0b11000000];
    b.stored(rows[0..6]);
    b.chunk("IEND", rows[0..0]);
    Image one = decoded(&arena, b.done());
    assert(one.width == 10 && one.at(0, 0) == 0xFFFFFFFF && one.at(1, 0) == 0xFF000000 && one.at(2, 0) == 0xFFFFFFFF);
    assert(one.at(8, 0) == 0xFFFFFFFF && one.at(9, 0) == 0xFF000000 && one.at(9, 1) == 0xFFFFFFFF);

    b = png(&arena, 2, 1, 16, 0, 0);
    mut ui8[2] key = [0x12, 0x34];
    b.chunk("tRNS", key[0..2]);
    mut ui8[5] wide = [0, 0x12, 0x34, 0xAB, 0xCD];
    b.stored(wide[0..5]);
    Image sixteen = decoded(&arena, b.done());
    assert(sixteen.at(0, 0) == 0x00121212 && sixteen.at(1, 0) == 0xFFABABAB);
}

test "gray and alpha, RGB of 16 bits, and the filters" {
    mut Arena arena = Arena.new(64 * KB);
    defer arena.free();
    mut Builder b = png(&arena, 2, 1, 8, 4, 0);
    mut ui8[5] ga = [0, 200, 128, 50, 255];
    b.stored(ga[0..5]);
    Image gray = decoded(&arena, b.done());
    assert(gray.at(0, 0) == 0x80C8C8C8 && gray.at(1, 0) == 0xFF323232);

    b = png(&arena, 1, 1, 16, 2, 0);
    mut ui8[7] rgb = [0, 0xFF, 0x00, 0x80, 0x00, 0x01, 0x00];
    b.stored(rgb[0..7]);
    assert(decoded(&arena, b.done()).at(0, 0) == 0xFFFF8001);

    // 3 gray pixels on 2 rows: Sub on the first, Up then Average and Paeth on the second
    b = png(&arena, 3, 3, 8, 0, 0);
    mut ui8[12] filtered = [1, 10, 5, 5, 2, 1, 1, 1, 3, 10, 0, 0];
    b.stored(filtered[0..12]);
    Image f = decoded(&arena, b.done());
    assert(f.at(0, 0) == 0xFF0A0A0A && f.at(1, 0) == 0xFF0F0F0F && f.at(2, 0) == 0xFF141414);
    assert(f.at(0, 1) == 0xFF0B0B0B && f.at(1, 1) == 0xFF101010 && f.at(2, 1) == 0xFF151515);
    // Average: 10 + (0 + 11) / 2 = 15, then 0 + (15 + 16) / 2 = 15, then 0 + (15 + 21) / 2 = 18
    assert(f.at(0, 2) == 0xFF0F0F0F && f.at(1, 2) == 0xFF0F0F0F && f.at(2, 2) == 0xFF121212);
}

test "an interlaced image (Adam7)" {
    mut Arena arena = Arena.new(64 * KB);
    defer arena.free();
    // 3 by 3, gray, pixel (x, y) = 10 * y + x: passes 1, 4, 5, 6 and 7 hold pixels
    mut Builder b = png(&arena, 3, 3, 8, 0, 1);
    mut ui8[17] passes = [0, 0, 0, 2, 0, 20, 22, 0, 1, 0, 21, 0, 10, 11, 12, 0, 0];
    b.stored(passes[0..15]);
    Image img = decoded(&arena, b.done());
    mut bool all = img.width == 3;
    for (i32 y in 0..3) {
        for (i32 x in 0..3) {
            ui32 v = (10 * y + x) as ui32;
            all = all && img.at(x, y) == 0xFF000000 | v << 16 | v << 8 | v;
        }
    }
    assert(all);
}

test "what is not a PNG file, or a damaged one" {
    mut Arena arena = Arena.new(64 * KB);
    defer arena.free();
    bool not_png = match (load(&arena, "packages/render/fonts/OFL.txt")) {
        ok(img) => false,
        err(e) => e == NotPng,
    };
    assert(not_png);
    bool missing = match (load(&arena, "packages/render/images/none.png")) {
        ok(img) => false,
        err(e) => e == Unreadable,
    };
    assert(missing);
    mut Builder b = png(&arena, 4, 4, 8, 0, 0);
    mut ui8[5] short = [0, 1, 2, 3, 4];  // one row of the four
    b.stored(short[0..5]);
    bool damaged = match (decode(&arena, b.done())) {
        ok(img) => false,
        err(e) => e == Damaged,
    };
    assert(damaged);
    ui8[] real = match (io.read_bytes(&arena, "packages/render/images/rgba.png")) {
        ok(bytes) => bytes,
        err(e) => arena.alloc_slice(ui8, 0),
    };
    bool truncated = match (decode(&arena, real[0..real.len / 2])) {
        ok(img) => false,
        err(e) => e == Damaged,
    };
    assert(truncated);
}
