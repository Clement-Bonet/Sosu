// render.png: a canvas written as a PNG file (8 bits per channel, RGBA, deflate-compressed).
import compress.zlib;
import compress.checksum;
import render.image;
import render.canvas;

// A PNG file being built: its bytes, in a slice sized for all of it.
struct Builder {
    mut ui8[] bytes;
    mut usize len = 0;

    void put(ui32 b) {
        bytes[len] = (b & 0xFF) as ui8;
        len += 1;
    }

    void put32(ui32 v) {
        put(v >> 24);
        put(v >> 16);
        put(v >> 8);
        put(v);
    }

    // A chunk: length, name, `body`, and the CRC of the name and the body.
    void chunk(str name, ui8[] body) {
        put32(body.len as ui32);
        usize start = len;
        for (ui8 b in name.bytes) {
            put(b as ui32);
        }
        for (ui8 b in body) {
            put(b as ui32);
        }
        put32(checksum.crc32(bytes[start..len]));
    }
}

// The bytes of the PNG file holding `cv`; the alpha of the pixels is kept.
pub ui8[] encode(Arena* arena, canvas.Canvas* cv) {
    // 4 bytes a pixel and a filter byte a row; `pixels.len * 4` is the size of memory already
    // allocated, so it cannot wrap around, even where usize has 32 bits.
    ui8[] raw = arena.alloc_slice(ui8, cv.pixels.len * 4 + cv.height as usize);
    mut usize at = 0;
    for (i32 y in 0..cv.height) {
        raw[at] = 0;  // no filter
        at += 1;
        for (i32 x in 0..cv.width) {
            ui32 p = cv.at(x, y);
            raw[at] = (p >> 16 & 0xFF) as ui8;
            raw[at + 1] = (p >> 8 & 0xFF) as ui8;
            raw[at + 2] = (p & 0xFF) as ui8;
            raw[at + 3] = (p >> 24 & 0xFF) as ui8;
            at += 4;
        }
    }
    ui8[] packed = zlib.compress(arena, raw);
    mut Builder b = Builder{ bytes: arena.alloc_slice(ui8, 8 + 25 + 12 + packed.len + 12) };
    ui8[8] signature = [137, 80, 78, 71, 13, 10, 26, 10];
    for (ui8 s in signature) {
        b.put(s as ui32);
    }
    mut ui8[13] header = [0, 0, 0, 0, 0, 0, 0, 0, 8, 6, 0, 0, 0];
    header[0] = (cv.width as ui32 >> 24) as ui8;
    header[1] = (cv.width as ui32 >> 16 & 0xFF) as ui8;
    header[2] = (cv.width as ui32 >> 8 & 0xFF) as ui8;
    header[3] = (cv.width as ui32 & 0xFF) as ui8;
    header[4] = (cv.height as ui32 >> 24) as ui8;
    header[5] = (cv.height as ui32 >> 16 & 0xFF) as ui8;
    header[6] = (cv.height as ui32 >> 8 & 0xFF) as ui8;
    header[7] = (cv.height as ui32 & 0xFF) as ui8;
    b.chunk("IHDR", header[0..13]);
    b.chunk("IDAT", packed);
    b.chunk("IEND", packed[0..0]);
    return b.bytes[0..b.len];
}

// Wider than 65 535 pixels: the width takes 3 bytes of its 4 in the header. The reader stops at
// 16 384 pixels (image.decode), so the header is checked byte by byte.
test "a canvas wider than 65 535 pixels is written whole" {
    mut Arena arena = Arena.new(4 * MB);
    defer arena.free();
    mut canvas.Canvas c = canvas.create(&arena, 70000, 2);
    ui8[] file = encode(&arena, &c);
    assert(file[16] == 0 && file[17] == 1 && file[18] == 0x11 && file[19] == 0x70);  // 70 000
    assert(file[20] == 0 && file[21] == 0 && file[22] == 0 && file[23] == 2);
}

test "a canvas written is read back" {
    mut Arena arena = Arena.new(64 * KB);
    defer arena.free();
    mut canvas.Canvas c = canvas.create(&arena, 5, 3);
    c.clear(canvas.Color{ r: 10, g: 20, b: 30 });
    c.fill(canvas.Rect{ x: 1.0, y: 1.0, w: 2.0, h: 1.0 }, canvas.Color{ r: 255, g: 0, b: 7, a: 128 });
    ui8[] file = encode(&arena, &c);
    match (image.decode(&arena, file)) {
        ok(img) => {
            assert(img.width == 5 && img.height == 3);
            for (i32 y in 0..3) {
                for (i32 x in 0..5) {
                    assert(img.at(x, y) == c.at(x, y));
                }
            }
        },
        err(e) => {
            assert(false);
        },
    }
}
