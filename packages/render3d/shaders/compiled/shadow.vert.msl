#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_Object
{
    float4x4 model;
    float4x4 light_view_projection;
};

struct main0_out
{
    float4 gl_Position [[position]];
};

struct main0_in
{
    float3 in_var_TEXCOORD0 [[attribute(0)]];
};

vertex main0_out main0(main0_in in [[stage_in]], constant type_Object& Object [[buffer(0)]])
{
    main0_out out = {};
    out.gl_Position = Object.light_view_projection * (Object.model * float4(in.in_var_TEXCOORD0, 1.0));
    return out;
}

