// scene.scene: entities and components (spec §8.2). An `Entity` is an index and a generation; a
// `Table<T>` keeps the components of one type packed, with an index by entity. The program writes
// its systems as functions over its tables and calls them in the order it reads: nothing is
// registered, nothing runs behind it. A despawned entity is dead in every table at once: a table
// checks the generation of what it holds, so the handle of a dead entity never reaches the
// components of another that took its place.
import std.vec;
import math.linear;

// An entity: its place in the world and the generation of that place.
pub struct Entity {
    ui32 index;
    ui32 generation;

    pub ui32 id() {
        return index;
    }

    pub bool same(Entity o) {
        return index == o.index && generation == o.generation;
    }
}

// The components of one type, packed in an array: `each` visits them in its order.
pub class Table<T> {
    World* world;
    vec.Vec<T>* items;
    vec.Vec<Entity>* owners;
    vec.Vec<ui32>* where;  // by index of entity: its place in `items` plus 1, 0 when none

    void init(keeps Arena* arena, keeps World* world) {
        self.world = world;
        items = vec.new(arena);
        owners = vec.new(arena);
        where = vec.new(arena);
    }

    // The place of the component of `e`, if it has one and is alive.
    usize? place(Entity e) {
        if (e.index as usize >= where.len()) {
            return none;
        }
        ui32 at = where.items()[e.index as usize];
        if (at == 0) {
            return none;
        }
        usize p = (at - 1) as usize;
        return owners.items()[p].same(e) && world.alive(e) ? some(p) : none;
    }

    // The component of `e`, set or replaced. `e` must be alive.
    pub void set(Entity e, keeps T value) {
        assert(world.alive(e));
        while (where.len() <= e.index as usize) {
            where.push(0);
        }
        ui32 at = where.items()[e.index as usize];
        if (at != 0) {
            // its own component, or a stale one of a dead entity that had this index: replaced
            usize p = (at - 1) as usize;
            items.set(p, value);
            owners.set(p, e);
            return;
        }
        items.push(value);
        owners.push(e);
        where.set(e.index as usize, items.len() as ui32);
    }

    // The component of `e`, none when it has none or is dead. The pointer is valid until the
    // next `set` or `remove` on this table, as in a `std.vec`.
    pub T*? get(Entity e) {
        return match (place(e)) {
            some(p) => some(items.at(p)),
            none => none,
        };
    }

    pub bool has(Entity e) {
        return match (place(e)) {
            some(p) => true,
            none => false,
        };
    }

    // The component of `e` taken away (the last of the array takes its place).
    pub void remove(Entity e) {
        if (e.index as usize >= where.len()) {
            return;
        }
        ui32 at = where.items()[e.index as usize];
        if (at == 0 || !owners.items()[(at - 1) as usize].same(e)) {
            return;
        }
        usize p = (at - 1) as usize;
        usize last = items.len() - 1;
        if (p != last) {
            items.set(p, items.items()[last]);
            Entity moved = owners.items()[last];
            owners.set(p, moved);
            where.set(moved.index as usize, (p + 1) as ui32);
        }
        items.pop();
        owners.pop();
        where.set(e.index as usize, 0);
    }

    // The components of dead entities, dropped: `each` skips them anyway.
    pub void compact() {
        mut usize p = 0;
        while (p < owners.len()) {
            Entity o = owners.items()[p];
            if (world.alive(o)) {
                p += 1;
            } else {
                // as `remove`, without the check of its generation
                usize last = items.len() - 1;
                if (p != last) {
                    items.set(p, items.items()[last]);
                    Entity moved = owners.items()[last];
                    owners.set(p, moved);
                    where.set(moved.index as usize, (p + 1) as ui32);
                }
                items.pop();
                owners.pop();
                if (o.index as usize < where.len() && where.items()[o.index as usize] == (p + 1) as ui32) {
                    where.set(o.index as usize, 0);
                }
                // `p` stays: the last came here
            }
        }
    }

    // How many components it holds, those of dead entities included until `compact`.
    pub usize len() {
        return items.len();
    }

    // Each living entity that has a component, and its component, in the order of the array.
    pub void each<uses E>(fn(Entity, T*) -> void uses E f) uses E {
        for (usize p in 0..items.len()) {
            Entity o = owners.items()[p];
            if (world.alive(o)) {
                f(o, items.at(p));
            }
        }
    }

    // Each living entity that has a component here and one in `other`, and both: the smaller
    // table drives.
    pub void join<U, uses E>(Table<U>* other, fn(Entity, T*, U*) -> void uses E f) uses E {
        if (items.len() <= other.len()) {
            for (usize p in 0..items.len()) {
                Entity o = owners.items()[p];
                match (other.get(o)) {
                    some(u) => {
                        if (world.alive(o)) {
                            f(o, items.at(p), u);
                        }
                    },
                    none => { },
                }
            }
        } else {
            for (Entity o in other.entities_now()) {
                match (get(o)) {
                    some(t) => {
                        match (other.get(o)) {
                            some(u) => {
                                f(o, t, u);
                            },
                            none => { },
                        }
                    },
                    none => { },
                }
            }
        }
    }

    // The entities of its components, living or not, as the array holds them now.
    pub Entity[] entities_now() {
        return owners.items();
    }
}

// The entities and the built-in tables.
pub class World {
    Arena* arena;
    vec.Vec<ui32>* generations;  // by index: the generation of the entity there now
    vec.Vec<bool>* living;
    vec.Vec<ui32>* free;  // indices of dead entities, given again
    pub Table<linear.Transform>* transforms;  // local to the parent
    pub Table<Entity>* parents;
    pub Table<str>* names;
    pub Table<linear.Mat4>* world_matrices;  // written by `propagate`
    mut vec.Vec<ui32>* stamps;  // by index: the `propagate` that placed it
    mut ui32 stamp;

    void init(keeps Arena* arena) keeps self {
        self.arena = arena;
        generations = vec.new(arena);
        living = vec.new(arena);
        free = vec.new(arena);
        stamps = vec.new(arena);
        stamp = 0;
        transforms = arena.new(Table<linear.Transform>, arena, self);
        parents = arena.new(Table<Entity>, arena, self);
        names = arena.new(Table<str>, arena, self);
        world_matrices = arena.new(Table<linear.Mat4>, arena, self);
    }

    // A table for components of the program.
    pub Table<T>* table<T>() keeps self {
        return arena.new(Table<T>, arena, self);
    }

    // A new entity, without components.
    pub Entity spawn() {
        match (free.pop()) {
            some(index) => {
                living.set(index as usize, true);
                return Entity{ index: index, generation: generations.items()[index as usize] };
            },
            none => { },
        }
        generations.push(1);
        living.push(true);
        return Entity{ index: (generations.len() - 1) as ui32, generation: 1 };
    }

    // A new entity named `name`, at `t`, under `parent` when there is one.
    pub Entity spawn_at(keeps str name, linear.Transform t, Entity? parent) {
        Entity e = spawn();
        names.set(e, name);
        transforms.set(e, t);
        match (parent) {
            some(p) => {
                set_parent(e, p);
            },
            none => { },
        }
        return e;
    }

    pub bool alive(Entity e) {
        return e.index as usize < generations.len() && living.items()[e.index as usize]
                && generations.items()[e.index as usize] == e.generation;
    }

    // `e` and its children, and theirs, dead: in every table at once.
    pub void despawn(Entity e) {
        if (!alive(e)) {
            return;
        }
        // the children first, found among the parents
        Entity[] owners = parents.entities_now();
        vec.Vec<Entity>* children = vec.new(arena);
        for (Entity c in owners) {
            match (parents.get(c)) {
                some(p) => {
                    if (p.same(e)) {
                        children.push(c);
                    }
                },
                none => { },
            }
        }
        living.set(e.index as usize, false);
        generations.set(e.index as usize, generations.items()[e.index as usize] + 1);
        free.push(e.index);
        for (Entity c in children.items()) {
            despawn(c);
        }
    }

    // `child` placed under `parent` (its transform is then relative to it). False, and nothing
    // changes, when `parent` is `child` or one of its children: a cycle.
    pub bool set_parent(Entity child, Entity parent) {
        if (!alive(child) || !alive(parent)) {
            return false;
        }
        mut Entity up = parent;
        mut usize depth = 0;
        while (depth < generations.len() + 1) {
            if (up.same(child)) {
                return false;
            }
            match (parents.get(up)) {
                some(p) => {
                    up = *p;
                },
                none => {
                    break;
                },
            }
            depth += 1;
        }
        parents.set(child, parent);
        return true;
    }

    // `child` at the root again.
    pub void clear_parent(Entity child) {
        parents.remove(child);
    }

    pub Entity? parent_of(Entity e) {
        return match (parents.get(e)) {
            some(p) => alive(*p) ? some(*p) : none,
            none => none,
        };
    }

    // The living children of `e`, in `into`.
    pub Entity[] children(Arena* into, Entity e) {
        vec.Vec<Entity>* found = vec.new(into);
        for (Entity c in parents.entities_now()) {
            if (alive(c)) {
                match (parents.get(c)) {
                    some(p) => {
                        if (p.same(e)) {
                            found.push(c);
                        }
                    },
                    none => { },
                }
            }
        }
        return found.items();
    }

    // The world matrix of every entity that has a transform, parents first: `world_matrices`. An
    // entity without a transform under a parent counts as at its parent.
    pub void propagate() {
        stamp += 1;
        while (stamps.len() < generations.len()) {
            stamps.push(0);
        }
        for (Entity e in transforms.entities_now()) {
            if (alive(e)) {
                place(e, 0);
            }
        }
    }

    // The world matrix of `e`, its parent placed first.
    linear.Mat4 place(Entity e, usize depth) {
        if (stamps.items()[e.index as usize] == stamp) {
            return match (world_matrices.get(e)) {
                some(m) => *m,
                none => linear.identity4(),
            };
        }
        linear.Mat4 local = match (transforms.get(e)) {
            some(t) => t.to_mat4(),
            none => linear.identity4(),
        };
        linear.Mat4 world = match (parent_of(e)) {
            some(p) => depth < generations.len() ? place(p, depth + 1).mul(local) : local,
            none => local,
        };
        world_matrices.set(e, world);
        stamps.set(e.index as usize, stamp);
        return world;
    }

    // How many entities are alive.
    pub usize count() {
        mut usize n = 0;
        for (bool l in living.items()) {
            if (l) {
                n += 1;
            }
        }
        return n;
    }

    // Every living entity, in the order of their indices.
    pub Entity[] entities(Arena* into) {
        vec.Vec<Entity>* found = vec.new(into);
        for (usize i in 0..living.len()) {
            if (living.items()[i]) {
                found.push(Entity{ index: i as ui32, generation: generations.items()[i] });
            }
        }
        return found.items();
    }
}

pub World* world(keeps Arena* arena) {
    return arena.new(World, arena);
}

struct Spin {
    mut f32 speed;
}

struct Health {
    mut i32 points;
}

test "entities, and their components in tables" {
    mut Arena arena = Arena.new(16 * KB);
    defer arena.free();
    World* w = world(&arena);
    Table<Spin>* spins = w.table<Spin>();
    Entity a = w.spawn();
    Entity b = w.spawn();
    spins.set(a, Spin{ speed: 1.5 });
    spins.set(b, Spin{ speed: 2.0 });
    assert(w.count() == 2 && spins.len() == 2 && spins.has(a));
    match (spins.get(a)) {
        some(s) => {
            s.speed = 3.0;
        },
        none => {
            assert(false);
        },
    }
    assert(match (spins.get(a)) {
        some(s) => s.speed == 3.0,
        none => false,
    });
    mut f32 total = 0.0;
    f32* sum = &total;  // a lambda copies what it uses: a pointer to change it
    spins.each((Entity e, Spin* s) => {
        *sum += s.speed;
    });
    assert(total == 5.0);
    spins.remove(a);
    assert(!spins.has(a) && spins.len() == 1 && spins.has(b));
    assert(match (spins.get(b)) {
        some(s) => s.speed == 2.0,
        none => false,
    });  // moved, still found
}

test "a dead entity is dead everywhere, and its place given again" {
    mut Arena arena = Arena.new(16 * KB);
    defer arena.free();
    World* w = world(&arena);
    Table<Spin>* spins = w.table<Spin>();
    Entity a = w.spawn();
    spins.set(a, Spin{ speed: 1.0 });
    w.despawn(a);
    assert(!w.alive(a) && !spins.has(a));
    Entity b = w.spawn();  // the index of `a`, a new generation
    assert(b.id() == a.id() && !b.same(a));
    assert(!spins.has(b) && !spins.has(a));  // the component of `a` is not that of `b`
    spins.set(b, Spin{ speed: 7.0 });
    assert(match (spins.get(b)) {
        some(s) => s.speed == 7.0,
        none => false,
    } && !spins.has(a));
    mut usize visited = 0;
    usize* seen = &visited;
    spins.each((Entity e, Spin* s) => {
        *seen += 1;
    });
    assert(visited == 1);
    spins.compact();
    assert(spins.len() == 1);
}

test "a hierarchy: world matrices, children, cycles refused, despawned with its children" {
    mut Arena arena = Arena.new(16 * KB);
    defer arena.free();
    World* w = world(&arena);
    mut linear.Transform moved = linear.transform();
    moved.position = linear.vec3(10.0, 0.0, 0.0);
    Entity root = w.spawn_at("root", moved, none);
    mut linear.Transform up = linear.transform();
    up.position = linear.vec3(0.0, 2.0, 0.0);
    Entity child = w.spawn_at("child", up, some(root));
    Entity grandchild = w.spawn_at("grandchild", up, some(child));
    w.propagate();
    linear.Vec3 at = match (w.world_matrices.get(grandchild)) {
        some(m) => m.transform_point(linear.vec3(0.0, 0.0, 0.0)),
        none => linear.vec3(0.0, 0.0, 0.0),
    };
    assert(at.near(linear.vec3(10.0, 4.0, 0.0), 0.0001));
    assert(w.children(&arena, root).len == 1 && w.children(&arena, child)[0].same(grandchild));
    assert(!w.set_parent(root, grandchild));  // a cycle
    assert(match (w.parent_of(root)) {
        some(p) => false,
        none => true,
    });
    // moved again: the next propagate follows
    match (w.transforms.get(root)) {
        some(t) => {
            t.position = linear.vec3(0.0, 0.0, 0.0);
        },
        none => { },
    }
    w.propagate();
    assert(match (w.world_matrices.get(grandchild)) {
        some(m) => m.transform_point(linear.vec3(0.0, 0.0, 0.0)).near(linear.vec3(0.0, 4.0, 0.0), 0.0001),
        none => false,
    });
    w.despawn(root);
    assert(!w.alive(child) && !w.alive(grandchild) && w.count() == 0);
}

test "a join of two tables" {
    mut Arena arena = Arena.new(16 * KB);
    defer arena.free();
    World* w = world(&arena);
    Table<Spin>* spins = w.table<Spin>();
    Table<Health>* health = w.table<Health>();
    for (usize i in 0..10) {
        Entity e = w.spawn();
        spins.set(e, Spin{ speed: i as f32 });
        if (i % 3 == 0) {
            health.set(e, Health{ points: 100 });
        }
    }
    mut usize both = 0;
    mut f32 speeds = 0.0;
    usize* counted = &both;
    f32* summed = &speeds;
    spins.join(health, (Entity e, Spin* s, Health* h) => {
        *counted += 1;
        *summed += s.speed;
        h.points -= 1;
    });
    assert(both == 4 && speeds == 18.0);  // 0, 3, 6, 9
    mut usize again = 0;
    usize* twice = &again;
    health.join(spins, (Entity e, Health* h, Spin* s) => {
        assert(h.points == 99);
        *twice += 1;
    });
    assert(again == 4);
}
