// ui.widgets: widgets in immediate mode (spec §10). Each frame, the program describes its
// interface from its own state, by calls: `if (f.button("OK")) { ... }`. Nothing is
// registered and nothing calls the program back: the description is simply run again.
//
// `Ui` keeps what lasts between frames: the input received since the last one, the widget
// pressed and the text field that has the focus. `Frame` places the widgets of one frame,
// one under the other, or side by side between `row()` and `end_row()`.
import i18n.catalog;
import render.canvas;
import render.image;
import render.truetype;

// Text typed or edited: at most 256 bytes of UTF-8.
pub struct TextBuffer {
    mut u8[256] bytes = [0; 256];
    mut usize len = 0;

    pub str text() {
        return match (str.from_bytes(bytes[0..len])) {
            ok(valid) => valid,
            err(e) => "",
        };
    }

    pub void set(str text) {
        len = 0;
        append(text);
    }

    // Adds `text` at the end, if it fits whole.
    pub void append(str text) {
        if (len + text.len > 256) {
            return;
        }
        for (u8 b in text.bytes) {
            bytes[len] = b;
            len += 1;
        }
    }

    // Removes the last character (all its bytes).
    pub void erase_last() {
        if (len == 0) {
            return;
        }
        len -= 1;
        while (len > 0 && bytes[len] & 0xC0 == 0x80) {  // a continuation byte
            len -= 1;
        }
    }

    // The last `count` characters at most.
    pub str tail(usize count) {
        mut usize start = len;
        mut usize found = 0;
        while (start > 0 && found < count) {
            start -= 1;
            if (bytes[start] & 0xC0 != 0x80) {
                found += 1;
            }
        }
        return match (str.from_bytes(bytes[start..len])) {
            ok(valid) => valid,
            err(e) => "",
        };
    }

    // The number of characters.
    pub usize count() {
        mut usize found = 0;
        for (usize i in 0..len) {
            if (bytes[i] & 0xC0 != 0x80) {
                found += 1;
            }
        }
        return found;
    }

    // Editing, at byte offsets that start a character (0 and `len` included).

    // The text from byte `from` to byte `to`.
    pub str slice(usize from, usize to) {
        usize end = min(to, len);
        return match (str.from_bytes(bytes[min(from, end)..end])) {
            ok(valid) => valid,
            err(e) => "",
        };
    }

    // Where the character after the one at `at` starts.
    pub usize next(usize at) {
        mut usize i = min(at + 1, len);
        while (i < len && bytes[i] & 0xC0 == 0x80) {
            i += 1;
        }
        return i;
    }

    // Where the character before `at` starts.
    pub usize previous(usize at) {
        if (at == 0) {
            return 0;
        }
        mut usize i = min(at, len) - 1;
        while (i > 0 && bytes[i] & 0xC0 == 0x80) {
            i -= 1;
        }
        return i;
    }

    // Inserts `text` at `at`; false, and nothing changes, if it does not fit.
    pub bool insert(usize at, str text) {
        if (len + text.len > 256 || at > len) {
            return false;
        }
        for (mut usize i = len; i > at; i -= 1) {
            bytes[i - 1 + text.len] = bytes[i - 1];
        }
        for (usize i in 0..text.len) {
            bytes[at + i] = text.bytes[i];
        }
        len += text.len;
        return true;
    }

    // Removes the bytes from `from` to `to`.
    pub void remove(usize from, usize to) {
        usize end = min(to, len);
        usize start = min(from, end);
        usize removed = end - start;
        for (mut usize i = start; i + removed < len; i += 1) {
            bytes[i] = bytes[i + removed];
        }
        len -= removed;
    }
}

// Text that grows, in an arena of its own (spec §10.9): the text of a `TextArea`. It owns its
// arena, so it is moved, never copied (§6): it lives in the state of the program. Make one with
// `long_text()`, and free it with `free()`.
pub struct LongText {
    mut Arena arena;
    mut u8[] bytes;
    mut usize len = 0;

    pub str text() {
        return slice(0, len);
    }

    pub void set(str text) {
        len = 0;
        insert(0, text);
    }

    // The number of characters.
    pub usize count() {
        mut usize found = 0;
        for (usize i in 0..len) {
            if (bytes[i] & 0xC0 != 0x80) {
                found += 1;
            }
        }
        return found;
    }

    // Editing, at byte offsets that start a character (0 and `len` included), as `TextBuffer`.

    pub str slice(usize from, usize to) {
        usize end = min(to, len);
        return match (str.from_bytes(bytes[min(from, end)..end])) {
            ok(valid) => valid,
            err(e) => "",
        };
    }

    pub usize next(usize at) {
        mut usize i = min(at + 1, len);
        while (i < len && bytes[i] & 0xC0 == 0x80) {
            i += 1;
        }
        return i;
    }

    pub usize previous(usize at) {
        if (at == 0) {
            return 0;
        }
        mut usize i = min(at, len) - 1;
        while (i > 0 && bytes[i] & 0xC0 == 0x80) {
            i -= 1;
        }
        return i;
    }

    // Inserts `text` at `at`, the bytes growing as needed (twice as many each time).
    pub bool insert(usize at, str text) {
        if (at > len) {
            return false;
        }
        if (len + text.len > bytes.len) {
            mut usize room = max(bytes.len * 2, 64);
            while (room < len + text.len) {
                room *= 2;
            }
            mut u8[] grown = arena.alloc_slice(u8, room);
            for (usize i in 0..len) {
                grown[i] = bytes[i];
            }
            bytes = grown;
        }
        for (mut usize i = len; i > at; i -= 1) {
            bytes[i - 1 + text.len] = bytes[i - 1];
        }
        for (usize i in 0..text.len) {
            bytes[at + i] = text.bytes[i];
        }
        len += text.len;
        return true;
    }

    pub void remove(usize from, usize to) {
        usize end = min(to, len);
        usize start = min(from, end);
        usize removed = end - start;
        for (mut usize i = start; i + removed < len; i += 1) {
            bytes[i] = bytes[i + removed];
        }
        len -= removed;
    }

    // Frees its arena: the text is empty after it.
    pub void free() {
        arena.free();
        len = 0;
    }
}

// An empty `LongText`.
pub LongText long_text() {
    mut Arena arena = Arena.new(4 * KB);
    u8[] bytes = arena.alloc_slice(u8, 256);
    return LongText{ arena: arena, bytes: bytes };
}

// The text a field edits: a `TextBuffer` or a `LongText`, so that one editing core serves both.
struct Target {
    TextBuffer*? short_text = none;
    LongText*? long_text = none;

    usize len() {
        return match (short_text) {
            some(t) => t.len,
            none => match (long_text) {
                some(t) => t.len,
                none => 0,
            },
        };
    }

    str slice(usize from, usize to) {
        return match (short_text) {
            some(t) => t.slice(from, to),
            none => match (long_text) {
                some(t) => t.slice(from, to),
                none => "",
            },
        };
    }

    str text() {
        return slice(0, len());
    }

    usize next(usize at) {
        return match (short_text) {
            some(t) => t.next(at),
            none => match (long_text) {
                some(t) => t.next(at),
                none => 0,
            },
        };
    }

    usize previous(usize at) {
        return match (short_text) {
            some(t) => t.previous(at),
            none => match (long_text) {
                some(t) => t.previous(at),
                none => 0,
            },
        };
    }

    usize count() {
        return match (short_text) {
            some(t) => t.count(),
            none => match (long_text) {
                some(t) => t.count(),
                none => 0,
            },
        };
    }

    bool insert(usize at, str text) {
        return match (short_text) {
            some(t) => t.insert(at, text),
            none => match (long_text) {
                some(t) => t.insert(at, text),
                none => false,
            },
        };
    }

    void remove(usize from, usize to) {
        match (short_text) {
            some(t) => {
                t.remove(from, to);
            },
            none => {
                match (long_text) {
                    some(t) => {
                        t.remove(from, to);
                    },
                    none => { },
                }
            },
        }
    }
}

Target short_target(TextBuffer* text) {
    return Target{ short_text: some(text) };
}

Target long_target(LongText* text) {
    return Target{ long_text: some(text) };
}

// A byte of a word, for Ctrl+Left and Ctrl+Right and the double click: letters, digits, `_`, and
// every character beyond ASCII.
bool word_byte(u8 b) {
    return b >= 48 && b <= 57 || b >= 65 && b <= 90 || b >= 97 && b <= 122 || b == 95 || b >= 0x80;
}

// The start of the word before `at` (the spaces before it skipped).
usize word_left(Target t, usize at) {
    str all = t.text();
    mut usize i = at;
    while (i > 0 && !word_byte(all.bytes[t.previous(i)])) {
        i = t.previous(i);
    }
    while (i > 0 && word_byte(all.bytes[t.previous(i)])) {
        i = t.previous(i);
    }
    return i;
}

// The start of the word after `at` (the end of this one, then its spaces skipped).
usize word_right(Target t, usize at) {
    str all = t.text();
    usize n = t.len();
    mut usize i = at;
    while (i < n && word_byte(all.bytes[i])) {
        i = t.next(i);
    }
    while (i < n && !word_byte(all.bytes[i])) {
        i = t.next(i);
    }
    return i;
}

// A change of the text of a field, for undo and redo: the bytes `at` to `at + removed_len` became
// the `inserted_len` bytes; both texts are in `Ui.history`, from `text_at`.
struct Change {
    mut usize at = 0;
    mut usize text_at = 0;
    mut usize removed_len = 0;
    mut usize inserted_len = 0;
    mut bool typing = false;  // text typed: what follows joins it, up to the next word
}

f32 abs_f32(f32 v) {
    return v < 0.0 ? -v : v;
}

// The key codes of SDL that text fields use (`platform.app` gives them as they are).
u32 key_backspace() {
    return 8;
}

u32 key_enter() {
    return 13;
}

u32 key_delete() {
    return 127;
}

u32 key_right() {
    return 0x4000004F;
}

u32 key_left() {
    return 0x40000050;
}

u32 key_up() {
    return 0x40000052;
}

u32 key_down() {
    return 0x40000051;
}

u32 key_home() {
    return 0x4000004A;
}

u32 key_end() {
    return 0x4000004D;
}

// Something typed for the text field that has the keyboard: text, or a key.
struct Edit {
    mut u32 key = 0;  // 0: the text `from` to `to` of `Ui.typed`
    mut usize from = 0;
    mut usize to = 0;
    mut bool shift = false;
    mut bool ctrl = false;
    mut bool alt = false;
}

u32 key_tab() {
    return 9;
}

u32 key_space() {
    return 32;
}

u32 key_escape() {
    return 27;
}

u32 key_page_up() {
    return 0x4000004B;
}

u32 key_page_down() {
    return 0x4000004E;
}

u32 key_f10() {
    return 0x40000043;
}

u32 key_menu() {  // the Menu key (SDLK_APPLICATION)
    return 0x40000065;
}

// The identity of a widget: the hash of its path, 64 bits (FNV-1a over the bytes of each part).
u64 mix(u64 h, u64 part) {
    mut u64 x = h;
    for (usize i in 0..8) {
        x = x ^ part >> (8 * i) as u64 & 0xFF;
        x = wrapping_mul(x, 0x100000001B3);
    }
    return x;
}

// What lasts between frames for a widget that needs it (a `Scroll`, a list), by identity.
struct WidgetState {
    mut u64 id = 0;  // 0: a free entry
    mut bool seen = false;  // used during this frame: entries not used are freed at its end
    mut f32 scroll_x = 0.0;  // how far its content is scrolled
    mut f32 scroll_y = 0.0;
    mut f32 content_w = 0.0;  // the size of its content at the last frame
    mut f32 content_h = 0.0;
    mut i32 items = 0;  // a list: how many items
    mut bool closed = false;  // a group folded, a branch of a tree closed
    // Tabs: the tab chosen when the program does not bind it, a tab to choose and a tab to close
    // at the next frame (-1: none), how many tabs it had, and the width of its row of tabs.
    mut i32 chosen = 0;
    mut i32 pick = -1;
    mut i32 closing = -1;
    mut bool expanded = false;  // a branch of a tree open
    mut f32 extent = 0.0;
    mut bool reveal = false;  // a list: scroll to the item chosen, after a key moved the choice
    mut f32 item_h = 0.0;  // a long list: the height of its items, measured at the last frame
}

// The state of an interface between frames.
pub struct Ui {
    // The input since the last frame.
    mut f32 mouse_x = 0.0;
    mut f32 mouse_y = 0.0;
    mut bool moved = false;  // the mouse moved since the last frame
    mut bool down = false;  // the left button is held
    mut bool pressed = false;  // it went down
    mut bool released = false;  // it went up
    mut TextBuffer typed = TextBuffer{ };  // the text of the edits
    mut Edit[64] edits = [Edit{ }; 64];  // in the order they came
    mut usize edit_count = 0;

    // Between frames, by identity (spec §10.6; 0: none): the widget pressed and not yet
    // released, the widget that has the keyboard; whether Tab just gave it the keyboard (it
    // comes into view); the state of the widgets that keep one; the identities used twice.
    mut u64 active = 0;
    mut u64 focus = 0;
    mut bool reveal = false;
    mut WidgetState[64] states = [WidgetState{ }; 64];
    pub mut u32 duplicates = 0;
    // The grids (spec §10.8), 8 at most: their identities, whether each was seen in this frame,
    // and the size of the content of each column (16) and row (64) at the last frame.
    mut u64[8] grid_ids = [0; 8];
    mut bool[8] grid_seen = [false; 8];
    mut f32[128] grid_widths = [0.0; 128];
    mut f32[512] grid_heights = [0.0; 512];
    // In the text field that has the keyboard: the cursor and the other end of the selection
    // (byte offsets), and how far its text is scrolled to keep the cursor in view.
    mut usize cursor = 0;
    mut usize anchor = 0;
    mut f32 scroll = 0.0;
    // What Ctrl+C or Ctrl+X copied, for the program to put on the clipboard.
    mut TextBuffer copied = TextBuffer{ };
    mut bool has_copied = false;
    // The mouse wheel since the last frame, in steps (positive: away from the user; sideways:
    // to the right), whether Shift is held (the wheel then scrolls sideways), and where the
    // thumb of a scroll bar was taken.
    mut f32 wheel = 0.0;
    mut f32 wheel_x = 0.0;
    mut bool shift_held = false;
    mut f32 drag_offset = 0.0;
    // Alt held, and no other key since: released alone, it is F10 (the menus).
    mut bool alt_down = false;
    mut bool alt_alone = false;

    // The dropdown open (0: none), and the rectangle of its list at the last frame: the
    // layer above, which takes the mouse before the widgets under it. With the keyboard: the
    // option highlighted in the open list, and an option to choose at the next frame.
    mut u64 open = 0;
    mut canvas.Rect layer = nowhere();
    mut i32 highlight = -1;
    mut u64 pick_dropdown = 0;
    mut i32 pick_option = -1;

    // The menus open: at each level, its widget number (-1: none), the first a menu opened by
    // its title (`menu_in_bar`) or a context menu, the others its submenus; where the context
    // menu opened; the size of each menu open at the last frame, and its rectangle, above the
    // rest as the list of a dropdown is.
    mut u64[4] menus = [0; 4];
    mut bool menu_in_bar = false;
    // The menus with the keyboard: the keyboard on the bar (F10, Alt), its title highlighted,
    // the entry highlighted at each level (-1: none, -2: the first one, at the next frame), and
    // an item chosen with Enter, which acts at the next frame.
    mut bool bar_keys = false;
    mut i32 bar_index = 0;
    mut i32[4] menu_cursor = [-1; 4];
    mut u64 pick_menu = 0;
    mut i32 pick_entry = -1;
    mut f32 context_x = 0.0;
    mut f32 context_y = 0.0;
    mut f32[4] menu_w = [0.0; 4];
    mut f32[4] menu_h = [0.0; 4];
    mut canvas.Rect[4] popups = [nowhere(); 4];
    mut usize popup_count = 0;
    mut bool right_pressed = false;  // the right button went down: context menus
    mut bool editing = false;  // a text field had the keyboard at the last frame

    // The title bar of the last frame (spec §10.5): its rectangle, those of the interactive
    // widgets in it and of its window buttons, and the request of a window button.
    mut canvas.Rect bar = nowhere();
    mut canvas.Rect[16] bar_widgets = [nowhere(); 16];
    mut usize bar_widget_count = 0;
    mut canvas.Rect bar_buttons = nowhere();
    mut WindowRequest? request = none;
    // Set by the program: whether the system left the title bar to it (`platform.app` says
    // so with `CustomTitleBar`), else a `title_bar` is a tool bar; whether it is maximized.
    pub mut bool custom_title_bar = false;
    pub mut bool maximized = false;

    // The font of the widgets; without one, the built-in 8 by 8 font. Text is 9 pixels per
    // em for each step of scale: 18 for labels, 27 for titles.
    pub mut truetype.Font*? font = none;
    // The translations of the texts (spec §10.7); none: the language of the source.
    pub mut catalog.Catalog*? catalog = none;
    // The colors and sizes of the widgets (spec §10.7); none: `default_theme()`.
    pub mut Theme? theme = none;

    // The time (spec §10.9), given by the program before each frame: milliseconds of a monotonic
    // clock. Without it, what needs time (double clicks, tooltips...) does not happen.
    mut u64 now = 0;
    mut bool has_clock = false;
    // The presses of the left button in a row, near each other in place and time: 2 is a double
    // click, 3 a triple one.
    mut u32 presses = 0;
    mut u64 press_time = 0;
    mut f32 press_x = 0.0;
    mut f32 press_y = 0.0;
    // Undo and redo in the text field that has the keyboard: its identity, its changes (those
    // before `change_at` are done, the others undone), and their texts.
    mut u64 history_of = 0;
    mut Change[64] changes = [Change{ }; 64];
    mut usize change_count = 0;
    mut usize change_at = 0;
    mut u8[4096] history = [0; 4096];
    mut usize history_used = 0;
    // What an input method is composing (spec §10.9), shown at the cursor of the field that has
    // the keyboard; and where that cursor was at the last frame, for the window of candidates.
    // Touch screens (spec §10.9): the finger followed (-1: none), where and when it went down, whether
    // it drags (it scrolls) or pressed long (the right button), its speed for the inertia of a
    // scroll, in pixels per millisecond, and the margins of the safe area.
    mut i64 finger = -1;
    mut f32 finger_x = 0.0;
    mut f32 finger_y = 0.0;
    mut u64 finger_time = 0;
    mut bool dragging = false;
    mut bool long_press = false;
    mut f32 speed_x = 0.0;
    mut f32 speed_y = 0.0;
    mut u64 last_clock = 0;
    mut f32 safe_left = 0.0;
    mut f32 safe_top = 0.0;
    mut f32 safe_right = 0.0;
    mut f32 safe_bottom = 0.0;
    mut TextBuffer composing = TextBuffer{ };
    mut canvas.Rect caret = nowhere();

    // The number field that has the keyboard, and its text being typed (spec §10.9).
    // The widget under the mouse for its tooltip, and since when (the time of `clock`).
    mut u64 tip_key = 0;
    mut u64 tip_since = 0;
    // A dialog was open at the last frame (spec §10.9): only its widgets see the mouse.
    mut bool modal = false;
    // The date field that has the keyboard, its text being typed, and the month its calendar shows
    // (and the day the keyboard is on).
    mut u64 date_of = 0;
    mut TextBuffer date_text = TextBuffer{ };
    mut i32 cal_year = 2000;
    mut i32 cal_month = 1;
    mut i32 cal_day = 1;
    mut u64 number_of = 0;
    mut TextBuffer number_text = TextBuffer{ };

    pub void clock(u64 ms) {
        u64 elapsed = has_clock && ms > now ? ms - now : 0;
        now = ms;
        has_clock = true;
        // a finger held without moving: the right button, once
        if (finger >= 0 && !dragging && !long_press && now - finger_time >= 500) {
            long_press = true;
            mouse_move(finger_x, finger_y);
            right_button(true);
        }
        // the inertia of a scroll by a finger, slowing down
        if (finger < 0 && (abs_f32(speed_x) > 0.02 || abs_f32(speed_y) > 0.02)) {
            wheel += speed_y * elapsed as f32 / 40.0;
            wheel_x -= speed_x * elapsed as f32 / 40.0;
            f32 keep = elapsed > 0 ? max(1.0 - 0.004 * elapsed as f32, 0.0) : 1.0;
            speed_x *= keep;
            speed_y *= keep;
        }
    }

    // A finger on a touch screen (`platform.app.Touch`): the first one is the mouse. A tap is a
    // click, a long press (500 ms, with `clock`) the right button, and a finger that moves scrolls
    // the area under it, with inertia when it leaves.
    pub void touch(i64 id, f32 x, f32 y, Finger phase) {
        match (phase) {
            Down => {
                if (finger < 0) {
                    finger = id;
                    finger_x = x;
                    finger_y = y;
                    finger_time = now;
                    dragging = false;
                    last_clock = now;
                    long_press = false;
                    speed_x = 0.0;
                    speed_y = 0.0;
                    mouse_move(x, y);
                }
            },
            Move => {
                if (id != finger) {
                    return;
                }
                f32 dx = x - finger_x;
                f32 dy = y - finger_y;
                if (!dragging && !long_press && abs_f32(dx) + abs_f32(dy) > 8.0) {
                    dragging = true;
                }
                if (dragging) {
                    wheel += dy / 40.0;
                    wheel_x -= dx / 40.0;
                    u64 elapsed = max(now - last_clock, 1);
                    speed_x = dx / elapsed as f32;
                    speed_y = dy / elapsed as f32;
                    last_clock = now;
                    finger_x = x;
                    finger_y = y;
                }
            },
            Up => {
                if (id != finger) {
                    return;
                }
                if (!dragging && !long_press) {  // a tap: a click
                    mouse_move(x, y);
                    mouse_button(true);
                    mouse_button(false);
                }
                if (!dragging) {
                    speed_x = 0.0;
                    speed_y = 0.0;
                }
                finger = -1;
            },
            Cancel => {
                finger = -1;
                speed_x = 0.0;
                speed_y = 0.0;
            },
        }
    }

    // The safe area (`platform.app.SafeAreaChanged`): the frame is placed inside these margins.
    pub void safe_area(f32 left, f32 top, f32 right, f32 bottom) {
        safe_left = left;
        safe_top = top;
        safe_right = right;
        safe_bottom = bottom;
    }

    // The text an input method composes (`platform.app.TextEditing`): shown underlined at the cursor
    // until it is typed; an empty text ends it.
    pub void compose(str text, i32 cursor) {
        composing.set(text);
    }

    // The rectangle of the cursor of the text field that has the keyboard, at the last frame: give it
    // to `platform.app.set_text_input_area`.
    pub canvas.Rect caret_area() {
        return caret;
    }

    // Whether a text widget has the keyboard: the keyboard of the system is shown then, on a touch
    // screen.
    pub bool wants_text() {
        return editing;
    }

    // The input, as `platform.app` gives it.
    pub void mouse_move(f32 x, f32 y) {
        moved = moved || x != mouse_x || y != mouse_y;
        mouse_x = x;
        mouse_y = y;
    }

    // The left button, pressed or released.
    pub void mouse_button(bool is_down) {
        if (is_down) {
            pressed = true;
            bool near = abs_f32(mouse_x - press_x) <= 4.0 && abs_f32(mouse_y - press_y) <= 4.0;
            presses = has_clock && near && now - press_time <= 400 ? presses + 1 : 1;
            press_time = now;
            press_x = mouse_x;
            press_y = mouse_y;
        } else {
            released = true;
        }
        down = is_down;
    }

    // The right button, pressed or released: a press opens the context menu under the mouse.
    pub void right_button(bool is_down) {
        if (is_down) {
            right_pressed = true;
        }
    }

    // Closes the menus open from `level` on.
    void close_menus(usize level) {
        for (usize i in level..4) {
            menus[i] = 0;
            menu_cursor[i] = -1;
        }
    }

    // The entry of `states` of the widget `id`: its own, or a new one (a free entry, or one
    // not used during this frame).
    usize state_slot(u64 id) {
        for (usize i in 0..64) {
            if (states[i].id == id) {
                states[i].seen = true;
                return i;
            }
        }
        mut usize slot = 63;
        for (usize i in 0..64) {
            if (states[i].id == 0 || !states[i].seen) {
                slot = i;
                break;
            }
        }
        states[slot] = WidgetState{ id: id, seen: true };
        return slot;
    }

    bool has_state(u64 id) {
        for (usize i in 0..64) {
            if (states[i].id == id) {
                return true;
            }
        }
        return false;
    }

    // The sideways wheel (`platform.app.Wheel(x, y)`, x): it scrolls the area under the mouse.
    pub void scroll_wheel_x(f32 steps) {
        wheel_x += steps;
    }

    // Whether (x, y) is on the layer above: the list of a dropdown or a menu, open.
    bool on_layer(f32 x, f32 y) {
        if (contains(layer, x, y)) {
            return true;
        }
        for (usize i in 0..popup_count) {
            if (contains(popups[i], x, y)) {
                return true;
            }
        }
        return false;
    }

    // The mouse wheel turned by `steps` (`platform.app.Wheel`): it scrolls the list under the mouse.
    pub void scroll_wheel(f32 steps) {
        wheel += steps;
    }

    // Typed text, or the text of the clipboard for a paste (Ctrl+V).
    pub void type_text(str text) {
        composing.len = 0;  // what was composed is typed
        usize from = typed.len;
        if (edit_count < 64 && typed.insert(from, text)) {
            edits[edit_count] = Edit{ from: from, to: typed.len };
            edit_count += 1;
        }
    }

    // A key, with the key codes of SDL, and whether Shift and Ctrl (Cmd on macOS) are held.
    // Text fields use Left, Right, Home, End (Shift to select), Backspace, Delete, Enter, and
    // Ctrl+A, Ctrl+C and Ctrl+X.
    // Alt pressed and released alone is F10 (the menus); its release is needed for that.
    pub void key(u32 code, bool is_down, bool shift, bool ctrl) {
        shift_held = shift;
        if (code == 0x400000E2 || code == 0x400000E6) {  // left and right Alt
            if (is_down && !alt_down) {
                alt_down = true;
                alt_alone = true;
            } else if (!is_down) {
                if (alt_down && alt_alone && edit_count < 64) {
                    edits[edit_count] = Edit{ key: key_f10() };
                    edit_count += 1;
                }
                alt_down = false;
            }
            return;
        }
        if (is_down && edit_count < 64) {
            alt_alone = false;
            edits[edit_count] = Edit{ key: code, shift: shift, ctrl: ctrl, alt: alt_down };
            edit_count += 1;
        }
    }

    // Whether `code` was pressed in this frame, with these modifiers.
    bool pressed_key(u32 code, bool shift, bool ctrl) {
        for (usize i in 0..edit_count) {
            if (edits[i].key == code && edits[i].shift == shift && edits[i].ctrl == ctrl) {
                return true;
            }
        }
        return false;
    }

    // What Ctrl+C or Ctrl+X copied since the last call, for the clipboard.
    pub str? take_copied() {
        if (!has_copied) {
            return none;
        }
        has_copied = false;
        return some(copied.text());
    }

    // What a window button of the title bar asked since the last call, for `platform.app`.
    pub WindowRequest? take_window_request() {
        WindowRequest? asked = request;
        request = none;
        return asked;
    }

    // Whether the mouse at (x, y) moves the window: on the title bar of the last frame, and on
    // none of its interactive widgets, its window buttons, an open dropdown or menu. Labels drag.
    pub bool is_drag_area(f32 x, f32 y) {
        if (!custom_title_bar || !contains(bar, x, y) || contains(bar_buttons, x, y) || on_layer(x, y)) {
            return false;
        }
        for (usize i in 0..bar_widget_count) {
            if (contains(bar_widgets[i], x, y)) {
                return false;
            }
        }
        return true;
    }
}

// The size of a column or a row of a grid (spec §10.8): pixels, that of its content at the last
// frame, or a share of what is left, by weight.
pub enum Size {
    Pixels(f32 px),
    Auto,
    Fill(f32 weight),
}

// Where a widget goes in its cell, when it is narrower.
pub enum Align {
    Start,
    Center,
    End,
    Stretch,  // as wide as its cell
}

// Where the row of a `Tabs` is: above its content, or below it.
pub enum Side {
    Top,
    Bottom,
}

// What a finger does on a touch screen (`platform.app.TouchPhase`), for `Ui.touch`.
pub enum Finger {
    Down,
    Move,
    Up,
    Cancel,
}

// What a window button asks of the window.
pub enum WindowRequest {
    Minimize,
    ToggleMaximize,  // maximize, or restore when it is maximized
    Close,
}

canvas.Rect nowhere() {
    return canvas.Rect{ x: 0.0, y: 0.0, w: 0.0, h: 0.0 };
}

bool contains(canvas.Rect r, f32 x, f32 y) {
    return x >= r.x && x < r.x + r.w && y >= r.y && y < r.y + r.h;
}

// ---- Formats of text fields ----

// What a text field accepts, character by character.
pub enum Accept {
    Any,
    Digits,  // 0 to 9
    Integer,  // digits, and `-` first
    Decimal,  // digits, `-` first, and one separator, `.` or `,`
}

// The letter that `&` marks in `text` (spec §10.9), lower case: `"&Save"` gives `s`; `&&` is an `&`.
// 0 when there is none.
u8 mnemonic_of(str text) {
    mut usize i = 0;
    while (i + 1 < text.len) {
        if (text.bytes[i] == 38) {
            u8 c = text.bytes[i + 1];
            if (c != 38) {
                return c >= 65 && c <= 90 ? c + 32 : c;
            }
            i += 1;
        }
        i += 1;
    }
    return 0;
}

// A date of the calendar (spec §10.9), for a `DateField`.
pub struct Date {
    pub mut i32 year = 2000;
    pub mut i32 month = 1;
    pub mut i32 day = 1;
}

bool leap(i32 year) {
    return year % 4 == 0 && year % 100 != 0 || year % 400 == 0;
}

i32 days_in(i32 year, i32 month) {
    if (month == 2) {
        return leap(year) ? 29 : 28;
    }
    return month == 4 || month == 6 || month == 9 || month == 11 ? 30 : 31;
}

pub bool valid_date(Date d) {
    return d.year >= 1 && d.year <= 9999 && d.month >= 1 && d.month <= 12 && d.day >= 1 && d.day <= days_in(d.year, d.month);
}

// The day of the week of a date: 0 for Sunday (the method of Sakamoto).
i32 weekday(i32 year, i32 month, i32 day) {
    mut i32[12] shift = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4];
    i32 y = month < 3 ? year - 1 : year;
    return (y + y / 4 - y / 100 + y / 400 + shift[(month - 1) as usize] + day) % 7;
}

bool same_date(Date a, Date b) {
    return a.year == b.year && a.month == b.month && a.day == b.day;
}

// The format of a `DateField` that gives none.
pub str default_date_format() {
    return "dd/mm/yyyy";
}

// The mask of a date `format` (`dd/mm/yyyy`, `mm/dd/yyyy`, `yyyy-mm-dd`...): its letters become 9.
TextBuffer mask_of(str format) {
    mut TextBuffer m = TextBuffer{ };
    for (usize i in 0..format.len) {
        u8 c = format.bytes[i];
        m.append(c == 100 || c == 109 || c == 121 ? "9" : text_of(format.bytes[i..i + 1]));
    }
    return m;
}

// `d` written as `format` says.
TextBuffer format_date(Date d, str format) {
    mut TextBuffer out = TextBuffer{ };
    mut usize i = 0;
    while (i < format.len) {
        u8 c = format.bytes[i];
        mut usize run = 1;
        while (i + run < format.len && format.bytes[i + run] == c) {
            run += 1;
        }
        i32 value = c == 100 ? d.day : c == 109 ? d.month : c == 121 ? d.year : -1;
        if (value < 0) {
            out.append(text_of(format.bytes[i..i + run]));
        } else {
            mut u8[4] digits = [48; 4];
            mut i32 v = value;
            for (usize k in 0..run) {
                digits[run - 1 - k] = (48 + v % 10) as u8;
                v /= 10;
            }
            out.append(text_of(digits[0..run]));
        }
        i += run;
    }
    return out;
}

// The date of `text` typed as `format` says, if it is complete and valid.
Date? parse_date(str text, str format) {
    if (text.len != format.len) {
        return none;
    }
    mut Date d = Date{ year: 0, month: 0, day: 0 };
    for (usize i in 0..format.len) {
        u8 c = format.bytes[i];
        if (c != 100 && c != 109 && c != 121) {
            continue;
        }
        u8 t = text.bytes[i];
        if (t < 48 || t > 57) {
            return none;
        }
        i32 digit = (t - 48) as i32;
        if (c == 100) {
            d.day = d.day * 10 + digit;
        } else if (c == 109) {
            d.month = d.month * 10 + digit;
        } else {
            d.year = d.year * 10 + digit;
        }
    }
    return valid_date(d) ? some(d) : none;
}

// What a number field accepts and shows (spec §10.9): its range and step, its decimals (the value
// is an integer of hundredths with 2), its separators, and for money, its symbol.
pub struct Number {
    pub i64? min = none;
    pub i64? max = none;
    pub i64 step = 1;
    pub i32 decimals = 0;
    pub str decimal = ".";
    pub str group = "";  // between thousands, when the field does not have the keyboard
    pub str symbol = "";
    pub bool symbol_first = false;
}

// `value` written as `n` says: with its groups and its symbol when `decorated`.
TextBuffer format_number(i64 value, Number n, bool decorated) {
    mut u8[24] digits = [0; 24];
    mut usize count = 0;
    mut u64 rest = value < 0 ? (0 - (value + 1)) as u64 + 1 : value as u64;
    usize places = max(n.decimals, 0) as usize;
    while (count == 0 || rest > 0 || count <= places) {
        digits[count] = (48 + rest % 10) as u8;
        rest /= 10;
        count += 1;
    }
    mut TextBuffer out = TextBuffer{ };
    if (decorated && n.symbol_first && n.symbol.len > 0) {
        out.append(n.symbol);
    }
    if (value < 0) {
        out.append("-");
    }
    usize whole = count - places;
    for (usize i in 0..whole) {
        if (decorated && n.group.len > 0 && i > 0 && (whole - i) % 3 == 0) {
            out.append(n.group);
        }
        out.append(text_of(digits[count - 1 - i..count - i]));
    }
    if (places > 0) {
        out.append(n.decimal);
        for (usize i in whole..count) {
            out.append(text_of(digits[count - 1 - i..count - i]));
        }
    }
    if (decorated && !n.symbol_first && n.symbol.len > 0) {
        out.append(" ");
        out.append(n.symbol);
    }
    return out;
}

// The value of `text` typed in a number field: digits, a `-` first, a separator `.` or `,` and
// at most `decimals` digits after it; none when it is not one (yet).
i64? parse_number(str text, Number n) {
    usize places = max(n.decimals, 0) as usize;
    mut i64 value = 0;
    mut bool negative = false;
    mut bool digits = false;
    mut bool separated = false;
    mut usize after = 0;
    for (usize i in 0..text.len) {
        u8 c = text.bytes[i];
        if (c == 45 && i == 0) {
            negative = true;
        } else if ((c == 46 || c == 44) && !separated && places > 0) {
            separated = true;
        } else if (c >= 48 && c <= 57) {
            if (separated) {
                after += 1;
                if (after > places) {
                    return none;
                }
            }
            if (value > 922337203685477580) {
                return none;
            }
            value = value * 10 + (c - 48) as i64;
            digits = true;
        } else {
            return none;
        }
    }
    if (!digits) {
        return none;
    }
    for (usize i in after..places) {
        value *= 10;
    }
    return some(negative ? -value : value);
}

// `value` within the range of `n`.
i64 clamp_number(i64 value, Number n) {
    mut i64 v = value;
    match (n.min) {
        some(low) => {
            v = v < low ? low : v;
        },
        none => { },
    }
    match (n.max) {
        some(high) => {
            v = v > high ? high : v;
        },
        none => { },
    }
    return v;
}

// What a text area accepts (spec §10.9): lines broken at the last space that fits (`wrap`), Tab
// typing four spaces instead of moving the keyboard (`tabs`), a hint while it is empty.
pub struct Area {
    pub bool wrap = true;
    pub bool tabs = false;
    pub str placeholder = "";
}

// How a text area lays out its lines: their width (0: no wrapping), the size of the text and the
// height of a line.
struct AreaLayout {
    f32 width;
    f32 size;
    f32 line_h;
}

// A visual line of a text area: its bytes `start` to `end`, where the next one starts, and whether
// it is the last one.
struct Span {
    usize start;
    usize end;
    usize next;
    bool last;
}

// A visual line and its number.
struct Spot {
    Span span;
    i32 line;
}

// Whether the cursor at `at` is on `line`: at its end too, unless the next line starts there.
bool in_line(Span line, usize at) {
    return at >= line.start && (at < line.end || at == line.end && (line.next > line.end || line.last));
}

pub struct Format {
    pub Accept accept = Any;
    pub usize max = 0;  // characters at most; 0: as many as fit
    // 9: a digit, A: a letter, *: any character; the other characters are written as they
    // are, when the cursor reaches them (`99/99/9999` for a date). Empty: no mask.
    pub str mask = "";
    // A hint drawn, dimmed, while the text is empty (spec §10.7). Empty: none.
    pub str placeholder = "";
}

str text_of(u8[] bytes) {
    return match (str.from_bytes(bytes)) {
        ok(valid) => valid,
        err(e) => "",
    };
}

// Where the character after the one at byte `at` of `text` starts.
usize next_char(str text, usize at) {
    mut usize i = at + 1;
    while (i < text.len && text.bytes[i] & 0xC0 == 0x80) {
        i += 1;
    }
    return min(i, text.len);
}

usize chars_in(str text) {
    mut usize count = 0;
    for (char c in text.chars()) {
        count += 1;
    }
    return count;
}

bool is_digit(u8 b) {
    return b >= 48 && b <= 57;
}

// A letter: ASCII, or any character beyond it (é, ß, ж...).
bool is_letter(u8 b) {
    return b >= 65 && b <= 90 || b >= 97 && b <= 122 || b >= 0xC0;
}

bool is_slot(u8 m) {
    return m == 57 || m == 65 || m == 42;  // 9, A, *
}

// Whether a character starting with byte `first` can go in the slot `m` of a mask.
bool fits_slot(u8 m, u8 first) {
    return m == 42 || m == 57 && is_digit(first) || m == 65 && is_letter(first);
}

// Whether a character starting with byte `first` can go at `at` in `text`.
bool accepts(Accept accept, u8 first, str text, usize at) {
    bool minus = first == 45 && at == 0 && !has_byte(text, 45);
    bool separator = (first == 46 || first == 44) && !has_byte(text, 46) && !has_byte(text, 44);
    return match (accept) {
        Any => true,
        Digits => is_digit(first),
        Integer => is_digit(first) || minus,
        Decimal => is_digit(first) || minus || separator,
    };
}

bool has_byte(str text, u8 b) {
    for (u8 c in text.bytes) {
        if (c == b) {
            return true;
        }
    }
    return false;
}

// The colors of the widgets.
canvas.Color ink() {
    return canvas.Color{ r: 205, g: 214, b: 244 };
}

canvas.Color face(bool hot, bool held) {
    if (held) {
        return canvas.Color{ r: 49, g: 50, b: 68 };
    }
    return hot ? canvas.Color{ r: 88, g: 91, b: 112 } : canvas.Color{ r: 69, g: 71, b: 90 };
}

canvas.Color accent() {
    return canvas.Color{ r: 137, g: 180, b: 250 };
}

// The color of placeholders.
canvas.Color hint() {
    return canvas.Color{ r: 127, g: 132, b: 156 };
}

canvas.Color well() {
    return canvas.Color{ r: 24, g: 24, b: 37 };
}

// ---- Themes and styles (spec §10.7) ----

// A color from its components: `#RRGGBB` and `#RRGGBBAA` in .ui.sosu files.
pub canvas.Color rgb(u8 r, u8 g, u8 b, u8 a) {
    return canvas.Color{ r: r, g: g, b: b, a: a };
}

// What a theme or a style says about a widget, in a state or a part: each property may be left
// out, to come from a weaker rule.
pub struct Props {
    pub canvas.Color? color = none;  // of text
    pub canvas.Color? background = none;
    pub canvas.Color? border = none;  // its color
    pub f32? border_width = none;
    pub f32? radius = none;  // of the corners
    pub f32? padding = none;
    pub f32? gap = none;  // between the widgets of a column or a row
    pub f32? height = none;  // of a line of widgets
    pub f32? font_size = none;  // pixels per em
    pub canvas.Color? accent = none;  // marks, cursor, ring of the keyboard, selection
}

// A style, the class of CSS: properties, and those of the states and parts of a widget.
pub struct Style {
    pub Props normal = Props{ };
    pub Props hover = Props{ };
    pub Props pressed = Props{ };
    pub Props focus = Props{ };  // it has the keyboard
    pub Props disabled = Props{ };
    pub Props checked = Props{ };  // a checkbox checked, a radio chosen
    pub Props open = Props{ };  // a dropdown, a menu
    pub Props placeholder = Props{ };  // the hint of a field or of a dropdown
    pub Props selection = Props{ };  // the text selected, the item chosen
    pub Props bar = Props{ };  // the scroll bars
}

// A theme: a style for each kind of widget, and `all`, whose `color`, `font_size` and `accent`
// every widget inherits.
pub struct Theme {
    pub Props all = Props{ };
    pub Style window = Style{ };
    pub Style text = Style{ };
    pub Style title = Style{ };
    pub Style button = Style{ };
    pub Style text_field = Style{ };
    pub Style checkbox = Style{ };
    pub Style radio = Style{ };
    pub Style dropdown = Style{ };
    pub Style list = Style{ };
    pub Style scroll = Style{ };
    pub Style column = Style{ };
    pub Style row = Style{ };
    pub Style title_bar = Style{ };
    pub Style menu_bar = Style{ };
    pub Style menu = Style{ };
    pub Style image = Style{ };
    pub Style grid = Style{ };
    pub Style group = Style{ };  // its part `placeholder` is its title
    pub Style tabs = Style{ };  // a tab: `checked` the one chosen; the part `bar` the row
    pub Style tree = Style{ };
    pub Style slider = Style{ };  // its track; `accent`: its thumb and the part before it
    pub Style progress = Style{ };  // its track; `accent`: what is done
    pub Style tooltip = Style{ };
    pub Style dialog = Style{ };  // its window; the part `placeholder` is its title
    pub Style date = Style{ };  // the calendar of a date field; `checked`: the day chosen
    pub Style table = Style{ };  // its rows; the part `bar`: its header and its scroll bar
}

// The kinds of widgets, the selectors of a theme.
enum Kind {
    Window,
    Text,
    Title,
    Button,
    TextField,
    Checkbox,
    Radio,
    Dropdown,
    List,
    Scroll,
    Column,
    Row,
    TitleBar,
    MenuBar,
    Menu,
    Image,
    Grid,
    Group,
    Tabs,
    Tree,
    Slider,
    Progress,
    Tooltip,
    Dialog,
    Calendar,
    Table,
}

// The states of a widget, which can be combined.
u32 state_hover() {
    return 1;
}

u32 state_pressed() {
    return 2;
}

u32 state_focus() {
    return 4;
}

u32 state_disabled() {
    return 8;
}

u32 state_checked() {
    return 16;
}

u32 state_open() {
    return 32;
}

canvas.Color? or_color(canvas.Color? strong, canvas.Color? weak) {
    return match (strong) {
        some(c) => some(c),
        none => weak,
    };
}

f32? or_f32(f32? strong, f32? weak) {
    return match (strong) {
        some(v) => some(v),
        none => weak,
    };
}

// `strong` over `weak`: what `strong` says, else what `weak` says.
Props merge_props(Props weak, Props strong) {
    return Props{ color: or_color(strong.color, weak.color), background: or_color(strong.background, weak.background), border: or_color(strong.border, weak.border), border_width: or_f32(strong.border_width, weak.border_width), radius: or_f32(strong.radius, weak.radius), padding: or_f32(strong.padding, weak.padding), gap: or_f32(strong.gap, weak.gap), height: or_f32(strong.height, weak.height), font_size: or_f32(strong.font_size, weak.font_size), accent: or_color(strong.accent, weak.accent) };
}

// `strong` over `weak`, state by state and part by part: a theme that starts from another one.
pub Style merge(Style weak, Style strong) {
    return Style{ normal: merge_props(weak.normal, strong.normal), hover: merge_props(weak.hover, strong.hover), pressed: merge_props(weak.pressed, strong.pressed), focus: merge_props(weak.focus, strong.focus), disabled: merge_props(weak.disabled, strong.disabled), checked: merge_props(weak.checked, strong.checked), open: merge_props(weak.open, strong.open), placeholder: merge_props(weak.placeholder, strong.placeholder), selection: merge_props(weak.selection, strong.selection), bar: merge_props(weak.bar, strong.bar) };
}

// The theme `strong` over the theme `weak`, selector by selector: `theme Light : Dark`.
pub Theme over(Theme weak, Theme strong) {
    return Theme{ all: merge_props(weak.all, strong.all), window: merge(weak.window, strong.window), text: merge(weak.text, strong.text), title: merge(weak.title, strong.title), button: merge(weak.button, strong.button), text_field: merge(weak.text_field, strong.text_field), checkbox: merge(weak.checkbox, strong.checkbox), radio: merge(weak.radio, strong.radio), dropdown: merge(weak.dropdown, strong.dropdown), list: merge(weak.list, strong.list), scroll: merge(weak.scroll, strong.scroll), column: merge(weak.column, strong.column), row: merge(weak.row, strong.row), title_bar: merge(weak.title_bar, strong.title_bar), menu_bar: merge(weak.menu_bar, strong.menu_bar), menu: merge(weak.menu, strong.menu), image: merge(weak.image, strong.image), grid: merge(weak.grid, strong.grid), group: merge(weak.group, strong.group), tabs: merge(weak.tabs, strong.tabs), tree: merge(weak.tree, strong.tree), slider: merge(weak.slider, strong.slider), progress: merge(weak.progress, strong.progress), tooltip: merge(weak.tooltip, strong.tooltip), dialog: merge(weak.dialog, strong.dialog), date: merge(weak.date, strong.date), table: merge(weak.table, strong.table) };
}

// What `s` says about a widget in `states`, the states in the order of the spec.
Props in_states(Style s, u32 states) {
    mut Props p = s.normal;
    if (states & state_hover() != 0) {
        p = merge_props(p, s.hover);
    }
    if (states & state_pressed() != 0) {
        p = merge_props(p, s.pressed);
    }
    if (states & state_focus() != 0) {
        p = merge_props(p, s.focus);
    }
    if (states & state_disabled() != 0) {
        p = merge_props(p, s.disabled);
    }
    if (states & state_checked() != 0) {
        p = merge_props(p, s.checked);
    }
    if (states & state_open() != 0) {
        p = merge_props(p, s.open);
    }
    return p;
}

Style style_of(Theme t, Kind kind) {
    return match (kind) {
        Window => t.window,
        Text => t.text,
        Title => t.title,
        Button => t.button,
        TextField => t.text_field,
        Checkbox => t.checkbox,
        Radio => t.radio,
        Dropdown => t.dropdown,
        List => t.list,
        Scroll => t.scroll,
        Column => t.column,
        Row => t.row,
        TitleBar => t.title_bar,
        MenuBar => t.menu_bar,
        Menu => t.menu,
        Image => t.image,
        Grid => t.grid,
        Group => t.group,
        Tabs => t.tabs,
        Tree => t.tree,
        Slider => t.slider,
        Progress => t.progress,
        Tooltip => t.tooltip,
        Dialog => t.dialog,
        Calendar => t.date,
        Table => t.table,
    };
}

// The look of a widget: every property, resolved.
struct Look {
    canvas.Color color;
    canvas.Color background;
    canvas.Color border;
    f32 border_width;
    f32 radius;
    f32 padding;
    f32 gap;
    f32 height;
    f32 font_size;
    canvas.Color accent;
    canvas.Color hint;  // placeholders
    canvas.Color selection;
    canvas.Color bar;
}

// The scale of the built-in font for `size` pixels per em (9 a step).
i32 scale_of(f32 size) {
    return max((size / 9.0 + 0.5) as i32, 1);
}

canvas.Color clear() {
    return canvas.Color{ r: 0, g: 0, b: 0, a: 0 };
}

canvas.Color color_or(canvas.Color? c, canvas.Color fallback) {
    return match (c) {
        some(v) => v,
        none => fallback,
    };
}

f32 f32_or(f32? v, f32 fallback) {
    return match (v) {
        some(x) => x,
        none => fallback,
    };
}

// The theme of `ui` when the program sets none: the colors of the widgets since the start, so
// that a program without a theme looks as before. Its rules are in `default_look`.
pub Theme default_theme() {
    return Theme{ };
}

// The look of a widget of `kind` in `states` when no rule says otherwise: the weakest level
// of the cascade.
Look default_look(Kind kind, u32 states) {
    bool hot = states & state_hover() != 0;
    bool down = states & state_pressed() != 0;
    bool focus = states & state_focus() != 0;
    bool off = states & state_disabled() != 0;
    bool open = states & state_open() != 0;
    mut canvas.Color color = ink();
    mut canvas.Color background = clear();
    mut canvas.Color border = clear();
    mut f32 border_width = 0.0;
    mut f32 padding = 0.0;
    mut f32 font_size = 18.0;
    match (kind) {
        Title => {
            font_size = 27.0;
        },
        Button => {
            background = off ? well() : face(hot, down);
            color = off ? face(false, false) : ink();
            padding = 16.0;
        },
        TextField => {
            background = well();
            border = focus ? accent() : face(hot, false);
            border_width = 2.0;
            padding = 8.0;
        },
        Dropdown => {
            background = well();
            border = focus || open ? accent() : face(hot, false);
            border_width = 2.0;
            padding = 8.0;
        },
        List => {
            background = well();
            border = focus ? accent() : face(false, false);
            border_width = 2.0;
        },
        Scroll => {
            background = well();
            border = focus ? accent() : face(false, false);
            border_width = 2.0;
        },
        Checkbox => {
            background = face(hot, down);
        },
        Radio => {
            background = face(hot, down);
        },
        TitleBar => {
            background = rgb(17, 17, 27, 255);
        },
        MenuBar => {
            background = open ? face(false, true) : hot ? face(true, false) : clear();
            padding = 12.0;
        },
        Menu => {
            background = rgb(49, 50, 68, 255);
            border = face(true, false);
            border_width = 1.0;
        },
        Group => {
            border = face(true, false);
            border_width = 1.0;
            padding = 12.0;
        },
        Tabs => {  // a tab; the one chosen is `checked`
            bool chosen = states & state_checked() != 0;
            background = chosen ? well() : hot ? face(true, false) : clear();
            color = off ? face(false, false) : ink();
            padding = 14.0;
        },
        Tree => {
            background = well();
            border = focus ? accent() : face(false, false);
            border_width = 2.0;
        },
        Slider => {
            background = face(hot, false);
        },
        Progress => {
            background = well();
        },
        Dialog => {
            background = rgb(36, 39, 58, 255);
            border = face(true, false);
            border_width = 1.0;
            padding = 16.0;
        },
        Table => {
            background = well();
            border = focus ? accent() : face(false, false);
            border_width = 2.0;
        },
        Calendar => {
            background = rgb(49, 50, 68, 255);
            border = face(true, false);
            border_width = 1.0;
        },
        Tooltip => {
            background = rgb(49, 50, 68, 255);
            border = face(true, false);
            border_width = 1.0;
            padding = 8.0;
            font_size = 15.0;
        },
        _ => { },
    }
    return Look{ color: color, background: background, border: border, border_width: border_width, radius: 0.0, padding: padding, gap: 8.0, height: 32.0, font_size: font_size, accent: accent(), hint: hint(), selection: rgb(137, 180, 250, 90), bar: face(true, false) };
}

// A light theme, given by `ui`.
pub Theme light_theme() {
    canvas.Color text = rgb(76, 79, 105, 255);
    canvas.Color accent = rgb(30, 102, 245, 255);
    canvas.Color surface = rgb(204, 208, 218, 255);
    canvas.Color page = rgb(239, 241, 245, 255);
    canvas.Color mantle = rgb(230, 233, 239, 255);
    Props field = Props{ background: some(rgb(255, 255, 255, 255)), border: some(surface) };
    Props focus = Props{ border: some(accent) };
    return Theme{ all: Props{ color: some(text), accent: some(accent) }, window: Style{ normal: Props{ background: some(page) } }, button: Style{ normal: Props{ background: some(surface) }, hover: Props{ background: some(rgb(188, 192, 204, 255)) }, pressed: Props{ background: some(rgb(172, 176, 190, 255)) }, disabled: Props{ background: some(mantle), color: some(rgb(156, 160, 176, 255)) } }, text_field: Style{ normal: field, focus: focus, placeholder: Props{ color: some(rgb(140, 143, 161, 255)) } }, checkbox: Style{ normal: Props{ background: some(surface) }, hover: Props{ background: some(rgb(188, 192, 204, 255)) } }, radio: Style{ normal: Props{ background: some(surface) }, hover: Props{ background: some(rgb(188, 192, 204, 255)) } }, dropdown: Style{ normal: field, focus: focus, open: focus, placeholder: Props{ color: some(rgb(140, 143, 161, 255)) } }, list: Style{ normal: field, focus: focus }, scroll: Style{ normal: field, focus: focus, bar: Props{ background: some(rgb(172, 176, 190, 255)) } }, title_bar: Style{ normal: Props{ background: some(rgb(220, 224, 232, 255)) } }, menu_bar: Style{ hover: Props{ background: some(surface) }, open: Props{ background: some(rgb(188, 192, 204, 255)) } }, menu: Style{ normal: Props{ background: some(rgb(255, 255, 255, 255)), border: some(surface) } } };
}

// What a window of a `.ui.sosu` file says about itself (spec §10.2).
pub struct Window {
    pub str title = "Sosu";
    pub i32 width = 640;
    pub i32 height = 480;
    pub bool custom_title_bar = false;  // it draws its own title bar (`TitleBar`, spec §10.5)
    pub str icon = "";  // the path of its icon, a PNG file: "" for none
}

// A menu being described, open or not: its place, and its entries, drawn by `finish()` when
// it is open.
struct Popup {
    mut u64 id = 0;
    mut bool open = false;
    mut usize level = 0;
    mut f32 x = 0.0;
    mut f32 y = 0.0;
    mut f32 w = 0.0;  // the width it had at the last frame
    mut f32 h = 0.0;  // of its entries so far
    mut f32 widest = 0.0;  // of an entry, for its width at the next frame
    mut usize count = 0;
    mut str[24] labels = [""; 24];
    mut str[24] keys = [""; 24];  // the shortcuts
    mut u8[24] kinds = [0; 24];  // 0: an item, 1: a separator, 2: a submenu
    mut bool[24] enabled = [true; 24];
    mut u64[24] submenus = [0; 24];  // the identity of a submenu
}

// The key code of a shortcut such as "Ctrl+S", "Ctrl+Shift+Z", "F5" or "Delete", and its
// modifiers; the code 0 when it is not understood.
struct Shortcut {
    mut u32 code = 0;
    mut bool ctrl = false;
    mut bool shift = false;
}

bool same_text(str a, str b) {
    if (a.len != b.len) {
        return false;
    }
    for (usize i in 0..a.len) {
        u8 x = a.bytes[i] >= 65 && a.bytes[i] <= 90 ? a.bytes[i] + 32 : a.bytes[i];
        u8 y = b.bytes[i] >= 65 && b.bytes[i] <= 90 ? b.bytes[i] + 32 : b.bytes[i];
        if (x != y) {
            return false;
        }
    }
    return true;
}

// Whether `name` is in `text` at `at`.
bool same_bytes(str text, usize at, str name) {
    if (at + name.len > text.len) {
        return false;
    }
    for (usize i in 0..name.len) {
        if (text.bytes[at + i] != name.bytes[i]) {
            return false;
        }
    }
    return true;
}

// The key of a shortcut: a character (a letter, without case), F1 to F12, or a named key.
u32 key_named(str name) {
    if (name.len == 1) {
        u8 c = name.bytes[0];
        return (c >= 65 && c <= 90 ? c + 32 : c) as u32;
    }
    if (name.len >= 2 && name.len <= 3 && (name.bytes[0] == 70 || name.bytes[0] == 102)) {  // F1 to F12
        mut u32 n = 0;
        for (usize i in 1..name.len) {
            if (!is_digit(name.bytes[i])) {
                return 0;
            }
            n = n * 10 + (name.bytes[i] - 48) as u32;
        }
        return n >= 1 && n <= 12 ? 0x4000003A + n - 1 : 0;
    }
    if (same_text(name, "delete") || same_text(name, "del")) {
        return key_delete();
    }
    if (same_text(name, "enter")) {
        return key_enter();
    }
    if (same_text(name, "backspace")) {
        return key_backspace();
    }
    if (same_text(name, "tab")) {
        return 9;
    }
    if (same_text(name, "space")) {
        return 32;
    }
    return 0;
}

Shortcut parse_shortcut(str text) {
    mut Shortcut s = Shortcut{ };
    mut usize start = 0;
    for (usize i in 0..text.len + 1) {
        if (i < text.len && text.bytes[i] != 43) {  // +
            continue;
        }
        str part = text_of(text.bytes[start..i]);
        bool modifier = i < text.len;  // followed by +
        if (modifier && (same_text(part, "ctrl") || same_text(part, "cmd"))) {
            s.ctrl = true;
        } else if (modifier && same_text(part, "shift")) {
            s.shift = true;
        } else {
            s.code = key_named(part);
        }
        start = i + 1;
    }
    return s;
}

// A column or a row of widgets, being placed.
struct Layout {
    mut bool horizontal = false;
    mut f32 x = 0.0;  // where the next widget goes
    mut f32 y = 0.0;
    mut f32 left = 0.0;  // where its widgets start, inside its padding
    mut f32 top = 0.0;
    mut f32 right = 0.0;  // how far its widgets go
    mut f32 bottom = 0.0;
    mut f32 gap = 8.0;
    mut f32 padding = 0.0;
    // In a `Scroll` or a list: its entry of `Ui.states` (-1: neither), its identity, its
    // rectangle, the width of its vertical bar; in a list, the next item and the item chosen,
    // if the list has a choice.
    mut i32 area = -1;
    mut u64 area_id = 0;
    mut bool is_list = false;
    mut canvas.Rect frame = canvas.Rect{ x: 0.0, y: 0.0, w: 0.0, h: 0.0 };
    mut f32 bar_w = 0.0;
    mut f32 bar_h = 0.0;
    mut i32 item = 0;
    mut i32*? selected = none;
    // What its widgets inherit (spec §10.7), and, when it is painted (a background, a border),
    // its identity, which keeps its size from the last frame, and its look.
    mut canvas.Color? color = none;
    mut f32? font_size = none;
    mut canvas.Color? accent = none;
    mut u64 painted = 0;
    mut Look look = default_look(Column, 0);
    // The room its widgets have, from `left` and `top` (spec §10.8): what `Fill` fills; 0 when
    // it is not known (in a row, the height).
    mut f32 room_w = 0.0;
    mut f32 room_h = 0.0;
    mut i32 grid = -1;  // a grid: its entry of `Frame.grids`
    mut bool tree = false;  // a list that is a tree: its items are indented branches and leaves
    mut i32 long_count = -1;  // a long list: how many items it has (-1: not one)
    // A group: where its frame starts, its title (its width and height, 0: none), its look.
    mut bool group = false;
    mut f32 group_x = 0.0;
    mut f32 group_y = 0.0;
    mut f32 title_w = 0.0;
    mut f32 title_h = 0.0;
    mut bool folded = false;
}

// A `Tabs` being described (spec §10.8): its identity and its entry of `Ui.states`, the tab
// chosen, the tabs so far and where the next one goes in its row, the row and how far it is
// scrolled, whether the last tab was closed, and the keyboard marks before its content.
struct TabsBuild {
    mut u64 id = 0;
    mut usize slot = 0;
    mut i32*? bound = none;
    mut i32 chosen = 0;
    mut i32 count = 0;
    mut f32 x = 0.0;
    mut canvas.Rect row = canvas.Rect{ x: 0.0, y: 0.0, w: 0.0, h: 0.0 };
    mut f32 offset = 0.0;
    mut f32 width = 0.0;  // of the row with its arrows
    mut f32 top = 0.0;  // where the tabs start
    mut bool bottom = false;  // the row below the content
    mut bool reveal = false;  // the tab chosen was just chosen: it is scrolled into view
    mut bool closed = false;
    mut usize marks = 0;
    mut usize depth = 0;  // that of the layout of its content
}

// How the rows of a `Table` are sorted (spec §10.9): by `column` (-1: none), maybe descending. The
// program sorts them; the table shows it and changes it when a title is clicked.
pub struct Sort {
    pub mut i32 column = -1;
    pub mut bool descending = false;
}

// The table being described: its rectangle, rows, columns (titles, sizes, alignments), their places
// once laid out, the widths its cells measured in this frame, the next cell, and whether a row
// was activated (Enter, a double click).
struct TableBuild {
    mut u64 id = 0;
    mut canvas.Rect rect = canvas.Rect{ x: 0.0, y: 0.0, w: 0.0, h: 0.0 };
    mut i32 count = 0;
    mut i32*? selected = none;
    mut Sort*? sort = none;
    mut str[16] titles = [""; 16];
    mut Size[16] sizes = [Auto; 16];
    mut bool[16] sortable = [false; 16];
    mut Align[16] aligns = [Start; 16];
    mut usize columns = 0;
    mut f32[16] col_x = [0.0; 16];
    mut f32[16] col_w = [0.0; 16];
    mut f32[16] seen_w = [0.0; 16];
    mut usize memory = 0;
    mut usize cell = 0;
    mut bool cell_open = false;
    mut f32 row_y = 0.0;
    mut u64 area_id = 0;
    mut bool activated = false;
}

// A grid being described: its columns and rows, laid out at its first cell, the next free
// cell, the cell of the next widget, and the sizes measured in this frame, for the next one.
struct GridBuild {
    mut usize memory = 0;  // its entry of `Ui.grid_ids`
    mut Size[16] columns = [Auto; 16];
    mut usize column_count = 0;
    mut Size[64] rows = [Auto; 64];
    mut usize row_count = 0;
    mut bool ready = false;
    mut f32[16] col_x = [0.0; 16];
    mut f32[16] col_w = [0.0; 16];
    mut f32[65] row_y = [0.0; 65];
    mut f32[16] seen_w = [0.0; 16];
    mut f32[64] seen_h = [0.0; 64];
    mut i32 next_row = 0;
    mut i32 next_col = 0;
    mut bool has_cell = false;
    mut canvas.Rect cell = canvas.Rect{ x: 0.0, y: 0.0, w: 0.0, h: 0.0 };
    mut i32 cell_row = 0;
    mut i32 cell_col = 0;
    mut bool single_w = true;  // the cell spans one column: its widget measures it
    mut bool single_h = true;
    mut Align align = Start;
}

// The widgets of one frame, drawn on `surface`.
pub struct Frame {
    Ui* ui;
    canvas.Canvas* surface;
    // The layouts open, the frame itself first: a column, or a row inside, and so on.
    mut Layout[16] layouts = [Layout{ }; 16];
    mut usize depth = 0;
    // The identities (spec §10.6): the hash of each scope open, the root first; in each, the
    // widgets without a place so far and the iterations of its loop; the place given to the
    // next widget (`at`); scopes past the 16th, ignored; the identities used in this frame.
    mut u64[16] scopes = [0xCBF29CE484222325; 16];
    mut u32[16] calls = [0; 16];
    mut u64[16] iterations = [0; 16];
    mut u32[16] containers = [0; 16];  // the columns and rows painted so far, in each scope
    mut usize scope = 0;
    mut usize scopes_lost = 0;
    mut u32 site = 0;
    mut bool has_site = false;
    mut u64[256] used = [0; 256];
    mut usize used_count = 0;
    mut bool focus_wanted = false;  // `focus_here()`: the next widget takes the keyboard
    mut u64 last_id = 0;  // of the last widget, or of the last list or `Scroll`
    mut u64 placed_id = 0;  // the identity taken for the widget about to be placed
    // The widgets that take the keyboard, in the order of Tab.
    mut u64[256] order = [0; 256];
    mut usize order_count = 0;
    mut bool focus_taken = false;  // a widget took the focus in this frame
    // The styles given to the next node (`style`), and those of the node being described.
    mut Style[4] pending = [Style{ }; 4];
    mut usize pending_count = 0;
    mut Style[4] node_styles = [Style{ }; 4];
    mut usize node_style_count = 0;
    // The texts made in this frame (translations with values, numbers), until its end.
    mut u8[8192] pool = [0; 8192];
    mut usize pool_used = 0;
    f32 height = 32.0;  // of a line of widgets
    // The title bar being placed: the depth of its row (0: none), its rectangle, and the
    // interactive widgets in it.
    mut usize bar_depth = 0;
    mut canvas.Rect bar = nowhere();
    mut canvas.Rect[16] bar_widgets = [nowhere(); 16];
    mut usize bar_widget_count = 0;
    // The dropdown being described (-1: none) and its box; the list of the open one, drawn by
    // `finish()` above the rest: its owner, its rectangle, its options and the one chosen.
    mut u64 dropdown_id = 0;
    mut canvas.Rect box = nowhere();
    mut u64 layer_owner = 0;
    // The options of the dropdown being described so far, the one chosen, an option chosen
    // with Enter, and a move of the choice with Up or Down, applied at the next frame.
    mut i32 option_index = 0;
    mut i32 option_current = -1;
    mut i32 option_enter = -1;
    mut i32 option_move = 0;
    mut str dropdown_hint = "";  // its placeholder
    mut Look drop_look = default_look(Dropdown, 0);  // its look
    mut canvas.Rect layer = nowhere();
    mut str[16] options = [""; 16];
    mut usize option_count = 0;
    mut i32 option_chosen = -1;
    mut bool dropdown_pressed = false;  // a press went to a dropdown or to one of its options
    // The menus being described, one per level (`menu_level` of them), and those open, drawn by
    // `finish()`; a press that went to a menu, a right press that opened a context menu.
    mut Popup[4] menu_popups = [Popup{ }; 4];
    mut usize menu_level = 0;
    mut Popup[4] shown = [Popup{ }; 4];
    mut usize shown_count = 0;
    mut bool menu_pressed = false;
    mut bool right_taken = false;
    mut u64 keys_taken = 0;  // the edits a shortcut used: one item per key pressed
    mut bool editing = false;  // a text field has the keyboard
    mut str tip = "";  // the tooltip to draw at the end of the frame
    // The dialog being described: its widgets are those of `order` from `dialog_from`, its size is
    // kept in `dialog_slot`; whether one was open in this frame; `finishing`: the layers above are
    // being drawn.
    mut bool in_dialog = false;
    mut bool dialog_open = false;
    mut usize dialog_from = 0;
    mut usize dialog_to = 0;
    mut usize dialog_slot = 0;
    mut bool finishing = false;
    // The date field whose calendar is open (0: none), its date, and on which day weeks start.
    mut u64 cal_owner = 0;
    mut Date*? cal_date = none;
    mut bool cal_monday = true;
    mut bool no_edit = false;
    mut TableBuild table_build = TableBuild{ };  // the table being described (one at a time)
    mut i32 shown_first = 0;  // a long list: the items in view, `shown_first` to `shown_last` excluded
    mut i32 shown_last = 0;
    mut u32 letters_taken = 0;  // the letters of Alt+letter that a widget took in this frame
    mut bool tab_typed = false;  // a text area with `tabs` has the keyboard: Tab types
    // The rectangle of the last widget placed, or of the last list: what a context menu is for.
    mut canvas.Rect last = nowhere();
    // The titles of the bar of menus being described (`menu_bar`): its layout, their identities.
    mut usize menu_bar_depth = 0;
    mut u64[16] bar_titles = [0; 16];
    mut usize bar_title_count = 0;
    // The grids being described, the outermost first (spec §10.8).
    mut GridBuild[4] grids = [GridBuild{ }; 4];
    mut usize grid_count = 0;
    // The tabs being described, the outermost first, and how many times the widget that has the
    // keyboard was placed so far (Ctrl+Tab: whether it is inside the content of a `Tabs`).
    mut TabsBuild[4] tab_builds = [TabsBuild{ }; 4];
    mut usize tabs_count = 0;
    mut usize focus_marks = 0;
    mut Align next_align = Start;  // `align`: for the next widget placed in a column or a row
    // The tree being described: how deep its branches are open, and the index of the item of
    // each branch open around the next item (Left goes to it).
    mut usize tree_level = 0;
    mut i32[16] tree_parents = [-1; 16];
    mut bool tree_keys_used = false;  // the keys of this frame acted on an item already

    // The widgets that follow go under each other, `gap` pixels apart, inside `padding`,
    // until `end()`; the column then takes its place in the layout that holds it.
    // A negative `gap` or `padding`: that of the theme and of the styles (8 and 0 by default).
    pub void column(f32 gap, f32 padding) {
        open_styled(Column, false, gap, padding);
    }

    // The same, side by side.
    pub void row_with(f32 gap, f32 padding) {
        open_styled(Row, true, gap, padding);
    }

    pub void end() {
        if (depth == 0) {
            return;
        }
        Layout done = layouts[depth];
        depth -= 1;
        canvas.Rect r = place(done.right - done.left + 2.0 * done.padding, done.bottom - done.top + 2.0 * done.padding);
        if (done.painted != 0) {  // its size, for its background at the next frame; its border
            usize slot = ui.state_slot(done.painted);  // a variable: see the bug noted in `menu`
            WidgetState* s = &ui.states[slot];
            s.content_w = r.w;
            s.content_h = r.h;
            if (done.look.border.a > 0 && done.look.border_width > 0.0) {
                surface.stroke_rounded(r, done.look.radius, done.look.border, done.look.border_width);
            }
        }
    }

    // A column or a row, with the styles of its node: its gap and padding, its background (drawn
    // at the size it had at the last frame, since its widgets come after it), and what its
    // widgets inherit.
    void open_styled(Kind kind, bool horizontal, f32 gap, f32 padding) {
        ensure_cell();  // in a grid, it starts in its cell
        take_styles();
        Look l = look(kind, 0);
        Props p = explicit_props(kind, 0);
        Layout parent = layouts[depth];
        mut u64 painted = 0;
        if (l.background.a > 0 || l.border.a > 0 && l.border_width > 0.0) {
            painted = container_id();
            WidgetState s = ui.states[ui.state_slot(painted)];
            if (s.content_w > 0.0 && l.background.a > 0) {
                surface.fill_rounded(canvas.Rect{ x: parent.x, y: parent.y, w: s.content_w, h: s.content_h }, l.radius, l.background);
            }
        }
        usize before = depth;
        open(horizontal, gap >= 0.0 ? gap : l.gap, padding >= 0.0 ? padding : l.padding);
        if (depth > before) {
            layouts[depth].color = or_color(p.color, parent.color);
            layouts[depth].font_size = or_f32(p.font_size, parent.font_size);
            layouts[depth].accent = or_color(p.accent, parent.accent);
            layouts[depth].painted = painted;
            layouts[depth].look = l;
        }
    }

    // The widgets that follow go side by side, until `end_row()`.
    pub void row() {
        open_styled(Row, true, -1.0, -1.0);
    }

    pub void end_row() {
        end();
    }

    // Empty space after the last widget.
    pub void space(f32 size) {
        if (layouts[depth].horizontal) {
            layouts[depth].x += size;
        } else {
            layouts[depth].y += size;
        }
    }

    // Text, at the size of the widgets (font at scale 2).
    pub void label(str text) {
        take_styles();
        Look l = look(Text, 0);
        canvas.Rect size = measure_px(text, l.font_size);
        canvas.Rect r = place(size.w, max(size.h, l.height));
        write_px(r.x, r.y, r.h, text, l.color, l.font_size);
    }

    // An image `size` pixels high (0: its own height), as wide as its proportions say; in a
    // row higher than it, it is centered vertically.
    pub void image(image.Image img, f32 size) {
        take_styles();
        if (img.width <= 0 || img.height <= 0) {
            return;
        }
        f32 h = size > 0.0 ? size : img.height as f32;
        f32 w = h * img.width as f32 / img.height as f32;
        f32 box = layouts[depth].horizontal ? max(h, height) : h;
        canvas.Rect r = place(w, box);
        surface.draw_image(img, canvas.Rect{ x: r.x, y: r.y + (box - h) / 2.0, w: w, h: h });
    }

    // Bigger text (27 pixels per em, with the theme of `ui`).
    pub void title(str text) {
        take_styles();
        Look l = look(Title, 0);
        canvas.Rect size = measure_px(text, l.font_size);
        canvas.Rect r = place(size.w, size.h + 8.0);
        write_px(r.x, r.y, size.h, text, l.color, l.font_size);
    }

    // Returns true when it is clicked: pressed, then released over it.
    pub bool button(str text) {
        return button_enabled(text, true);
    }

    // A button that can be disabled: dimmed, and never clicked.
    // With the keyboard, Space or Enter clicks it.
    pub bool button_enabled(str text, bool enabled) {
        u64 id = take_id();
        take_styles();
        Look first = look(Button, enabled ? 0 : state_disabled());
        canvas.Rect size = measure_label(text, first.font_size);
        canvas.Rect r = place(size.w + 2.0 * first.padding, first.height);
        interactive(r);
        if (!enabled) {
            paint(r, first);
            write_label(r.x + first.padding, r.y, r.h, text, first.color, first.font_size);
            return false;
        }
        focusable(id, r);
        bool clicked = click(id, r) || activated(id, true) || alt_letter(text);
        bool hot = over(r);
        u32 states = (hot ? state_hover() : 0) | (ui.active == id && hot ? state_pressed() : 0) | (ui.focus == id ? state_focus() : 0);
        Look l = look(Button, states);
        paint(r, l);
        write_label(r.x + l.padding, r.y, r.h, text, l.color, l.font_size);
        if (ui.focus == id) {
            ring(r, l.accent);
        }
        return clicked;
    }

    // A box that `value` checks or not; returns true when it changes it (Space, with the
    // keyboard).
    pub bool checkbox(str text, bool* value) {
        u64 id = take_id();
        take_styles();
        Look first = look(Checkbox, 0);
        canvas.Rect size = measure_label(text, first.font_size);
        canvas.Rect r = place(size.w + 32.0, first.height);
        interactive(r);
        focusable(id, r);
        bool clicked = click(id, r) || activated(id, false) || alt_letter(text);
        if (clicked) {
            *value = !(*value);
        }
        bool hot = over(r);
        u32 states = (hot ? state_hover() : 0) | (ui.active == id && hot ? state_pressed() : 0) | (ui.focus == id ? state_focus() : 0) | (*value ? state_checked() : 0);
        Look l = look(Checkbox, states);
        canvas.Rect box = canvas.Rect{ x: r.x + 2.0, y: r.y + (r.h - 20.0) / 2.0, w: 20.0, h: 20.0 };
        paint(box, l);
        if (*value) {
            surface.fill_rounded(canvas.Rect{ x: box.x + 5.0, y: box.y + 5.0, w: 10.0, h: 10.0 }, max(l.radius - 3.0, 0.0), l.accent);
        }
        write_label(r.x + 32.0, r.y, r.h, text, l.color, l.font_size);
        if (ui.focus == id) {
            ring(r, l.accent);
        }
        return clicked;
    }

    // The same box, without a label.
    pub bool checkbox_alone(bool* value) {
        return checkbox("", value);
    }

    // A round button of a group, of which one is chosen: drawn chosen when `chosen`; returns
    // true when it is clicked (the program then chooses it, see `Radio` in .ui.sosu files).
    pub bool radio(str text, bool chosen) {
        u64 id = take_id();
        take_styles();
        Look first = look(Radio, 0);
        canvas.Rect size = measure_label(text, first.font_size);
        canvas.Rect r = place(size.w + 32.0, first.height);
        interactive(r);
        focusable(id, r);
        bool clicked = click(id, r) || activated(id, false) || alt_letter(text);
        bool hot = over(r);
        u32 states = (hot ? state_hover() : 0) | (ui.active == id && hot ? state_pressed() : 0) | (ui.focus == id ? state_focus() : 0) | (chosen ? state_checked() : 0);
        Look l = look(Radio, states);
        if (ui.focus == id) {
            ring(r, l.accent);
        }
        f32 cx = r.x + 12.0;
        f32 cy = r.y + r.h / 2.0;
        surface.fill_circle(cx, cy, 10.0, l.background);
        if (chosen) {
            surface.fill_circle(cx, cy, 5.0, l.accent);
        }
        write_label(r.x + 32.0, r.y, r.h, text, l.color, l.font_size);
        return clicked;
    }

    // A text field `width` pixels wide. A click gives it the keyboard and places the cursor,
    // dragging selects; returns true when Enter is pressed in it.
    pub bool text_field(TextBuffer* text, f32 width) {
        return text_field_with(text, width, Format{ });
    }

    // The same, keeping only what `format` accepts.
    pub bool text_field_with(TextBuffer* text, f32 width, Format format) {
        return field(short_target(text), width, format);
    }

    // A field of one line over a `LongText` (spec §10.9): as long as the text goes.
    pub bool text_field_long(LongText* text, f32 width, Format format) {
        return field(long_target(text), width, format);
    }

    bool field(Target text, f32 width, Format format) {
        return field_id(take_id(), text, width, format);
    }

    bool field_id(u64 id, Target text, f32 width, Format format) {
        take_styles();
        Look first = look(TextField, 0);
        f32 size = first.font_size;
        canvas.Rect r = place(width, first.height);
        interactive(r);
        canvas.Rect inner = canvas.Rect{ x: r.x + first.padding, y: r.y, w: max(width - 2.0 * first.padding, 0.0), h: r.h };
        if (ui.pressed && over(r)) {
            if (ui.focus != id) {
                ui.focus = id;
                ui.scroll = 0.0;
            }
            focus_taken = true;
            ui.active = id;
            ui.cursor = index_at(text, ui.mouse_x - inner.x + ui.scroll, size);
            ui.anchor = ui.cursor;
            select_by_clicks(text, 0, text.len());
        } else if (ui.focus == id && ui.active == id && ui.down && ui.presses < 2) {
            ui.cursor = index_at(text, ui.mouse_x - inner.x + ui.scroll, size);  // dragging selects
        }
        focusable(id, r);
        bool focused = ui.focus == id;
        mut bool entered = false;
        editing = editing || focused;
        if (focused) {
            // the text may have changed since the last frame (a Clear button)
            ui.cursor = min(ui.cursor, text.len());
            ui.anchor = min(ui.anchor, text.len());
            if (!no_edit) {  // the calendar of a date field takes the keys while it is open
                entered = edit(id, text, format, false);
            }
        }

        Look l = look(TextField, (over(r) ? state_hover() : 0) | (focused ? state_focus() : 0));
        paint(r, l);
        surface.push_clip(canvas.Rect{ x: inner.x - 2.0, y: r.y + 2.0, w: inner.w + 4.0, h: r.h - 4.0 });
        f32 caret = measure_px(text.slice(0, focused ? ui.cursor : 0), size).w;
        f32 line = min(20.0, r.h - 4.0);  // the height of the selection and of the cursor
        f32 line_y = r.y + (r.h - line) / 2.0;
        if (focused) {  // keep the cursor in view
            if (caret - ui.scroll > inner.w - 2.0) {
                ui.scroll = caret - inner.w + 2.0;
            }
            if (caret < ui.scroll) {
                ui.scroll = caret;
            }
        }
        f32 shift = focused ? ui.scroll : 0.0;
        if (focused && ui.anchor != ui.cursor) {
            f32 a = measure_px(text.slice(0, min(ui.anchor, ui.cursor)), size).w;
            f32 b = measure_px(text.slice(0, max(ui.anchor, ui.cursor)), size).w;
            surface.fill(canvas.Rect{ x: inner.x + a - shift, y: line_y, w: b - a, h: line }, l.selection);
        }
        if (text.len() == 0 && format.placeholder.len > 0) {
            write_px(inner.x, r.y, r.h, format.placeholder, l.hint, size);
        }
        if (focused && ui.composing.len > 0) {  // the composition, underlined, at the cursor
            str composed = ui.composing.text();
            f32 composed_w = measure_px(composed, size).w;
            f32 at = inner.x + caret - shift;
            write_px(inner.x - shift, r.y, r.h, text.slice(0, ui.cursor), l.color, size);
            write_px(at, r.y, r.h, composed, l.color, size);
            surface.fill(canvas.Rect{ x: at, y: line_y + line - 1.0, w: composed_w, h: 1.0 }, l.color);
            write_px(at + composed_w, r.y, r.h, text.slice(ui.cursor, text.len()), l.color, size);
        } else {
            write_px(inner.x - shift, r.y, r.h, text.text(), l.color, size);
        }
        if (focused) {
            surface.fill(canvas.Rect{ x: inner.x + caret - shift, y: line_y, w: 2.0, h: line }, l.accent);
            ui.caret = canvas.Rect{ x: inner.x + caret - shift, y: line_y, w: 2.0, h: line };
        }
        surface.pop_clip();
        return entered;
    }

    // A double click selects the word under the cursor, a triple click the text from `from` to
    // `to` (the line).
    void select_by_clicks(Target text, usize from, usize to) {
        if (ui.presses == 2) {
            str all = text.text();
            mut usize start = ui.cursor;
            mut usize end = ui.cursor;
            while (start > from && word_byte(all.bytes[text.previous(start)])) {
                start = text.previous(start);
            }
            while (end < to && word_byte(all.bytes[end])) {
                end = text.next(end);
            }
            ui.anchor = start;
            ui.cursor = end;
        } else if (ui.presses >= 3) {
            ui.anchor = from;
            ui.cursor = to;
        }
    }

    // The byte offset of the character boundary nearest to `x`, from the start of the text.
    usize index_at(Target text, f32 x, f32 size) {
        return index_in(text, 0, text.len(), x, size);
    }

    // The same, in the bytes `from` to `to` (a line), `x` from where they start.
    usize index_in(Target text, usize from, usize to, f32 x, f32 size) {
        mut usize at = from;
        mut f32 left = 0.0;
        while (at < to) {
            usize after = text.next(at);
            f32 right = measure_px(text.slice(from, after), size).w;
            if (x < (left + right) / 2.0) {
                return at;
            }
            left = right;
            at = after;
        }
        return to;
    }

    // Applies the edits of the frame to the text field `id` that has the keyboard, in order.
    // Returns true if Enter was pressed (Ctrl+Enter, with `lines`, where Enter breaks a line).
    bool edit(u64 id, Target text, Format format, bool lines) {
        if (ui.history_of != id) {  // another field: the history of the last one is forgotten
            ui.history_of = id;
            ui.change_count = 0;
            ui.change_at = 0;
            ui.history_used = 0;
        }
        mut bool entered = false;
        for (usize i in 0..ui.edit_count) {
            Edit e = ui.edits[i];
            usize start = min(ui.anchor, ui.cursor);
            usize end = max(ui.anchor, ui.cursor);
            if (e.key == 0) {
                type_into(text, ui.typed.slice(e.from, e.to), format);
            } else if (e.ctrl && e.key == 97) {  // Ctrl+A: all
                ui.anchor = 0;
                ui.cursor = text.len();
            } else if (e.ctrl && (e.key == 99 || e.key == 120)) {  // Ctrl+C, Ctrl+X
                if (start != end) {
                    ui.copied.set(text.slice(start, end));
                    ui.has_copied = true;
                    if (e.key == 120) {
                        erase_selection(text);
                    }
                }
            } else if (e.ctrl && (e.key == 122 && !e.shift)) {  // Ctrl+Z
                undo(text);
            } else if (e.ctrl && (e.key == 121 || e.key == 122)) {  // Ctrl+Y, Ctrl+Shift+Z
                redo(text);
            } else if (e.key == key_backspace() || e.key == key_delete()) {
                if (start == end) {
                    bool back = e.key == key_backspace();
                    ui.anchor = e.ctrl ? back ? word_left(text, ui.cursor) : word_right(text, ui.cursor) : back ? text.previous(ui.cursor) : text.next(ui.cursor);
                }
                erase_selection(text);
            } else if (e.key == key_left() || e.key == key_right()) {
                bool left = e.key == key_left();
                if (start != end && !e.shift && !e.ctrl) {
                    ui.cursor = left ? start : end;  // the selection ends where the arrow points
                } else if (e.ctrl) {
                    ui.cursor = left ? word_left(text, ui.cursor) : word_right(text, ui.cursor);
                } else {
                    ui.cursor = left ? text.previous(ui.cursor) : text.next(ui.cursor);
                }
                if (!e.shift) {
                    ui.anchor = ui.cursor;
                }
            } else if (!lines && (e.key == key_home() || e.key == key_end())) {
                ui.cursor = e.key == key_home() ? 0 : text.len();
                if (!e.shift) {
                    ui.anchor = ui.cursor;
                }
            } else if (e.key == key_enter()) {
                if (lines && !e.ctrl) {
                    type_into(text, "\n", format);
                } else {
                    entered = true;
                }
            }
        }
        return entered;
    }

    void erase_selection(Target text) {
        usize start = min(ui.anchor, ui.cursor);
        replace(text, start, max(ui.anchor, ui.cursor), "", false);
        ui.cursor = start;
        ui.anchor = start;
    }

    // The bytes `from` to `to` become `with`, and the change is kept for undo; `typing` joins it
    // to the letters typed just before. False if the text does not take it (too long).
    bool replace(Target text, usize from, usize to, str with, bool typing) {
        if (from == to && with.len == 0) {
            return true;
        }
        str removed = text.slice(from, to);
        // its texts, kept for undo (when they fit; else the history starts again)
        if (ui.history_used + removed.len + with.len > 4096 || ui.change_at == 64) {
            ui.change_count = 0;
            ui.change_at = 0;
            ui.history_used = 0;
        }
        bool fits = ui.history_used + removed.len + with.len <= 4096;
        mut bool joined = false;
        if (fits && typing && ui.change_at > 0 && ui.change_at == ui.change_count) {
            usize last = ui.change_at - 1;
            Change c = ui.changes[last];
            // a word joins the spaces after it; the letter after a space starts the next change
            bool word_starts = c.inserted_len > 0 && ui.history[ui.history_used - 1] == 32 && with.len > 0 && with.bytes[0] != 32;
            if (c.typing && !word_starts && c.at + c.inserted_len == from && c.text_at + c.removed_len + c.inserted_len == ui.history_used) {
                ui.changes[last].inserted_len += with.len;  // the next letter of a word typed
                joined = true;
            }
        }
        if (fits && !joined) {
            usize slot = ui.change_at;
            ui.changes[slot] = Change{ at: from, text_at: ui.history_used, removed_len: removed.len, inserted_len: with.len, typing: typing };
            for (usize i in 0..removed.len) {
                ui.history[ui.history_used + i] = removed.bytes[i];
            }
            ui.history_used += removed.len;
            ui.change_at += 1;
            ui.change_count = ui.change_at;  // what was undone cannot be redone after a change
        }
        if (fits) {
            for (usize i in 0..with.len) {
                ui.history[ui.history_used + i] = with.bytes[i];
            }
            ui.history_used += with.len;
        }
        text.remove(from, to);
        return text.insert(from, with);
    }

    // Undoes the last change: its inserted text becomes the removed one again.
    void undo(Target text) {
        if (ui.change_at == 0) {
            return;
        }
        ui.change_at -= 1;
        Change c = ui.changes[ui.change_at];
        str before = text_of(ui.history[c.text_at..c.text_at + c.removed_len]);
        text.remove(c.at, c.at + c.inserted_len);
        text.insert(c.at, before);
        ui.cursor = c.at + c.removed_len;
        ui.anchor = c.at;
    }

    // Does again the last change undone.
    void redo(Target text) {
        if (ui.change_at == ui.change_count) {
            return;
        }
        Change c = ui.changes[ui.change_at];
        ui.change_at += 1;
        usize from = c.text_at + c.removed_len;
        str after = text_of(ui.history[from..from + c.inserted_len]);
        text.remove(c.at, c.at + c.removed_len);
        text.insert(c.at, after);
        ui.cursor = c.at + c.inserted_len;
        ui.anchor = ui.cursor;
    }

    // Typed text, at the cursor, instead of the selection: each character that `format`
    // accepts, with the fixed characters of its mask written on the way.
    void type_into(Target text, str typed, Format format) {
        erase_selection(text);
        mut usize at = 0;
        while (at < typed.len) {
            usize after = next_char(typed, at);
            str piece = text_of(typed.bytes[at..after]);
            at = after;
            if (format.mask.len > 0) {
                mut usize position = chars_in(text.slice(0, ui.cursor));
                while (position < format.mask.len && !is_slot(format.mask.bytes[position])) {
                    str fixed = text_of(format.mask.bytes[position..position + 1]);
                    if (!replace(text, ui.cursor, ui.cursor, fixed, true)) {
                        return;
                    }
                    ui.cursor += 1;
                    position += 1;
                }
                if (position >= format.mask.len || !fits_slot(format.mask.bytes[position], piece.bytes[0])) {
                    continue;
                }
            } else if (!accepts(format.accept, piece.bytes[0], text.text(), ui.cursor)) {
                continue;
            }
            if (format.max > 0 && text.count() >= format.max) {
                return;
            }
            if (replace(text, ui.cursor, ui.cursor, piece, true)) {
                ui.cursor += piece.len;
            }
        }
        ui.anchor = ui.cursor;
    }

    // ---- Numbers and money (spec §10.9) ----

    // A field bound to an integer (spec §10.9): with `decimals`, a number of hundredths, thousandths...
    // While it has the keyboard, its text is typed freely; the value changes when the text is a
    // number in range, and the field shows the value again when it loses the keyboard. Up and
    // Down, the wheel when it has the keyboard, and its two buttons add or take `step`. Returns
    // true when the value changed.
    pub bool number_field(i64* value, f32 width, Number n) {
        u64 id = take_id();
        mut bool focused = ui.focus == id;
        if (focused && ui.number_of != id) {  // it just took the keyboard: the value, to edit
            ui.number_of = id;
            ui.number_text = format_number(*value, n, false);
        }
        mut i64 next = *value;
        if (focused) {
            for (usize i in 0..ui.edit_count) {
                u32 key = ui.edits[i].key;
                if (key == key_up() || key == key_down()) {
                    next = clamp_number(next + (key == key_up() ? n.step : -n.step), n);
                }
            }
        }
        mut TextBuffer shown = format_number(*value, n, true);
        Format accept = Format{ accept: n.decimals > 0 ? Decimal : Integer };
        field_id(id, focused ? short_target(&ui.number_text) : short_target(&shown), width, accept);
        canvas.Rect r = last;
        focused = ui.focus == id;
        if (focused && ui.number_of != id) {  // it took the keyboard in this frame (a click)
            ui.number_of = id;
            ui.number_text = format_number(*value, n, false);
            ui.cursor = ui.number_text.len;
            ui.anchor = 0;
        } else if (focused && ui.number_of == id) {
            match (parse_number(ui.number_text.text(), n)) {
                some(typed) => {
                    if (clamp_number(typed, n) == typed && next == *value) {
                        next = typed;
                    }
                },
                none => { },
            }
        }
        // the two buttons, on the right of the field, and the wheel
        Look l = look(TextField, 0);
        canvas.Rect up = canvas.Rect{ x: r.x + r.w - 20.0, y: r.y + 2.0, w: 18.0, h: r.h / 2.0 - 2.0 };
        canvas.Rect down = canvas.Rect{ x: up.x, y: r.y + r.h / 2.0, w: 18.0, h: r.h / 2.0 - 2.0 };
        if (click(mix(id, 1), up)) {
            next = clamp_number(next + n.step, n);
        }
        if (click(mix(id, 2), down)) {
            next = clamp_number(next - n.step, n);
        }
        if (focused && over(r) && ui.wheel != 0.0) {
            next = clamp_number(next + (ui.wheel > 0.0 ? n.step : -n.step), n);
            ui.wheel = 0.0;
        }
        for (i32 k in 0..2) {
            canvas.Rect b = k == 0 ? up : down;
            canvas.Color mark = over(b) ? l.accent : l.color;
            i32 cx = (b.x + 9.0) as i32;
            i32 cy = (b.y + b.h / 2.0) as i32;
            i32 dir = k == 0 ? -1 : 1;
            surface.line(cx - 4, cy - 2 * dir, cx, cy + 2 * dir, mark);
            surface.line(cx, cy + 2 * dir, cx + 4, cy - 2 * dir, mark);
        }
        bool changed = next != *value;
        if (changed) {
            *value = next;
            bool typed_now = match (parse_number(ui.number_text.text(), n)) {
                some(typed) => typed == next,
                none => false,
            };
            if (focused && !typed_now) {
                ui.number_text = format_number(next, n, false);  // a step: the text follows
                ui.cursor = ui.number_text.len;
                ui.anchor = ui.cursor;
            }
        }
        return changed;
    }

    // A number field for money: its symbol and its groups shown when it does not have the
    // keyboard; 2 decimals unless `n` says otherwise.
    pub bool money_field(i64* value, f32 width, Number n) {
        return number_field(value, width, n);
    }

    // ---- Mnemonics (spec §10.9) ----

    // `text` without its `&` (`&&` gives `&`); the byte where its letter is, in `at`.
    str shown_text(str text, usize* at) {
        *at = text.len;
        mut bool marked = false;
        for (u8 b in text.bytes) {
            marked = marked || b == 38;
        }
        if (!marked) {
            return text;
        }
        usize start = pool_used;
        mut usize i = 0;
        while (i < text.len && pool_used < 8192) {
            u8 b = text.bytes[i];
            if (b == 38 && i + 1 < text.len) {
                i += 1;
                if (text.bytes[i] != 38 && *at == text.len) {
                    *at = pool_used - start;
                }
            }
            pool[pool_used] = text.bytes[i];
            pool_used += 1;
            i += 1;
        }
        return text_of(pool[start..pool_used]);
    }

    // The size of `text` as it is drawn, without its `&`.
    canvas.Rect measure_label(str text, f32 size) {
        mut usize at = 0;
        return measure_px(shown_text(text, &at), size);
    }

    // `text` drawn without its `&`, its letter underlined while Alt is held or the menus have the
    // keyboard.
    void write_label(f32 x, f32 y, f32 box, str text, canvas.Color color, f32 size) {
        mut usize at = 0;
        str shown = shown_text(text, &at);
        write_px(x, y, box, shown, color, size);
        if (at < shown.len && (ui.alt_down || ui.bar_keys)) {
            f32 left = measure_px(text_of(shown.bytes[0..at]), size).w;
            f32 right = measure_px(text_of(shown.bytes[0..next_char(shown, at)]), size).w;
            f32 h = measure_px(shown, size).h;
            surface.fill(canvas.Rect{ x: x + left, y: y + (box + h) / 2.0 - 2.0, w: max(right - left, 1.0), h: 1.0 }, color);
        }
    }

    // Whether Alt and the letter of `text` were pressed: the first widget with that letter, in the
    // order of the frame, takes it.
    bool alt_letter(str text) {
        u8 letter = mnemonic_of(text);
        if (letter < 97 || letter > 122) {
            return false;
        }
        u32 bit = 1 << (letter - 97) as u32;
        if (letters_taken & bit != 0) {
            return false;
        }
        for (usize i in 0..ui.edit_count) {
            Edit e = ui.edits[i];
            if (e.alt && !e.ctrl && e.key == letter as u32) {
                letters_taken = letters_taken | bit;
                return true;
            }
        }
        return false;
    }

    // ---- Sliders, progress, tooltips (spec §10.9) ----

    // A slider bound to an integer from `low` to `high`, by `step`: its thumb is dragged, a click
    // on its track moves it there; Left and Right, Page Up and Page Down (a tenth), Home and End
    // with the keyboard. Returns true when the value changed.
    pub bool slider(i64* value, f32 width, i64 low, i64 high, i64 step) {
        u64 id = take_id();
        take_styles();
        Look first = look(Slider, 0);
        canvas.Rect r = place(width, first.height);
        interactive(r);
        focusable(id, r);
        i64 range = max(high - low, 1);
        f32 left = r.x + 8.0;
        f32 track = max(r.w - 16.0, 1.0);
        mut i64 next = *value;
        if (ui.pressed && over(r)) {
            ui.active = id;
        }
        if (ui.active == id && ui.down) {  // dragged, or clicked on its track
            f32 at = max(min((ui.mouse_x - left) / track, 1.0), 0.0);
            next = low + (at * range as f32 + 0.5) as i64;
        }
        if (ui.focus == id) {
            i64 page = max(range / 10, step);
            for (usize i in 0..ui.edit_count) {
                u32 key = ui.edits[i].key;
                if (key == key_left() || key == key_right()) {
                    next += key == key_left() ? -step : step;
                } else if (key == key_page_up() || key == key_page_down()) {
                    next += key == key_page_down() ? -page : page;
                } else if (key == key_home() || key == key_end()) {
                    next = key == key_home() ? low : high;
                }
            }
        }
        if (step > 1) {  // on a step from `low`
            next = low + (next - low + step / 2) / step * step;
        }
        next = next < low ? low : next > high ? high : next;
        bool changed = next != *value;
        *value = next;
        Look l = look(Slider, (over(r) ? state_hover() : 0) | (ui.active == id ? state_pressed() : 0) | (ui.focus == id ? state_focus() : 0));
        f32 x = left + track * (next - low) as f32 / range as f32;
        f32 cy = r.y + r.h / 2.0;
        surface.fill_rounded(canvas.Rect{ x: left, y: cy - 2.0, w: track, h: 4.0 }, 2.0, l.background);
        surface.fill_rounded(canvas.Rect{ x: left, y: cy - 2.0, w: x - left, h: 4.0 }, 2.0, l.accent);
        surface.fill_circle(x, cy, ui.active == id ? 9.0 : 8.0, l.accent);
        if (ui.focus == id) {
            ring(r, l.accent);
        }
        return changed;
    }

    // A bar that shows `value` of `max` done.
    pub void progress(i64 value, i64 max_value, f32 width) {
        take_styles();
        Look l = look(Progress, 0);
        canvas.Rect r = place(width, 12.0);
        f32 done = max_value > 0 ? min(max(value as f32 / max_value as f32, 0.0), 1.0) : 0.0;
        surface.fill_rounded(r, 6.0, l.background);
        if (done > 0.0) {
            surface.fill_rounded(canvas.Rect{ x: r.x, y: r.y, w: r.w * done, h: r.h }, 6.0, l.accent);
        }
    }

    // A bar for work whose end is not known: a part of it moves, with the time of `ui.clock`.
    pub void progress_busy(f32 width) {
        take_styles();
        Look l = look(Progress, 0);
        canvas.Rect r = place(width, 12.0);
        surface.fill_rounded(r, 6.0, l.background);
        f32 part = r.w / 4.0;
        f32 phase = (ui.now % 1500) as f32 / 1500.0;  // a round in a second and a half
        f32 x = r.x - part + (r.w + part) * phase;
        surface.push_clip(r);
        surface.fill_rounded(canvas.Rect{ x: x, y: r.y, w: part, h: r.h }, 6.0, l.accent);
        surface.pop_clip();
    }

    // A tooltip for the widget placed last: `text`, after 500 ms over it without moving, near the
    // mouse, above everything (drawn by `finish()`).
    pub void tooltip(str text) {
        canvas.Rect r = last;
        u64 key = last_id != 0 ? last_id : mix(r.x as u64 * 65536 + r.y as u64, 0x7007);
        if (!over(r)) {
            if (ui.tip_key == key) {
                ui.tip_key = 0;
            }
            return;
        }
        if (ui.tip_key != key || ui.moved) {  // the mouse came, or moved: the wait starts again
            ui.tip_key = key;
            ui.tip_since = ui.now;
        }
        if (ui.has_clock && ui.now - ui.tip_since >= 500) {
            tip = text;
        }
    }

    // Draws the tooltip of this frame, if any.
    void draw_tooltip() {
        if (tip.len == 0) {
            return;
        }
        take_styles();
        Look l = look(Tooltip, 0);
        canvas.Rect size = measure_px(tip, l.font_size);
        f32 w = size.w + 2.0 * l.padding;
        f32 h = size.h + l.padding;
        f32 x = min(ui.mouse_x + 12.0, max(surface.width as f32 - w - 4.0, 0.0));
        f32 y = ui.mouse_y + 20.0 + h > surface.height as f32 ? ui.mouse_y - h - 8.0 : ui.mouse_y + 20.0;
        canvas.Rect box = canvas.Rect{ x: x, y: y, w: w, h: h };
        paint(box, l);
        write_px(x + l.padding, y, h, tip, l.color, l.font_size);
    }

    // ---- Dates (spec §10.9) ----

    // A field bound to a date, typed through the mask of `format` (`dd/mm/yyyy`...), with a button
    // that opens a calendar of the month above the rest: its arrows change the month, a click or
    // Enter on a day chooses it, Escape closes it; with the keyboard, the arrows move the day,
    // Page Up and Page Down the month. Weeks start on Monday with `monday_first`. A date typed
    // that is not valid leaves the value as it was. Returns true when the date changed.
    pub bool date_field(Date* date, f32 width, str format, bool monday_first) {
        u64 id = take_id();
        bool open = ui.open == id;
        mut bool changed = false;
        mut Date next = *date;
        if (open && ui.focus == id) {  // the keys of the calendar
            for (usize i in 0..ui.edit_count) {
                u32 key = ui.edits[i].key;
                mut i32 move = 0;
                if (key == key_left() || key == key_right()) {
                    move = key == key_left() ? -1 : 1;
                } else if (key == key_up() || key == key_down()) {
                    move = key == key_up() ? -7 : 7;
                } else if (key == key_page_up() || key == key_page_down()) {
                    calendar_month(key == key_page_up() ? -1 : 1);
                } else if (key == key_enter() || key == key_space()) {
                    next = Date{ year: ui.cal_year, month: ui.cal_month, day: ui.cal_day };
                    ui.open = 0;
                } else if (key == 27) {
                    ui.open = 0;
                }
                if (move != 0) {
                    ui.cal_day += move;
                    if (ui.cal_day < 1) {
                        calendar_month(-1);
                        ui.cal_day += days_in(ui.cal_year, ui.cal_month);
                    } else if (ui.cal_day > days_in(ui.cal_year, ui.cal_month)) {
                        ui.cal_day -= days_in(ui.cal_year, ui.cal_month);
                        calendar_month(1);
                    }
                }
            }
        }
        no_edit = open;
        mut TextBuffer shown = format_date(*date, format);
        TextBuffer mask = mask_of(format);
        bool focused_before = ui.focus == id;
        field_id(id, focused_before && ui.date_of == id ? short_target(&ui.date_text) : short_target(&shown), width, Format{ mask: mask.text() });
        no_edit = false;
        canvas.Rect r = last;
        bool focused = ui.focus == id;
        if (focused && ui.date_of != id) {  // it took the keyboard: the date, to edit
            ui.date_of = id;
            ui.date_text = format_date(*date, format);
            ui.cursor = ui.date_text.len;
            ui.anchor = 0;
        } else if (focused && !open) {
            match (parse_date(ui.date_text.text(), format)) {
                some(typed) => {
                    next = typed;
                },
                none => { },
            }
        }
        // its button, and the calendar above the rest
        canvas.Rect button = canvas.Rect{ x: r.x + r.w - 26.0, y: r.y + 4.0, w: 22.0, h: r.h - 8.0 };
        interactive(button);
        if (click(mix(id, 1), button)) {
            if (ui.open == id) {
                ui.open = 0;
            } else {
                ui.open = id;
                ui.focus = id;
                Date from = valid_date(*date) ? *date : Date{ };
                ui.cal_year = from.year;
                ui.cal_month = from.month;
                ui.cal_day = from.day;
            }
        }
        if (ui.pressed && over(button)) {
            dropdown_pressed = true;  // the click that opens it does not close it
        }
        Look l = look(TextField, 0);
        canvas.Color mark = over(button) || ui.open == id ? l.accent : l.color;
        surface.stroke(canvas.Rect{ x: button.x + 4.0, y: button.y + 4.0, w: 14.0, h: button.h - 8.0 }, mark, 1.0);
        surface.fill(canvas.Rect{ x: button.x + 4.0, y: button.y + 4.0, w: 14.0, h: 3.0 }, mark);
        if (ui.open == id) {
            canvas.Rect popup = canvas.Rect{ x: r.x, y: r.y + r.h + 2.0, w: 7.0 * 32.0 + 16.0, h: 32.0 + 24.0 + 6.0 * 28.0 + 8.0 };
            layer = popup;
            layer_owner = id;
            cal_owner = id;
            cal_date = some(date);
            cal_monday = monday_first;
            if (ui.pressed && contains(ui.layer, ui.mouse_x, ui.mouse_y)) {
                dropdown_pressed = true;
                f32 mx = ui.mouse_x - popup.x;
                f32 my = ui.mouse_y - popup.y;
                if (my < 32.0) {  // the arrows of the month
                    if (mx < 40.0) {
                        calendar_month(-1);
                    } else if (mx > popup.w - 40.0) {
                        calendar_month(1);
                    }
                } else if (my >= 56.0) {
                    i32 col = ((mx - 8.0) / 32.0) as i32;
                    i32 row = ((my - 56.0) / 28.0) as i32;
                    i32 day = row * 7 + col - first_column(monday_first) + 1;
                    if (col >= 0 && col < 7 && day >= 1 && day <= days_in(ui.cal_year, ui.cal_month)) {
                        next = Date{ year: ui.cal_year, month: ui.cal_month, day: day };
                        ui.open = 0;
                    }
                }
            }
        }
        if (!same_date(next, *date) && valid_date(next)) {
            *date = next;
            changed = true;
            if (focused) {
                ui.date_text = format_date(next, format);
                ui.cursor = ui.date_text.len;
                ui.anchor = ui.cursor;
            }
        }
        return changed;
    }

    // The calendar shows the month before (-1) or after (1).
    void calendar_month(i32 by) {
        ui.cal_month += by;
        if (ui.cal_month < 1) {
            ui.cal_month = 12;
            ui.cal_year -= 1;
        } else if (ui.cal_month > 12) {
            ui.cal_month = 1;
            ui.cal_year += 1;
        }
        ui.cal_day = min(ui.cal_day, days_in(ui.cal_year, ui.cal_month));
    }

    // The column of the first day of the month shown.
    i32 first_column(bool monday_first) {
        i32 first = weekday(ui.cal_year, ui.cal_month, 1);
        return monday_first ? (first + 6) % 7 : first;
    }

    // The calendar of the date field that has it open, above everything.
    void draw_calendar() {
        canvas.Rect r = layer;
        Look l = look(Calendar, 0);
        paint(r, l);
        mut str[12] months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
        mut str[7] days = ["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"];
        str title = tr(months[(ui.cal_month - 1) as usize]);
        str year = decimal(ui.cal_year as i64);
        canvas.Rect size = measure_px(title, l.font_size);
        write_px(r.x + (r.w - size.w - 50.0) / 2.0, r.y, 32.0, title, l.color, l.font_size);
        write_px(r.x + (r.w + size.w - 40.0) / 2.0, r.y, 32.0, year, l.color, l.font_size);
        for (i32 k in 0..2) {  // the arrows
            i32 cx = (k == 0 ? r.x + 20.0 : r.x + r.w - 20.0) as i32;
            i32 cy = (r.y + 16.0) as i32;
            i32 dir = k == 0 ? -1 : 1;
            surface.line(cx + 2 * dir * -1, cy - 5, cx + 3 * dir, cy, l.color);
            surface.line(cx + 3 * dir, cy, cx + 2 * dir * -1, cy + 5, l.color);
        }
        for (i32 c in 0..7) {
            i32 index = cal_monday ? (c + 1) % 7 : c;
            write_px(r.x + 8.0 + c as f32 * 32.0 + 6.0, r.y + 32.0, 24.0, tr(days[index as usize]), l.hint, l.font_size * 0.8);
        }
        Date chosen = match (cal_date) {
            some(d) => *d,
            none => Date{ },
        };
        i32 offset = first_column(cal_monday);
        for (i32 day in 1..days_in(ui.cal_year, ui.cal_month) + 1) {
            i32 cell = day - 1 + offset;
            canvas.Rect box = canvas.Rect{ x: r.x + 8.0 + (cell % 7) as f32 * 32.0, y: r.y + 56.0 + (cell / 7) as f32 * 28.0, w: 30.0, h: 26.0 };
            bool is_chosen = chosen.year == ui.cal_year && chosen.month == ui.cal_month && chosen.day == day;
            if (is_chosen) {
                surface.fill_rounded(box, 4.0, l.accent);
            } else if (contains(box, ui.mouse_x, ui.mouse_y)) {
                surface.fill_rounded(box, 4.0, face(true, false));
            }
            if (day == ui.cal_day) {  // the day of the keyboard
                surface.stroke_rounded(box, 4.0, l.accent, 1.0);
            }
            str number = decimal(day as i64);
            canvas.Rect n = measure_px(number, l.font_size * 0.9);
            write_px(box.x + (box.w - n.w) / 2.0, box.y, box.h, number, is_chosen ? well() : l.color, l.font_size * 0.9);
        }
    }

    // ---- Dialogs (spec §10.9) ----

    // A dialog, while `open`: a window inside the window, centered, `width` wide, over a darkened
    // backdrop. Its widgets follow, until `end_dialog()`, and only they see the mouse and the
    // keys (from the next frame). Escape, or its cross, sets `open` to false. Describe it after the
    // rest of the window (a .ui.sosu file does it), so that it is drawn above.
    pub bool dialog(str title, f32 width, bool* open) {
        u64 id = take_id();
        if (!(*open)) {
            return false;
        }
        take_styles();
        if (ui.pressed_key(27, false, false)) {  // Escape
            *open = false;
            return false;
        }
        in_dialog = true;
        Look l = look(Dialog, 0);
        usize slot = ui.state_slot(id);
        WidgetState kept = ui.states[slot];
        f32 sw = surface.width as f32;
        f32 sh = surface.height as f32;
        surface.fill(canvas.Rect{ x: 0.0, y: 0.0, w: sw, h: sh }, canvas.Color{ r: 0, g: 0, b: 0, a: 120 });
        f32 title_h = 40.0;
        f32 w = min(width, sw - 16.0);
        f32 h = kept.content_h > 0.0 ? kept.content_h + title_h + l.padding : 160.0;
        f32 x = (sw - w) / 2.0;
        f32 y = max((sh - h) / 2.0, 8.0);
        canvas.Rect r = canvas.Rect{ x: x, y: y, w: w, h: h };
        paint(r, l);
        canvas.Color ink_of = color_or(part(Dialog, 0).color, l.color);
        write_px(x + l.padding, y, title_h, title, ink_of, l.font_size);
        canvas.Rect cross = canvas.Rect{ x: x + w - 36.0, y: y + 6.0, w: 28.0, h: 28.0 };
        if (click(mix(id, 1), cross)) {
            *open = false;
        }
        canvas.Color mark = over(cross) ? l.accent : ink_of;
        i32 cx = (cross.x + 14.0) as i32;
        i32 cy = (cross.y + 14.0) as i32;
        surface.line(cx - 5, cy - 5, cx + 5, cy + 5, mark);
        surface.line(cx - 5, cy + 5, cx + 5, cy - 5, mark);
        dialog_from = order_count;
        dialog_slot = slot;
        if (depth == 15) {
            return true;
        }
        f32 left = x + l.padding;
        f32 top = y + title_h;
        depth += 1;
        layouts[depth] = Layout{ x: left, y: top, left: left, top: top, right: left, bottom: top, gap: l.gap, room_w: max(w - 2.0 * l.padding, 0.0) };
        return true;
    }

    // The end of the widgets of the dialog.
    pub void end_dialog() {
        if (!in_dialog) {
            return;
        }
        Layout done = layouts[depth];
        if (depth > 0) {
            depth -= 1;
        }
        usize slot = dialog_slot;  // a variable: see the bug noted in `menu`
        WidgetState* s = &ui.states[slot];
        s.content_h = done.bottom - done.top;
        in_dialog = false;
        dialog_open = true;
        dialog_to = order_count;
    }

    // ---- Text areas (spec §10.9) ----

    // Text on several lines, `rows` lines high, bound to a `LongText`. Enter breaks a line,
    // Ctrl+Enter returns true (`on_enter`); Up and Down keep the column of the cursor, Page Up and
    // Page Down move by the height of the area, Home and End go to the ends of the line, Ctrl+Home
    // and Ctrl+End to those of the text. The area scrolls to keep the cursor in view.
    pub bool text_area(LongText* text, f32 width, i32 rows, Area options) {
        Target t = long_target(text);
        u64 id = take_id();
        take_styles();
        Look first = look(TextField, 0);
        f32 size = first.font_size;
        f32 line_h = measure_px("Ag", size).h + 4.0;
        f32 pad = first.padding;
        canvas.Rect r = place(width, max(rows, 1) as f32 * line_h + 2.0 * pad);
        interactive(r);
        usize slot = ui.state_slot(id);
        f32 text_w = max(r.w - 2.0 * pad - 10.0, 10.0);  // 10: the scroll bar
        canvas.Rect inner = canvas.Rect{ x: r.x + pad, y: r.y + pad, w: text_w, h: r.h - 2.0 * pad };
        AreaLayout layout = AreaLayout{ width: options.wrap ? text_w : 0.0, size: size, line_h: line_h };
        f32 scroll = ui.states[slot].scroll_y;
        if (ui.pressed && over(r)) {
            if (ui.focus != id) {
                ui.focus = id;
            }
            focus_taken = true;
            ui.active = id;
            ui.cursor = area_index(t, layout, ui.mouse_x - inner.x, ui.mouse_y - inner.y + scroll);
            ui.anchor = ui.cursor;
            Span line = logical_line(t, ui.cursor);
            select_by_clicks(t, line.start, line.end);
        } else if (ui.focus == id && ui.active == id && ui.down && ui.presses < 2) {
            ui.cursor = area_index(t, layout, ui.mouse_x - inner.x, ui.mouse_y - inner.y + scroll);
        }
        focusable(id, r);
        bool focused = ui.focus == id;
        mut bool entered = false;
        editing = editing || focused;
        if (focused) {
            ui.cursor = min(ui.cursor, t.len());
            ui.anchor = min(ui.anchor, t.len());
            if (options.tabs) {  // Tab types spaces instead of moving the keyboard
                tab_typed = true;
                for (usize i in 0..ui.edit_count) {
                    if (ui.edits[i].key == key_tab() && !ui.edits[i].ctrl && !ui.edits[i].shift) {
                        ui.edits[i] = Edit{ from: ui.typed.len, to: ui.typed.len + 4 };
                        ui.typed.append("    ");
                    }
                }
            }
            entered = edit(id, t, Format{ }, true);
            area_keys(t, layout, inner.h);
        }

        Look l = look(TextField, (over(r) ? state_hover() : 0) | (focused ? state_focus() : 0));
        paint(r, l);
        // where the cursor is, to keep it in view
        if (focused) {
            Spot at = spot_of(t, layout, ui.cursor);
            f32 top = at.line as f32 * line_h;
            WidgetState* s = &ui.states[slot];
            s.scroll_y = min(s.scroll_y, top);
            s.scroll_y = max(s.scroll_y, top + line_h - inner.h);
        }
        WidgetState kept = ui.states[slot];
        surface.push_clip(canvas.Rect{ x: inner.x - 2.0, y: r.y + 2.0, w: inner.w + 4.0, h: r.h - 4.0 });
        usize low = min(ui.anchor, ui.cursor);
        usize high = max(ui.anchor, ui.cursor);
        mut usize from = 0;
        mut i32 index = 0;
        while (true) {
            Span line = span_of(t, layout, from);
            f32 y = inner.y + index as f32 * line_h - kept.scroll_y;
            if (y + line_h >= r.y && y <= r.y + r.h) {  // in view
                if (focused && low < high && low <= line.end && high >= line.start) {
                    usize a = max(low, line.start);
                    usize b = min(high, line.end);
                    f32 xa = measure_px(t.slice(line.start, a), size).w;
                    f32 xb = measure_px(t.slice(line.start, b), size).w + (high > line.end && !line.last ? 6.0 : 0.0);
                    surface.fill(canvas.Rect{ x: inner.x + xa, y: y, w: xb - xa, h: line_h }, l.selection);
                }
                write_px(inner.x, y, line_h, t.slice(line.start, line.end), l.color, size);
                if (focused && in_line(line, ui.cursor)) {
                    f32 cx = measure_px(t.slice(line.start, ui.cursor), size).w;
                    surface.fill(canvas.Rect{ x: inner.x + cx, y: y + 2.0, w: 2.0, h: line_h - 4.0 }, l.accent);
                    ui.caret = canvas.Rect{ x: inner.x + cx, y: y + 2.0, w: 2.0, h: line_h - 4.0 };
                }
            }
            index += 1;
            if (line.last) {
                break;
            }
            from = line.next;
        }
        if (t.len() == 0 && options.placeholder.len > 0) {
            write_px(inner.x, inner.y, line_h, options.placeholder, l.hint, size);
        }
        surface.pop_clip();
        // the scroll bar, and the wheel
        f32 content = index as f32 * line_h;
        WidgetState* s = &ui.states[slot];
        s.content_h = content;
        if (over(r) && content > inner.h && ui.wheel != 0.0) {
            s.scroll_y -= ui.wheel * line_h * 3.0;
            ui.wheel = 0.0;
        }
        s.scroll_y = max(min(s.scroll_y, content - inner.h), 0.0);
        if (content > inner.h) {
            f32 thumb = max(inner.h * inner.h / content, 16.0);
            f32 ty = inner.y + (inner.h - thumb) * s.scroll_y / (content - inner.h);
            surface.fill(canvas.Rect{ x: r.x + r.w - 7.0, y: ty, w: 4.0, h: thumb }, l.bar);
        }
        return entered;
    }

    // Up, Down, Page Up, Page Down, Home, End (Ctrl: of the text) in a text area.
    void area_keys(Target t, AreaLayout layout, f32 view_h) {
        i32 page = max((view_h / layout.line_h) as i32 - 1, 1);
        for (usize i in 0..ui.edit_count) {
            Edit e = ui.edits[i];
            Spot at = spot_of(t, layout, ui.cursor);
            mut i32 to_line = -1;
            if (e.key == key_up() || e.key == key_down()) {
                to_line = at.line + (e.key == key_up() ? -1 : 1);
            } else if (e.key == key_page_up() || e.key == key_page_down()) {
                to_line = at.line + (e.key == key_page_up() ? -page : page);
            } else if (e.key == key_home() || e.key == key_end()) {
                if (e.ctrl) {
                    ui.cursor = e.key == key_home() ? 0 : t.len();
                } else {
                    ui.cursor = e.key == key_home() ? at.span.start : at.span.end;
                }
            } else {
                continue;
            }
            if (to_line >= 0 || e.key == key_up() || e.key == key_page_up()) {
                Span target = line_number(t, layout, max(to_line, 0));
                f32 x = measure_px(t.slice(at.span.start, ui.cursor), layout.size).w;
                ui.cursor = to_line < 0 ? 0 : index_in(t, target.start, target.end, x, layout.size);
            }
            if (!e.shift) {
                ui.anchor = ui.cursor;
            }
        }
    }

    // The visual line that starts at `from`: up to a line break, or, when wrapping, to the last
    // space that fits (else to the last character that fits).
    Span span_of(Target t, AreaLayout layout, usize from) {
        str all = t.text();
        usize n = t.len();
        mut usize at = from;
        mut f32 w = 0.0;
        mut usize space = n + 1;  // the last space that fits, if any
        while (at < n) {
            if (all.bytes[at] == 10) {  // a line break
                return Span{ start: from, end: at, next: at + 1, last: false };
            }
            usize after = t.next(at);
            w += measure_px(t.slice(at, after), layout.size).w;
            if (layout.width > 0.0 && w > layout.width && at > from) {
                if (space <= n) {
                    return Span{ start: from, end: space, next: space + 1, last: false };
                }
                return Span{ start: from, end: at, next: at, last: false };
            }
            if (all.bytes[at] == 32) {
                space = at;
            }
            at = after;
        }
        return Span{ start: from, end: n, next: n, last: true };
    }

    // The visual line `number` (from 0), or the last one.
    Span line_number(Target t, AreaLayout layout, i32 number) {
        mut usize from = 0;
        mut i32 k = 0;
        while (true) {
            Span line = span_of(t, layout, from);
            if (k == number || line.last) {
                return line;
            }
            from = line.next;
            k += 1;
        }
        return span_of(t, layout, 0);
    }

    // The visual line of the byte `at`, and its number.
    Spot spot_of(Target t, AreaLayout layout, usize at) {
        mut usize from = 0;
        mut i32 k = 0;
        while (true) {
            Span line = span_of(t, layout, from);
            if (in_line(line, at) || line.last) {
                return Spot{ span: line, line: k };
            }
            from = line.next;
            k += 1;
        }
        return Spot{ span: span_of(t, layout, 0), line: 0 };
    }

    // The byte at (x, y) of a text area, from its first line.
    usize area_index(Target t, AreaLayout layout, f32 x, f32 y) {
        Span line = line_number(t, layout, max((y / layout.line_h) as i32, 0));
        return index_in(t, line.start, line.end, x, layout.size);
    }

    // The line between the line breaks around `at` (for a triple click).
    Span logical_line(Target t, usize at) {
        str all = t.text();
        mut usize start = min(at, t.len());
        while (start > 0 && all.bytes[start - 1] != 10) {
            start -= 1;
        }
        mut usize end = min(at, t.len());
        while (end < t.len() && all.bytes[end] != 10) {
            end += 1;
        }
        return Span{ start: start, end: end, next: end, last: true };
    }

    // A title bar across the surface, from the left of the current layout: the widgets that
    // follow, until `end_title_bar()`, go side by side in it, `gap` apart, `padding` from its
    // left end. Its empty space and its labels drag the window (`Ui.is_drag_area`).
    pub void title_bar(f32 bar_height, f32 gap, f32 padding) {
        Layout l = layouts[depth];
        bar = canvas.Rect{ x: l.x, y: l.y, w: max(surface.width as f32 - l.x, 0.0), h: bar_height };
        bar_widget_count = 0;
        take_styles();
        paint(bar, look(TitleBar, 0));
        Props p = explicit_props(TitleBar, 0);
        if (depth == 15) {
            return;  // too deep: the widgets stay in the current layout
        }
        f32 x = bar.x + padding;
        f32 y = bar.y + max((bar_height - height) / 2.0, 0.0);
        depth += 1;
        layouts[depth] = Layout{ horizontal: true, x: x, y: y, left: x, top: y, right: x, bottom: y, gap: gap, color: or_color(p.color, l.color), font_size: or_f32(p.font_size, l.font_size), accent: or_color(p.accent, l.accent) };
        bar_depth = depth;
    }

    // Ends the title bar: draws its window buttons, if the system left the bar to the program,
    // and remembers what is in it for `Ui.is_drag_area`. The frame goes on under it.
    pub void end_title_bar() {
        if (bar_depth == 0) {
            return;  // not in a title bar
        }
        depth = bar_depth - 1;
        bar_depth = 0;
        ui.bar = bar;
        ui.bar_widgets = bar_widgets;
        ui.bar_widget_count = bar_widget_count;
        ui.bar_buttons = nowhere();
        if (ui.custom_title_bar) {
            window_buttons();
        }
        place(bar.w, bar.h);
    }

    // Minimize, maximize (or restore) and close, at the right end of the title bar.
    void window_buttons() {
        f32 w = 46.0;
        canvas.Color mark = look(TitleBar, 0).color;  // that of the theme: light or dark
        canvas.Color white = canvas.Color{ r: 255, g: 255, b: 255 };
        ui.bar_buttons = canvas.Rect{ x: bar.x + bar.w - 3.0 * w, y: bar.y, w: 3.0 * w, h: bar.h };
        for (i32 i in 0..3) {
            u64 id = take_id();
            canvas.Rect r = canvas.Rect{ x: ui.bar_buttons.x + i as f32 * w, y: bar.y, w: w, h: bar.h };
            bool clicked = click(id, r);
            bool hot = over(r);
            if (hot) {
                bool held = ui.active == id;
                surface.fill(r, i == 2 ? canvas.Color{ r: 196, g: 43, b: 28 } : look(Button, state_hover() | (held ? state_pressed() : 0)).background);
            }
            canvas.Color ink_of = i == 2 && hot ? white : mark;
            i32 cx = (r.x + w / 2.0) as i32;
            i32 cy = (r.y + bar.h / 2.0) as i32;
            if (i == 0) {
                surface.line(cx - 5, cy, cx + 5, cy, ink_of);
            } else if (i == 1 && ui.maximized) {  // restore: two squares
                surface.stroke(canvas.Rect{ x: (cx - 5) as f32, y: (cy - 3) as f32, w: 8.0, h: 8.0 }, ink_of, 1.0);
                surface.line(cx - 3, cy - 5, cx + 5, cy - 5, ink_of);
                surface.line(cx + 5, cy - 5, cx + 5, cy + 3, ink_of);
            } else if (i == 1) {
                surface.stroke(canvas.Rect{ x: (cx - 5) as f32, y: (cy - 5) as f32, w: 10.0, h: 10.0 }, ink_of, 1.0);
            } else {
                surface.line(cx - 5, cy - 5, cx + 5, cy + 5, ink_of);
                surface.line(cx - 5, cy + 5, cx + 5, cy - 5, ink_of);
            }
            if (clicked) {
                if (i == 0) {
                    ui.request = some(WindowRequest.Minimize);
                } else if (i == 1) {
                    ui.request = some(WindowRequest.ToggleMaximize);
                } else {
                    ui.request = some(WindowRequest.Close);
                }
            }
        }
    }

    // A widget the mouse acts on: in a title bar, it does not drag the window.
    void interactive(canvas.Rect r) {
        if (bar_depth > 0 && bar_widget_count < 16) {
            bar_widgets[bar_widget_count] = r;
            bar_widget_count += 1;
        }
    }

    // A dropdown `width` wide: its options follow, until `end_dropdown()`. Its box shows the
    // option chosen; a click on it opens the list of its options under it, above the rest of
    // the frame, where a click chooses one. A click elsewhere, or Escape, closes it.
    // With the keyboard: Space, Enter or Alt+Down opens it; closed, Up and Down change the
    // choice; open, Up and Down move the highlight, Enter or Space chooses, Escape closes.
    pub void dropdown(f32 width) {
        dropdown_with(width, "");
    }

    // The same, showing `placeholder`, dimmed, while no option is chosen.
    pub void dropdown_with(f32 width, str placeholder) {
        u64 id = take_id();
        take_styles();
        canvas.Rect r = place(width, look(Dropdown, 0).height);
        interactive(r);
        focusable(id, r);
        if (ui.pressed && over(r)) {
            ui.open = ui.open == id ? 0 : id;
            ui.highlight = -1;
            dropdown_pressed = true;
        }
        option_index = 0;
        option_current = -1;
        option_enter = -1;
        option_move = 0;
        if (ui.focus == id || ui.open == id) {
            for (usize i in 0..ui.edit_count) {
                Edit e = ui.edits[i];
                if (ui.open == id) {
                    if (e.key == key_escape()) {
                        ui.open = 0;
                    } else if (e.key == key_up() || e.key == key_down()) {
                        ui.highlight = max(ui.highlight + (e.key == key_up() ? -1 : 1), 0);
                    } else if (e.key == key_enter() || e.key == key_space()) {
                        option_enter = ui.highlight;
                        ui.open = 0;
                    }
                } else if (e.key == key_space() || e.key == key_enter() || e.key == key_down() && e.alt) {
                    ui.open = id;
                    ui.highlight = -1;  // the option chosen, at `end_dropdown()`
                } else if (e.key == key_up() || e.key == key_down()) {
                    option_move += e.key == key_up() ? -1 : 1;
                }
            }
        }
        dropdown_id = id;
        box = r;
        dropdown_hint = placeholder;
        if (ui.open == id) {
            layer_owner = id;
            layer = canvas.Rect{ x: r.x, y: r.y + r.h, w: r.w, h: 0.0 };
            option_count = 0;
            option_chosen = -1;
        }
        u32 states = (over(r) ? state_hover() : 0) | (ui.focus == id ? state_focus() : 0) | (ui.open == id ? state_open() : 0);
        drop_look = look(Dropdown, states);
        paint(r, drop_look);
        i32 cx = (r.x + r.w - 16.0) as i32;  // a chevron, pointing down
        i32 cy = (r.y + height / 2.0) as i32;
        surface.line(cx - 5, cy - 2, cx, cy + 3, drop_look.color);
        surface.line(cx, cy + 3, cx + 5, cy - 2, drop_look.color);
    }

    // An option of the dropdown being described, drawn in its box when `chosen`; returns
    // true when it is clicked in the open list (the program then chooses it, see `Option` in
    // .ui.sosu files).
    pub bool option(str text, bool chosen) {
        if (dropdown_id == 0) {
            return false;  // not in a dropdown
        }
        i32 index = option_index;
        option_index += 1;
        if (chosen) {
            option_current = index;
            surface.push_clip(canvas.Rect{ x: box.x + 2.0, y: box.y + 2.0, w: max(box.w - 32.0, 0.0), h: box.h - 4.0 });
            write_px(box.x + drop_look.padding, box.y, box.h, text, drop_look.color, drop_look.font_size);
            surface.pop_clip();
        }
        if (index == option_enter) {
            return true;  // Enter, in the open list
        }
        if (ui.pick_dropdown == dropdown_id && index == ui.pick_option) {
            ui.pick_dropdown = 0;  // Up or Down, the list closed, at the last frame
            return true;
        }
        if (layer_owner != dropdown_id || option_count >= 16) {
            return false;
        }
        canvas.Rect r = canvas.Rect{ x: layer.x, y: layer.y + layer.h, w: layer.w, h: height };
        options[option_count] = text;
        if (chosen) {
            option_chosen = option_count as i32;
        }
        option_count += 1;
        layer = canvas.Rect{ x: layer.x, y: layer.y, w: layer.w, h: layer.h + height };
        if (ui.open == dropdown_id && ui.pressed && contains(r, ui.mouse_x, ui.mouse_y)) {
            ui.open = 0;
            dropdown_pressed = true;
            return true;
        }
        return false;
    }

    pub void end_dropdown() {
        if (dropdown_id != 0 && option_current < 0 && dropdown_hint.len > 0) {
            surface.push_clip(canvas.Rect{ x: box.x + 2.0, y: box.y + 2.0, w: max(box.w - 32.0, 0.0), h: box.h - 4.0 });
            write_px(box.x + drop_look.padding, box.y, box.h, dropdown_hint, drop_look.hint, drop_look.font_size);
            surface.pop_clip();
        }
        if (dropdown_id != 0 && option_index > 0) {
            if (ui.open == dropdown_id) {  // the highlight: on the option chosen at first
                ui.highlight = ui.highlight < 0 ? max(option_current, 0) : min(ui.highlight, option_index - 1);
            }
            if (option_move != 0) {  // the choice moved, closed: chosen at the next frame
                ui.pick_dropdown = dropdown_id;
                ui.pick_option = min(max(option_current + option_move, 0), option_index - 1);
            }
        }
        dropdown_id = 0;
    }

    // ---- Menus ----

    // A bar of menus: the `menu`s that follow, until `end_menu_bar()`, side by side.
    pub void menu_bar() {
        open(true, 0.0, 0.0);
        menu_bar_depth = depth;
        bar_title_count = 0;
    }

    pub void end_menu_bar() {
        menu_bar_depth = 0;
        end();
    }

    // A menu: its items follow, until `end_menu()`, described at each frame whether it is
    // open or not (their shortcuts work when it is closed). Outside of a menu, its title is
    // placed (in a bar of menus, or alone, as a button), and a click on it opens the menu
    // under it; when a menu opened by its title is open, the mouse over another title opens
    // that one instead. In a menu, it is an entry that opens the submenu beside it, when the
    // mouse is over it. Menus go 4 levels deep; deeper ones are ignored.
    pub void menu(str title) {
        u64 id = take_id();
        if (menu_level >= 4) {
            menu_level += 1;
            return;
        }
        if (menu_level == 0) {
            take_styles();
            Look first = look(MenuBar, 0);
            canvas.Rect r = place(measure_label(title, first.font_size).w + 2.0 * first.padding, first.height);
            interactive(r);
            bool hot = over(r);
            mut bool keyed = false;  // its title highlighted by the keyboard (F10, Alt)
            if (menu_bar_depth > 0 && depth == menu_bar_depth && bar_title_count < 16) {
                keyed = ui.bar_keys && ui.menus[0] == 0 && ui.bar_index == bar_title_count as i32;
                bar_titles[bar_title_count] = id;
                bar_title_count += 1;
            }
            if (ui.menus[0] == 0 && alt_letter(title)) {  // Alt and its letter: open, with the keyboard
                ui.close_menus(0);
                ui.menus[0] = id;
                ui.menu_in_bar = true;
                ui.menu_cursor[0] = -2;
                ui.bar_keys = true;
            }
            if (ui.pressed && hot) {
                ui.bar_keys = false;
                bool was_open = ui.menus[0] == id;
                ui.close_menus(0);
                if (!was_open) {
                    ui.menus[0] = id;
                    ui.menu_in_bar = true;
                }
                menu_pressed = true;
            } else if (hot && ui.moved && ui.menus[0] != 0 && ui.menus[0] != id && ui.menu_in_bar) {
                ui.close_menus(0);  // from one menu of the bar to the next
                ui.menus[0] = id;
            }
            bool open = ui.menus[0] == id;
            Look tl = look(MenuBar, (open ? state_open() : 0) | (hot || keyed ? state_hover() : 0));
            paint(r, tl);
            if (keyed) {
                ring(r, accent());
            }
            write_label(r.x + tl.padding, r.y, r.h, title, tl.color, tl.font_size);
            start_popup(id, open, r.x, r.y + r.h);
            return;
        }
        // in a menu: the entry that opens it
        canvas.Rect entry = add_entry(title, "", 2, true);
        Popup* parent = &menu_popups[menu_level - 1];
        usize entry_index = min(parent.count, 24) - 1;  // a variable: `parent.submenus[min(...)] = id` would write
        // into a copy of the array (a bug of the C generator of sosuc, when the index needs temporaries)
        parent.submenus[entry_index] = id;
        bool parent_open = menu_popups[menu_level - 1].open;
        if (parent_open && contains(entry, ui.mouse_x, ui.mouse_y) && (ui.moved || ui.pressed)) {
            if (ui.menus[menu_level] != id) {
                ui.close_menus(menu_level);
                ui.menus[menu_level] = id;
            }
            if (ui.pressed) {
                menu_pressed = true;
            }
        }
        start_popup(id, parent_open && ui.menus[menu_level] == id, entry.x + entry.w - 4.0, entry.y - 4.0);
    }

    pub void end_menu() {
        if (menu_level == 0) {
            return;
        }
        menu_level -= 1;
        if (menu_level < 4 && menu_popups[menu_level].open && shown_count < 4) {
            shown[shown_count] = menu_popups[menu_level];
            shown_count += 1;
        }
    }

    // A context menu for the widget placed just before it (a list: the whole list): its items
    // follow, until `end_context_menu()`. A press of the right button on that widget opens it
    // under the mouse; when context menus are nested (one for an item, one for its list), the
    // first one described opens.
    pub void context_menu() {
        u64 target = last_id;  // the widget it is for, before its own identity replaces it
        u64 id = take_id();
        if (menu_level > 0) {
            menu_level += 1;  // not in a menu: its items are ignored
            return;
        }
        if (ui.right_pressed && !right_taken && over(last)) {
            ui.close_menus(0);
            ui.menus[0] = id;
            ui.menu_in_bar = false;
            ui.context_x = ui.mouse_x;
            ui.context_y = ui.mouse_y;
            right_taken = true;
        } else if (!right_taken && ui.focus != 0 && ui.focus == target && (ui.pressed_key(key_f10(), true, false) || ui.pressed_key(key_menu(), false, false))) {
            ui.close_menus(0);  // Shift+F10 or the Menu key: under the widget that has the keyboard
            ui.menus[0] = id;
            ui.menu_in_bar = false;
            ui.menu_cursor[0] = -2;
            ui.context_x = last.x + 8.0;
            ui.context_y = last.y + last.h;
            right_taken = true;
        }
        start_popup(id, ui.menus[0] == id, ui.context_x, ui.context_y);
    }

    pub void end_context_menu() {
        end_menu();
    }

    // An item of the menu being described: returns true when it is clicked.
    pub bool menu_item(str text) {
        return menu_item_with(text, "", true);
    }

    // The same, dimmed and never clicked unless `enabled`.
    pub bool menu_item_enabled(str text, bool enabled) {
        return menu_item_with(text, "", enabled);
    }

    // The same, with a shortcut ("Ctrl+S", "Ctrl+Shift+Z", "F5", "Delete"; "" for none), shown at
    // its right, that works even with its menu closed. A shortcut without Ctrl does nothing
    // while a text field has the keyboard, unless it is a function key.
    pub bool menu_item_with(str text, str shortcut, bool enabled) {
        if (menu_level == 0 || menu_level > 4) {
            return false;
        }
        Popup* p = &menu_popups[menu_level - 1];
        i32 index = p.count as i32;
        canvas.Rect r = add_entry(text, shortcut, 0, enabled);
        if (!enabled) {
            return false;
        }
        if (ui.pick_menu == p.id && ui.pick_entry == index) {  // Enter, at the last frame
            ui.pick_menu = 0;
            ui.bar_keys = false;  // an item chosen: the keyboard back to the window
            ui.close_menus(0);
            return true;
        }
        if (menu_popups[menu_level - 1].open && contains(r, ui.mouse_x, ui.mouse_y)) {
            if (ui.released) {
                ui.bar_keys = false;
                ui.close_menus(0);
                return true;
            }
            if (ui.pressed) {
                menu_pressed = true;
            }
        }
        if (shortcut.len == 0) {
            return false;
        }
        Shortcut s = parse_shortcut(shortcut);
        if (s.code == 0 || !s.ctrl && ui.editing && s.code < 0x4000003A) {
            return false;
        }
        for (usize i in 0..ui.edit_count) {
            Edit e = ui.edits[i];
            u64 bit = 1 << i as u64;
            if (e.key == s.code && e.ctrl == s.ctrl && e.shift == s.shift && keys_taken & bit == 0) {
                keys_taken = keys_taken | bit;
                ui.close_menus(0);
                return true;
            }
        }
        return false;
    }

    // A line between the items of a menu.
    pub void separator() {
        if (menu_level > 0 && menu_level <= 4) {
            add_entry("", "", 1, false);
        }
    }

    // Opens the description of a menu, at (x, y) when it is open, kept on the surface.
    void start_popup(u64 id, bool open, f32 x, f32 y) {
        usize level = menu_level;
        f32 w = max(ui.menu_w[level], 160.0);
        f32 left = max(min(x, surface.width as f32 - w), 0.0);
        f32 top = max(min(y, surface.height as f32 - ui.menu_h[level]), 0.0);
        menu_popups[level] = Popup{ id: id, open: open, level: level, x: left, y: top, w: w };
        menu_level += 1;
    }

    // An entry of the menu being described; its rectangle. The mouse over an item closes the
    // submenus open beside.
    canvas.Rect add_entry(str label, str key, u8 kind, bool enabled) {
        Popup* p = &menu_popups[menu_level - 1];
        f32 h = kind == 1 ? 9.0 : 28.0;
        canvas.Rect r = canvas.Rect{ x: p.x, y: p.y + 4.0 + p.h, w: p.w, h: h };
        if (p.count < 24) {
            p.labels[p.count] = label;
            p.keys[p.count] = key;
            p.kinds[p.count] = kind;
            p.enabled[p.count] = enabled;
            p.count += 1;
        }
        p.h += h;
        f32 key_w = key.len > 0 ? measure(key, 2).w + 32.0 : 0.0;
        p.widest = max(p.widest, measure_label(label, 18.0).w + key_w + (kind == 2 ? 24.0 : 0.0));
        if (p.open && kind != 2 && ui.moved && contains(r, ui.mouse_x, ui.mouse_y)) {
            ui.close_menus(menu_level);
        }
        return r;
    }

    // An open menu, over everything else.
    void draw_popup(Popup p) {
        canvas.Rect frame = canvas.Rect{ x: p.x, y: p.y, w: p.w, h: p.h + 8.0 };
        Look m = look(Menu, 0);
        paint(frame, m);
        mut f32 y = p.y + 4.0;
        for (usize i in 0..p.count) {
            if (p.kinds[i] == 1) {
                surface.fill(canvas.Rect{ x: p.x + 8.0, y: y + 4.0, w: p.w - 16.0, h: 1.0 }, face(true, false));
                y += 9.0;
                continue;
            }
            canvas.Rect r = canvas.Rect{ x: p.x + 4.0, y: y, w: p.w - 8.0, h: 28.0 };
            bool open_beside = p.kinds[i] == 2 && p.level + 1 < 4 && ui.menus[p.level + 1] == p.submenus[i] && p.submenus[i] != 0;
            bool keyed = ui.menu_cursor[p.level] == i as i32;
            if (p.enabled[i] && (contains(r, ui.mouse_x, ui.mouse_y) || open_beside || keyed)) {
                surface.fill(r, m.selection);
            }
            canvas.Color color = p.enabled[i] ? m.color : face(true, false);
            write_label(p.x + 12.0, y, 28.0, p.labels[i], color, m.font_size);
            if (p.keys[i].len > 0) {
                f32 kw = measure(p.keys[i], 2).w;
                write(p.x + p.w - 12.0 - kw, y, 28.0, p.keys[i], face(true, false), 2);
            }
            if (p.kinds[i] == 2) {  // a chevron, pointing right
                i32 cx = (p.x + p.w - 16.0) as i32;
                i32 cy = (y + 14.0) as i32;
                surface.line(cx - 2, cy - 5, cx + 3, cy, ink());
                surface.line(cx + 3, cy, cx - 2, cy + 5, ink());
            }
            y += 28.0;
        }
    }

    // Closes the menus a click elsewhere, a right press elsewhere or Escape closes, or whose
    // menu was not described; draws those still open, and remembers them for the next frame.
    void finish_menus() {
        mut bool inside = false;
        mut bool first_shown = false;
        for (usize i in 0..shown_count) {
            Popup p = shown[i];
            inside = inside || contains(canvas.Rect{ x: p.x, y: p.y, w: p.w, h: p.h + 8.0 }, ui.mouse_x, ui.mouse_y);
            first_shown = first_shown || p.level == 0;
        }
        if (ui.pressed && !menu_pressed && !inside || ui.right_pressed && !right_taken || !first_shown) {
            ui.close_menus(0);
        }
        if (ui.pressed) {
            ui.bar_keys = false;  // the mouse takes over
        }
        menu_keys();
        ui.popup_count = 0;
        for (usize level in 0..4) {
            for (usize i in 0..shown_count) {
                Popup p = shown[i];
                if (p.level == level && ui.menus[level] == p.id) {
                    if (ui.menu_cursor[level] == -2) {
                        ui.menu_cursor[level] = next_entry(p, -1, 1);
                    }
                    draw_popup(p);
                    ui.popups[ui.popup_count] = canvas.Rect{ x: p.x, y: p.y, w: p.w, h: p.h + 8.0 };
                    ui.popup_count += 1;
                    ui.menu_w[level] = max(p.widest + 40.0, 160.0);
                    ui.menu_h[level] = p.h + 8.0;
                }
            }
        }
        ui.right_pressed = false;
        ui.editing = editing;
    }

    // The keys of the menus: F10 (or Alt alone) gives the keyboard to the bar, Left and Right go
    // from title to title, Down or Enter opens; in an open menu, Up and Down go from entry to
    // entry, Right opens a submenu (or the next menu of the bar), Left closes it (or goes to the
    // previous menu), Enter chooses (at the next frame), Escape closes one level.
    void menu_keys() {
        for (usize k in 0..ui.edit_count) {
            Edit e = ui.edits[k];
            if (e.ctrl) {
                continue;
            }
            mut usize level = 0;  // the deepest menu open
            while (level + 1 < 4 && ui.menus[level + 1] != 0) {
                level += 1;
            }
            if (ui.menus[0] == 0) {
                if (e.key == key_f10() && !e.shift) {
                    ui.bar_keys = !ui.bar_keys && bar_title_count > 0;
                    ui.bar_index = 0;
                } else if (ui.bar_keys && bar_title_count > 0) {
                    i32 n = bar_title_count as i32;
                    if (e.key == key_left() || e.key == key_right()) {
                        ui.bar_index = (ui.bar_index + (e.key == key_left() ? n - 1 : 1)) % n;
                    } else if (e.key == key_down() || e.key == key_enter() || e.key == key_space()) {
                        open_title(ui.bar_index);
                    } else if (e.key == key_escape()) {
                        ui.bar_keys = false;
                    }
                }
                continue;
            }
            mut i32 found = -1;  // the menu open at that level, among those described
            for (usize i in 0..shown_count) {
                if (shown[i].level == level && shown[i].id == ui.menus[level]) {
                    found = i as i32;
                }
            }
            if (found < 0) {
                continue;
            }
            Popup p = shown[found as usize];
            i32 cursor = ui.menu_cursor[level] == -2 ? next_entry(p, -1, 1) : ui.menu_cursor[level];
            ui.menu_cursor[level] = cursor;
            bool on_submenu = cursor >= 0 && p.kinds[cursor as usize] == 2;
            if (e.key == key_f10() && !e.shift || e.key == key_escape()) {
                if (level > 0 && e.key == key_escape()) {
                    ui.close_menus(level);
                } else {
                    ui.bar_keys = ui.menu_in_bar && e.key == key_escape();  // back on the bar
                    ui.close_menus(0);
                }
            } else if (e.key == key_up() || e.key == key_down()) {
                ui.menu_cursor[level] = next_entry(p, cursor, e.key == key_up() ? -1 : 1);
            } else if (e.key == key_right() && on_submenu || (e.key == key_enter() || e.key == key_space()) && on_submenu) {
                if (level + 1 < 4) {
                    ui.close_menus(level + 1);
                    ui.menus[level + 1] = p.submenus[cursor as usize];
                    ui.menu_cursor[level + 1] = -2;
                }
            } else if (e.key == key_left() && level > 0) {
                ui.close_menus(level);
            } else if ((e.key == key_left() || e.key == key_right()) && ui.menu_in_bar && bar_title_count > 0) {
                i32 n = bar_title_count as i32;
                mut i32 index = 0;
                for (usize i in 0..bar_title_count) {
                    if (bar_titles[i] == ui.menus[0]) {
                        index = i as i32;
                    }
                }
                open_title((index + (e.key == key_left() ? n - 1 : 1)) % n);
            } else if ((e.key == key_enter() || e.key == key_space()) && cursor >= 0) {
                ui.pick_menu = p.id;
                ui.pick_entry = cursor;
            } else if (!e.alt && e.key >= 97 && e.key <= 122) {  // the letter of an entry: it is chosen
                for (usize j in 0..p.count) {
                    if (p.enabled[j] && p.kinds[j] != 1 && mnemonic_of(p.labels[j]) as u32 == e.key) {
                        if (p.kinds[j] == 2 && level + 1 < 4) {
                            ui.close_menus(level + 1);
                            ui.menus[level + 1] = p.submenus[j];
                            ui.menu_cursor[level + 1] = -2;
                        } else if (p.kinds[j] == 0) {
                            ui.pick_menu = p.id;
                            ui.pick_entry = j as i32;
                        }
                        break;
                    }
                }
            }
        }
    }

    // Opens the menu of the title `index` of the bar, from the keyboard.
    void open_title(i32 index) {
        ui.close_menus(0);
        ui.menus[0] = bar_titles[index as usize];
        ui.menu_in_bar = true;
        ui.menu_cursor[0] = -2;
        ui.bar_index = index;
        ui.bar_keys = true;
    }

    // The entry of `p` after (or before, `step` -1) `from` that the keyboard can reach: not a
    // separator, not disabled; it goes round. -1 when there is none.
    i32 next_entry(Popup p, i32 from, i32 step) {
        i32 n = p.count as i32;
        for (i32 k in 1..n + 1) {
            i32 i = ((from + step * k) % n + n) % n;
            if (p.kinds[i as usize] != 1 && p.enabled[i as usize]) {
                return i;
            }
        }
        return -1;
    }

    // The open list of a dropdown, over everything else.
    void draw_layer() {
        Look m = look(Menu, 0);
        surface.fill_rounded(layer, m.radius, face(false, false));
        for (usize i in 0..option_count) {
            canvas.Rect r = canvas.Rect{ x: layer.x, y: layer.y + i as f32 * height, w: layer.w, h: height };
            if (i as i32 == option_chosen) {
                surface.fill(r, m.selection);
            }
            if (i as i32 == ui.highlight) {  // with the keyboard
                surface.stroke(r, m.accent, 2.0);
            } else if (contains(r, ui.mouse_x, ui.mouse_y)) {
                surface.fill(r, canvas.Color{ r: 205, g: 214, b: 244, a: 18 });
            }
            write_px(r.x + 8.0, r.y, height, options[i], m.color, m.font_size);
        }
        surface.stroke_rounded(layer, m.radius, m.accent, 2.0);
    }

    // Ends the frame: draws the layer above, and the input it used is consumed.
    pub void finish() {
        finishing = true;
        ui.modal = dialog_open;
        if (ui.pressed && !dropdown_pressed || ui.open != layer_owner) {
            ui.open = 0;  // a click elsewhere closes the dropdown, as does its disappearance
        }
        if (ui.open != 0) {
            if (ui.open == cal_owner) {
                draw_calendar();
            } else {
                draw_layer();
            }
            ui.layer = layer;
        } else {
            ui.layer = nowhere();
        }
        finish_menus();
        draw_tooltip();  // above everything
        if (ui.released) {
            ui.active = 0;
        }
        if (ui.pressed && !focus_taken) {
            ui.focus = 0;  // a click elsewhere takes the keyboard away
        }
        tab_keys();
        mut bool focus_seen = ui.focus == 0;  // the widget that has the keyboard disappeared
        for (usize i in 0..order_count) {
            focus_seen = focus_seen || order[i] == ui.focus;
        }
        if (!focus_seen) {
            ui.focus = 0;
        }
        for (usize i in 0..8) {  // the same for the grids
            if (!ui.grid_seen[i]) {
                ui.grid_ids[i] = 0;
            }
            ui.grid_seen[i] = false;
        }
        for (usize i in 0..64) {  // what a widget no longer described kept is forgotten
            if (!ui.states[i].seen) {
                ui.states[i].id = 0;
            }
            ui.states[i].seen = false;
        }
        ui.pressed = false;
        ui.released = false;
        ui.typed.len = 0;
        ui.edit_count = 0;
        ui.wheel = 0.0;
        ui.wheel_x = 0.0;
        ui.moved = false;
    }

    // The size of `text` at `scale`, in the font of `ui`, or else the built-in one.
    canvas.Rect measure(str text, i32 scale) {
        return match (ui.font) {
            some(f) => canvas.Rect{ x: 0.0, y: 0.0, w: f.measure(text, 9.0 * scale as f32), h: f.line_height(9.0 * scale as f32) },
            none => canvas.text_size(text, scale),
        };
    }

    // `text` at `scale`, from x, in the middle of a box `box` high from y.
    void write(f32 x, f32 y, f32 box, str text, canvas.Color color, i32 scale) {
        f32 top = y + (box - measure(text, scale).h) / 2.0;
        match (ui.font) {
            some(f) => {
                surface.text_with(f, 9.0 * scale as f32, x, top, text, color);
            },
            none => {
                surface.text(x, top, text, color, scale);
            },
        }
    }

    // ---- Themes and styles (spec §10.7) ----

    // The next node (a widget, a column...) takes `s` too, over the theme; several: the later
    // ones win (4 at most).
    pub void style(Style s) {
        if (pending_count < 4) {
            pending[pending_count] = s;
            pending_count += 1;
        }
    }

    // The node being described takes the pending styles.
    void take_styles() {
        node_styles = pending;
        node_style_count = pending_count;
        pending_count = 0;
    }

    // What the theme and the styles of the node say about it, in `states`; and its parts.
    Props explicit_props(Kind kind, u32 states) {
        mut Props p = Props{ };
        match (ui.theme) {
            some(t) => {
                p = in_states(style_of(t, kind), states);
            },
            none => { },
        }
        for (usize i in 0..node_style_count) {
            p = merge_props(p, in_states(node_styles[i], states));
        }
        return p;
    }

    Props part(Kind kind, u32 which) {
        mut Props p = Props{ };
        match (ui.theme) {
            some(t) => {
                Style s = style_of(t, kind);
                p = which == 0 ? s.placeholder : which == 1 ? s.selection : s.bar;
            },
            none => { },
        }
        for (usize i in 0..node_style_count) {
            Style s = node_styles[i];
            p = merge_props(p, which == 0 ? s.placeholder : which == 1 ? s.selection : s.bar);
        }
        return p;
    }

    // The look of the node being described: the cascade, from the defaults of `ui` to the
    // styles of the node; `color`, `font_size` and `accent` inherited from the layout holding it.
    Look look(Kind kind, u32 states) {
        Look d = default_look(kind, states);
        Props p = explicit_props(kind, states);
        mut Props all = Props{ };
        match (ui.theme) {
            some(t) => {
                all = t.all;
            },
            none => { },
        }
        Layout l = layouts[depth];
        // a disabled button and a title keep their own default unless a rule says otherwise
        bool own_color = states & state_disabled() != 0;
        canvas.Color inherited = color_or(l.color, color_or(all.color, d.color));
        f32 size = kind == Title ? d.font_size : f32_or(l.font_size, f32_or(all.font_size, d.font_size));
        return Look{ color: color_or(p.color, own_color ? d.color : inherited), background: color_or(p.background, d.background), border: color_or(p.border, d.border), border_width: f32_or(p.border_width, d.border_width), radius: f32_or(p.radius, d.radius), padding: f32_or(p.padding, d.padding), gap: f32_or(p.gap, d.gap), height: f32_or(p.height, d.height), font_size: f32_or(p.font_size, size), accent: color_or(p.accent, color_or(l.accent, color_or(all.accent, d.accent))), hint: color_or(part(kind, 0).color, d.hint), selection: color_or(part(kind, 1).background, d.selection), bar: color_or(part(kind, 2).background, d.bar) };
    }

    // The background and the border of `r`, as `l` says.
    void paint(canvas.Rect r, Look l) {
        if (l.background.a > 0) {
            surface.fill_rounded(r, l.radius, l.background);
        }
        if (l.border.a > 0 && l.border_width > 0.0) {
            surface.stroke_rounded(r, l.radius, l.border, l.border_width);
        }
    }

    // The size of `text` at `size` pixels per em, in the font of `ui`, or else the built-in one.
    canvas.Rect measure_px(str text, f32 size) {
        return match (ui.font) {
            some(f) => canvas.Rect{ x: 0.0, y: 0.0, w: f.measure(text, size), h: f.line_height(size) },
            none => canvas.text_size(text, scale_of(size)),
        };
    }

    // `text` at `size`, from x, in the middle of a box `box` high from y.
    void write_px(f32 x, f32 y, f32 box, str text, canvas.Color color, f32 size) {
        f32 top = y + (box - measure_px(text, size).h) / 2.0;
        match (ui.font) {
            some(f) => {
                surface.text_with(f, size, x, top, text, color);
            },
            none => {
                surface.text(x, top, text, color, scale_of(size));
            },
        }
    }

    // The identity of a painted column or row: its place among those of its scope.
    u64 container_id() {
        u64 id = mix(scopes[scope], 0xC0000000 | containers[scope] as u64);
        containers[scope] += 1;
        return id;
    }

    // ---- Translations (spec §10.7) ----

    // `source`, translated by `ui.catalog`, or itself.
    pub str tr(str source) {
        return match (ui.catalog) {
            some(c) => c.text(source),
            none => source,
        };
    }

    // The same, for one meaning of `source` (`msgctxt`).
    pub str tr_in(str context, str source) {
        return match (ui.catalog) {
            some(c) => c.in_context(context, source),
            none => source,
        };
    }

    // The form of `one` (its plural: `other`) for `n` things, translated.
    pub str tr_plural(str one, str other, i64 n) {
        return match (ui.catalog) {
            some(c) => c.plural(one, other, n),
            none => n == 1 ? one : other,
        };
    }

    pub str tr_plural_in(str context, str one, str other, i64 n) {
        return match (ui.catalog) {
            some(c) => c.plural_in_context(context, one, other, n),
            none => n == 1 ? one : other,
        };
    }

    // `text` with `{name}` replaced by `value` (`with2` to `with4`: more values). The result lasts
    // until the end of the frame; when the frame has no room left (8 KB of such texts), `text`.
    pub str with1(str text, str name, str value) {
        return fill(text, [name, "", "", ""], [value, "", "", ""], 1);
    }

    pub str with2(str text, str name1, str value1, str name2, str value2) {
        return fill(text, [name1, name2, "", ""], [value1, value2, "", ""], 2);
    }

    pub str with3(str text, str name1, str value1, str name2, str value2, str name3, str value3) {
        return fill(text, [name1, name2, name3, ""], [value1, value2, value3, ""], 3);
    }

    pub str with4(str text, str name1, str value1, str name2, str value2, str name3, str value3, str name4, str value4) {
        return fill(text, [name1, name2, name3, name4], [value1, value2, value3, value4], 4);
    }

    // `n` in decimal digits, until the end of the frame.
    pub str decimal(i64 n) {
        mut u8[20] digits = [0; 20];
        mut usize count = 0;
        mut u64 rest = n < 0 ? (0 - (n + 1)) as u64 + 1 : n as u64;
        while (count == 0 || rest > 0) {
            digits[count] = (48 + rest % 10) as u8;
            rest /= 10;
            count += 1;
        }
        usize start = pool_used;
        if (pool_used + count + 1 > 8192) {
            return "?";
        }
        if (n < 0) {
            pool[pool_used] = 45;  // -
            pool_used += 1;
        }
        for (usize i in 0..count) {
            pool[pool_used] = digits[count - 1 - i];
            pool_used += 1;
        }
        return text_of(pool[start..pool_used]);
    }

    str fill(str text, str[4] names, str[4] values, usize count) {
        usize start = pool_used;
        mut usize i = 0;
        while (i < text.len) {
            mut bool replaced = false;
            if (text.bytes[i] == 123) {  // {
                for (usize k in 0..count) {
                    str name = names[k];
                    if (i + name.len + 1 < text.len && text.bytes[i + name.len + 1] == 125 && same_bytes(text, i + 1, name)) {
                        if (pool_used + values[k].len > 8192) {
                            pool_used = start;
                            return text;
                        }
                        for (u8 b in values[k].bytes) {
                            pool[pool_used] = b;
                            pool_used += 1;
                        }
                        i += name.len + 2;
                        replaced = true;
                        break;
                    }
                }
            }
            if (!replaced) {
                if (pool_used == 8192) {
                    pool_used = start;
                    return text;
                }
                pool[pool_used] = text.bytes[i];
                pool_used += 1;
                i += 1;
            }
        }
        return text_of(pool[start..pool_used]);
    }

    // ---- Identities and the keyboard (spec §10.6) ----

    // The next widget's place in its scope: the offset of its node in a .ui.sosu file. Without
    // it, a widget's place is the number of its call in its scope.
    pub void at(u32 place) {
        site = place;
        has_site = true;
    }

    // The widgets that follow, until `pop_id()`, are in a scope named `key`: a component used
    // as a node, an item of a loop (`for ..., key: k`).
    pub void push_id(u64 key) {
        if (scope == 15) {
            scopes_lost += 1;
            return;
        }
        scopes[scope + 1] = mix(scopes[scope], key);
        scope += 1;
        calls[scope] = 0;
        containers[scope] = 0;
        iterations[scope] = 0;
    }

    // A scope for the next iteration of the loop whose scope is open: its number.
    pub void push_item() {
        u64 index = iterations[scope];
        iterations[scope] += 1;
        push_id(index);
    }

    pub void pop_id() {
        if (scopes_lost > 0) {
            scopes_lost -= 1;
        } else if (scope > 0) {
            scope -= 1;
        }
    }

    // The next widget takes the keyboard, the first time it is described (`focus: true`).
    pub void focus_here() {
        focus_wanted = true;
    }

    // The identity of the next widget.
    u64 take_id() {
        u64 part = has_site ? 1 << 32 | site as u64 : calls[scope] as u64;
        if (!has_site) {
            calls[scope] += 1;
        }
        has_site = false;
        mut u64 id = mix(scopes[scope], part);
        for (usize i in 0..used_count) {
            if (used[i] == id) {  // used twice: the second gets the number of its call
                ui.duplicates += 1;
                id = mix(id, 0xFFFF0000 | calls[scope] as u64);
                calls[scope] += 1;
                break;
            }
        }
        if (id == 0) {
            id = 1;
        }
        if (used_count < 256) {
            used[used_count] = id;
            used_count += 1;
        }
        placed_id = id;
        if (focus_wanted) {
            focus_wanted = false;
            if (!ui.has_state(id)) {
                ui.focus = id;
                ui.reveal = true;
                ui.cursor = 0xFFFF;
                ui.anchor = 0;
            }
            ui.state_slot(id);  // remembers that it was seen
        }
        return id;
    }

    // A widget that takes the keyboard: in the order of Tab; when Tab gave it the keyboard,
    // brought into view in the `Scroll` areas around it; a press on it gives it the keyboard.
    void focusable(u64 id, canvas.Rect r) {
        if (order_count < 256) {
            order[order_count] = id;
            order_count += 1;
        }
        if (ui.pressed && over(r)) {
            ui.focus = id;
            focus_taken = true;
        }
        if (ui.focus == id) {
            focus_marks += 1;
        }
        if (ui.focus == id && ui.reveal) {
            ui.reveal = false;
            reveal(r);
        }
    }

    // Scrolls the areas around `r` (the innermost first) to show it.
    void reveal(canvas.Rect r) {
        mut usize d = depth;
        while (d > 0) {
            Layout l = layouts[d];
            if (l.area >= 0 && !l.is_list) {
                WidgetState* s = &ui.states[l.area as usize];
                f32 top = r.y - l.frame.y + s.scroll_y;
                f32 left = r.x - l.frame.x + s.scroll_x;
                s.scroll_y = max(min(s.scroll_y, top - 8.0), top + r.h + 8.0 - l.frame.h);
                s.scroll_x = max(min(s.scroll_x, left - 8.0), left + r.w + 8.0 - l.frame.w + l.bar_w);
            }
            d -= 1;
        }
    }

    // The ring of the widget that has the keyboard, in `color` (its accent).
    void ring(canvas.Rect r, canvas.Color color) {
        surface.stroke(canvas.Rect{ x: r.x - 3.0, y: r.y - 3.0, w: r.w + 6.0, h: r.h + 6.0 }, color, 2.0);
    }

    // Space (and Enter, with `enter`) pressed while `id` has the keyboard.
    bool activated(u64 id, bool enter) {
        if (ui.focus != id) {
            return false;
        }
        return ui.pressed_key(key_space(), false, false) || enter && ui.pressed_key(key_enter(), false, false);
    }

    // Tab and Shift+Tab: the keyboard to the next or the previous widget of this frame.
    void tab_keys() {
        // in a dialog, the keyboard stays among its widgets, and goes to the first of them
        usize low = dialog_open ? dialog_from : 0;
        usize high = dialog_open ? dialog_to : order_count;
        usize count = high - low;
        if (dialog_open && count > 0) {
            mut bool inside = false;
            for (usize k in low..high) {
                inside = inside || order[k] == ui.focus;
            }
            if (!inside) {
                ui.focus = order[low];
            }
        }
        if (tab_typed) {
            return;
        }
        for (usize i in 0..ui.edit_count) {
            Edit e = ui.edits[i];
            if (e.key != key_tab() || e.ctrl || count == 0) {
                continue;
            }
            mut usize at_now = count;
            for (usize k in low..high) {
                if (order[k] == ui.focus) {
                    at_now = k - low;
                }
            }
            usize next = at_now == count ? e.shift ? count - 1 : 0 : (at_now + (e.shift ? count - 1 : 1)) % count;
            ui.focus = order[low + next];
            ui.reveal = true;
            ui.cursor = 0xFFFF;  // a text field: all its text selected
            ui.anchor = 0;
            ui.scroll = 0.0;
        }
    }

    void open(bool horizontal, f32 gap, f32 padding) {
        if (depth == 15) {
            return;  // too deep: the widgets stay in the current layout
        }
        next_align = Start;  // a column or a row starts where it is; its widgets are aligned
        ensure_cell();
        f32 room_w = max(fill_width() - 2.0 * padding, 0.0);
        f32 room_h = max(fill_height() - 2.0 * padding, 0.0);
        f32 x = layouts[depth].x + padding;
        f32 y = layouts[depth].y + padding;
        depth += 1;
        layouts[depth] = Layout{ horizontal: horizontal, x: x, y: y, left: x, top: y, right: x, bottom: y, gap: gap, padding: padding, room_w: room_w, room_h: room_h };
    }

    // The width the next widget can fill (spec §10.8): its cell in a grid, else what is left of
    // its layout; 0 when it is not known.
    pub f32 fill_width() {
        Layout l = layouts[depth];
        if (l.grid >= 0) {
            ensure_cell();  // the next free cell, if the widget gave none
            return grids[l.grid as usize].cell.w;
        }
        return l.room_w > 0.0 ? max(l.left + l.room_w - l.x, 0.0) : 0.0;
    }

    // The same, its height.
    pub f32 fill_height() {
        Layout l = layouts[depth];
        if (l.grid >= 0) {
            ensure_cell();
            return grids[l.grid as usize].cell.h;
        }
        return l.room_h > 0.0 ? max(l.top + l.room_h - l.y, 0.0) : 0.0;
    }

    // ---- Groups (spec §10.8) ----

    // A frame with `title` on its border ("": a frame alone): the widgets that follow, until
    // `end_group()`, go in a column inside it. A negative `gap` or `padding`: that of the theme.
    pub void group(str title, f32 gap, f32 padding) {
        group_open(title, gap, padding, false, none);
    }

    // A frame without a title.
    pub void group_untitled(f32 gap, f32 padding) {
        group_open("", gap, padding, false, none);
    }

    // The same, folding: a click on its title, or Space when it has the keyboard, folds it to its
    // title or opens it. `open` binds that state; none: the group keeps it. Returns whether it
    // is open: its widgets are described only then, but `end_group()` always follows.
    pub bool group_folding(str title, f32 gap, f32 padding, bool*? open) {
        return group_open(title, gap, padding, true, open);
    }

    bool group_open(str title, f32 gap, f32 padding, bool folding, bool*? bound) {
        ensure_cell();
        u64 id = take_id();
        take_styles();
        Look l = look(Group, 0);
        Layout parent = layouts[depth];
        canvas.Rect size = title.len > 0 ? measure_px(title, l.font_size) : canvas.Rect{ x: 0.0, y: 0.0, w: 0.0, h: 0.0 };
        f32 mark = folding ? 18.0 : 0.0;  // the triangle before the title
        f32 title_w = size.w + mark;
        canvas.Rect head = canvas.Rect{ x: parent.x + 10.0, y: parent.y, w: title_w + 8.0, h: size.h };
        usize slot = ui.state_slot(id);
        mut bool is_open = true;
        if (folding) {
            WidgetState* s = &ui.states[slot];
            is_open = match (bound) {
                some(flag) => *flag,
                none => !s.closed,
            };
            focusable(id, head);
            interactive(head);
            if (click(id, head) || activated(id, true)) {
                is_open = !is_open;
                match (bound) {
                    some(flag) => {
                        *flag = is_open;
                    },
                    none => { },
                }
                s.closed = !is_open;
            }
            if (ui.focus == id) {
                ring(head, l.accent);
            }
        }
        // its background, at the size it had at the last frame
        WidgetState kept = ui.states[slot];
        if (l.background.a > 0 && kept.content_w > 0.0) {
            surface.fill_rounded(canvas.Rect{ x: parent.x, y: parent.y + size.h / 2.0, w: kept.content_w, h: kept.content_h - size.h / 2.0 }, l.radius, l.background);
        }
        Props p = explicit_props(Group, 0);
        canvas.Color ink_of = color_or(part(Group, 0).color, l.color);
        f32 tx = parent.x + 14.0;
        if (folding) {  // a triangle: down when open, right when folded
            i32 cx = (tx + 6.0) as i32;
            i32 cy = (parent.y + size.h / 2.0) as i32;
            if (is_open) {
                surface.line(cx - 5, cy - 2, cx, cy + 3, ink_of);
                surface.line(cx, cy + 3, cx + 5, cy - 2, ink_of);
            } else {
                surface.line(cx - 2, cy - 5, cx + 3, cy, ink_of);
                surface.line(cx + 3, cy, cx - 2, cy + 5, ink_of);
            }
        }
        if (title.len > 0) {
            write_px(tx + mark, parent.y, size.h, title, ink_of, l.font_size);
        }
        usize before = depth;
        open(false, gap >= 0.0 ? gap : l.gap, padding >= 0.0 ? padding : l.padding);
        if (depth > before) {
            layouts[depth].y += size.h / 2.0;  // under the title, which is on the border
            layouts[depth].top += size.h / 2.0;
            layouts[depth].room_h = max(layouts[depth].room_h - size.h / 2.0, 0.0);
            layouts[depth].bottom = layouts[depth].top;
            layouts[depth].color = or_color(p.color, parent.color);
            layouts[depth].font_size = or_f32(p.font_size, parent.font_size);
            layouts[depth].accent = or_color(p.accent, parent.accent);
            layouts[depth].painted = id;
            layouts[depth].look = l;
            layouts[depth].group = true;
            layouts[depth].group_x = parent.x;
            layouts[depth].group_y = parent.y;
            layouts[depth].title_w = title.len > 0 || folding ? title_w + 8.0 : 0.0;
            layouts[depth].title_h = size.h;
            layouts[depth].folded = !is_open;
        }
        return is_open;
    }

    // The end of a group: its frame is drawn around its widgets, open on its title.
    pub void end_group() {
        Layout done = layouts[depth];
        if (!done.group) {
            end();
            return;
        }
        depth -= 1;
        f32 w = max(done.right - done.left, done.title_w + 20.0 - 2.0 * done.padding) + 2.0 * done.padding;
        f32 h = done.folded ? done.title_h : done.bottom - done.top + 2.0 * done.padding + done.title_h / 2.0;
        canvas.Rect r = place(w, h);
        usize slot = ui.state_slot(done.painted);
        WidgetState* s = &ui.states[slot];
        s.content_w = r.w;
        s.content_h = r.h;
        Look l = done.look;
        if (done.folded) {  // folded: its title, on a line
            f32 top = r.y + done.title_h / 2.0;
            surface.fill(canvas.Rect{ x: r.x + 10.0 + done.title_w, y: top, w: max(r.w - 10.0 - done.title_w, 0.0), h: max(l.border_width, 1.0) }, l.border);
        } else if (l.border.a > 0 && l.border_width > 0.0) {  // four sides, the top one cut by the title
            f32 bw = l.border_width;
            f32 top = r.y + done.title_h / 2.0;
            f32 cut = done.title_w > 0.0 ? done.title_w : 0.0;
            surface.fill(canvas.Rect{ x: r.x, y: top, w: 10.0, h: bw }, l.border);
            surface.fill(canvas.Rect{ x: r.x + 10.0 + cut, y: top, w: max(r.w - 10.0 - cut, 0.0), h: bw }, l.border);
            surface.fill(canvas.Rect{ x: r.x, y: top, w: bw, h: r.y + r.h - top }, l.border);
            surface.fill(canvas.Rect{ x: r.x + r.w - bw, y: top, w: bw, h: r.y + r.h - top }, l.border);
            surface.fill(canvas.Rect{ x: r.x, y: r.y + r.h - bw, w: r.w, h: bw }, l.border);
        }
    }

    // ---- Tabs (spec §10.8) ----

    // A row of tabs, then the content of the tab chosen: `tab(...)` for each tab, true for the
    // one chosen, whose widgets follow; then `end_tabs()`. `chosen` binds the index of the tab
    // chosen; none: the tabs keep it. A click, the keys of the row (Left, Right, Home, End) and
    // Ctrl+Tab choose at the next frame, so that one content only is described in a frame.
    pub void tabs(i32*? chosen) {
        tabs_at(chosen, Top);
    }

    // The same, its row of tabs on the `side` of its content: below it, the row is at the bottom of
    // the room it has, or under the content of the last frame.
    pub void tabs_at(i32*? chosen, Side side) {
        bool bottom = match (side) {
            Bottom => true,
            _ => false,
        };
        ensure_cell();
        u64 id = take_id();
        take_styles();
        Look l = look(Tabs, 0);
        Layout parent = layouts[depth];
        if (tabs_count == 4 || depth == 15) {
            open(false, l.gap, 0.0);  // too deep: a column
            return;
        }
        usize slot = ui.state_slot(id);
        WidgetState* s = &ui.states[slot];
        mut i32 current = match (chosen) {
            some(index) => *index,
            none => s.chosen,
        };
        bool picked = s.pick >= 0;  // a tab was chosen: it comes into view
        if (picked) {
            current = s.pick;
            s.pick = -1;
        }
        current = s.items > 0 ? min(max(current, 0), s.items - 1) : max(current, 0);  // the count is known from the second frame
        match (chosen) {
            some(index) => {
                *index = current;
            },
            none => { },
        }
        s.chosen = current;
        f32 row_h = l.height + 4.0;
        f32 width = fill_width() > 0.0 ? fill_width() : max(s.extent, s.content_w);
        f32 room_h = fill_height();
        f32 row_y = !bottom ? parent.y : room_h > 0.0 ? parent.y + max(room_h - row_h, 0.0) : parent.y + s.content_h + 8.0;
        // tabs wider than the row: two arrows at its end scroll it
        bool arrows = s.extent > width;
        f32 view_w = arrows ? max(width - 48.0, 0.0) : width;
        canvas.Rect row = canvas.Rect{ x: parent.x, y: row_y, w: view_w, h: row_h };
        Look bar = look(Tabs, 0);
        Props row_props = part(Tabs, 2);
        match (row_props.background) {
            some(c) => {
                surface.fill(row, c);
            },
            none => { },
        }
        // the row scrolls with the wheel and its arrows when its tabs are wider than it
        if (over(row) && arrows) {
            s.scroll_x -= (ui.wheel + ui.wheel_x) * 40.0;
            ui.wheel = 0.0;
            ui.wheel_x = 0.0;
        }
        if (arrows) {
            for (i32 k in 0..2) {
                canvas.Rect a = canvas.Rect{ x: row.x + view_w + k as f32 * 24.0, y: row.y, w: 24.0, h: row_h };
                interactive(a);
                if (click(mix(id, 0xA0 | k as u64), a)) {
                    s.scroll_x += k == 0 ? -120.0 : 120.0;
                }
                canvas.Color mark = over(a) ? l.accent : l.color;
                i32 cx = (a.x + 12.0) as i32;
                i32 cy = (a.y + row_h / 2.0) as i32;
                i32 dir = k == 0 ? -1 : 1;
                surface.line(cx - 2 * dir, cy - 5, cx + 3 * dir, cy, mark);
                surface.line(cx + 3 * dir, cy, cx - 2 * dir, cy + 5, mark);
            }
        }
        s.scroll_x = max(min(s.scroll_x, s.extent - view_w), 0.0);
        focusable(id, row);
        if (ui.focus == id) {
            for (usize i in 0..ui.edit_count) {
                Edit e = ui.edits[i];
                if (e.key == key_left() || e.key == key_right()) {
                    s.pick = min(max(current + (e.key == key_left() ? -1 : 1), 0), max(s.items - 1, 0));
                } else if (e.key == key_home() || e.key == key_end()) {
                    s.pick = e.key == key_home() ? 0 : max(s.items - 1, 0);
                }
            }
        }
        usize t = tabs_count;
        tabs_count += 1;
        open(false, bar.gap, 0.0);
        layouts[depth].room_h = max(layouts[depth].room_h - row_h - 8.0, 0.0);
        if (!bottom) {  // the content, under the row
            layouts[depth].y += row_h + 8.0;
            layouts[depth].top += row_h + 8.0;
            layouts[depth].bottom = layouts[depth].top;
        }
        tab_builds[t] = TabsBuild{ id: id, slot: slot, bound: chosen, chosen: current, row: row, width: width, top: parent.y, bottom: bottom, reveal: picked, offset: s.scroll_x, marks: focus_marks, depth: depth };
    }

    // A tab of the `Tabs` being described: true when it is the one chosen, whose widgets follow.
    // `closable` puts a cross on it (`tab_closed()` then says it was clicked); a tab not
    // `enabled` is dimmed and cannot be chosen.
    pub bool tab(str title, bool closable, bool enabled) {
        if (tabs_count == 0) {
            return false;
        }
        usize t = tabs_count - 1;
        TabsBuild b = tab_builds[t];
        i32 index = b.count;
        tab_builds[t].count += 1;
        u64 id = mix(b.id, 0x7AB00000 | index as u64);
        Look first = look(Tabs, 0);
        canvas.Rect size = measure_label(title, first.font_size);
        f32 cross = closable ? 22.0 : 0.0;
        f32 w = size.w + 2.0 * first.padding + cross;
        canvas.Rect r = canvas.Rect{ x: b.row.x + b.x - b.offset, y: b.row.y, w: w, h: b.row.h };
        tab_builds[t].x += w + 2.0;
        bool chosen = index == b.chosen;
        canvas.Rect close_box = canvas.Rect{ x: r.x + r.w - cross - 4.0, y: r.y + (r.h - 18.0) / 2.0, w: 18.0, h: 18.0 };
        surface.push_clip(b.row);
        bool hot = over(r) && over(b.row);
        mut bool closed = false;
        if (enabled) {
            if (closable && click(mix(id, 1), close_box) && over(b.row)) {
                closed = true;
            } else if (click(id, r) && over(b.row) && !chosen) {
                ui.states[b.slot].pick = index;
            } else if (!chosen && alt_letter(title)) {
                ui.states[b.slot].pick = index;
            }
        }
        WidgetState* s = &ui.states[b.slot];
        if (s.closing == index) {  // Ctrl+W at the last frame
            s.closing = -1;
            closed = closable;
        }
        tab_builds[t].closed = closed;
        u32 states = (hot ? state_hover() : 0) | (chosen ? state_checked() : 0) | (enabled ? 0 : state_disabled());
        Look l = look(Tabs, states);
        paint(r, l);
        write_label(r.x + l.padding, r.y, r.h, title, l.color, l.font_size);
        if (chosen) {  // the mark of the tab chosen, on the side of the content; the tab comes into view
            surface.fill(canvas.Rect{ x: r.x, y: b.bottom ? r.y : r.y + r.h - 3.0, w: r.w, h: 3.0 }, l.accent);
            if (b.reveal && r.x < b.row.x) {
                s.scroll_x -= b.row.x - r.x;
            } else if (b.reveal && r.x + r.w > b.row.x + b.row.w) {
                s.scroll_x += r.x + r.w - b.row.x - b.row.w;
            }
            if (ui.focus == b.id) {
                ring(r, l.accent);
            }
        }
        if (closable) {
            canvas.Color mark = over(close_box) ? l.accent : l.color;
            i32 cx = (close_box.x + 9.0) as i32;
            i32 cy = (close_box.y + 9.0) as i32;
            surface.line(cx - 4, cy - 4, cx + 4, cy + 4, mark);
            surface.line(cx - 4, cy + 4, cx + 4, cy - 4, mark);
        }
        surface.pop_clip();
        if (enabled) {
            interactive(r);
        }
        return chosen;
    }

    // Whether the cross of the last tab was clicked (or Ctrl+W pressed on it): the program
    // then removes it.
    pub bool tab_closed() {
        if (tabs_count == 0) {
            return false;
        }
        bool closed = tab_builds[tabs_count - 1].closed;
        tab_builds[tabs_count - 1].closed = false;
        return closed;
    }

    // The end of the tabs: the line under the row, the keys of the tabs, and their place.
    pub void end_tabs() {
        if (tabs_count == 0 || tab_builds[tabs_count - 1].depth != depth) {
            end();
            return;
        }
        tabs_count -= 1;
        TabsBuild b = tab_builds[tabs_count];
        Layout content = layouts[depth];
        depth -= 1;
        WidgetState* s = &ui.states[b.slot];
        s.items = b.count;
        s.extent = b.x;
        s.content_w = content.right - content.left;
        s.content_h = content.bottom - content.top;
        Look l = look(Tabs, 0);
        surface.fill(canvas.Rect{ x: b.row.x, y: b.bottom ? b.row.y : b.row.y + b.row.h - 1.0, w: b.width, h: 1.0 }, l.bar);
        // Ctrl+Tab and Ctrl+Shift+Tab, Ctrl+W: from the row, or from a widget of the content
        if (ui.focus == b.id || focus_marks > b.marks) {
            for (usize i in 0..ui.edit_count) {
                Edit e = ui.edits[i];
                if (e.key == key_tab() && e.ctrl && b.count > 0) {
                    s.pick = (b.chosen + (e.shift ? b.count - 1 : 1)) % b.count;
                } else if (e.key == 119 && e.ctrl) {  // W
                    s.closing = b.chosen;
                }
            }
        }
        place(max(b.width, s.content_w), max(b.row.y + b.row.h, content.bottom) - b.top);
    }

    // ---- Grids (spec §10.8) ----

    // A grid: its columns (`grid_column`) and rows (`grid_row`) follow, then its widgets, each
    // after `cell` (or in the next free cell), until `end_grid()`. A negative `gap` or `padding`:
    // that of the theme and of the styles.
    pub void grid(f32 gap, f32 padding) {
        u64 id = take_id();
        usize before = depth;
        open_styled(Grid, false, gap, padding);  // painted as a column, with its styles
        if (depth == before || grid_count == 4) {
            return;  // too deep: a column
        }
        usize g = grid_count;
        grid_count += 1;
        layouts[depth].grid = g as i32;
        grids[g] = GridBuild{ memory: grid_memory(id) };
    }

    // The entry of `Ui.grid_ids` of the grid or the table `id`: its own, or a new one.
    usize grid_memory(u64 id) {
        mut usize memory = 7;
        mut bool found = false;
        for (usize i in 0..8) {
            if (ui.grid_ids[i] == id) {
                memory = i;
                found = true;
            }
        }
        if (!found) {
            for (usize i in 0..8) {
                if (!found && (ui.grid_ids[i] == 0 || !ui.grid_seen[i])) {
                    memory = i;
                    found = true;
                }
            }
            ui.grid_ids[memory] = id;
            for (usize i in 0..16) {
                ui.grid_widths[memory * 16 + i] = 0.0;
            }
            for (usize i in 0..64) {
                ui.grid_heights[memory * 64 + i] = 0.0;
            }
        }
        ui.grid_seen[memory] = true;
        return memory;
    }

    // A column of the grid being described, 16 at most.
    pub void grid_column(Size size) {
        i32 g = layouts[depth].grid;
        if (g >= 0) {
            GridBuild* b = &grids[g as usize];
            if (b.column_count < 16 && !b.ready) {
                b.columns[b.column_count] = size;
                b.column_count += 1;
            }
        }
    }

    // A row of the grid being described, 64 at most; the rows not given are `Auto`.
    pub void grid_row(Size size) {
        i32 g = layouts[depth].grid;
        if (g >= 0) {
            GridBuild* b = &grids[g as usize];
            if (b.row_count < 64 && !b.ready) {
                b.rows[b.row_count] = size;
                b.row_count += 1;
            }
        }
    }

    // The widths of the columns and the heights of the rows of the grid `g`, from its sizes,
    // the room of its layout and what its cells measured at the last frame.
    void ready_grid(usize g) {
        GridBuild* b = &grids[g];
        if (b.ready) {
            return;
        }
        b.ready = true;
        if (b.column_count == 0) {
            b.columns[0] = Fill(1.0);
            b.column_count = 1;
        }
        Layout l = layouts[depth];
        usize memory = b.memory;
        mut f32 fixed = l.gap * (b.column_count - 1) as f32;
        mut f32 weights = 0.0;
        for (usize i in 0..b.column_count) {
            f32 seen = ui.grid_widths[memory * 16 + i];
            match (b.columns[i]) {
                Pixels(px) => {
                    b.col_w[i] = px;
                    fixed += px;
                },
                Auto => {
                    b.col_w[i] = seen;
                    fixed += seen;
                },
                Fill(weight) => {
                    b.col_w[i] = seen;  // if the room is not known: as Auto
                    weights += max(weight, 0.0);
                },
            }
        }
        if (l.room_w > 0.0 && weights > 0.0) {
            f32 left = max(l.room_w - fixed, 0.0);
            for (usize i in 0..b.column_count) {
                match (b.columns[i]) {
                    Fill(weight) => {
                        b.col_w[i] = left * max(weight, 0.0) / weights;
                    },
                    _ => { },
                }
            }
        }
        mut f32 x = l.left;
        for (usize i in 0..b.column_count) {
            b.col_x[i] = x;
            x += b.col_w[i] + l.gap;
        }
        // the rows: those given, then `Auto`; an `Auto` row not measured yet is a line high
        mut f32[64] heights = [0.0; 64];
        mut f32 used = 0.0;
        mut f32 row_weights = 0.0;
        for (usize i in 0..64) {
            f32 seen = ui.grid_heights[memory * 64 + i];
            Size size = i < b.row_count ? b.rows[i] : Auto;
            match (size) {
                Pixels(px) => {
                    heights[i] = px;
                },
                Auto => {
                    heights[i] = seen > 0.0 ? seen : height;
                },
                Fill(weight) => {
                    heights[i] = seen > 0.0 ? seen : height;
                    row_weights += max(weight, 0.0);
                },
            }
            if (i < b.row_count) {
                match (size) {
                    Fill(weight) => { },
                    _ => {
                        used += heights[i];
                    },
                }
            }
        }
        if (l.room_h > 0.0 && row_weights > 0.0) {
            f32 left = max(l.room_h - used - l.gap * max(b.row_count as f32 - 1.0, 0.0), 0.0);
            for (usize i in 0..b.row_count) {
                match (b.rows[i]) {
                    Fill(weight) => {
                        heights[i] = left * max(weight, 0.0) / row_weights;
                    },
                    _ => { },
                }
            }
        }
        mut f32 y = l.top;
        for (usize i in 0..64) {
            b.row_y[i] = y;
            y += heights[i] + l.gap;
        }
        b.row_y[64] = y;
    }

    // The cell of the next widget: row `row` and column `col` (from 0; negative: the next free
    // cell, row by row), over `span` columns and `row_span` rows; `align` places it in the cell.
    pub void cell(i32 row, i32 col, i32 span, i32 row_span, Align align) {
        i32 g = layouts[depth].grid;
        if (g < 0) {
            return;
        }
        usize index = g as usize;
        ready_grid(index);
        GridBuild* b = &grids[index];
        i32 columns = b.column_count as i32;
        mut i32 r = row;
        mut i32 c = col;
        if (r < 0 && c < 0) {  // the next free cell
            r = b.next_row;
            c = b.next_col;
        } else if (r < 0) {  // a column: in this row if it is still free, else in the next one
            r = c >= b.next_col ? b.next_row : b.next_row + 1;
        } else if (c < 0) {  // a row: its next free cell, or its first one
            c = r == b.next_row ? b.next_col : 0;
        }
        r = min(max(r, 0), 63);
        c = min(max(c, 0), columns - 1);
        i32 wide = min(max(span, 1), columns - c);
        i32 tall = min(max(row_span, 1), 64 - r);
        b.next_row = c + wide >= columns ? r + 1 : r;
        b.next_col = c + wide >= columns ? 0 : c + wide;
        usize first = c as usize;
        usize last_col = (c + wide - 1) as usize;
        usize top = r as usize;
        usize bottom = (r + tall) as usize;
        f32 x = b.col_x[first];
        f32 y = b.row_y[top];
        b.cell = canvas.Rect{ x: x, y: y, w: b.col_x[last_col] + b.col_w[last_col] - x, h: b.row_y[bottom] - layouts[depth].gap - y };
        b.cell_row = r;
        b.cell_col = c;
        b.single_w = wide == 1;
        b.single_h = tall == 1;
        b.align = align;
        b.has_cell = true;
        layouts[depth].x = x;  // a column or a row opened in the cell starts there
        layouts[depth].y = y;
    }

    // A widget `w` by `h` placed in its cell, as its alignment says; it measures its column and
    // its row for the next frame.
    canvas.Rect place_in_grid(usize g, f32 w, f32 h) {
        if (!grids[g].has_cell) {
            cell(-1, -1, 1, 1, Start);
        }
        GridBuild* b = &grids[g];
        b.has_cell = false;
        canvas.Rect c = b.cell;
        canvas.Rect r = match (b.align) {
            Start => canvas.Rect{ x: c.x, y: c.y, w: w, h: h },
            Center => canvas.Rect{ x: c.x + max(c.w - w, 0.0) / 2.0, y: c.y, w: w, h: h },
            End => canvas.Rect{ x: c.x + max(c.w - w, 0.0), y: c.y, w: w, h: h },
            Stretch => canvas.Rect{ x: c.x, y: c.y, w: max(c.w, w), h: h },
        };
        if (b.single_w) {
            usize col = b.cell_col as usize;
            b.seen_w[col] = max(b.seen_w[col], w);
        }
        if (b.single_h) {
            usize row = b.cell_row as usize;
            b.seen_h[row] = max(b.seen_h[row], h);
        }
        layouts[depth].right = max(layouts[depth].right, max(r.x + r.w, c.x + c.w));
        layouts[depth].bottom = max(layouts[depth].bottom, r.y + r.h);
        return r;
    }

    // In a grid, the next widget without `cell` takes the next free cell.
    void ensure_cell() {
        i32 g = layouts[depth].grid;
        if (g >= 0 && !grids[g as usize].has_cell) {
            cell(-1, -1, 1, 1, Start);
        }
    }

    // The end of the grid: what its cells measured is kept for the next frame, and the grid
    // takes its place in the layout that holds it.
    pub void end_grid() {
        i32 g = layouts[depth].grid;
        if (g < 0) {
            end();
            return;
        }
        usize index = g as usize;
        ready_grid(index);
        GridBuild* b = &grids[index];
        usize memory = b.memory;
        for (usize i in 0..16) {
            ui.grid_widths[memory * 16 + i] = b.seen_w[i];
        }
        mut usize rows = b.row_count;
        for (usize i in 0..64) {
            ui.grid_heights[memory * 64 + i] = b.seen_h[i];
            if (b.seen_h[i] > 0.0) {
                rows = max(rows, i + 1);
            }
        }
        // its size: all its columns, and its rows down to the last one used or given
        usize last_col = b.column_count - 1;
        layouts[depth].right = max(layouts[depth].right, b.col_x[last_col] + b.col_w[last_col]);
        if (rows > 0) {
            layouts[depth].bottom = max(layouts[depth].bottom, b.row_y[rows] - layouts[depth].gap);
        }
        grid_count -= 1;
        end();
    }

    // The place of the next widget, of size `w` by `h`, in the current layout.
    canvas.Rect place(f32 w, f32 h) {
        if (layouts[depth].grid >= 0) {
            canvas.Rect r = place_in_grid(layouts[depth].grid as usize, w, h);
            last_id = placed_id;
            placed_id = 0;
            last = r;
            return r;
        }
        Layout l = layouts[depth];
        canvas.Rect r = aligned(l, canvas.Rect{ x: l.x, y: l.y, w: w, h: h });
        layouts[depth].right = max(l.right, r.x + r.w);
        layouts[depth].bottom = max(l.bottom, r.y + r.h);
        if (l.horizontal) {
            layouts[depth].x += w + l.gap;
        } else {
            layouts[depth].y += h + l.gap;
        }
        if (l.area >= 0 && l.is_list) {
            item_placed(l, r);
        }
        last_id = placed_id;  // 0 for a widget without identity (a label)
        placed_id = 0;
        last = r;
        return r;
    }

    // The place of the next widget, across its column or its row, as `align` asked (spec §10.8): in
    // a column, within the width it has room for; in a row, within its height, or a line.
    pub void align(Align how) {
        next_align = how;
    }

    canvas.Rect aligned(Layout l, canvas.Rect r) {
        Align how = next_align;
        next_align = Start;
        f32 room = l.horizontal ? l.room_h > 0.0 ? max(l.top + l.room_h - l.y, r.h) : max(height, r.h) : l.room_w > 0.0 ? max(l.left + l.room_w - l.x, r.w) : r.w;
        f32 size = l.horizontal ? r.h : r.w;
        f32 shift = match (how) {
            Start => 0.0,
            Center => (room - size) / 2.0,
            End => room - size,
            Stretch => 0.0,
        };
        bool stretch = match (how) {
            Stretch => true,
            _ => false,
        };
        if (l.horizontal) {
            return canvas.Rect{ x: r.x, y: r.y + shift, w: r.w, h: stretch ? room : r.h };
        }
        return canvas.Rect{ x: r.x + shift, y: r.y, w: stretch ? room : r.w, h: r.h };
    }

    // A widget placed in a list is one of its items: it can be chosen, and is highlighted.
    void item_placed(Layout l, canvas.Rect r) {
        i32 index = l.item;
        layouts[depth].item += 1;
        if (l.long_count >= 0 && index == shown_first) {
            usize area = l.area as usize;
            ui.states[area].item_h = r.h;  // the height of the items of a long list, for the next frame
        }
        canvas.Rect row = canvas.Rect{ x: l.frame.x, y: r.y, w: l.frame.w - l.bar_w, h: r.h };
        bool inside = over(row) && over(l.frame);
        match (l.selected) {
            some(chosen) => {
                if (ui.pressed && inside) {
                    *chosen = index;
                }
                WidgetState* s = &ui.states[l.area as usize];
                if (*chosen == index) {
                    surface.fill(row, l.look.selection);
                    if (s.reveal) {  // the item chosen with a key comes into view
                        f32 top = r.y - l.frame.y + s.scroll_y;
                        s.scroll_y = min(s.scroll_y, top);
                        s.scroll_y = max(s.scroll_y, top + r.h - l.frame.h);
                        s.reveal = false;
                    }
                } else if (inside) {
                    surface.fill(row, canvas.Color{ r: 205, g: 214, b: 244, a: 18 });
                }
            },
            none => { },
        }
    }

    // A `Scroll` area `width` by `height`: the widgets that follow, until `end_scroll()`, go in a
    // column inside it, clipped, and its content scrolls when it is larger. The wheel over it
    // scrolls it (sideways with Shift, or with the sideways wheel), the innermost area that can
    // still scroll first; its bars can be dragged by their thumb, or clicked beside it to move
    // by a page; with the keyboard, the arrows, Page Up, Page Down, Home and End scroll it.
    pub void scroll(f32 width, f32 height) {
        begin_area(Scroll, width, height, false, none);
    }

    pub void end_scroll() {
        end_area(false);
    }

    // A list `width` by `height`: a `Scroll` whose widgets are items, one under the other. With
    // `selected`, a click chooses an item and gives the list the keyboard; Up, Down, Home, End,
    // Page Up and Page Down move the choice, which comes into view; the item chosen is
    // highlighted.
    pub void list(f32 width, f32 height, i32*? selected) {
        begin_area(List, width, height, true, selected);
    }

    pub void end_list() {
        end_area(true);
    }

    // A long list of `count` items (spec §10.9), `width` by `height`: only the items in view are
    // described, those from `first_shown()` to `last_shown()` excluded, each as high as the first
    // one; then `end_list()`.
    pub void list_of(i32 count, f32 width, f32 height_of, i32*? selected) {
        u64 id = take_id();
        take_styles();
        canvas.Rect r = place(width, height_of);
        interactive(r);
        open_area(id, List, r, true, selected, max(count, 0));
    }

    // ---- Tables (spec §10.9) ----

    // A table of `count` rows, `width` by `height`: its columns follow (`table_column`), then
    // `table_rows()`, then the rows in view (`first_shown()` to `last_shown()`), each cell after
    // `table_cell()`, then `end_table()`, true when a row was activated (Enter, a double click).
    // Rows are chosen as the items of a list; `sort`, when given, is set by a click on the title
    // of a sortable column (again: descending); the border between two titles can be dragged.
    pub void table(i32 count, f32 width, f32 height_of, i32*? selected, Sort*? sort) {
        ensure_cell();
        u64 id = take_id();
        take_styles();
        canvas.Rect r = place(width, height_of);
        interactive(r);
        table_build = TableBuild{ id: id, rect: r, count: max(count, 0), selected: selected, sort: sort, memory: grid_memory(id) };
    }

    // A column of the table being described, 16 at most: its title, its width (pixels, `Auto`,
    // `Fill`), whether a click on its title sorts by it, and where its cells are aligned.
    pub void table_column(str title, Size size, bool sortable, Align align) {
        usize k = table_build.columns;
        if (k < 16) {
            table_build.titles[k] = title;
            table_build.sizes[k] = size;
            table_build.sortable[k] = sortable;
            table_build.aligns[k] = align;
            table_build.columns = k + 1;
        }
    }

    // Lays out the columns, draws the header, and opens the rows.
    pub void table_rows() {
        TableBuild b = table_build;
        u64 id = b.id;
        canvas.Rect r = b.rect;
        Look l = look(Table, 0);
        f32 header_h = l.height;
        usize memory = b.memory;
        // the widths: dragged by the user (kept in the heights of its memory), else its sizes
        f32 room = max(r.w - 10.0, 0.0);
        mut f32 fixed = 0.0;
        mut f32 weights = 0.0;
        mut f32[16] widths = [0.0; 16];
        for (usize i in 0..b.columns) {
            f32 dragged = ui.grid_heights[memory * 64 + i];
            f32 title = measure_px(b.titles[i], l.font_size).w + 28.0;
            if (dragged > 0.0) {
                widths[i] = dragged;
            } else {
                match (b.sizes[i]) {
                    Pixels(px) => {
                        widths[i] = px;
                    },
                    Auto => {
                        widths[i] = max(ui.grid_widths[memory * 16 + i], title);
                    },
                    Fill(weight) => {
                        weights += max(weight, 0.0);
                    },
                }
            }
            fixed += widths[i];
        }
        mut f32 x = r.x;
        for (usize i in 0..b.columns) {
            if (ui.grid_heights[memory * 64 + i] <= 0.0) {
                match (b.sizes[i]) {
                    Fill(weight) => {
                        widths[i] = weights > 0.0 ? max(room - fixed, 0.0) * max(weight, 0.0) / weights : 0.0;
                    },
                    _ => { },
                }
            }
            table_build.col_x[i] = x;
            table_build.col_w[i] = widths[i];
            x += widths[i];
        }
        // the header: titles, the arrow of the sort, borders that can be dragged
        canvas.Rect header = canvas.Rect{ x: r.x, y: r.y, w: r.w, h: header_h };
        mut bool gripped = false;  // the borders first: a press on one is not a click on a title
        for (usize i in 0..b.columns) {
            canvas.Rect grip = canvas.Rect{ x: table_build.col_x[i] + widths[i] - 3.0, y: r.y, w: 6.0, h: header_h };
            if (ui.pressed && over(grip)) {
                ui.active = mix(id, 0x600 | i as u64);
                ui.drag_offset = ui.mouse_x - (table_build.col_x[i] + widths[i]);
                gripped = true;
            }
        }
        Props bar = part(Table, 2);
        surface.fill(header, color_or(bar.background, face(false, false)));
        for (usize i in 0..b.columns) {
            canvas.Rect title = canvas.Rect{ x: table_build.col_x[i], y: r.y, w: widths[i], h: header_h };
            u64 grip_id = mix(id, 0x600 | i as u64);
            if (!gripped && b.sortable[i] && click(mix(id, 0x500 | i as u64), canvas.Rect{ x: title.x, y: title.y, w: title.w - 3.0, h: title.h })) {
                match (b.sort) {
                    some(order) => {
                        order.descending = order.column == i as i32 ? !order.descending : false;
                        order.column = i as i32;
                    },
                    none => { },
                }
            }
            if (ui.active == grip_id && ui.down) {
                ui.grid_heights[memory * 64 + i] = max(ui.mouse_x - ui.drag_offset - title.x, 24.0);
            }
            surface.push_clip(title);
            write_px(title.x + 8.0, title.y, title.h, b.titles[i], l.color, l.font_size);
            match (b.sort) {
                some(order) => {
                    if (order.column == i as i32) {  // the arrow of the sort
                        i32 cx = (title.x + title.w - 14.0) as i32;
                        i32 cy = (title.y + title.h / 2.0) as i32;
                        i32 dir = order.descending ? 1 : -1;
                        surface.line(cx - 4, cy - 2 * dir, cx, cy + 2 * dir, l.accent);
                        surface.line(cx, cy + 2 * dir, cx + 4, cy - 2 * dir, l.accent);
                    }
                },
                none => { },
            }
            surface.pop_clip();
            surface.fill(canvas.Rect{ x: title.x + title.w - 1.0, y: title.y + 6.0, w: 1.0, h: title.h - 12.0 }, l.border);
        }
        // the rows: a long list under the header
        u64 area = mix(id, 0xA11);
        table_build.area_id = area;
        open_area(area, Table, canvas.Rect{ x: r.x, y: r.y + header_h, w: r.w, h: max(r.h - header_h, 0.0) }, true, b.selected, b.count);
    }

    // The next cell: in the next column of the row, or of a new row after the last column.
    pub void table_cell() {
        if (table_build.columns == 0) {
            return;
        }
        if (table_build.cell_open) {
            close_cell();
        }
        usize k = table_build.cell;
        if (k == 0) {  // a new row: an item of the list, as wide as the columns
            usize last_col = table_build.columns - 1;
            f32 wide = table_build.col_x[last_col] + table_build.col_w[last_col] - table_build.rect.x;
            canvas.Rect row = place(wide, height);
            table_build.row_y = row.y;
            if (ui.pressed && ui.presses == 2 && over(row)) {
                table_build.activated = true;
            }
        }
        if (depth == 15) {
            return;
        }
        f32 x = table_build.col_x[k] + 6.0;
        f32 w = max(table_build.col_w[k] - 12.0, 0.0);
        surface.push_clip(canvas.Rect{ x: x - 4.0, y: table_build.row_y, w: w + 8.0, h: height });
        depth += 1;
        layouts[depth] = Layout{ x: x, y: table_build.row_y, left: x, top: table_build.row_y, right: x, bottom: table_build.row_y, gap: 0.0, room_w: w };
        next_align = table_build.aligns[k];
        table_build.cell_open = true;
        table_build.cell = (k + 1) % table_build.columns;
    }

    // Closes the cell being described: it measures its column, for `Auto` at the next frame.
    void close_cell() {
        Layout done = layouts[depth];
        usize k = (table_build.cell + table_build.columns - 1) % table_build.columns;
        table_build.seen_w[k] = max(table_build.seen_w[k], done.right - done.left + 12.0);
        depth -= 1;
        surface.pop_clip();
        table_build.cell_open = false;
        next_align = Start;
    }

    pub bool end_table() {
        if (table_build.cell_open) {
            close_cell();
        }
        bool focused = ui.focus == table_build.area_id;
        end_area(true);
        usize memory = table_build.memory;
        for (usize i in 0..16) {
            ui.grid_widths[memory * 16 + i] = table_build.seen_w[i];
        }
        bool activated = table_build.activated || focused && ui.pressed_key(key_enter(), false, false);
        table_build = TableBuild{ };
        return activated;
    }

    pub i32 first_shown() {
        return shown_first;
    }

    pub i32 last_shown() {
        return shown_last;
    }

    // ---- Trees (spec §10.8) ----

    // A tree `width` by `height`: a list whose items are branches (`branch`) and leaves
    // (`leaf`), indented by their depth, until `end_tree()`. With `selected`, the index of the
    // item chosen among those shown; Up and Down move it, Right opens a branch or goes to its
    // first child, Left closes it or goes to its parent, Enter clicks a leaf.
    pub void tree(f32 width, f32 height, i32*? selected) {
        begin_area(Tree, width, height, true, selected);
        if (layouts[depth].is_list) {
            layouts[depth].tree = true;
        }
        tree_level = 0;
    }

    pub void end_tree() {
        tree_level = 0;
        end_area(true);
    }

    // A branch of the tree being described: a triangle and `text`. A click on the triangle, or
    // Right and Left when it is chosen, opens and closes it; `open` binds that state, none: the
    // tree keeps it (closed at first). Returns whether it is open: its children follow, then
    // `end_branch()`.
    pub bool branch(str text, bool*? open) {
        return branch_with(text, open, none);
    }

    // The same, with `icon` before its text (16 pixels high).
    pub bool branch_with(str text, bool*? open, image.Image? icon) {
        u64 id = take_id();
        usize slot = ui.state_slot(id);
        WidgetState* s = &ui.states[slot];
        mut bool is_open = match (open) {
            some(flag) => *flag,
            none => s.expanded,
        };
        i32 index = layouts[depth].item;
        canvas.Rect r = tree_item(text, true, is_open, icon);
        canvas.Rect toggle = canvas.Rect{ x: r.x, y: r.y, w: 20.0, h: r.h };
        mut bool change = click(id, toggle);
        if (tree_keys(index)) {
            for (usize i in 0..ui.edit_count) {
                u32 key = ui.edits[i].key;
                if (key == key_right()) {
                    if (!is_open) {
                        change = true;
                    } else {
                        tree_choose(index + 1);  // its first child
                    }
                } else if (key == key_left()) {
                    if (is_open) {
                        change = true;
                    } else {
                        tree_to_parent();
                    }
                } else if (key == key_enter()) {
                    change = true;
                }
            }
        }
        if (change) {
            is_open = !is_open;
            s.expanded = is_open;
            match (open) {
                some(flag) => {
                    *flag = is_open;
                },
                none => { },
            }
        }
        if (is_open && tree_level < 16) {
            tree_parents[tree_level] = index;
            tree_level += 1;
        }
        return is_open;
    }

    // The end of the children of an open branch.
    pub void end_branch() {
        if (tree_level > 0) {
            tree_level -= 1;
        }
    }

    // A leaf of the tree being described: `text`. Returns true when it is clicked, or when Enter
    // is pressed while it is chosen.
    pub bool leaf(str text) {
        return leaf_with(text, none);
    }

    // The same, with `icon` before its text (16 pixels high).
    pub bool leaf_with(str text, image.Image? icon) {
        u64 id = take_id();
        i32 index = layouts[depth].item;
        canvas.Rect r = tree_item(text, false, false, icon);
        mut bool clicked = click(id, r);
        if (tree_keys(index)) {
            for (usize i in 0..ui.edit_count) {
                u32 key = ui.edits[i].key;
                if (key == key_enter()) {
                    clicked = true;
                } else if (key == key_left()) {
                    tree_to_parent();
                }
            }
        }
        return clicked;
    }

    // An item of the tree: its row, indented, a triangle for a branch, its icon and its text.
    canvas.Rect tree_item(str text, bool is_branch, bool is_open, image.Image? icon) {
        take_styles();
        Look l = look(Tree, 0);
        f32 indent = tree_level as f32 * 16.0;
        canvas.Rect size = measure_px(text, l.font_size);
        mut f32 icon_w = 0.0;
        match (icon) {
            some(img) => {
                icon_w = img.height > 0 ? 16.0 * img.width as f32 / img.height as f32 + 6.0 : 0.0;
            },
            none => { },
        }
        canvas.Rect r = place(indent + 22.0 + icon_w + size.w + 8.0, l.height);
        canvas.Rect row = canvas.Rect{ x: r.x + indent, y: r.y, w: r.w - indent, h: r.h };
        if (is_branch) {  // down when open, right when closed
            i32 cx = (row.x + 8.0) as i32;
            i32 cy = (row.y + row.h / 2.0) as i32;
            if (is_open) {
                surface.line(cx - 4, cy - 2, cx, cy + 2, l.color);
                surface.line(cx, cy + 2, cx + 4, cy - 2, l.color);
            } else {
                surface.line(cx - 2, cy - 4, cx + 2, cy, l.color);
                surface.line(cx + 2, cy, cx - 2, cy + 4, l.color);
            }
        }
        match (icon) {
            some(img) => {
                if (icon_w > 0.0) {
                    surface.draw_image(img, canvas.Rect{ x: row.x + 22.0, y: row.y + (row.h - 16.0) / 2.0, w: icon_w - 6.0, h: 16.0 });
                }
            },
            none => { },
        }
        write_px(row.x + 22.0 + icon_w, row.y, row.h, text, l.color, l.font_size);
        last = row;  // what a context menu is for
        return row;
    }

    // Whether the keys act on the item `index`: the tree has the keyboard and it is chosen.
    bool tree_keys(i32 index) {
        Layout l = layouts[depth];
        if (!l.tree || ui.focus != l.area_id || tree_keys_used) {
            return false;
        }
        bool chosen_now = match (l.selected) {
            some(chosen) => *chosen == index,
            none => false,
        };
        tree_keys_used = chosen_now;
        return chosen_now;
    }

    void tree_choose(i32 index) {
        match (layouts[depth].selected) {
            some(chosen) => {
                *chosen = index;
                ui.states[layouts[depth].area as usize].reveal = true;
            },
            none => { },
        }
    }

    // Left on an item that is not an open branch: the branch that holds it.
    void tree_to_parent() {
        if (tree_level > 0) {
            tree_choose(tree_parents[tree_level - 1]);
        }
    }

    void begin_area(Kind kind, f32 width, f32 height_of, bool is_list, i32*? selected) {
        u64 id = take_id();
        take_styles();
        canvas.Rect r = place(width, height_of);
        interactive(r);
        open_area(id, kind, r, is_list, selected, -1);
    }

    // The area `r` of a `Scroll`, a list or a table: with `count` >= 0, a long list of that many items
    // as high as the first one, of which only those in view are described (`first_shown` to
    // `last_shown`).
    void open_area(u64 id, Kind kind, canvas.Rect r, bool is_list, i32*? selected, i32 count) {
        usize slot = ui.state_slot(id);
        WidgetState* s = &ui.states[slot];
        bool long_list = count >= 0;
        f32 item_h = s.item_h > 0.0 ? s.item_h : height;
        if (long_list) {
            s.items = count;
            s.content_h = count as f32 * item_h;
        }
        bool tall = s.content_h > r.h;
        bool wide = !is_list && s.content_w > r.w;
        f32 bar_w = tall ? 10.0 : 0.0;
        f32 bar_h = wide ? 10.0 : 0.0;
        f32 view_w = r.w - bar_w;  // what shows of the content
        f32 view_h = r.h - bar_h;
        if (is_list || tall || wide) {  // an area that cannot scroll does not take the keyboard
            focusable(id, r);
        }
        if (ui.focus == id) {
            for (usize i in 0..ui.edit_count) {
                u32 key = ui.edits[i].key;
                if (is_list) {
                    match (selected) {
                        some(chosen) => {
                            i32 last_item = max(s.items - 1, 0);
                            i32 page = max((view_h / height) as i32 - 1, 1);
                            mut i32 next = *chosen;
                            if (key == key_up() || key == key_down()) {
                                next = *chosen + (key == key_up() ? -1 : 1);
                            } else if (key == key_page_up() || key == key_page_down()) {
                                next = *chosen + (key == key_page_up() ? -page : page);
                            } else if (key == key_home() || key == key_end()) {
                                next = key == key_home() ? 0 : last_item;
                            }
                            if (next != *chosen) {
                                *chosen = min(max(next, 0), last_item);
                                s.reveal = true;
                            }
                        },
                        none => { },
                    }
                } else if (key == key_up() || key == key_down()) {
                    s.scroll_y += key == key_up() ? -40.0 : 40.0;
                } else if (key == key_left() || key == key_right()) {
                    s.scroll_x += key == key_left() ? -40.0 : 40.0;
                } else if (key == key_page_up() || key == key_page_down()) {
                    s.scroll_y += (key == key_page_up() ? -1.0 : 1.0) * max(view_h - 40.0, 40.0);
                } else if (key == key_home() || key == key_end()) {
                    s.scroll_y = key == key_home() ? 0.0 : s.content_h;
                }
            }
        }
        if (tall) {
            s.scroll_y = drag_bar(mix(id, 1), canvas.Rect{ x: r.x + r.w - bar_w, y: r.y, w: bar_w, h: view_h }, s.scroll_y, s.content_h, view_h, true);
        }
        if (wide) {
            s.scroll_x = drag_bar(mix(id, 2), canvas.Rect{ x: r.x, y: r.y + r.h - bar_h, w: view_w, h: bar_h }, s.scroll_x, s.content_w, view_w, false);
        }
        s.scroll_y = max(min(s.scroll_y, s.content_h - view_h), 0.0);
        s.scroll_x = max(min(s.scroll_x, s.content_w - view_w), 0.0);
        Look area_look = look(kind, (over(r) ? state_hover() : 0) | (ui.focus == id ? state_focus() : 0));
        paint(r, area_look);
        surface.push_clip(canvas.Rect{ x: r.x + 2.0, y: r.y + 2.0, w: view_w - (tall ? 2.0 : 4.0), h: view_h - (wide ? 2.0 : 4.0) });
        if (depth == 15) {
            return;  // too deep: the widgets stay in the current layout
        }
        f32 pad = is_list ? 0.0 : 8.0;
        f32 left = r.x + 8.0 - s.scroll_x;
        f32 top = r.y + pad - s.scroll_y;
        depth += 1;
        layouts[depth] = Layout{ x: left, y: top, left: left, top: top, right: left, bottom: top, gap: is_list ? 0.0 : 8.0, area: slot as i32, area_id: id, is_list: is_list, frame: r, bar_w: bar_w, bar_h: bar_h, selected: selected, look: area_look, room_w: max(view_w - 16.0, 0.0) };
        shown_first = 0;
        shown_last = 0;
        if (long_list) {  // the items in view: the first ones are skipped, where they would be
            WidgetState* kept = &ui.states[slot];
            match (selected) {
                some(chosen) => {
                    if (kept.reveal) {
                        f32 at = *chosen as f32 * item_h;
                        kept.scroll_y = max(min(kept.scroll_y, at), at + item_h - view_h);
                        kept.scroll_y = max(min(kept.scroll_y, kept.content_h - view_h), 0.0);
                        kept.reveal = false;
                    }
                },
                none => { },
            }
            shown_first = min((kept.scroll_y / item_h) as i32, count);
            shown_last = min(shown_first + (view_h / item_h) as i32 + 2, count);
            f32 skipped = shown_first as f32 * item_h;
            layouts[depth].y = r.y - kept.scroll_y + skipped;
            layouts[depth].bottom = layouts[depth].y;
            layouts[depth].item = shown_first;
            layouts[depth].long_count = count;
        }
    }

    void end_area(bool is_list) {
        Layout done = layouts[depth];
        if (done.area < 0 || done.is_list != is_list) {
            return;  // not in such an area
        }
        depth -= 1;
        WidgetState* s = &ui.states[done.area as usize];
        f32 pad = is_list ? 0.0 : 8.0;
        s.content_h = done.bottom - done.top + 2.0 * pad;
        s.content_w = is_list ? 0.0 : done.right - done.left + 16.0;
        if (is_list) {
            s.items = done.item;
        }
        if (done.long_count >= 0) {  // a long list: all its items, as high as the first one
            f32 item_h = s.item_h > 0.0 ? s.item_h : height;
            s.content_h = done.long_count as f32 * item_h;
            s.items = done.long_count;
        }
        surface.pop_clip();
        canvas.Rect r = done.frame;
        f32 view_w = r.w - done.bar_w;
        f32 view_h = r.h - done.bar_h;
        // The wheel: this area takes it if the mouse is over it and it can still scroll that way;
        // an inner area ends first, so it has its chance first.
        if (over(r)) {
            f32 down = ui.shift_held ? 0.0 : -ui.wheel;
            f32 right = ui.wheel_x + (ui.shift_held ? -ui.wheel : 0.0);
            if (down != 0.0 && (down < 0.0 ? s.scroll_y > 0.0 : s.scroll_y < s.content_h - view_h)) {
                s.scroll_y += down * 40.0;
                ui.wheel = 0.0;
            }
            if (right != 0.0 && (right < 0.0 ? s.scroll_x > 0.0 : s.scroll_x < s.content_w - view_w)) {
                s.scroll_x += right * 40.0;
                ui.wheel_x = 0.0;
                if (ui.shift_held) {
                    ui.wheel = 0.0;
                }
            }
        }
        s.scroll_y = max(min(s.scroll_y, s.content_h - view_h), 0.0);
        s.scroll_x = max(min(s.scroll_x, s.content_w - view_w), 0.0);
        if (s.content_h > view_h) {  // the bars show where the content is
            f32 thumb = max(view_h * view_h / s.content_h, 16.0);
            f32 y = r.y + (view_h - thumb) * s.scroll_y / (s.content_h - view_h);
            surface.fill(canvas.Rect{ x: r.x + r.w - 7.0, y: y + 2.0, w: 4.0, h: thumb - 4.0 }, ui.active == mix(done.area_id, 1) ? done.look.accent : done.look.bar);
        }
        if (!is_list && s.content_w > view_w) {
            f32 thumb = max(view_w * view_w / s.content_w, 16.0);
            f32 x = r.x + (view_w - thumb) * s.scroll_x / (s.content_w - view_w);
            surface.fill(canvas.Rect{ x: x + 2.0, y: r.y + r.h - 7.0, w: thumb - 4.0, h: 4.0 }, ui.active == mix(done.area_id, 2) ? done.look.accent : done.look.bar);
        }
        last = r;
        last_id = done.area_id;
    }

    // A scroll bar along `track`: where the content is scrolled (`at`, of `content` of which
    // `view` shows), after its thumb was dragged, or the bar clicked beside it (a page).
    f32 drag_bar(u64 id, canvas.Rect track, f32 at, f32 content, f32 view, bool vertical) {
        f32 length = vertical ? track.h : track.w;
        f32 origin = vertical ? track.y : track.x;
        f32 thumb = max(length * view / content, 16.0);
        f32 room = max(length - thumb, 1.0);
        f32 range = max(content - view, 1.0);
        f32 start = origin + room * at / range;
        f32 mouse = vertical ? ui.mouse_y : ui.mouse_x;
        mut f32 next = at;
        if (ui.pressed && over(track)) {
            if (mouse >= start && mouse < start + thumb) {
                ui.active = id;
                ui.drag_offset = mouse - start;
            } else {
                next += (mouse < start ? -1.0 : 1.0) * view;
            }
        }
        if (ui.active == id && ui.down) {
            next = (mouse - ui.drag_offset - origin) / room * range;
        }
        return next;
    }

    // The mouse is over `r`, and not over the open list of a dropdown, which is above it.
    bool over(canvas.Rect r) {
        return contains(r, ui.mouse_x, ui.mouse_y) && !ui.on_layer(ui.mouse_x, ui.mouse_y) && (!ui.modal || in_dialog || finishing);
    }

    // Pressed then released over `r`, the press and the release maybe in the same frame.
    bool click(u64 id, canvas.Rect r) {
        if (ui.pressed && over(r)) {
            ui.active = id;
        }
        return ui.released && ui.active == id && over(r);
    }
}

// The widgets of a frame, from (x, y) downwards. End it with `finish()`.
pub Frame begin(Ui* ui, canvas.Canvas* surface, f32 x, f32 y) {
    mut Frame f = Frame{ ui: ui, surface: surface };
    // inside the safe area (spec §10.9): notches and system bars leave margins
    f32 left = x + ui.safe_left;
    f32 top = y + ui.safe_top;
    f.layouts[0] = Layout{ x: left, y: top, left: left, top: top, right: left, bottom: top, room_w: max(surface.width as f32 - left - ui.safe_right, 0.0), room_h: max(surface.height as f32 - top - ui.safe_bottom, 0.0) };
    // the background of the window, when the theme gives one (spec §10.7)
    match (ui.theme) {
        some(t) => {
            match (in_states(t.window, 0).background) {
                some(c) => {
                    surface.clear(c);
                },
                none => { },
            }
        },
        none => { },
    }
    return f;
}

test "text buffer" {
    mut TextBuffer t = TextBuffer{ };
    t.set("h\u{e9}llo");
    assert(t.len == 6 && t.count() == 5);
    t.erase_last();
    t.erase_last();
    t.erase_last();
    assert(t.text().len == 3 && t.count() == 2);  // "hé": é takes 2 bytes
    t.erase_last();
    assert(t.text().len == 1);
    t.set("abcdef");
    assert(t.tail(2).len == 2 && t.tail(10).len == 6);
}

test "a button is clicked by a press and a release over it" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 200, 100);
    mut Ui ui = Ui{ };
    ui.mouse_move(20.0, 20.0);
    ui.mouse_button(true);
    mut Frame f = begin(&ui, &surface, 10.0, 10.0);
    assert(!f.button("OK"));
    f.finish();
    assert(ui.active != 0);
    ui.mouse_button(false);
    f = begin(&ui, &surface, 10.0, 10.0);
    assert(f.button("OK"));
    f.finish();
    assert(ui.active == 0);
    assert(surface.at(12, 12) != 0);  // drawn

    // pressed elsewhere, released over it: not a click
    ui.mouse_move(150.0, 90.0);
    ui.mouse_button(true);
    f = begin(&ui, &surface, 10.0, 10.0);
    assert(!f.button("OK"));
    f.finish();
    ui.mouse_move(20.0, 20.0);
    ui.mouse_button(false);
    f = begin(&ui, &surface, 10.0, 10.0);
    assert(!f.button("OK"));
    f.finish();
}

test "a text field takes the keyboard when clicked" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 300, 100);
    mut Ui ui = Ui{ };
    mut TextBuffer name = TextBuffer{ };
    mut bool done = false;

    ui.type_text("lost");  // no field has the focus yet
    mut Frame f = begin(&ui, &surface, 0.0, 0.0);
    f.text_field(&name, 200.0);
    f.finish();
    assert(name.len == 0);

    ui.mouse_move(10.0, 10.0);
    ui.mouse_button(true);
    ui.mouse_button(false);
    ui.type_text("Ada");
    ui.key(8, true, false, false);
    ui.key(13, true, false, false);
    f = begin(&ui, &surface, 0.0, 0.0);
    assert(f.text_field(&name, 200.0));  // Enter
    f.finish();
    assert(name.len == 2 && ui.focus != 0);
    u64 field = ui.focus;

    // a click on another widget gives it the keyboard; the checkbox is the second widget
    ui.mouse_move(20.0, 50.0);
    ui.mouse_button(true);
    ui.mouse_button(false);
    f = begin(&ui, &surface, 0.0, 0.0);
    f.text_field(&name, 200.0);
    assert(f.checkbox("Done", &done) && done);
    f.finish();
    assert(ui.focus != 0 && ui.focus != field);
    // a click on nothing takes the keyboard away
    ui.mouse_move(250.0, 90.0);
    ui.mouse_button(true);
    ui.mouse_button(false);
    f = begin(&ui, &surface, 0.0, 0.0);
    f.text_field(&name, 200.0);
    f.checkbox("Done", &done);
    f.finish();
    assert(ui.focus == 0);
}

test "layouts nest" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 300, 200);
    mut Ui ui = Ui{ };
    mut Frame f = begin(&ui, &surface, 10.0, 10.0);
    f.row_with(4.0, 0.0);
    f.column(2.0, 0.0);
    canvas.Rect a = f.place(16.0, 32.0);
    canvas.Rect b = f.place(20.0, 32.0);
    f.end();  // the column: 20 wide, 66 high
    canvas.Rect c = f.place(10.0, 10.0);
    f.end();
    canvas.Rect d = f.place(10.0, 10.0);
    assert(a.x == 10.0 && a.y == 10.0 && b.x == 10.0 && b.y == 44.0);
    assert(c.x == 34.0 && c.y == 10.0);
    assert(d.x == 10.0 && d.y == 84.0);

    f.column(0.0, 5.0);  // padding on every side
    canvas.Rect e = f.place(10.0, 10.0);
    f.end();
    canvas.Rect g = f.place(10.0, 10.0);
    assert(e.x == 15.0 && e.y == 107.0 && g.y == 130.0);  // the column, 20 high, starts at 102
    f.end();  // nothing open: ignored
    f.finish();
}

test "a disabled button is never clicked" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 200, 100);
    mut Ui ui = Ui{ };
    ui.mouse_move(20.0, 20.0);
    ui.mouse_button(true);
    ui.mouse_button(false);
    mut Frame f = begin(&ui, &surface, 10.0, 10.0);
    assert(!f.button_enabled("OK", false));
    f.finish();
}

test "the widgets use the font of ui" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 300, 100);
    mut Ui ui = Ui{ };
    truetype.Font* noto = match (truetype.load(&arena, "packages/render/fonts/NotoSans-Regular.ttf")) {
        ok(f) => f,
        err(e) => {
            assert(false);
            return;
        },
    };
    defer noto.close();
    mut Frame f = begin(&ui, &surface, 0.0, 0.0);
    canvas.Rect bitmap = f.measure("iiii", 2);  // 8 by 8: every character as wide
    ui.font = some(noto);
    canvas.Rect proportional = f.measure("iiii", 2);
    assert(proportional.w < bitmap.w / 2.0);
    f.label("Hello");
    mut u32 drawn = 0;
    for (mut i32 y = 0; y < 32; y += 1) {
        for (mut i32 x = 0; x < 60; x += 1) {
            drawn += surface.at(x, y) != 0 ? 1 : 0;
        }
    }
    assert(drawn > 50);
    f.finish();
}

// Runs one frame with a text field 200 pixels wide at (0, 0), and the input given so far.
bool field_frame(Ui* ui, canvas.Canvas* surface, TextBuffer* text, Format format) {
    mut Frame f = begin(ui, surface, 0.0, 0.0);
    bool entered = f.text_field_with(text, 200.0, format);
    f.finish();
    return entered;
}

void press(Ui* ui, u32 key, bool shift, bool ctrl) {
    ui.key(key, true, shift, ctrl);
    ui.key(key, false, shift, ctrl);  // released keys are ignored
}

test "editing a text field" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 300, 100);
    mut Ui ui = Ui{ };
    mut TextBuffer t = TextBuffer{ };
    Format any = Format{ };
    // a click gives the keyboard; typing, moving and typing again, in order
    ui.mouse_move(10.0, 10.0);
    ui.mouse_button(true);
    ui.mouse_button(false);
    ui.type_text("held");
    press(&ui, key_left(), false, false);
    press(&ui, key_left(), false, false);
    ui.type_text("\u{e9}");
    field_frame(&ui, &surface, &t, any);
    assert(t.text().len == 6 && ui.cursor == 4);  // "heéld": é is 2 bytes
    // Shift+Home selects to the start, typing replaces the selection
    press(&ui, key_home(), true, false);
    ui.type_text("W");
    field_frame(&ui, &surface, &t, any);
    assert(t.len == 3 && t.bytes[0] == 87 && ui.cursor == 1);  // "Wld"
    // Backspace and Delete, with and without a selection
    press(&ui, key_delete(), false, false);
    press(&ui, key_end(), false, false);
    press(&ui, key_backspace(), false, false);
    field_frame(&ui, &surface, &t, any);
    assert(t.len == 1 && ui.cursor == 1);  // "W"
    ui.type_text("orld");
    press(&ui, 97, false, true);  // Ctrl+A
    press(&ui, 99, false, true);  // Ctrl+C
    press(&ui, key_right(), false, false);  // the selection ends: the cursor at its end
    field_frame(&ui, &surface, &t, any);
    assert(t.len == 5 && ui.cursor == 5 && ui.anchor == 5);
    bool copied = match (ui.take_copied()) {
        some(text) => text.len == 5,
        none => false,
    };
    assert(copied && !ui.has_copied);
    press(&ui, key_left(), true, false);
    press(&ui, key_left(), true, false);
    press(&ui, 120, false, true);  // Ctrl+X: "ld"
    press(&ui, key_enter(), false, false);
    assert(field_frame(&ui, &surface, &t, any));
    assert(t.len == 3 && ui.copied.len == 2);  // "Wor"
}

test "the mouse places the cursor and selects" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 300, 100);
    mut Ui ui = Ui{ };
    mut TextBuffer t = TextBuffer{ };
    t.set("abcdef");  // the built-in font: 16 pixels per character, from x = 8
    ui.mouse_move(8.0 + 2.0 * 16.0 + 3.0, 10.0);  // nearer to the boundary after `b`
    ui.mouse_button(true);
    field_frame(&ui, &surface, &t, Format{ });
    assert(ui.cursor == 2 && ui.anchor == 2);
    ui.mouse_move(8.0 + 5.0 * 16.0 - 2.0, 10.0);  // dragging, the button still held
    field_frame(&ui, &surface, &t, Format{ });
    assert(ui.cursor == 5 && ui.anchor == 2);
    ui.mouse_button(false);
    field_frame(&ui, &surface, &t, Format{ });
    assert(ui.active == 0 && ui.focus != 0);
}

test "formats" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 300, 100);
    mut Ui ui = Ui{ };
    ui.mouse_move(10.0, 10.0);
    ui.mouse_button(true);
    ui.mouse_button(false);

    mut TextBuffer digits = TextBuffer{ };
    ui.type_text("a1-2.3 4");
    field_frame(&ui, &surface, &digits, Format{ accept: Digits, max: 3 });
    assert(digits.len == 3 && digits.bytes[0] == 49 && digits.bytes[2] == 51);  // "123"

    mut TextBuffer integer = TextBuffer{ };
    ui.type_text("-12-3");
    field_frame(&ui, &surface, &integer, Format{ accept: Integer });
    assert(integer.len == 4);  // "-123": the second `-` is refused

    mut TextBuffer decimal = TextBuffer{ };
    ui.type_text("3,14.15");
    field_frame(&ui, &surface, &decimal, Format{ accept: Decimal });
    assert(decimal.len == 6 && decimal.bytes[1] == 44);  // "3,1415": one separator

    mut TextBuffer date = TextBuffer{ };
    ui.type_text("2512x2026/7");
    field_frame(&ui, &surface, &date, Format{ mask: "99/99/9999" });
    assert(date.len == 10 && date.bytes[2] == 47 && date.bytes[5] == 47);  // "25/12/2026"

    mut TextBuffer code = TextBuffer{ };
    ui.type_text("ab12");
    field_frame(&ui, &surface, &code, Format{ mask: "AA-99" });
    assert(code.len == 5 && code.bytes[2] == 45);  // "ab-12"
}

// A list 200 by 100 at (0, 0), of 20 labels 32 high: 640 of content.
void list_frame(Ui* ui, canvas.Canvas* surface, i32* chosen) {
    mut Frame f = begin(ui, surface, 0.0, 0.0);
    f.list(200.0, 100.0, some(chosen));
    for (i32 i in 0..20) {
        f.label("item");
    }
    f.end_list();
    f.finish();
}

// The first state kept by `ui`: in a frame with one list or one `Scroll`, its own.
WidgetState first_state(Ui* ui) {
    for (usize i in 0..64) {
        if (ui.states[i].id != 0) {
            return ui.states[i];
        }
    }
    return WidgetState{ };
}

test "lists scroll and choose" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 300, 200);
    mut Ui ui = Ui{ };
    mut i32 chosen = -1;
    list_frame(&ui, &surface, &chosen);
    assert(first_state(&ui).content_h == 640.0 && first_state(&ui).items == 20);

    ui.mouse_move(50.0, 40.0);  // the second item (32 to 64)
    ui.mouse_button(true);
    ui.mouse_button(false);
    list_frame(&ui, &surface, &chosen);
    assert(chosen == 1 && ui.focus != 0);

    ui.scroll_wheel(-2.0);  // towards the user: down, 80 pixels
    list_frame(&ui, &surface, &chosen);
    assert(first_state(&ui).scroll_y == 80.0);
    ui.scroll_wheel(-100.0);  // no further than the end
    list_frame(&ui, &surface, &chosen);
    list_frame(&ui, &surface, &chosen);
    assert(first_state(&ui).scroll_y == 540.0);
    ui.mouse_move(250.0, 40.0);  // outside: the wheel does nothing
    ui.scroll_wheel(5.0);
    list_frame(&ui, &surface, &chosen);
    assert(first_state(&ui).scroll_y == 540.0);

    // Up and Down move the choice; the item chosen comes into view
    ui.key(key_down(), true, false, false);
    ui.key(key_up(), true, false, false);
    ui.key(key_up(), true, false, false);
    list_frame(&ui, &surface, &chosen);
    list_frame(&ui, &surface, &chosen);
    assert(chosen == 0 && first_state(&ui).scroll_y == 0.0);
    for (i32 i in 0..30) {
        ui.key(key_down(), true, false, false);
    }
    list_frame(&ui, &surface, &chosen);
    list_frame(&ui, &surface, &chosen);
    assert(chosen == 19 && first_state(&ui).scroll_y == 540.0);
}

// A title bar 40 high holding a label and a button, then a label under it. Returns whether
// the button was clicked.
bool bar_frame(Ui* ui, canvas.Canvas* surface) {
    mut Frame f = begin(ui, surface, 0.0, 0.0);
    f.title_bar(40.0, 8.0, 4.0);
    f.label("App");  // built-in font: 48 wide, from x 4
    bool run = f.button("Run");  // x 60 to 140
    f.end_title_bar();
    f.label("under");
    f.finish();
    return run;
}

void click_at(Ui* ui, f32 x, f32 y) {
    ui.mouse_move(x, y);
    ui.mouse_button(true);
    ui.mouse_button(false);
}

test "a title bar drags the window, except on its widgets and buttons" {
    mut Arena arena = Arena.new(512 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 400, 200);
    mut Ui ui = Ui{ };
    bar_frame(&ui, &surface);
    assert(!ui.is_drag_area(200.0, 20.0));  // the system kept its title bar: a tool bar
    assert(ui.bar_buttons.w == 0.0);

    ui.custom_title_bar = true;
    bar_frame(&ui, &surface);
    assert(ui.is_drag_area(200.0, 20.0));  // empty space
    assert(ui.is_drag_area(10.0, 20.0));  // the label
    assert(!ui.is_drag_area(100.0, 20.0));  // the button
    assert(!ui.is_drag_area(300.0, 20.0));  // the window buttons: x 262 to 400
    assert(!ui.is_drag_area(200.0, 60.0));  // under the bar
    assert(surface.at(1, 1) != 0);  // drawn

    click_at(&ui, 100.0, 20.0);
    assert(bar_frame(&ui, &surface));
    match (ui.take_window_request()) {
        some(r) => assert(false),
        none => { },
    }
    // the window buttons: minimize, maximize, close, 46 wide each
    for (i32 i in 0..3) {
        click_at(&ui, 262.0 + 46.0 * i as f32 + 20.0, 20.0);
        bar_frame(&ui, &surface);
        mut i32 asked = -1;
        match (ui.take_window_request()) {
            some(r) => {
                asked = match (r) {
                    Minimize => 0,
                    ToggleMaximize => 1,
                    Close => 2,
                };
            },
            none => { },
        }
        assert(asked == i);
    }
    match (ui.take_window_request()) {  // given once
        some(r) => assert(false),
        none => { },
    }
}

// A dropdown of three options at the top, and a button under it (y 40 to 72), which its open
// list (y 32 to 128) covers. Returns whether the button was clicked.
bool dropdown_frame(Ui* ui, canvas.Canvas* surface, i32* choice) {
    mut Frame f = begin(ui, surface, 0.0, 0.0);
    f.dropdown(160.0);
    for (i32 i in 0..3) {
        str text = i == 0 ? "Debug" : i == 1 ? "Release" : "Profile";
        if (f.option(text, *choice == i) && *choice != i) {
            *choice = i;
        }
    }
    f.end_dropdown();
    bool under = f.button("Under");
    f.finish();
    return under;
}

test "a dropdown opens above the rest, chooses and closes" {
    mut Arena arena = Arena.new(512 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 400, 200);
    mut Ui ui = Ui{ };
    mut i32 choice = 1;
    dropdown_frame(&ui, &surface, &choice);
    assert(ui.open == 0 && ui.layer.h == 0.0);

    click_at(&ui, 20.0, 10.0);  // the box opens the list
    dropdown_frame(&ui, &surface, &choice);
    assert(ui.open != 0 && ui.layer.y == 32.0 && ui.layer.h == 96.0);

    // the first option, over the button: the option takes the click, and the list closes
    click_at(&ui, 20.0, 50.0);
    assert(!dropdown_frame(&ui, &surface, &choice));
    assert(choice == 0 && ui.open == 0);
    dropdown_frame(&ui, &surface, &choice);
    assert(ui.layer.h == 0.0);
    click_at(&ui, 20.0, 50.0);  // closed: the button gets the click
    assert(dropdown_frame(&ui, &surface, &choice));

    click_at(&ui, 20.0, 10.0);  // a click elsewhere closes it without choosing
    dropdown_frame(&ui, &surface, &choice);
    click_at(&ui, 300.0, 150.0);
    dropdown_frame(&ui, &surface, &choice);
    assert(ui.open == 0 && choice == 0);

    click_at(&ui, 20.0, 10.0);  // and Escape
    dropdown_frame(&ui, &surface, &choice);
    ui.key(27, true, false, false);
    dropdown_frame(&ui, &surface, &choice);
    assert(ui.open == 0 && choice == 0);
}

test "an image is placed as a widget, centered in a row" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 200, 100);
    mut Ui ui = Ui{ };
    mut u32[] pixels = arena.alloc_slice(u32, 8);
    for (usize i in 0..8) {
        pixels[i] = 0xFFFF0000;
    }
    image.Image img = image.Image{ width: 4, height: 2, pixels: pixels };  // twice as wide as high
    mut Frame f = begin(&ui, &surface, 0.0, 0.0);
    f.image(img, 0.0);  // its own size: 4 by 2, at (0, 0)
    f.row();
    f.image(img, 10.0);  // 20 by 10, centered in a row 32 high, at y 10 + 11
    f.label("x");
    f.end_row();
    f.finish();
    assert(surface.at(3, 1) == 0xFFFF0000 && surface.at(4, 1) == 0);
    assert(surface.at(19, 21) == 0xFFFF0000 && surface.at(19, 20) == 0 && surface.at(19, 31) == 0);
}

// A bar with File (New, a separator, Recent > a.sosu, Quit disabled) and Edit (Undo), then a
// button under it. Each bit of the result is something clicked: 1 New, 2 a.sosu, 4 Quit,
// 8 Undo, 16 the button.
i32 menu_frame(Ui* ui, canvas.Canvas* surface) {
    mut i32 clicked = 0;
    mut Frame f = begin(ui, surface, 0.0, 0.0);
    f.menu_bar();
    f.menu("File");  // the built-in font: x 0 to 88; its menu x 0 to 216 (New and Ctrl+N), y 32 to 133
    if (f.menu_item_with("New", "Ctrl+N", true)) {  // y 36 to 64
        clicked += 1;
    }
    f.separator();  // 64 to 73
    f.menu("Recent");  // 73 to 101; its menu from x 212, y 69
    if (f.menu_item("a.sosu")) {  // y 73 to 101
        clicked += 2;
    }
    f.end_menu();
    if (f.menu_item_with("Quit", "Ctrl+Q", false)) {  // 101 to 129
        clicked += 4;
    }
    f.end_menu();
    f.menu("Edit");  // x 88 to 176
    if (f.menu_item_with("Undo", "Ctrl+Z", true)) {
        clicked += 8;
    }
    f.end_menu();
    f.end_menu_bar();
    if (f.button("Under")) {  // y 40 to 72
        clicked += 16;
    }
    f.finish();
    return clicked;
}

test "menus of a bar: open, switch, submenus, items and shortcuts" {
    mut Arena arena = Arena.new(512 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 400, 300);
    mut Ui ui = Ui{ };
    assert(menu_frame(&ui, &surface) == 0 && ui.menus[0] == 0);

    click_at(&ui, 20.0, 10.0);  // File opens
    assert(menu_frame(&ui, &surface) == 0 && ui.menus[0] != 0 && ui.popup_count == 1 && ui.popups[0].x == 0.0);
    ui.mouse_move(120.0, 10.0);  // over Edit, File open: Edit opens instead
    menu_frame(&ui, &surface);
    assert(ui.menus[0] != 0 && ui.popups[0].x == 88.0);
    click_at(&ui, 120.0, 10.0);  // a click on the title of the menu open closes it
    menu_frame(&ui, &surface);
    assert(ui.menus[0] == 0);

    click_at(&ui, 20.0, 10.0);
    menu_frame(&ui, &surface);
    ui.mouse_move(20.0, 85.0);  // over Recent: its submenu opens
    menu_frame(&ui, &surface);
    assert(ui.menus[1] != 0 && ui.popup_count == 2);
    ui.mouse_move(20.0, 50.0);  // over New: it closes
    menu_frame(&ui, &surface);
    assert(ui.menus[1] == 0 && ui.menus[0] != 0);
    ui.mouse_move(20.0, 85.0);
    menu_frame(&ui, &surface);
    click_at(&ui, 300.0, 85.0);  // a.sosu, in the submenu: everything closes
    assert(menu_frame(&ui, &surface) == 2 && ui.menus[0] == 0);

    click_at(&ui, 20.0, 10.0);
    menu_frame(&ui, &surface);
    click_at(&ui, 20.0, 115.0);  // Quit, disabled: nothing, the menu stays open
    assert(menu_frame(&ui, &surface) == 0 && ui.menus[0] != 0);
    click_at(&ui, 20.0, 50.0);  // New, over the button: the menu takes the click
    assert(menu_frame(&ui, &surface) == 1 && ui.menus[0] == 0);
    click_at(&ui, 20.0, 50.0);  // closed: the button gets it
    assert(menu_frame(&ui, &surface) == 16);

    ui.key(110, true, false, true);  // Ctrl+N, the menu closed
    assert(menu_frame(&ui, &surface) == 1);
    ui.key(113, true, false, true);  // Ctrl+Q: Quit is disabled
    ui.key(122, true, true, true);  // Ctrl+Shift+Z is not Ctrl+Z
    assert(menu_frame(&ui, &surface) == 0);
    ui.key(122, true, false, true);
    assert(menu_frame(&ui, &surface) == 8);
    ui.key(110, true, false, true);  // Ctrl+N once, Ctrl+Z twice: each press, once
    ui.key(122, true, false, true);
    ui.key(122, true, false, true);
    assert(menu_frame(&ui, &surface) == 9);

    click_at(&ui, 20.0, 10.0);  // Escape closes
    menu_frame(&ui, &surface);
    ui.key(27, true, false, false);
    menu_frame(&ui, &surface);
    assert(ui.menus[0] == 0 && ui.popup_count == 0);
}

// A list of two items, the first with its own context menu (Open), then the context menu of
// the list (Rename, Delete), and a text field. 1 Open, 2 Rename, 4 Delete.
i32 context_frame(Ui* ui, canvas.Canvas* surface, TextBuffer* text) {
    mut i32 clicked = 0;
    mut Frame f = begin(ui, surface, 0.0, 0.0);
    f.list(200.0, 120.0, none);  // y 0 to 120, the items from y 0, 32 high
    f.label("first");
    f.context_menu();
    if (f.menu_item("Open")) {
        clicked += 1;
    }
    f.end_context_menu();
    f.label("second");
    f.end_list();
    f.context_menu();
    if (f.menu_item_with("Rename", "F2", true)) {
        clicked += 2;
    }
    if (f.menu_item_with("Delete", "Delete", true)) {
        clicked += 4;
    }
    f.end_context_menu();
    f.text_field(text, 200.0);  // y 128 to 160
    f.finish();
    return clicked;
}

test "context menus open under the mouse, the innermost first" {
    mut Arena arena = Arena.new(512 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 400, 300);
    mut Ui ui = Ui{ };
    mut TextBuffer text = TextBuffer{ };
    ui.mouse_move(50.0, 90.0);  // in the list, under its items
    ui.right_button(true);
    ui.right_button(false);
    context_frame(&ui, &surface, &text);
    assert(ui.menus[0] != 0 && ui.popups[0].h == 64.0 && ui.context_x == 50.0 && ui.context_y == 90.0);
    click_at(&ui, 60.0, 108.0);  // Rename: y 94 to 122
    assert(context_frame(&ui, &surface, &text) == 2 && ui.menus[0] == 0);

    ui.mouse_move(30.0, 10.0);  // on the first item: its own menu
    ui.right_button(true);
    context_frame(&ui, &surface, &text);
    assert(ui.menus[0] != 0 && ui.popups[0].h == 36.0);  // one entry: the menu of the item
    ui.mouse_move(300.0, 250.0);  // a right press elsewhere closes it
    ui.right_button(true);
    context_frame(&ui, &surface, &text);
    assert(ui.menus[0] == 0);

    ui.key(key_delete(), true, false, false);  // the shortcut Delete
    assert(context_frame(&ui, &surface, &text) == 4);
    click_at(&ui, 20.0, 140.0);  // the text field takes the keyboard
    context_frame(&ui, &surface, &text);
    ui.key(key_delete(), true, false, false);  // now Delete edits the text
    ui.key(0x4000003B, true, false, false);  // F2 still works
    assert(context_frame(&ui, &surface, &text) == 2);
}

// ---- Identities, the keyboard, scrolling (spec §10.6) ----

// A button that may appear before a text field, both with their place, as the translator
// gives them; then the fields of a loop, named by `keys`.
void identity_frame(Ui* ui, canvas.Canvas* surface, bool extra, TextBuffer* text, u64[] keys, TextBuffer[] items) {
    mut Frame f = begin(ui, surface, 0.0, 0.0);
    if (extra) {
        f.at(10);
        f.button("Extra");
    }
    f.at(20);
    f.text_field(text, 200.0);
    f.push_id(30);
    for (usize i in 0..keys.len) {
        f.push_id(keys[i]);
        f.at(40);
        f.text_field(&items[i], 100.0);
        f.pop_id();
    }
    f.pop_id();
    f.finish();
}

test "identities survive an if and an insertion in a loop" {
    mut Arena arena = Arena.new(512 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 400, 300);
    mut Ui ui = Ui{ };
    mut TextBuffer text = TextBuffer{ };
    mut TextBuffer[3] items = [TextBuffer{ }; 3];
    mut u64[3] keys = [7, 8, 9];
    click_at(&ui, 20.0, 10.0);  // the field, at y 0 to 32
    identity_frame(&ui, &surface, false, &text, keys[0..2], items[0..2]);
    ui.type_text("a");
    identity_frame(&ui, &surface, true, &text, keys[0..2], items[0..2]);  // a button appears before it
    ui.type_text("b");
    identity_frame(&ui, &surface, true, &text, keys[0..2], items[0..2]);
    assert(text.text().len == 2 && ui.duplicates == 0);

    // the item named 8, second, takes the keyboard (y 120 to 152); an item 6 comes before it
    click_at(&ui, 20.0, 130.0);
    identity_frame(&ui, &surface, true, &text, keys[0..2], items[0..2]);
    ui.type_text("x");
    identity_frame(&ui, &surface, true, &text, keys[0..2], items[0..2]);
    assert(items[1].text().len == 1);
    keys = [6, 7, 8];
    items[2] = items[1];
    items[1] = items[0];
    items[0] = TextBuffer{ };
    ui.type_text("y");
    identity_frame(&ui, &surface, true, &text, keys[0..3], items[0..3]);
    assert(items[2].text().len == 2 && items[0].text().len == 0 && items[1].text().len == 0);

    // the same place twice in a scope: the second widget is still distinct, and counted
    mut Frame f = begin(&ui, &surface, 0.0, 0.0);
    f.at(5);
    f.button("A");
    f.at(5);
    f.button("B");
    f.finish();
    assert(ui.duplicates == 1);
}

// A field, a disabled button, a checkbox and a button, for Tab. 1: OK clicked.
i32 tab_frame(Ui* ui, canvas.Canvas* surface, TextBuffer* text, bool* box) {
    mut Frame f = begin(ui, surface, 0.0, 0.0);
    f.text_field(text, 200.0);  // y 0 to 32
    f.button_enabled("Off", false);  // 40 to 72
    f.checkbox("Box", box);  // 80 to 112
    bool ok = f.button("OK");  // 120 to 152
    f.finish();
    return ok ? 1 : 0;
}

test "Tab and Shift+Tab, Space and Enter" {
    mut Arena arena = Arena.new(512 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 400, 300);
    mut Ui ui = Ui{ };
    mut TextBuffer text = TextBuffer{ };
    text.set("hello");
    mut bool box = false;
    tab_frame(&ui, &surface, &text, &box);
    ui.key(key_tab(), true, false, false);  // nothing has the keyboard: the first widget
    tab_frame(&ui, &surface, &text, &box);
    u64 field = ui.focus;
    ui.type_text("!");  // all its text was selected: replaced
    tab_frame(&ui, &surface, &text, &box);
    assert(field != 0 && text.text().len == 1);

    ui.key(key_tab(), true, false, false);  // the disabled button is skipped: the checkbox
    tab_frame(&ui, &surface, &text, &box);
    ui.key(key_space(), true, false, false);
    tab_frame(&ui, &surface, &text, &box);
    assert(box);
    ui.key(key_tab(), true, false, false);  // OK, then Enter clicks it
    tab_frame(&ui, &surface, &text, &box);
    ui.key(key_enter(), true, false, false);
    assert(tab_frame(&ui, &surface, &text, &box) == 1);
    ui.key(key_tab(), true, false, false);  // round: the field again
    tab_frame(&ui, &surface, &text, &box);
    assert(ui.focus == field);
    ui.key(key_tab(), true, true, false);  // Shift+Tab: back to OK
    tab_frame(&ui, &surface, &text, &box);
    ui.key(key_space(), true, false, false);
    assert(tab_frame(&ui, &surface, &text, &box) == 1);
    assert(surface.at(1, 118) != 0);  // its ring, around it
}

test "a dropdown with the keyboard" {
    mut Arena arena = Arena.new(512 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 400, 200);
    mut Ui ui = Ui{ };
    mut i32 choice = 0;
    dropdown_frame(&ui, &surface, &choice);
    ui.key(key_tab(), true, false, false);  // the dropdown has the keyboard
    dropdown_frame(&ui, &surface, &choice);
    ui.key(key_down(), true, false, false);  // closed: the next option, at the next frame
    dropdown_frame(&ui, &surface, &choice);
    dropdown_frame(&ui, &surface, &choice);
    assert(choice == 1 && ui.open == 0);
    ui.key(key_space(), true, false, false);  // opens, on the option chosen
    dropdown_frame(&ui, &surface, &choice);
    assert(ui.open != 0 && ui.highlight == 1);
    ui.key(key_down(), true, false, false);
    ui.key(key_down(), true, false, false);  // no further than the last
    dropdown_frame(&ui, &surface, &choice);
    assert(ui.highlight == 2);
    ui.key(key_enter(), true, false, false);
    dropdown_frame(&ui, &surface, &choice);
    assert(choice == 2 && ui.open == 0);
    ui.key(0x400000E2, true, false, false);  // Alt+Down opens it too
    ui.key(key_down(), true, false, false);
    ui.key(0x400000E2, false, false, false);
    dropdown_frame(&ui, &surface, &choice);
    assert(ui.open != 0);
    ui.key(key_escape(), true, false, false);
    dropdown_frame(&ui, &surface, &choice);
    assert(ui.open == 0 && choice == 2);
}

test "menus with the keyboard" {
    mut Arena arena = Arena.new(512 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 400, 300);
    mut Ui ui = Ui{ };
    menu_frame(&ui, &surface);
    ui.key(0x400000E2, true, false, false);  // Alt pressed and released alone: the bar
    ui.key(0x400000E2, false, false, false);
    menu_frame(&ui, &surface);
    assert(ui.bar_keys && ui.bar_index == 0 && ui.menus[0] == 0);
    ui.key(key_right(), true, false, false);  // Edit
    ui.key(key_down(), true, false, false);  // opens it, on Undo
    menu_frame(&ui, &surface);
    menu_frame(&ui, &surface);  // described open: drawn
    assert(ui.menus[0] != 0 && ui.popups[0].x == 88.0 && ui.menu_cursor[0] == 0);
    ui.key(key_left(), true, false, false);  // the menu before: File, on New
    menu_frame(&ui, &surface);
    menu_frame(&ui, &surface);
    assert(ui.popups[0].x == 0.0 && ui.menu_cursor[0] == 0);
    ui.key(key_down(), true, false, false);  // over the separator: Recent
    ui.key(key_right(), true, false, false);  // its submenu, on a.sosu
    menu_frame(&ui, &surface);
    menu_frame(&ui, &surface);
    assert(ui.menu_cursor[0] == 2 && ui.menus[1] != 0 && ui.menu_cursor[1] == 0);
    ui.key(key_enter(), true, false, false);  // chooses, at the next frame
    menu_frame(&ui, &surface);
    assert(menu_frame(&ui, &surface) == 2 && ui.menus[0] == 0);

    ui.key(key_f10(), true, false, false);  // F10 and Down: File, on New
    ui.key(key_down(), true, false, false);
    menu_frame(&ui, &surface);
    menu_frame(&ui, &surface);
    ui.key(key_up(), true, false, false);  // from New, up: round to Recent (Quit is disabled)
    menu_frame(&ui, &surface);
    assert(ui.menu_cursor[0] == 2);
    ui.key(key_escape(), true, false, false);  // closes the menu: the keyboard back on the bar
    menu_frame(&ui, &surface);
    assert(ui.menus[0] == 0 && ui.bar_keys);
    ui.key(key_escape(), true, false, false);
    menu_frame(&ui, &surface);
    assert(!ui.bar_keys);
}

test "Shift+F10 opens the context menu of the widget that has the keyboard" {
    mut Arena arena = Arena.new(512 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 400, 300);
    mut Ui ui = Ui{ };
    mut TextBuffer text = TextBuffer{ };
    context_frame(&ui, &surface, &text);
    ui.key(key_tab(), true, false, false);  // the list
    context_frame(&ui, &surface, &text);
    ui.key(key_f10(), true, true, false);
    context_frame(&ui, &surface, &text);
    assert(ui.menus[0] != 0 && ui.popups[0].h == 64.0 && ui.context_y == 120.0 && ui.menu_cursor[0] == 0);
    ui.key(key_down(), true, false, false);
    ui.key(key_enter(), true, false, false);  // Delete
    context_frame(&ui, &surface, &text);
    assert(context_frame(&ui, &surface, &text) == 4);
}

// A `Scroll` 200 by 100 holding a label, a `Scroll` 150 by 60 of 6 labels, and 3 buttons.
void scroll_frame(Ui* ui, canvas.Canvas* surface) {
    mut Frame f = begin(ui, surface, 0.0, 0.0);
    f.scroll(200.0, 100.0);
    f.label("top");
    f.scroll(150.0, 60.0);
    for (i32 i in 0..6) {
        f.label("inner");
    }
    f.end_scroll();
    f.button("one");
    f.button("two");
    f.button("three");
    f.end_scroll();
    f.finish();
}

// The state of the `Scroll` whose content is `high` pixels high.
WidgetState state_of(Ui* ui, f32 high) {
    for (usize i in 0..64) {
        if (ui.states[i].id != 0 && ui.states[i].content_h == high) {
            return ui.states[i];
        }
    }
    return WidgetState{ };
}

test "nested Scroll areas, their bars and the keyboard" {
    mut Arena arena = Arena.new(512 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 400, 300);
    mut Ui ui = Ui{ };
    scroll_frame(&ui, &surface);
    scroll_frame(&ui, &surface);
    // the inner content: 6 labels 32 high, 8 apart, and 8 around: 248; the outer: 32 + 60 +
    // 3 buttons 32 high, 8 apart, and 8 around: 236
    assert(state_of(&ui, 248.0).id != 0 && state_of(&ui, 236.0).id != 0);
    ui.mouse_move(50.0, 60.0);  // over the inner area (y 48 to 108, clipped at 100)
    ui.scroll_wheel(-3.0);  // 120 pixels: the inner area scrolls
    scroll_frame(&ui, &surface);
    assert(state_of(&ui, 248.0).scroll_y == 120.0 && state_of(&ui, 236.0).scroll_y == 0.0);
    ui.scroll_wheel(-10.0);
    scroll_frame(&ui, &surface);
    assert(state_of(&ui, 248.0).scroll_y == 188.0);  // its end: 248 - 60
    ui.scroll_wheel(-1.0);  // at its end: the outer area takes the wheel
    scroll_frame(&ui, &surface);
    assert(state_of(&ui, 236.0).scroll_y == 40.0);

    // the thumb of the outer bar (x 190 to 200), dragged to the bottom
    WidgetState outer = state_of(&ui, 236.0);
    f32 thumb_top = (100.0 - 100.0 * 100.0 / 236.0) * outer.scroll_y / 136.0;
    ui.mouse_move(195.0, thumb_top + 2.0);
    ui.mouse_button(true);
    scroll_frame(&ui, &surface);
    ui.mouse_move(195.0, 150.0);
    scroll_frame(&ui, &surface);
    ui.mouse_button(false);
    scroll_frame(&ui, &surface);
    assert(state_of(&ui, 236.0).scroll_y == 136.0);
    // a click on the bar above the thumb: a page up
    click_at(&ui, 195.0, 5.0);
    scroll_frame(&ui, &surface);
    assert(state_of(&ui, 236.0).scroll_y == 36.0);

    // Tab to the third button, under the view: the outer area brings it into view
    for (i32 i in 0..4) {  // from the outer area (the click gave it the keyboard): the inner one, the buttons
        ui.key(key_tab(), true, false, false);
    }
    scroll_frame(&ui, &surface);
    scroll_frame(&ui, &surface);
    assert(state_of(&ui, 236.0).scroll_y == 136.0);
}

test "focus_here gives the keyboard the first time only" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 300, 100);
    mut Ui ui = Ui{ };
    mut TextBuffer text = TextBuffer{ };
    mut Frame f = begin(&ui, &surface, 0.0, 0.0);
    f.focus_here();
    f.text_field(&text, 200.0);
    f.finish();
    assert(ui.focus != 0);
    click_at(&ui, 250.0, 90.0);  // a click on nothing takes it away, for good
    f = begin(&ui, &surface, 0.0, 0.0);
    f.focus_here();
    f.text_field(&text, 200.0);
    f.finish();
    assert(ui.focus == 0);
}

test "placeholders: shown while the text is empty, never typed" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 300, 100);
    mut Ui ui = Ui{ };
    mut TextBuffer text = TextBuffer{ };
    Format search = Format{ placeholder: "Search" };
    // the built-in font: "Search" from x 8, 16 pixels a character, in the color of hints
    surface.clear(canvas.Color{ r: 0, g: 0, b: 0 });
    mut Frame f = begin(&ui, &surface, 0.0, 0.0);
    f.text_field_with(&text, 200.0, search);
    f.finish();
    mut bool dimmed = false;
    for (i32 x in 8..24) {
        for (i32 y in 8..24) {
            dimmed = dimmed || surface.at(x, y) == canvas.pack(hint());
        }
    }
    assert(dimmed && text.len == 0);
    click_at(&ui, 20.0, 10.0);
    ui.type_text("a");
    surface.clear(canvas.Color{ r: 0, g: 0, b: 0 });
    f = begin(&ui, &surface, 0.0, 0.0);
    f.text_field_with(&text, 200.0, search);
    f.finish();
    mut bool still = false;
    for (i32 x in 8..120) {
        for (i32 y in 8..24) {
            still = still || surface.at(x, y) == canvas.pack(hint());
        }
    }
    assert(!still && text.text().len == 1);

    // a dropdown with no option chosen shows its placeholder
    surface.clear(canvas.Color{ r: 0, g: 0, b: 0 });
    f = begin(&ui, &surface, 0.0, 50.0);
    f.dropdown_with(160.0, "Pick");
    f.option("One", false);
    f.end_dropdown();
    f.finish();
    mut bool picked = false;
    for (i32 x in 8..72) {
        for (i32 y in 58..74) {
            picked = picked || surface.at(x, y) == canvas.pack(hint());
        }
    }
    assert(picked);
}

bool is_text(str a, str b) {
    return a.len == b.len && same_bytes(a, 0, b);
}

test "texts translated, with values and plurals" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 100, 100);
    mut Ui ui = Ui{ };
    mut Frame f = begin(&ui, &surface, 0.0, 0.0);
    assert(is_text(f.tr("Save"), "Save"));  // no catalog: the source
    assert(is_text(f.tr_plural("{count} file", "{count} files", 1), "{count} file"));
    f.finish();
    match (catalog.load(&arena, "packages/i18n/tests/messages.locale.fr.sosu")) {
        ok(c) => {
            ui.catalog = some(c);
        },
        err(e) => { },
    }
    f = begin(&ui, &surface, 0.0, 0.0);
    assert(is_text(f.tr("Save"), "Enregistrer") && is_text(f.tr_in("verb", "Open"), "Ouvrir"));
    str files = f.tr_plural("{count} file", "{count} files", 0);  // French: 0 is singular
    assert(is_text(f.with1(files, "count", f.decimal(0)), "0 fichier"));
    assert(is_text(f.with2("{a} and {b}, {a}", "a", "x", "b", "yz"), "x and yz, x"));
    assert(is_text(f.with1("{unknown} {", "name", "v"), "{unknown} {"));
    assert(is_text(f.decimal(-42), "-42") && is_text(f.decimal(1234567), "1234567"));
    f.finish();
}

// Whether a pixel of `r` on `surface` is `color`.
bool has_pixel(canvas.Canvas* surface, canvas.Rect r, canvas.Color color) {
    u32 wanted = canvas.pack(color);
    for (i32 y in r.y as i32..(r.y + r.h) as i32) {
        for (i32 x in r.x as i32..(r.x + r.w) as i32) {
            if (surface.at(x, y) == wanted) {
                return true;
            }
        }
    }
    return false;
}

test "themes and styles: the cascade" {
    mut Arena arena = Arena.new(512 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 300, 300);
    mut Ui ui = Ui{ };
    canvas.Color dark = rgb(10, 20, 30, 255);
    canvas.Color hot = rgb(40, 50, 60, 255);
    canvas.Color red = rgb(200, 0, 0, 255);
    canvas.Color green = rgb(0, 200, 0, 255);
    canvas.Color pink = rgb(255, 0, 255, 255);
    canvas.Color blue = rgb(0, 0, 200, 255);
    canvas.Color page = rgb(1, 2, 3, 255);
    ui.theme = some(Theme{ window: Style{ normal: Props{ background: some(page) } }, button: Style{ normal: Props{ background: some(dark), radius: some(6.0) }, hover: Props{ background: some(hot) } } });
    Style danger = Style{ normal: Props{ background: some(red) } };
    Style safe = Style{ normal: Props{ background: some(green) } };
    Style card = Style{ normal: Props{ background: some(blue), color: some(pink), padding: some(8.0) } };
    ui.mouse_move(299.0, 299.0);  // over nothing
    for (i32 round in 0..2) {  // a painted column has its background from the second frame
        mut Frame f = begin(&ui, &surface, 0.0, 0.0);
        f.button("A");  // y 0 to 32
        f.style(danger);
        f.button("B");  // 40 to 72
        f.style(danger);
        f.style(safe);  // the later one wins
        f.button("C");  // 80 to 112
        f.style(card);
        f.column(-1.0, -1.0);  // from y 120, its padding 8
        f.label("x");
        f.end();
        f.finish();
    }
    assert(surface.at(250, 290) == canvas.pack(page));  // the window
    assert(surface.at(3, 16) == canvas.pack(dark) && surface.at(0, 0) == canvas.pack(page));  // rounded: its corner left out
    assert(surface.at(3, 56) == canvas.pack(red) && surface.at(3, 96) == canvas.pack(green));
    assert(surface.at(3, 123) == canvas.pack(blue));  // the column, in its padding
    assert(has_pixel(&surface, canvas.Rect{ x: 8.0, y: 128.0, w: 20.0, h: 32.0 }, pink));  // the label inherits its color
    ui.mouse_move(16.0, 16.0);
    mut Frame f = begin(&ui, &surface, 0.0, 0.0);
    f.button("A");
    f.finish();
    assert(surface.at(3, 16) == canvas.pack(hot));  // hover

    ui.theme = some(light_theme());
    ui.mouse_move(299.0, 299.0);
    f = begin(&ui, &surface, 0.0, 0.0);
    f.button("A");
    f.finish();
    assert(surface.at(250, 290) == canvas.pack(rgb(239, 241, 245, 255)) && surface.at(3, 16) == canvas.pack(rgb(204, 208, 218, 255)));
}

// A grid of three columns (100 pixels, `Auto`, `Fill`), for the test below: the rectangles of
// its widgets, and of a label placed after it.
canvas.Rect[6] grid_frame(Ui* ui, canvas.Canvas* surface) {
    mut canvas.Rect[6] r = [nowhere(); 6];
    mut Frame f = begin(ui, surface, 0.0, 0.0);
    f.grid(10.0, 0.0);
    f.grid_column(Pixels(100.0));
    f.grid_column(Auto);
    f.grid_column(Fill(1.0));
    f.label("ab");  // the next free cell: (0, 0)
    r[0] = f.last;
    f.button("OK");  // (0, 1)
    r[1] = f.last;
    f.cell(0, 2, 1, 1, Stretch);
    f.label("wide");
    r[2] = f.last;
    f.label("next");  // (1, 0)
    r[3] = f.last;
    f.cell(-1, -1, 3, 1, End);  // (1, 1), over the 2 columns left
    f.label("end");
    r[4] = f.last;
    f.end_grid();
    f.label("after");
    r[5] = f.last;
    f.finish();
    return r;
}

test "a grid: pixels, Auto and Fill columns, the next free cell, spans and alignment" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 400, 200);
    mut Ui ui = Ui{ };
    ui.mouse_move(399.0, 199.0);
    canvas.Rect[6] first = grid_frame(&ui, &surface);
    f32 ok_w = first[1].w;  // the Auto column is measured at the first frame
    assert(first[0].x == 0.0 && first[0].y == 0.0);
    canvas.Rect[6] r = grid_frame(&ui, &surface);
    assert(r[1].x == 110.0 && r[1].y == 0.0);
    f32 third = 110.0 + ok_w + 10.0;
    assert(r[2].x == third && r[2].w == 400.0 - third);  // Fill, and Stretch
    assert(r[3].x == 0.0 && r[3].y == 42.0);  // the row below, a line high
    assert(r[4].x + r[4].w == 400.0 && r[4].y == 42.0);  // End of the 2 columns
    assert(r[5].x == 0.0 && r[5].y == 82.0);  // under its 2 rows (74), then the gap of the frame
}

test "a group: its widgets under its title, folded and opened by a click" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 300, 200);
    mut Ui ui = Ui{ };
    ui.mouse_move(299.0, 199.0);
    mut Frame f = begin(&ui, &surface, 0.0, 0.0);
    assert(f.group_folding("Options", 8.0, 12.0, none));
    f.label("inside");
    canvas.Rect inside = f.last;
    f.end_group();
    canvas.Rect open_box = f.last;
    f.finish();
    assert(inside.x == 12.0 && inside.y > 12.0);  // inside its padding, under the title
    assert(open_box.h > inside.h + 24.0);
    // a click on its title folds it: its widgets are not described, and it is its title only
    ui.mouse_move(30.0, 5.0);
    ui.mouse_button(true);
    ui.mouse_button(false);
    f = begin(&ui, &surface, 0.0, 0.0);
    bool open_now = f.group_folding("Options", 8.0, 12.0, none);
    f.end_group();
    f.finish();
    assert(!open_now);
    ui.mouse_move(299.0, 199.0);
    f = begin(&ui, &surface, 0.0, 0.0);
    assert(!f.group_folding("Options", 8.0, 12.0, none));  // it stays folded
    f.end_group();
    assert(f.last.h < open_box.h);
    f.finish();
    // bound to the program, and with the keyboard: Space opens it
    mut bool flag = false;
    ui.key(key_tab(), true, false, false);
    f = begin(&ui, &surface, 0.0, 0.0);
    f.group_folding("Options", 8.0, 12.0, some(&flag));
    f.end_group();
    f.finish();
    ui.key(key_space(), true, false, false);
    f = begin(&ui, &surface, 0.0, 0.0);
    assert(f.group_folding("Options", 8.0, 12.0, some(&flag)));
    f.end_group();
    f.finish();
    assert(flag);
}

// Three tabs, the last one closable, for the test below: which contents were described, and
// whether the last tab was closed. The content of the first one has a text field.
i32 tabs_frame(Ui* ui, canvas.Canvas* surface, i32* chosen, TextBuffer* name, bool* closed) {
    mut i32 described = 0;
    mut Frame f = begin(ui, surface, 0.0, 0.0);
    f.tabs(some(chosen));
    if (f.tab("One", false, true)) {
        described += 1;
        f.text_field(name, 100.0);
    }
    if (f.tab("Two", false, true)) {
        described += 10;
    }
    if (f.tab("Three", true, true)) {
        described += 100;
    }
    *closed = f.tab_closed();
    f.end_tabs();
    f.finish();
    return described;
}

test "tabs: the content of the tab chosen only, a click, the keys, Ctrl+Tab, a closed tab" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 400, 200);
    mut Ui ui = Ui{ };
    mut i32 chosen = 0;
    mut TextBuffer name = TextBuffer{ };
    mut bool closed = false;
    ui.mouse_move(399.0, 199.0);
    assert(tabs_frame(&ui, &surface, &chosen, &name, &closed) == 1);
    // a click on the second tab: chosen at the next frame, one content per frame
    ui.mouse_move(100.0, 15.0);
    ui.mouse_button(true);
    ui.mouse_button(false);
    assert(tabs_frame(&ui, &surface, &chosen, &name, &closed) == 1);
    assert(tabs_frame(&ui, &surface, &chosen, &name, &closed) == 10 && chosen == 1);
    // the row has the keyboard after the click: Right, then End
    ui.mouse_move(399.0, 199.0);
    ui.key(key_right(), true, false, false);
    tabs_frame(&ui, &surface, &chosen, &name, &closed);
    assert(tabs_frame(&ui, &surface, &chosen, &name, &closed) == 100 && chosen == 2);
    ui.key(key_home(), true, false, false);
    tabs_frame(&ui, &surface, &chosen, &name, &closed);
    assert(chosen == 0 || tabs_frame(&ui, &surface, &chosen, &name, &closed) == 1);
    assert(chosen == 0);
    // Ctrl+Tab from the text field of the content
    ui.key(key_tab(), true, false, false);  // the keyboard to the field
    tabs_frame(&ui, &surface, &chosen, &name, &closed);
    ui.key(key_tab(), true, false, true);
    tabs_frame(&ui, &surface, &chosen, &name, &closed);
    assert(tabs_frame(&ui, &surface, &chosen, &name, &closed) == 10 && chosen == 1);
    // the cross of the third tab
    chosen = 2;
    tabs_frame(&ui, &surface, &chosen, &name, &closed);
    ui.mouse_move(0.0, 0.0);
    mut Frame f = begin(&ui, &surface, 0.0, 0.0);
    f.tabs(some(&chosen));
    f.tab("One", false, true);
    f.tab("Two", false, true);
    f.tab("Three", true, true);
    canvas.Rect third = f.tab_builds[0].row;
    f32 end_x = f.tab_builds[0].x;
    f.end_tabs();
    f.finish();
    ui.mouse_move(end_x - 2.0 - 4.0 - 9.0, third.y + third.h / 2.0);  // the middle of the cross of the last tab
    ui.mouse_button(true);
    ui.mouse_button(false);
    tabs_frame(&ui, &surface, &chosen, &name, &closed);
    assert(closed);
}

// A tree for the test below: a branch `src` (bound to `open`) with two leaves, then a leaf.
// Returns the leaf clicked (1, 2, 3; 0: none); `x` gets where the text of `main` starts.
i32 tree_frame(Ui* ui, canvas.Canvas* surface, i32* chosen, bool* open, f32* x) {
    mut i32 clicked = 0;
    mut Frame f = begin(ui, surface, 0.0, 0.0);
    f.tree(200.0, 150.0, some(chosen));
    if (f.branch("src", some(open))) {
        if (f.leaf("main")) {
            clicked = 1;
        }
        *x = f.last.x;
        if (f.leaf("lib")) {
            clicked = 2;
        }
        f.end_branch();
    }
    if (f.leaf("README")) {
        clicked = 3;
    }
    f.end_tree();
    f.finish();
    return clicked;
}

test "a tree: branches open and closed, indentation, the keys" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 300, 200);
    mut Ui ui = Ui{ };
    mut i32 chosen = 0;
    mut bool open = false;
    mut f32 x = -1.0;
    ui.mouse_move(299.0, 199.0);
    tree_frame(&ui, &surface, &chosen, &open, &x);
    assert(x == -1.0);  // closed: its leaves are not described
    // a click on the triangle opens it, and gives the tree the keyboard
    ui.mouse_move(10.0, 16.0);
    ui.mouse_button(true);
    ui.mouse_button(false);
    tree_frame(&ui, &surface, &chosen, &open, &x);
    assert(open);
    ui.mouse_move(299.0, 199.0);
    tree_frame(&ui, &surface, &chosen, &open, &x);
    assert(x == 24.0);  // indented by 16, inside the 8 of the list
    // Right on an open branch: its first child; Down: the next; Left: the parent; Left: closed
    ui.key(key_right(), true, false, false);
    tree_frame(&ui, &surface, &chosen, &open, &x);
    assert(chosen == 1);
    ui.key(key_down(), true, false, false);
    tree_frame(&ui, &surface, &chosen, &open, &x);
    assert(chosen == 2);
    ui.key(key_enter(), true, false, false);
    assert(tree_frame(&ui, &surface, &chosen, &open, &x) == 2);
    ui.key(key_left(), true, false, false);
    tree_frame(&ui, &surface, &chosen, &open, &x);
    assert(chosen == 0 && open);
    ui.key(key_left(), true, false, false);
    tree_frame(&ui, &surface, &chosen, &open, &x);
    assert(!open);
    // closed: the leaf after it is the item 1
    ui.key(key_down(), true, false, false);
    tree_frame(&ui, &surface, &chosen, &open, &x);
    ui.key(key_enter(), true, false, false);
    assert(chosen == 1 && tree_frame(&ui, &surface, &chosen, &open, &x) == 3);
}

test "tabs bound to a tab other than the first keep it from the first frame" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 400, 200);
    mut Ui ui = Ui{ };
    mut i32 chosen = 2;
    mut TextBuffer name = TextBuffer{ };
    mut bool closed = false;
    ui.mouse_move(399.0, 199.0);
    assert(tabs_frame(&ui, &surface, &chosen, &name, &closed) == 100 && chosen == 2);
    chosen = 7;  // beyond the last tab: the last one
    tabs_frame(&ui, &surface, &chosen, &name, &closed);
    assert(chosen == 2);
}

test "align: across the room of a column" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 400, 200);
    mut Ui ui = Ui{ };
    ui.mouse_move(399.0, 199.0);
    mut Frame f = begin(&ui, &surface, 0.0, 0.0);
    f.align(Center);
    f.label("mid");
    canvas.Rect mid = f.last;
    f.align(End);
    f.label("end");
    canvas.Rect end_r = f.last;
    f.align(Stretch);
    f.button("wide");
    canvas.Rect wide = f.last;
    f.label("start");
    canvas.Rect start = f.last;
    f.finish();
    assert(mid.x > 0.0 && mid.x + mid.w / 2.0 == 200.0);
    assert(end_r.x + end_r.w == 400.0);
    assert(wide.x == 0.0 && wide.w == 400.0);
    assert(start.x == 0.0);  // the next one is at the start again
}

// Six tabs, for the test below: the rectangle of the content of the tab chosen, and the row.
canvas.Rect wide_tabs(Ui* ui, canvas.Canvas* surface, i32* chosen, Side side, canvas.Rect* row) {
    mut canvas.Rect content = nowhere();
    mut Frame f = begin(ui, surface, 0.0, 0.0);
    f.tabs_at(some(chosen), side);
    for (i32 i in 0..6) {
        if (f.tab("A long title", false, true)) {
            f.label("content");
            content = f.last;
        }
    }
    *row = f.tab_builds[0].row;
    f.end_tabs();
    f.finish();
    return content;
}

test "tabs below their content, and a row too long scrolled by its arrows and to the tab chosen" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 300, 200);
    mut Ui ui = Ui{ };
    mut i32 chosen = 0;
    mut canvas.Rect row = nowhere();
    ui.mouse_move(299.0, 199.0);
    // below: the content at the top, the row at the bottom of the room
    canvas.Rect content = wide_tabs(&ui, &surface, &chosen, Bottom, &row);
    assert(content.y == 0.0 && row.y + row.h == 200.0);
    // too long for 300 pixels: arrows (48 pixels) at the end of the row
    wide_tabs(&ui, &surface, &chosen, Top, &row);
    assert(row.w == 252.0);
    // its right arrow scrolls it
    ui.mouse_move(252.0 + 24.0 + 12.0, 10.0);
    ui.mouse_button(true);
    ui.mouse_button(false);
    wide_tabs(&ui, &surface, &chosen, Top, &row);
    mut Frame f = begin(&ui, &surface, 0.0, 0.0);
    f.tabs(some(&chosen));
    f32 offset = f.tab_builds[0].offset;
    f.end_tabs();
    f.finish();
    assert(offset == 120.0);
    // End chooses the last tab, which comes into view
    ui.mouse_move(10.0, 10.0);
    ui.mouse_button(true);
    ui.mouse_button(false);
    wide_tabs(&ui, &surface, &chosen, Top, &row);  // the row has the keyboard
    ui.mouse_move(299.0, 199.0);
    ui.key(key_end(), true, false, false);
    wide_tabs(&ui, &surface, &chosen, Top, &row);
    wide_tabs(&ui, &surface, &chosen, Top, &row);
    assert(chosen == 5);
    f = begin(&ui, &surface, 0.0, 0.0);
    f.tabs(some(&chosen));
    for (i32 i in 0..6) {
        f.tab("A long title", false, true);
    }
    f32 end_x = f.tab_builds[0].x - 2.0 - f.tab_builds[0].offset;  // the right of the last tab
    f.end_tabs();
    f.finish();
    assert(end_x <= 252.0 && end_x > 200.0);
}

// A frame with one field over `text`, for the tests below.
void long_frame(Ui* ui, canvas.Canvas* surface, LongText* text) {
    mut Frame f = begin(ui, surface, 0.0, 0.0);
    f.text_field_long(text, 300.0, Format{ });
    f.finish();
}

test "the editing core: words, undo and redo, double and triple clicks, a long text" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 320, 60);
    mut Ui ui = Ui{ };
    mut LongText text = long_text();
    defer text.free();
    ui.clock(1000);
    ui.mouse_move(10.0, 16.0);
    ui.mouse_button(true);
    ui.mouse_button(false);
    long_frame(&ui, &surface, &text);  // the field has the keyboard
    ui.type_text("hello brave world");
    long_frame(&ui, &surface, &text);
    assert(text.text() == "hello brave world");
    // Ctrl+Backspace removes the last word; Ctrl+Left goes to the start of the previous one
    ui.key(key_backspace(), true, false, true);
    long_frame(&ui, &surface, &text);
    assert(text.text() == "hello brave ");
    ui.key(key_left(), true, false, true);
    ui.type_text("very ");
    long_frame(&ui, &surface, &text);
    assert(text.text() == "hello very brave ");
    // undo: the word typed, then the word removed; redo the first again
    ui.key(122, true, false, true);
    long_frame(&ui, &surface, &text);
    assert(text.text() == "hello brave ");
    ui.key(122, true, false, true);
    long_frame(&ui, &surface, &text);
    assert(text.text() == "hello brave world");
    ui.key(121, true, false, true);
    long_frame(&ui, &surface, &text);
    assert(text.text() == "hello brave ");
    // a double click selects a word, a triple click all of it
    ui.clock(2000);
    ui.mouse_move(20.0, 16.0);
    ui.mouse_button(true);
    ui.mouse_button(false);
    ui.clock(2100);
    ui.mouse_button(true);
    ui.mouse_button(false);
    long_frame(&ui, &surface, &text);
    assert(min(ui.anchor, ui.cursor) == 0 && max(ui.anchor, ui.cursor) == 5);
    ui.clock(2200);
    ui.mouse_button(true);
    ui.mouse_button(false);
    long_frame(&ui, &surface, &text);
    assert(min(ui.anchor, ui.cursor) == 0 && max(ui.anchor, ui.cursor) == text.len);
    // a long text: 100 000 bytes
    text.set("");
    for (i32 i in 0..10000) {
        text.insert(text.len, "0123456789");
    }
    assert(text.len == 100000 && text.slice(99990, 100000) == "0123456789");
}

// A text area 3 lines high and 200 pixels wide, for the test below; returns Ctrl+Enter.
bool area_frame(Ui* ui, canvas.Canvas* surface, LongText* text, bool wrap) {
    mut Frame f = begin(ui, surface, 0.0, 0.0);
    bool entered = f.text_area(text, 200.0, 3, Area{ wrap: wrap });
    f.finish();
    return entered;
}

test "a text area: lines, Up and Down, Home and End, wrapping, scrolling to the cursor" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 300, 200);
    mut Ui ui = Ui{ };
    mut LongText text = long_text();
    defer text.free();
    ui.mouse_move(10.0, 10.0);
    ui.mouse_button(true);
    ui.mouse_button(false);
    area_frame(&ui, &surface, &text, false);  // the area has the keyboard
    ui.type_text("first");
    ui.key(key_enter(), true, false, false);  // Enter breaks the line
    ui.type_text("second line");
    assert(!area_frame(&ui, &surface, &text, false));
    assert(text.text() == "first\nsecond line");
    // Up keeps the column (the end of "first", shorter), Down comes back to the end of "secon"
    ui.key(key_home(), true, false, false);
    area_frame(&ui, &surface, &text, false);
    assert(ui.cursor == 6);
    ui.key(key_end(), true, false, false);
    ui.key(key_up(), true, false, false);
    area_frame(&ui, &surface, &text, false);
    assert(ui.cursor == 5);
    ui.key(key_down(), true, false, false);
    area_frame(&ui, &surface, &text, false);
    assert(ui.cursor > 6 && ui.cursor <= 12);
    ui.key(key_end(), true, false, true);  // Ctrl+End
    ui.key(key_enter(), true, false, true);  // Ctrl+Enter: on_enter, no line break
    assert(area_frame(&ui, &surface, &text, false));
    assert(text.text() == "first\nsecond line" && ui.cursor == text.len);
    // wrapping: a long line is cut at the last space that fits
    text.set("one two three four five six seven eight nine ten");
    ui.cursor = 0;
    ui.anchor = 0;
    area_frame(&ui, &surface, &text, true);
    mut Frame f = begin(&ui, &surface, 0.0, 0.0);
    AreaLayout layout = AreaLayout{ width: 200.0 - 16.0 - 10.0, size: 18.0, line_h: 20.0 };
    Span first = f.span_of(long_target(&text), layout, 0);
    // (not finished: a frame without the area would forget its keyboard and its scroll)
    assert(first.end > 0 && first.end < text.len && text.bytes[first.end] == 32 && !first.last);
    // the cursor at the end of many lines: the area scrolls to show it
    for (i32 i in 0..10) {
        text.insert(text.len, "\nline");
    }
    ui.key(key_end(), true, false, true);
    area_frame(&ui, &surface, &text, true);
    area_frame(&ui, &surface, &text, true);
    mut bool scrolled = false;
    for (usize i in 0..64) {
        scrolled = scrolled || ui.states[i].scroll_y > 0.0;
    }
    assert(scrolled);
}

// A money field in euros, for the test below.
bool money_frame(Ui* ui, canvas.Canvas* surface, i64* cents) {
    mut Frame f = begin(ui, surface, 0.0, 0.0);
    bool changed = f.money_field(cents, 200.0, Number{ min: some(0), max: some(100000000), step: 100, decimals: 2, decimal: ",", group: " ", symbol: "€" });
    f.finish();
    return changed;
}

test "numbers and money: shown with their groups and symbol, typed, out of range, stepped" {
    Number euros = Number{ decimals: 2, decimal: ",", group: " ", symbol: "€" };
    assert(format_number(123456789, euros, true).text() == "1 234 567,89 €");
    assert(format_number(-5, euros, false).text() == "-0,05");
    assert(format_number(42, Number{ }, true).text() == "42");
    assert(format_number(1000, Number{ symbol: "$", symbol_first: true, group: "," }, true).text() == "$1,000");
    i64 parsed = match (parse_number("12,5", euros)) {
        some(v) => v,
        none => -1,
    };
    assert(parsed == 1250);
    assert(match (parse_number("1.234", euros)) {
        some(v) => false,
        none => true,
    });  // 3 decimals: not a number of hundredths
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 300, 60);
    mut Ui ui = Ui{ };
    mut i64 cents = 1999;
    ui.mouse_move(20.0, 16.0);
    ui.mouse_button(true);
    ui.mouse_button(false);
    money_frame(&ui, &surface, &cents);  // the field has the keyboard: its text is "19,99"
    assert(ui.number_text.text() == "19,99");
    ui.key(97, true, false, true);  // Ctrl+A, then typed
    ui.type_text("1234,5");
    assert(money_frame(&ui, &surface, &cents) && cents == 123450);
    ui.key(97, true, false, true);
    ui.type_text("-3");  // out of range: the value stays
    assert(!money_frame(&ui, &surface, &cents) && cents == 123450);
    ui.key(97, true, false, true);
    ui.type_text("10");
    money_frame(&ui, &surface, &cents);
    ui.key(key_up(), true, false, false);  // + 1,00
    assert(money_frame(&ui, &surface, &cents) && cents == 1100 && ui.number_text.text() == "11,00");
    // its lower button: - 1,00
    ui.mouse_move(190.0, 24.0);  // the field is 32 high: its lower button from 16 to 30
    ui.mouse_button(true);
    ui.mouse_button(false);
    money_frame(&ui, &surface, &cents);
    assert(cents == 1000);
}

// A slider from 0 to 100, and a button with a tooltip, for the test below.
str slider_frame(Ui* ui, canvas.Canvas* surface, i64* volume) {
    mut Frame f = begin(ui, surface, 0.0, 0.0);
    f.slider(volume, 216.0, 0, 100, 1);
    f.button("Save");
    f.tooltip("Save the file");
    f.progress(*volume, 100, 200.0);
    str tip = f.tip;
    f.finish();
    return tip;
}

test "a slider, a progress bar, a tooltip after 500 ms" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 300, 140);
    mut Ui ui = Ui{ };
    mut i64 volume = 0;
    ui.clock(0);
    // pressed in the middle of its track (8 to 208): 50, then dragged to the end
    ui.mouse_move(108.0, 16.0);
    ui.mouse_button(true);
    slider_frame(&ui, &surface, &volume);
    assert(volume == 50);
    ui.mouse_move(260.0, 16.0);
    slider_frame(&ui, &surface, &volume);
    assert(volume == 100);
    ui.mouse_button(false);
    slider_frame(&ui, &surface, &volume);
    // it has the keyboard: Home, then Right
    ui.key(key_home(), true, false, false);
    ui.key(key_right(), true, false, false);
    slider_frame(&ui, &surface, &volume);
    assert(volume == 1);
    // over the button: no tooltip before 500 ms, one after
    ui.mouse_move(20.0, 50.0);
    ui.clock(1000);
    assert(slider_frame(&ui, &surface, &volume).len == 0);
    ui.clock(1400);
    assert(slider_frame(&ui, &surface, &volume).len == 0);
    ui.clock(1600);
    assert(slider_frame(&ui, &surface, &volume) == "Save the file");
    ui.mouse_move(250.0, 130.0);  // elsewhere: gone
    assert(slider_frame(&ui, &surface, &volume).len == 0);
}

// A button behind, and a dialog with two buttons, for the test below. Returns what was clicked:
// 1 the button behind, 2 OK, 3 Cancel.
i32 dialog_frame(Ui* ui, canvas.Canvas* surface, bool* open) {
    mut i32 clicked = 0;
    mut Frame f = begin(ui, surface, 0.0, 0.0);
    if (f.button("Behind")) {
        clicked = 1;
    }
    if (f.dialog("Delete?", 200.0, open)) {
        f.row();
        if (f.button("OK")) {
            clicked = 2;
        }
        if (f.button("Cancel")) {
            clicked = 3;
        }
        f.end_row();
        f.end_dialog();
    }
    f.finish();
    return clicked;
}

test "a dialog: the widgets behind see neither the mouse nor Tab; Escape and its cross close it" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 400, 300);
    mut Ui ui = Ui{ };
    mut bool open = true;
    ui.mouse_move(399.0, 299.0);
    dialog_frame(&ui, &surface, &open);
    // the button behind (0, 0) does not take a click while the dialog is open
    ui.mouse_move(10.0, 10.0);
    ui.mouse_button(true);
    ui.mouse_button(false);
    assert(dialog_frame(&ui, &surface, &open) == 0);
    // the keyboard is on its first button; Tab goes to the second, then back to the first
    ui.key(key_space(), true, false, false);
    assert(dialog_frame(&ui, &surface, &open) == 2);
    ui.key(key_tab(), true, false, false);
    dialog_frame(&ui, &surface, &open);
    ui.key(key_tab(), true, false, false);
    dialog_frame(&ui, &surface, &open);
    ui.key(key_space(), true, false, false);
    assert(dialog_frame(&ui, &surface, &open) == 2);
    // Escape closes it; the button behind takes clicks again
    ui.key(27, true, false, false);
    dialog_frame(&ui, &surface, &open);
    assert(!open);
    ui.mouse_button(true);
    ui.mouse_button(false);
    assert(dialog_frame(&ui, &surface, &open) == 1);
    // open again: its cross closes it. The dialog is 200 wide, centered (x 100), 40 + 32 + 16 high
    // (y 106): its cross from x 264 to 292, y 112 to 140
    open = true;
    ui.mouse_move(399.0, 299.0);
    dialog_frame(&ui, &surface, &open);
    dialog_frame(&ui, &surface, &open);
    ui.mouse_move(278.0, 126.0);
    ui.mouse_button(true);
    ui.mouse_button(false);
    dialog_frame(&ui, &surface, &open);
    assert(!open);
}

// A date field, for the test below.
bool date_frame(Ui* ui, canvas.Canvas* surface, Date* date) {
    mut Frame f = begin(ui, surface, 0.0, 0.0);
    bool changed = f.date_field(date, 200.0, "dd/mm/yyyy", true);
    f.finish();
    return changed;
}

test "dates: their days, typed, and chosen in the calendar with the mouse and the keyboard" {
    assert(weekday(2026, 10, 25) == 0);  // a Sunday
    assert(days_in(2024, 2) == 29 && days_in(2026, 2) == 28 && days_in(2000, 2) == 29 && days_in(1900, 2) == 28);
    assert(format_date(Date{ year: 2026, month: 3, day: 7 }, "dd/mm/yyyy").text() == "07/03/2026");
    assert(format_date(Date{ year: 2026, month: 3, day: 7 }, "yyyy-mm-dd").text() == "2026-03-07");
    assert(match (parse_date("31/02/2026", "dd/mm/yyyy")) {
        some(d) => false,
        none => true,
    });
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 300, 300);
    mut Ui ui = Ui{ };
    mut Date date = Date{ year: 2026, month: 10, day: 25 };
    // typed: the whole text selected when it takes the keyboard, then a new date
    ui.mouse_move(20.0, 16.0);
    ui.mouse_button(true);
    ui.mouse_button(false);
    date_frame(&ui, &surface, &date);
    ui.type_text("01112026");
    assert(date_frame(&ui, &surface, &date) && date.day == 1 && date.month == 11);
    // its button opens the calendar of November 2026, which starts on a Sunday: column 6
    ui.mouse_move(200.0 - 15.0, 16.0);
    ui.mouse_button(true);
    ui.mouse_button(false);
    date_frame(&ui, &surface, &date);
    assert(ui.open != 0 && ui.cal_month == 11);
    // Right, then Enter: the 2nd
    ui.mouse_move(299.0, 299.0);
    ui.key(key_right(), true, false, false);
    ui.key(key_enter(), true, false, false);
    assert(date_frame(&ui, &surface, &date) && date.day == 2 && ui.open == 0);
    // opened again; its right arrow: December; a click on the 24th (a Thursday: column 3, row 3)
    ui.mouse_move(200.0 - 15.0, 16.0);
    ui.mouse_button(true);
    ui.mouse_button(false);
    date_frame(&ui, &surface, &date);
    f32 top = 32.0 + 2.0;  // the calendar, under the field
    ui.mouse_move(240.0 - 20.0, top + 16.0);
    ui.mouse_button(true);
    ui.mouse_button(false);
    date_frame(&ui, &surface, &date);
    assert(ui.cal_month == 12);
    ui.mouse_move(8.0 + 3.0 * 32.0 + 15.0, top + 56.0 + 3.0 * 28.0 + 13.0);
    ui.mouse_button(true);
    ui.mouse_button(false);
    assert(date_frame(&ui, &surface, &date) && date.month == 12 && date.day == 24);
}

// A long list of 100 000 items, 200 pixels high, for the test below: how many were described.
i32 long_list_frame(Ui* ui, canvas.Canvas* surface, i32* chosen) {
    mut i32 described = 0;
    mut Frame f = begin(ui, surface, 0.0, 0.0);
    f.list_of(100000, 200.0, 200.0, some(chosen));
    for (i32 i in f.first_shown()..f.last_shown()) {
        f.push_item();
        f.label("item");
        f.pop_id();
        described += 1;
    }
    f.end_list();
    f.finish();
    return described;
}

test "a long list: 100 000 items, only those in view described" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 300, 220);
    mut Ui ui = Ui{ };
    mut i32 chosen = 0;
    ui.mouse_move(10.0, 10.0);
    ui.mouse_button(true);
    ui.mouse_button(false);
    assert(long_list_frame(&ui, &surface, &chosen) <= 9);  // 200 / 32, and two more
    ui.key(key_end(), true, false, false);  // the last item, which comes into view
    long_list_frame(&ui, &surface, &chosen);
    long_list_frame(&ui, &surface, &chosen);
    assert(chosen == 99999);
    mut Frame f = begin(&ui, &surface, 0.0, 0.0);
    f.list_of(100000, 200.0, 200.0, some(&chosen));
    assert(f.last_shown() == 100000 && f.first_shown() > 99990);
    f.end_list();
    f.finish();
    // a click in it chooses the item under the mouse
    ui.key(key_home(), true, false, false);
    long_list_frame(&ui, &surface, &chosen);
    ui.mouse_move(10.0, 32.0 * 3.0 + 10.0);
    ui.mouse_button(true);
    ui.mouse_button(false);
    long_list_frame(&ui, &surface, &chosen);
    assert(chosen == 3);
}

// A table of 50 files, 3 columns (Name: Fill, Size: 100 aligned at the end, Kind: Auto), for the
// test below; `cells` gets the rectangles of the cells of its first row. Returns its activation.
bool table_frame(Ui* ui, canvas.Canvas* surface, i32* row, Sort* sort, canvas.Rect[3]* cells) {
    mut Frame f = begin(ui, surface, 0.0, 0.0);
    f.table(50, 400.0, 200.0, some(row), some(sort));
    f.table_column("Name", Fill(1.0), true, Start);
    f.table_column("Size", Pixels(100.0), true, End);
    f.table_column("Kind", Auto, false, Start);
    f.table_rows();
    for (i32 i in f.first_shown()..f.last_shown()) {
        f.push_item();
        f.table_cell();
        f.label("file");
        canvas.Rect name = f.last;
        f.table_cell();
        f.label("12");
        canvas.Rect size = f.last;
        f.table_cell();
        f.label("source");
        if (i == 0) {
            (*cells)[0] = name;
            (*cells)[1] = size;
            (*cells)[2] = f.last;
        }
        f.pop_id();
    }
    bool activated = f.end_table();
    f.finish();
    return activated;
}

test "a table: columns, alignment, sorting, a border dragged, a row chosen and activated" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 420, 220);
    mut Ui ui = Ui{ };
    mut i32 row = 0;
    mut Sort sort = Sort{ };
    mut canvas.Rect[3] cells = [nowhere(); 3];
    ui.mouse_move(419.0, 219.0);
    table_frame(&ui, &surface, &row, &sort, &cells);
    table_frame(&ui, &surface, &row, &sort, &cells);  // Auto measured
    // Kind: Auto, as wide as "source" or its title; Size: 100; Name: the rest of 390
    assert(cells[0].x == 6.0);
    assert(cells[1].x + cells[1].w <= cells[2].x - 6.0 && cells[1].x > cells[0].x + 100.0);  // aligned at its end
    // the places of the columns, as the table laid them out
    mut Frame g = begin(&ui, &surface, 0.0, 0.0);
    g.table(50, 400.0, 200.0, some(&row), some(&sort));
    g.table_column("Name", Fill(1.0), true, Start);
    g.table_column("Size", Pixels(100.0), true, End);
    g.table_column("Kind", Auto, false, Start);
    g.table_rows();
    f32 border = g.table_build.col_x[1];
    assert(g.table_build.col_w[1] == 100.0 && g.table_build.col_x[2] + g.table_build.col_w[2] == 390.0);
    g.end_table();
    g.finish();
    // a click on the title Size: sorted by it; again: descending
    ui.mouse_move(border + 50.0, 10.0);
    ui.mouse_button(true);
    ui.mouse_button(false);
    table_frame(&ui, &surface, &row, &sort, &cells);
    assert(sort.column == 1 && !sort.descending);
    ui.mouse_button(true);
    ui.mouse_button(false);
    table_frame(&ui, &surface, &row, &sort, &cells);
    assert(sort.column == 1 && sort.descending);
    // the border after Name dragged 50 pixels to the left: Name is narrower
    f32 name_end = cells[1].x;
    ui.mouse_move(border, 10.0);
    ui.mouse_button(true);
    table_frame(&ui, &surface, &row, &sort, &cells);
    ui.mouse_move(border - 50.0, 10.0);
    table_frame(&ui, &surface, &row, &sort, &cells);
    ui.mouse_button(false);
    table_frame(&ui, &surface, &row, &sort, &cells);
    assert(cells[1].x < name_end - 40.0);
    // a click on the third row chooses it; a double click activates it
    ui.clock(1000);
    ui.mouse_move(50.0, 32.0 + 2.0 * 32.0 + 10.0);
    ui.mouse_button(true);
    ui.mouse_button(false);
    assert(!table_frame(&ui, &surface, &row, &sort, &cells) && row == 2);
    ui.clock(1100);
    ui.mouse_button(true);
    ui.mouse_button(false);
    assert(table_frame(&ui, &surface, &row, &sort, &cells));
}

// Buttons, a checkbox and a menu with letters, for the test below: 1 Save, 2 Send (the second S),
// 3 Quit; `bold` the checkbox.
i32 letters_frame(Ui* ui, canvas.Canvas* surface, bool* bold) {
    mut i32 clicked = 0;
    mut Frame f = begin(ui, surface, 0.0, 0.0);
    f.menu_bar();
    f.menu("&File");
    if (f.menu_item("&Quit")) {
        clicked = 3;
    }
    f.end_menu();
    f.end_menu_bar();
    if (f.button("&Save")) {
        clicked = 1;
    }
    if (f.button("&Send")) {
        clicked = 2;
    }
    f.checkbox("&Bold && strong", bold);
    f.finish();
    return clicked;
}

test "mnemonics: Alt and a letter, the first widget with it; in an open menu, the letter alone" {
    assert(mnemonic_of("&File") == 102 && mnemonic_of("Save &As") == 97 && mnemonic_of("A && B") == 0);
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 400, 300);
    mut Ui ui = Ui{ };
    mut bool bold = false;
    ui.mouse_move(399.0, 299.0);
    letters_frame(&ui, &surface, &bold);
    ui.key(0x400000E2, true, false, false);  // Alt held
    ui.key(115, true, false, false);  // S: Save, the first one
    assert(letters_frame(&ui, &surface, &bold) == 1);
    ui.key(98, true, false, false);  // B: the checkbox
    letters_frame(&ui, &surface, &bold);
    assert(bold);
    ui.key(102, true, false, false);  // F: the menu File opens
    ui.key(0x400000E2, false, false, false);
    letters_frame(&ui, &surface, &bold);
    assert(ui.menus[0] != 0);
    ui.key(113, true, false, false);  // q, alone: Quit, chosen at the next frame
    letters_frame(&ui, &surface, &bold);
    assert(letters_frame(&ui, &surface, &bold) == 3);
}

test "input methods: the composition shown at the cursor, then typed; the area of the cursor" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 320, 60);
    mut Ui ui = Ui{ };
    mut LongText text = long_text();
    defer text.free();
    assert(!ui.wants_text());
    ui.mouse_move(10.0, 16.0);
    ui.mouse_button(true);
    ui.mouse_button(false);
    long_frame(&ui, &surface, &text);
    assert(ui.wants_text());
    ui.type_text("ab");
    long_frame(&ui, &surface, &text);
    // composing: shown, not typed; the cursor area is where the cursor is
    ui.compose("\u{304b}", 1);
    long_frame(&ui, &surface, &text);
    assert(text.text() == "ab" && ui.composing.len > 0);
    canvas.Rect at = ui.caret_area();
    assert(at.x > 8.0 && at.h > 0.0);
    // the input method types it: the composition ends
    ui.type_text("\u{304b}");
    long_frame(&ui, &surface, &text);
    assert(text.text() == "ab\u{304b}" && ui.composing.len == 0);
}

// A button, a context menu on it, and a long list under it, for the test below: 1 the button
// clicked, 2 the context menu open.
i32 touch_frame(Ui* ui, canvas.Canvas* surface, i32* chosen, f32* scroll) {
    mut i32 seen = 0;
    mut Frame f = begin(ui, surface, 0.0, 0.0);
    if (f.button("Tap")) {
        seen = 1;
    }
    f.context_menu();
    f.menu_item("Copy");
    f.end_context_menu();
    if (ui.menus[0] != 0) {
        seen = 2;
    }
    f.list_of(1000, 200.0, 200.0, some(chosen));
    for (i32 i in f.first_shown()..f.last_shown()) {
        f.push_item();
        f.label("item");
        f.pop_id();
    }
    f.end_list();
    f.finish();
    for (usize i in 0..64) {
        if (ui.states[i].items == 1000) {
            *scroll = ui.states[i].scroll_y;
        }
    }
    return seen;
}

test "touch: a tap clicks, a long press opens the context menu, a drag scrolls with inertia" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 300, 300);
    mut Ui ui = Ui{ };
    mut i32 chosen = 0;
    mut f32 scroll = 0.0;
    ui.clock(1000);
    touch_frame(&ui, &surface, &chosen, &scroll);
    // a tap on the button
    ui.touch(1, 20.0, 16.0, Down);
    ui.touch(1, 21.0, 16.0, Up);
    assert(touch_frame(&ui, &surface, &chosen, &scroll) == 1);
    // a long press on it: its context menu
    ui.touch(2, 20.0, 16.0, Down);
    touch_frame(&ui, &surface, &chosen, &scroll);
    ui.clock(1600);
    assert(touch_frame(&ui, &surface, &chosen, &scroll) == 2);
    ui.touch(2, 20.0, 16.0, Up);
    ui.key(27, true, false, false);  // Escape closes it
    touch_frame(&ui, &surface, &chosen, &scroll);
    // a finger dragged up over the list: it scrolls down, then goes on a little
    ui.touch(3, 100.0, 200.0, Down);  // the list is from y 40 to 240
    ui.clock(1700);
    ui.touch(3, 100.0, 150.0, Move);
    touch_frame(&ui, &surface, &chosen, &scroll);
    ui.clock(1716);
    ui.touch(3, 100.0, 100.0, Move);
    ui.touch(3, 100.0, 100.0, Up);
    touch_frame(&ui, &surface, &chosen, &scroll);
    f32 after_drag = scroll;
    assert(after_drag > 0.0 && chosen == 0);  // scrolled, nothing chosen
    ui.clock(1800);
    touch_frame(&ui, &surface, &chosen, &scroll);
    assert(scroll > after_drag);  // inertia
    // the safe area: the frame starts inside its margins
    ui.safe_area(10.0, 30.0, 0.0, 0.0);
    mut Frame f = begin(&ui, &surface, 0.0, 0.0);
    f.label("top");
    assert(f.last.x == 10.0 && f.last.y == 30.0);
    f.finish();
}
