// ui.widgets: widgets in immediate mode (spec §10). Each frame, the program describes its
// interface from its own state, by calls: `if (f.button("OK")) { ... }`. Nothing is
// registered and nothing calls the program back: the description is simply run again.
//
// `Ui` keeps what lasts between frames: the input received since the last one, the widget
// pressed and the text field that has the focus. `Frame` places the widgets of one frame,
// one under the other, or side by side between `row()` and `end_row()`.
import render.canvas;
import render.image;
import render.truetype;

// Text typed or edited: at most 256 bytes of UTF-8.
pub struct TextBuffer {
    mut u8[256] bytes = [0; 256];
    mut usize len = 0;

    pub str text() {
        return match (str.from_bytes(bytes[0..len])) {
            ok(valid) => valid,
            err(e) => "",
        };
    }

    pub void set(str text) {
        len = 0;
        append(text);
    }

    // Adds `text` at the end, if it fits whole.
    pub void append(str text) {
        if (len + text.len > 256) {
            return;
        }
        for (u8 b in text.bytes) {
            bytes[len] = b;
            len += 1;
        }
    }

    // Removes the last character (all its bytes).
    pub void erase_last() {
        if (len == 0) {
            return;
        }
        len -= 1;
        while (len > 0 && bytes[len] & 0xC0 == 0x80) {  // a continuation byte
            len -= 1;
        }
    }

    // The last `count` characters at most.
    pub str tail(usize count) {
        mut usize start = len;
        mut usize found = 0;
        while (start > 0 && found < count) {
            start -= 1;
            if (bytes[start] & 0xC0 != 0x80) {
                found += 1;
            }
        }
        return match (str.from_bytes(bytes[start..len])) {
            ok(valid) => valid,
            err(e) => "",
        };
    }

    // The number of characters.
    pub usize count() {
        mut usize found = 0;
        for (usize i in 0..len) {
            if (bytes[i] & 0xC0 != 0x80) {
                found += 1;
            }
        }
        return found;
    }

    // Editing, at byte offsets that start a character (0 and `len` included).

    // The text from byte `from` to byte `to`.
    pub str slice(usize from, usize to) {
        usize end = min(to, len);
        return match (str.from_bytes(bytes[min(from, end)..end])) {
            ok(valid) => valid,
            err(e) => "",
        };
    }

    // Where the character after the one at `at` starts.
    pub usize next(usize at) {
        mut usize i = min(at + 1, len);
        while (i < len && bytes[i] & 0xC0 == 0x80) {
            i += 1;
        }
        return i;
    }

    // Where the character before `at` starts.
    pub usize previous(usize at) {
        if (at == 0) {
            return 0;
        }
        mut usize i = min(at, len) - 1;
        while (i > 0 && bytes[i] & 0xC0 == 0x80) {
            i -= 1;
        }
        return i;
    }

    // Inserts `text` at `at`; false, and nothing changes, if it does not fit.
    pub bool insert(usize at, str text) {
        if (len + text.len > 256 || at > len) {
            return false;
        }
        for (mut usize i = len; i > at; i -= 1) {
            bytes[i - 1 + text.len] = bytes[i - 1];
        }
        for (usize i in 0..text.len) {
            bytes[at + i] = text.bytes[i];
        }
        len += text.len;
        return true;
    }

    // Removes the bytes from `from` to `to`.
    pub void remove(usize from, usize to) {
        usize end = min(to, len);
        usize start = min(from, end);
        usize removed = end - start;
        for (mut usize i = start; i + removed < len; i += 1) {
            bytes[i] = bytes[i + removed];
        }
        len -= removed;
    }
}

// The key codes of SDL that text fields use (`platform.app` gives them as they are).
u32 key_backspace() {
    return 8;
}

u32 key_enter() {
    return 13;
}

u32 key_delete() {
    return 127;
}

u32 key_right() {
    return 0x4000004F;
}

u32 key_left() {
    return 0x40000050;
}

u32 key_up() {
    return 0x40000052;
}

u32 key_down() {
    return 0x40000051;
}

u32 key_home() {
    return 0x4000004A;
}

u32 key_end() {
    return 0x4000004D;
}

// Something typed for the text field that has the keyboard: text, or a key.
struct Edit {
    mut u32 key = 0;  // 0: the text `from` to `to` of `Ui.typed`
    mut usize from = 0;
    mut usize to = 0;
    mut bool shift = false;
    mut bool ctrl = false;
}

// The state of an interface between frames.
pub struct Ui {
    // The input since the last frame.
    mut f32 mouse_x = 0.0;
    mut f32 mouse_y = 0.0;
    mut bool down = false;  // the left button is held
    mut bool pressed = false;  // it went down
    mut bool released = false;  // it went up
    mut TextBuffer typed = TextBuffer{ };  // the text of the edits
    mut Edit[64] edits = [Edit{ }; 64];  // in the order they came
    mut usize edit_count = 0;

    // Between frames: the widget pressed and not yet released, the text field that has
    // the keyboard (-1: none). Widgets are numbered in the order of the calls.
    mut i32 active = -1;
    mut i32 focus = -1;
    // In the text field that has the keyboard: the cursor and the other end of the selection
    // (byte offsets), and how far its text is scrolled to keep the cursor in view.
    mut usize cursor = 0;
    mut usize anchor = 0;
    mut f32 scroll = 0.0;
    // What Ctrl+C or Ctrl+X copied, for the program to put on the clipboard.
    mut TextBuffer copied = TextBuffer{ };
    mut bool has_copied = false;
    // The mouse wheel since the last frame, in steps (positive: away from the user), and
    // what each list keeps between frames.
    mut f32 wheel = 0.0;
    mut ListState[8] lists = [ListState{ }; 8];

    // The dropdown open (-1: none), and the rectangle of its list at the last frame: the
    // layer above, which takes the mouse before the widgets under it.
    mut i32 open = -1;
    mut canvas.Rect layer = nowhere();

    // The menus open: at each level, its widget number (-1: none), the first a menu opened by
    // its title (`menu_in_bar`) or a context menu, the others its submenus; where the context
    // menu opened; the size of each menu open at the last frame, and its rectangle, above the
    // rest as the list of a dropdown is.
    mut i32[4] menus = [-1; 4];
    mut bool menu_in_bar = false;
    mut f32 context_x = 0.0;
    mut f32 context_y = 0.0;
    mut f32[4] menu_w = [0.0; 4];
    mut f32[4] menu_h = [0.0; 4];
    mut canvas.Rect[4] popups = [nowhere(); 4];
    mut usize popup_count = 0;
    mut bool right_pressed = false;  // the right button went down: context menus
    mut bool editing = false;  // a text field had the keyboard at the last frame

    // The title bar of the last frame (spec §10.5): its rectangle, those of the interactive
    // widgets in it and of its window buttons, and the request of a window button.
    mut canvas.Rect bar = nowhere();
    mut canvas.Rect[16] bar_widgets = [nowhere(); 16];
    mut usize bar_widget_count = 0;
    mut canvas.Rect bar_buttons = nowhere();
    mut WindowRequest? request = none;
    // Set by the program: whether the system left the title bar to it (`platform.app` says
    // so with `CustomTitleBar`), else a `title_bar` is a tool bar; whether it is maximized.
    pub mut bool custom_title_bar = false;
    pub mut bool maximized = false;

    // The font of the widgets; without one, the built-in 8 by 8 font. Text is 9 pixels per
    // em for each step of scale: 18 for labels, 27 for titles.
    pub mut truetype.Font*? font = none;

    // The input, as `platform.app` gives it.
    pub void mouse_move(f32 x, f32 y) {
        mouse_x = x;
        mouse_y = y;
    }

    // The left button, pressed or released.
    pub void mouse_button(bool is_down) {
        if (is_down) {
            pressed = true;
        } else {
            released = true;
        }
        down = is_down;
    }

    // The right button, pressed or released: a press opens the context menu under the mouse.
    pub void right_button(bool is_down) {
        if (is_down) {
            right_pressed = true;
        }
    }

    // Closes the menus open from `level` on.
    void close_menus(usize level) {
        for (usize i in level..4) {
            menus[i] = -1;
        }
    }

    // Whether (x, y) is on the layer above: the list of a dropdown or a menu, open.
    bool on_layer(f32 x, f32 y) {
        if (contains(layer, x, y)) {
            return true;
        }
        for (usize i in 0..popup_count) {
            if (contains(popups[i], x, y)) {
                return true;
            }
        }
        return false;
    }

    // The mouse wheel turned by `steps` (`platform.app.Wheel`): it scrolls the list under the mouse.
    pub void scroll_wheel(f32 steps) {
        wheel += steps;
    }

    // Typed text, or the text of the clipboard for a paste (Ctrl+V).
    pub void type_text(str text) {
        usize from = typed.len;
        if (edit_count < 64 && typed.insert(from, text)) {
            edits[edit_count] = Edit{ from: from, to: typed.len };
            edit_count += 1;
        }
    }

    // A key, with the key codes of SDL, and whether Shift and Ctrl (Cmd on macOS) are held.
    // Text fields use Left, Right, Home, End (Shift to select), Backspace, Delete, Enter, and
    // Ctrl+A, Ctrl+C and Ctrl+X.
    pub void key(u32 code, bool is_down, bool shift, bool ctrl) {
        if (is_down && edit_count < 64) {
            edits[edit_count] = Edit{ key: code, shift: shift, ctrl: ctrl };
            edit_count += 1;
        }
    }

    // What Ctrl+C or Ctrl+X copied since the last call, for the clipboard.
    pub str? take_copied() {
        if (!has_copied) {
            return none;
        }
        has_copied = false;
        return some(copied.text());
    }

    // What a window button of the title bar asked since the last call, for `platform.app`.
    pub WindowRequest? take_window_request() {
        WindowRequest? asked = request;
        request = none;
        return asked;
    }

    // Whether the mouse at (x, y) moves the window: on the title bar of the last frame, and on
    // none of its interactive widgets, its window buttons, an open dropdown or menu. Labels drag.
    pub bool is_drag_area(f32 x, f32 y) {
        if (!custom_title_bar || !contains(bar, x, y) || contains(bar_buttons, x, y) || on_layer(x, y)) {
            return false;
        }
        for (usize i in 0..bar_widget_count) {
            if (contains(bar_widgets[i], x, y)) {
                return false;
            }
        }
        return true;
    }
}

// What a window button asks of the window.
pub enum WindowRequest {
    Minimize,
    ToggleMaximize,  // maximize, or restore when it is maximized
    Close,
}

canvas.Rect nowhere() {
    return canvas.Rect{ x: 0.0, y: 0.0, w: 0.0, h: 0.0 };
}

bool contains(canvas.Rect r, f32 x, f32 y) {
    return x >= r.x && x < r.x + r.w && y >= r.y && y < r.y + r.h;
}

// ---- Formats of text fields ----

// What a text field accepts, character by character.
pub enum Accept {
    Any,
    Digits,  // 0 to 9
    Integer,  // digits, and `-` first
    Decimal,  // digits, `-` first, and one separator, `.` or `,`
}

pub struct Format {
    pub Accept accept = Any;
    pub usize max = 0;  // characters at most; 0: as many as fit
    // 9: a digit, A: a letter, *: any character; the other characters are written as they
    // are, when the cursor reaches them (`99/99/9999` for a date). Empty: no mask.
    pub str mask = "";
}

str text_of(u8[] bytes) {
    return match (str.from_bytes(bytes)) {
        ok(valid) => valid,
        err(e) => "",
    };
}

// Where the character after the one at byte `at` of `text` starts.
usize next_char(str text, usize at) {
    mut usize i = at + 1;
    while (i < text.len && text.bytes[i] & 0xC0 == 0x80) {
        i += 1;
    }
    return min(i, text.len);
}

usize chars_in(str text) {
    mut usize count = 0;
    for (char c in text.chars()) {
        count += 1;
    }
    return count;
}

bool is_digit(u8 b) {
    return b >= 48 && b <= 57;
}

// A letter: ASCII, or any character beyond it (é, ß, ж...).
bool is_letter(u8 b) {
    return b >= 65 && b <= 90 || b >= 97 && b <= 122 || b >= 0xC0;
}

bool is_slot(u8 m) {
    return m == 57 || m == 65 || m == 42;  // 9, A, *
}

// Whether a character starting with byte `first` can go in the slot `m` of a mask.
bool fits_slot(u8 m, u8 first) {
    return m == 42 || m == 57 && is_digit(first) || m == 65 && is_letter(first);
}

// Whether a character starting with byte `first` can go at `at` in `text`.
bool accepts(Accept accept, u8 first, TextBuffer* text, usize at) {
    bool minus = first == 45 && at == 0 && !has_byte(text, 45);
    bool separator = (first == 46 || first == 44) && !has_byte(text, 46) && !has_byte(text, 44);
    return match (accept) {
        Any => true,
        Digits => is_digit(first),
        Integer => is_digit(first) || minus,
        Decimal => is_digit(first) || minus || separator,
    };
}

bool has_byte(TextBuffer* text, u8 b) {
    for (usize i in 0..text.len) {
        if (text.bytes[i] == b) {
            return true;
        }
    }
    return false;
}

// The colors of the widgets.
canvas.Color ink() {
    return canvas.Color{ r: 205, g: 214, b: 244 };
}

canvas.Color face(bool hot, bool held) {
    if (held) {
        return canvas.Color{ r: 49, g: 50, b: 68 };
    }
    return hot ? canvas.Color{ r: 88, g: 91, b: 112 } : canvas.Color{ r: 69, g: 71, b: 90 };
}

canvas.Color accent() {
    return canvas.Color{ r: 137, g: 180, b: 250 };
}

canvas.Color well() {
    return canvas.Color{ r: 24, g: 24, b: 37 };
}

// What a window of a `.ui.sosu` file says about itself (spec §10.2).
pub struct Window {
    pub str title = "Sosu";
    pub i32 width = 640;
    pub i32 height = 480;
    pub bool custom_title_bar = false;  // it draws its own title bar (`TitleBar`, spec §10.5)
    pub str icon = "";  // the path of its icon, a PNG file: "" for none
}

// A menu being described, open or not: its place, and its entries, drawn by `finish()` when
// it is open.
struct Popup {
    mut i32 id = -1;
    mut bool open = false;
    mut usize level = 0;
    mut f32 x = 0.0;
    mut f32 y = 0.0;
    mut f32 w = 0.0;  // the width it had at the last frame
    mut f32 h = 0.0;  // of its entries so far
    mut f32 widest = 0.0;  // of an entry, for its width at the next frame
    mut usize count = 0;
    mut str[24] labels = [""; 24];
    mut str[24] keys = [""; 24];  // the shortcuts
    mut u8[24] kinds = [0; 24];  // 0: an item, 1: a separator, 2: a submenu
    mut bool[24] enabled = [true; 24];
    mut i32[24] submenus = [-1; 24];  // the widget number of a submenu
}

// The key code of a shortcut such as "Ctrl+S", "Ctrl+Shift+Z", "F5" or "Delete", and its
// modifiers; the code 0 when it is not understood.
struct Shortcut {
    mut u32 code = 0;
    mut bool ctrl = false;
    mut bool shift = false;
}

bool same_text(str a, str b) {
    if (a.len != b.len) {
        return false;
    }
    for (usize i in 0..a.len) {
        u8 x = a.bytes[i] >= 65 && a.bytes[i] <= 90 ? a.bytes[i] + 32 : a.bytes[i];
        u8 y = b.bytes[i] >= 65 && b.bytes[i] <= 90 ? b.bytes[i] + 32 : b.bytes[i];
        if (x != y) {
            return false;
        }
    }
    return true;
}

// The key of a shortcut: a character (a letter, without case), F1 to F12, or a named key.
u32 key_named(str name) {
    if (name.len == 1) {
        u8 c = name.bytes[0];
        return (c >= 65 && c <= 90 ? c + 32 : c) as u32;
    }
    if (name.len >= 2 && name.len <= 3 && (name.bytes[0] == 70 || name.bytes[0] == 102)) {  // F1 to F12
        mut u32 n = 0;
        for (usize i in 1..name.len) {
            if (!is_digit(name.bytes[i])) {
                return 0;
            }
            n = n * 10 + (name.bytes[i] - 48) as u32;
        }
        return n >= 1 && n <= 12 ? 0x4000003A + n - 1 : 0;
    }
    if (same_text(name, "delete") || same_text(name, "del")) {
        return key_delete();
    }
    if (same_text(name, "enter")) {
        return key_enter();
    }
    if (same_text(name, "backspace")) {
        return key_backspace();
    }
    if (same_text(name, "tab")) {
        return 9;
    }
    if (same_text(name, "space")) {
        return 32;
    }
    return 0;
}

Shortcut parse_shortcut(str text) {
    mut Shortcut s = Shortcut{ };
    mut usize start = 0;
    for (usize i in 0..text.len + 1) {
        if (i < text.len && text.bytes[i] != 43) {  // +
            continue;
        }
        str part = text_of(text.bytes[start..i]);
        bool modifier = i < text.len;  // followed by +
        if (modifier && (same_text(part, "ctrl") || same_text(part, "cmd"))) {
            s.ctrl = true;
        } else if (modifier && same_text(part, "shift")) {
            s.shift = true;
        } else {
            s.code = key_named(part);
        }
        start = i + 1;
    }
    return s;
}

// A column or a row of widgets, being placed.
struct Layout {
    mut bool horizontal = false;
    mut f32 x = 0.0;  // where the next widget goes
    mut f32 y = 0.0;
    mut f32 left = 0.0;  // where its widgets start, inside its padding
    mut f32 top = 0.0;
    mut f32 right = 0.0;  // how far its widgets go
    mut f32 bottom = 0.0;
    mut f32 gap = 8.0;
    mut f32 padding = 0.0;
    // In a list: the slot of `Ui.lists` (-1: not a list), its rectangle, the next item, and
    // the item chosen, if the list has a choice.
    mut i32 list = -1;
    mut canvas.Rect frame = canvas.Rect{ x: 0.0, y: 0.0, w: 0.0, h: 0.0 };
    mut i32 item = 0;
    mut i32*? selected = none;
}

// What a list keeps between frames.
struct ListState {
    mut i32 id = -1;  // the widget number of its list, -1: a free slot
    mut f32 scroll = 0.0;  // how far its items are scrolled up
    mut f32 content = 0.0;  // how high its items were at the last frame
    mut i32 items = 0;  // how many
    mut bool reveal = false;  // scroll to the item chosen, after a key moved the choice
}

// The widgets of one frame, drawn on `surface`.
pub struct Frame {
    Ui* ui;
    canvas.Canvas* surface;
    // The layouts open, the frame itself first: a column, or a row inside, and so on.
    mut Layout[16] layouts = [Layout{ }; 16];
    mut usize depth = 0;
    mut i32 next_id = 0;
    mut bool focus_taken = false;  // a text field took the focus in this frame
    f32 height = 32.0;  // of a line of widgets
    // The title bar being placed: the depth of its row (0: none), its rectangle, and the
    // interactive widgets in it.
    mut usize bar_depth = 0;
    mut canvas.Rect bar = nowhere();
    mut canvas.Rect[16] bar_widgets = [nowhere(); 16];
    mut usize bar_widget_count = 0;
    // The dropdown being described (-1: none) and its box; the list of the open one, drawn by
    // `finish()` above the rest: its owner, its rectangle, its options and the one chosen.
    mut i32 dropdown_id = -1;
    mut canvas.Rect box = nowhere();
    mut i32 layer_owner = -1;
    mut canvas.Rect layer = nowhere();
    mut str[16] options = [""; 16];
    mut usize option_count = 0;
    mut i32 option_chosen = -1;
    mut bool dropdown_pressed = false;  // a press went to a dropdown or to one of its options
    // The menus being described, one per level (`menu_level` of them), and those open, drawn by
    // `finish()`; a press that went to a menu, a right press that opened a context menu.
    mut Popup[4] menu_popups = [Popup{ }; 4];
    mut usize menu_level = 0;
    mut Popup[4] shown = [Popup{ }; 4];
    mut usize shown_count = 0;
    mut bool menu_pressed = false;
    mut bool right_taken = false;
    mut u64 keys_taken = 0;  // the edits a shortcut used: one item per key pressed
    mut bool editing = false;  // a text field has the keyboard
    // The rectangle of the last widget placed, or of the last list: what a context menu is for.
    mut canvas.Rect last = nowhere();

    // The widgets that follow go under each other, `gap` pixels apart, inside `padding`,
    // until `end()`; the column then takes its place in the layout that holds it.
    pub void column(f32 gap, f32 padding) {
        open(false, gap, padding);
    }

    // The same, side by side.
    pub void row_with(f32 gap, f32 padding) {
        open(true, gap, padding);
    }

    pub void end() {
        if (depth == 0) {
            return;
        }
        Layout done = layouts[depth];
        depth -= 1;
        place(done.right - done.left + 2.0 * done.padding, done.bottom - done.top + 2.0 * done.padding);
    }

    // The widgets that follow go side by side, until `end_row()`.
    pub void row() {
        open(true, 8.0, 0.0);
    }

    pub void end_row() {
        end();
    }

    // Empty space after the last widget.
    pub void space(f32 size) {
        if (layouts[depth].horizontal) {
            layouts[depth].x += size;
        } else {
            layouts[depth].y += size;
        }
    }

    // Text, at the size of the widgets (font at scale 2).
    pub void label(str text) {
        canvas.Rect size = measure(text, 2);
        canvas.Rect r = place(size.w, max(size.h, height));
        write(r.x, r.y, height, text, ink(), 2);
    }

    // An image `size` pixels high (0: its own height), as wide as its proportions say; in a
    // row higher than it, it is centered vertically.
    pub void image(image.Image img, f32 size) {
        if (img.width <= 0 || img.height <= 0) {
            return;
        }
        f32 h = size > 0.0 ? size : img.height as f32;
        f32 w = h * img.width as f32 / img.height as f32;
        f32 box = layouts[depth].horizontal ? max(h, height) : h;
        canvas.Rect r = place(w, box);
        surface.draw_image(img, canvas.Rect{ x: r.x, y: r.y + (box - h) / 2.0, w: w, h: h });
    }

    // Bigger text (font at scale 3).
    pub void title(str text) {
        canvas.Rect size = measure(text, 3);
        canvas.Rect r = place(size.w, size.h + 8.0);
        write(r.x, r.y, size.h, text, ink(), 3);
    }

    // Returns true when it is clicked: pressed, then released over it.
    pub bool button(str text) {
        return button_enabled(text, true);
    }

    // A button that can be disabled: dimmed, and never clicked.
    pub bool button_enabled(str text, bool enabled) {
        i32 id = take_id();
        canvas.Rect size = measure(text, 2);
        canvas.Rect r = place(size.w + 32.0, height);
        interactive(r);
        if (!enabled) {
            surface.fill(r, well());
            write(r.x + 16.0, r.y, height, text, face(false, false), 2);
            return false;
        }
        bool clicked = click(id, r);
        bool hot = over(r);
        surface.fill(r, face(hot, ui.active == id && hot));
        write(r.x + 16.0, r.y, height, text, ink(), 2);
        return clicked;
    }

    // A box that `value` checks or not; returns true when it changes it.
    pub bool checkbox(str text, bool* value) {
        i32 id = take_id();
        canvas.Rect size = measure(text, 2);
        canvas.Rect r = place(size.w + 32.0, height);
        interactive(r);
        bool clicked = click(id, r);
        if (clicked) {
            *value = !(*value);
        }
        canvas.Rect box = canvas.Rect{ x: r.x + 2.0, y: r.y + 6.0, w: 20.0, h: 20.0 };
        surface.fill(box, face(over(r), ui.active == id && over(r)));
        if (*value) {
            surface.fill(canvas.Rect{ x: box.x + 5.0, y: box.y + 5.0, w: 10.0, h: 10.0 }, accent());
        }
        write(r.x + 32.0, r.y, height, text, ink(), 2);
        return clicked;
    }

    // The same box, without a label.
    pub bool checkbox_alone(bool* value) {
        return checkbox("", value);
    }

    // A round button of a group, of which one is chosen: drawn chosen when `chosen`; returns
    // true when it is clicked (the program then chooses it, see `Radio` in .ui.sosu files).
    pub bool radio(str text, bool chosen) {
        i32 id = take_id();
        canvas.Rect size = measure(text, 2);
        canvas.Rect r = place(size.w + 32.0, height);
        interactive(r);
        bool clicked = click(id, r);
        f32 cx = r.x + 12.0;
        f32 cy = r.y + height / 2.0;
        surface.fill_circle(cx, cy, 10.0, face(over(r), ui.active == id && over(r)));
        if (chosen) {
            surface.fill_circle(cx, cy, 5.0, accent());
        }
        write(r.x + 32.0, r.y, height, text, ink(), 2);
        return clicked;
    }

    // A text field `width` pixels wide. A click gives it the keyboard and places the cursor,
    // dragging selects; returns true when Enter is pressed in it.
    pub bool text_field(TextBuffer* text, f32 width) {
        return text_field_with(text, width, Format{ });
    }

    // The same, keeping only what `format` accepts.
    pub bool text_field_with(TextBuffer* text, f32 width, Format format) {
        i32 id = take_id();
        canvas.Rect r = place(width, height);
        interactive(r);
        canvas.Rect inner = canvas.Rect{ x: r.x + 8.0, y: r.y, w: max(width - 16.0, 0.0), h: height };
        if (ui.pressed && over(r)) {
            if (ui.focus != id) {
                ui.focus = id;
                ui.scroll = 0.0;
            }
            focus_taken = true;
            ui.active = id;
            ui.cursor = index_at(text, ui.mouse_x - inner.x + ui.scroll);
            ui.anchor = ui.cursor;
        } else if (ui.focus == id && ui.active == id && ui.down) {
            ui.cursor = index_at(text, ui.mouse_x - inner.x + ui.scroll);  // dragging selects
        }
        bool focused = ui.focus == id;
        mut bool entered = false;
        editing = editing || focused;
        if (focused) {
            // the text may have changed since the last frame (a Clear button)
            ui.cursor = min(ui.cursor, text.len);
            ui.anchor = min(ui.anchor, text.len);
            entered = edit(text, format);
        }

        surface.fill(r, well());
        surface.stroke(r, focused ? accent() : face(over(r), false), 2.0);
        surface.push_clip(canvas.Rect{ x: inner.x - 2.0, y: r.y + 2.0, w: inner.w + 4.0, h: r.h - 4.0 });
        f32 caret = measure(text.slice(0, focused ? ui.cursor : 0), 2).w;
        if (focused) {  // keep the cursor in view
            if (caret - ui.scroll > inner.w - 2.0) {
                ui.scroll = caret - inner.w + 2.0;
            }
            if (caret < ui.scroll) {
                ui.scroll = caret;
            }
        }
        f32 shift = focused ? ui.scroll : 0.0;
        if (focused && ui.anchor != ui.cursor) {
            f32 a = measure(text.slice(0, min(ui.anchor, ui.cursor)), 2).w;
            f32 b = measure(text.slice(0, max(ui.anchor, ui.cursor)), 2).w;
            canvas.Color selected = canvas.Color{ r: 137, g: 180, b: 250, a: 90 };
            surface.fill(canvas.Rect{ x: inner.x + a - shift, y: r.y + 6.0, w: b - a, h: 20.0 }, selected);
        }
        write(inner.x - shift, r.y, height, text.text(), ink(), 2);
        if (focused) {
            surface.fill(canvas.Rect{ x: inner.x + caret - shift, y: r.y + 6.0, w: 2.0, h: 20.0 }, accent());
        }
        surface.pop_clip();
        return entered;
    }

    // The byte offset of the character boundary nearest to `x`, from the start of the text.
    usize index_at(TextBuffer* text, f32 x) {
        mut usize at = 0;
        while (at < text.len) {
            usize after = text.next(at);
            f32 left = measure(text.slice(0, at), 2).w;
            f32 right = measure(text.slice(0, after), 2).w;
            if (x < (left + right) / 2.0) {
                return at;
            }
            at = after;
        }
        return text.len;
    }

    // Applies the edits of the frame to the text field that has the keyboard, in order.
    // Returns true if Enter was pressed.
    bool edit(TextBuffer* text, Format format) {
        mut bool entered = false;
        for (usize i in 0..ui.edit_count) {
            Edit e = ui.edits[i];
            usize start = min(ui.anchor, ui.cursor);
            usize end = max(ui.anchor, ui.cursor);
            if (e.key == 0) {
                type_into(text, ui.typed.slice(e.from, e.to), format);
            } else if (e.ctrl && e.key == 97) {  // Ctrl+A: all
                ui.anchor = 0;
                ui.cursor = text.len;
            } else if (e.ctrl && (e.key == 99 || e.key == 120)) {  // Ctrl+C, Ctrl+X
                if (start != end) {
                    ui.copied.set(text.slice(start, end));
                    ui.has_copied = true;
                    if (e.key == 120) {
                        erase_selection(text);
                    }
                }
            } else if (e.key == key_backspace() || e.key == key_delete()) {
                if (start == end) {
                    ui.anchor = e.key == key_backspace() ? text.previous(ui.cursor) : text.next(ui.cursor);
                }
                erase_selection(text);
            } else if (e.key == key_left() || e.key == key_right()) {
                bool left = e.key == key_left();
                if (start != end && !e.shift) {
                    ui.cursor = left ? start : end;  // the selection ends where the arrow points
                } else {
                    ui.cursor = left ? text.previous(ui.cursor) : text.next(ui.cursor);
                }
                if (!e.shift) {
                    ui.anchor = ui.cursor;
                }
            } else if (e.key == key_home() || e.key == key_end()) {
                ui.cursor = e.key == key_home() ? 0 : text.len;
                if (!e.shift) {
                    ui.anchor = ui.cursor;
                }
            } else if (e.key == key_enter()) {
                entered = true;
            }
        }
        return entered;
    }

    void erase_selection(TextBuffer* text) {
        usize start = min(ui.anchor, ui.cursor);
        text.remove(start, max(ui.anchor, ui.cursor));
        ui.cursor = start;
        ui.anchor = start;
    }

    // Typed text, at the cursor, instead of the selection: each character that `format`
    // accepts, with the fixed characters of its mask written on the way.
    void type_into(TextBuffer* text, str typed, Format format) {
        erase_selection(text);
        mut usize at = 0;
        while (at < typed.len) {
            usize after = next_char(typed, at);
            str piece = text_of(typed.bytes[at..after]);
            at = after;
            if (format.mask.len > 0) {
                mut usize position = chars_in(text.slice(0, ui.cursor));
                while (position < format.mask.len && !is_slot(format.mask.bytes[position])) {
                    str fixed = text_of(format.mask.bytes[position..position + 1]);
                    if (!text.insert(ui.cursor, fixed)) {
                        return;
                    }
                    ui.cursor += 1;
                    position += 1;
                }
                if (position >= format.mask.len || !fits_slot(format.mask.bytes[position], piece.bytes[0])) {
                    continue;
                }
            } else if (!accepts(format.accept, piece.bytes[0], text, ui.cursor)) {
                continue;
            }
            if (format.max > 0 && text.count() >= format.max) {
                return;
            }
            if (text.insert(ui.cursor, piece)) {
                ui.cursor += piece.len;
            }
        }
        ui.anchor = ui.cursor;
    }

    // A title bar across the surface, from the left of the current layout: the widgets that
    // follow, until `end_title_bar()`, go side by side in it, `gap` apart, `padding` from its
    // left end. Its empty space and its labels drag the window (`Ui.is_drag_area`).
    pub void title_bar(f32 bar_height, f32 gap, f32 padding) {
        Layout l = layouts[depth];
        bar = canvas.Rect{ x: l.x, y: l.y, w: max(surface.width as f32 - l.x, 0.0), h: bar_height };
        bar_widget_count = 0;
        surface.fill(bar, canvas.Color{ r: 17, g: 17, b: 27 });
        if (depth == 15) {
            return;  // too deep: the widgets stay in the current layout
        }
        f32 x = bar.x + padding;
        f32 y = bar.y + max((bar_height - height) / 2.0, 0.0);
        depth += 1;
        layouts[depth] = Layout{ horizontal: true, x: x, y: y, left: x, top: y, right: x, bottom: y, gap: gap };
        bar_depth = depth;
    }

    // Ends the title bar: draws its window buttons, if the system left the bar to the program,
    // and remembers what is in it for `Ui.is_drag_area`. The frame goes on under it.
    pub void end_title_bar() {
        if (bar_depth == 0) {
            return;  // not in a title bar
        }
        depth = bar_depth - 1;
        bar_depth = 0;
        ui.bar = bar;
        ui.bar_widgets = bar_widgets;
        ui.bar_widget_count = bar_widget_count;
        ui.bar_buttons = nowhere();
        if (ui.custom_title_bar) {
            window_buttons();
        }
        place(bar.w, bar.h);
    }

    // Minimize, maximize (or restore) and close, at the right end of the title bar.
    void window_buttons() {
        f32 w = 46.0;
        ui.bar_buttons = canvas.Rect{ x: bar.x + bar.w - 3.0 * w, y: bar.y, w: 3.0 * w, h: bar.h };
        for (i32 i in 0..3) {
            i32 id = take_id();
            canvas.Rect r = canvas.Rect{ x: ui.bar_buttons.x + i as f32 * w, y: bar.y, w: w, h: bar.h };
            bool clicked = click(id, r);
            if (over(r)) {
                bool held = ui.active == id;
                surface.fill(r, i == 2 ? canvas.Color{ r: 196, g: 43, b: 28 } : face(!held, held));
            }
            i32 cx = (r.x + w / 2.0) as i32;
            i32 cy = (r.y + bar.h / 2.0) as i32;
            if (i == 0) {
                surface.line(cx - 5, cy, cx + 5, cy, ink());
            } else if (i == 1 && ui.maximized) {  // restore: two squares
                surface.stroke(canvas.Rect{ x: (cx - 5) as f32, y: (cy - 3) as f32, w: 8.0, h: 8.0 }, ink(), 1.0);
                surface.line(cx - 3, cy - 5, cx + 5, cy - 5, ink());
                surface.line(cx + 5, cy - 5, cx + 5, cy + 3, ink());
            } else if (i == 1) {
                surface.stroke(canvas.Rect{ x: (cx - 5) as f32, y: (cy - 5) as f32, w: 10.0, h: 10.0 }, ink(), 1.0);
            } else {
                surface.line(cx - 5, cy - 5, cx + 5, cy + 5, ink());
                surface.line(cx - 5, cy + 5, cx + 5, cy - 5, ink());
            }
            if (clicked) {
                if (i == 0) {
                    ui.request = some(WindowRequest.Minimize);
                } else if (i == 1) {
                    ui.request = some(WindowRequest.ToggleMaximize);
                } else {
                    ui.request = some(WindowRequest.Close);
                }
            }
        }
    }

    // A widget the mouse acts on: in a title bar, it does not drag the window.
    void interactive(canvas.Rect r) {
        if (bar_depth > 0 && bar_widget_count < 16) {
            bar_widgets[bar_widget_count] = r;
            bar_widget_count += 1;
        }
    }

    // A dropdown `width` wide: its options follow, until `end_dropdown()`. Its box shows the
    // option chosen; a click on it opens the list of its options under it, above the rest of
    // the frame, where a click chooses one. A click elsewhere, or Escape, closes it.
    pub void dropdown(f32 width) {
        i32 id = take_id();
        canvas.Rect r = place(width, height);
        interactive(r);
        if (ui.pressed && over(r)) {
            ui.open = ui.open == id ? -1 : id;
            dropdown_pressed = true;
        }
        if (ui.open == id) {
            for (usize i in 0..ui.edit_count) {
                if (ui.edits[i].key == 27) {  // Escape
                    ui.open = -1;
                }
            }
        }
        dropdown_id = id;
        box = r;
        if (ui.open == id) {
            layer_owner = id;
            layer = canvas.Rect{ x: r.x, y: r.y + r.h, w: r.w, h: 0.0 };
            option_count = 0;
            option_chosen = -1;
        }
        surface.fill(r, well());
        surface.stroke(r, ui.open == id ? accent() : face(over(r), false), 2.0);
        i32 cx = (r.x + r.w - 16.0) as i32;  // a chevron, pointing down
        i32 cy = (r.y + height / 2.0) as i32;
        surface.line(cx - 5, cy - 2, cx, cy + 3, ink());
        surface.line(cx, cy + 3, cx + 5, cy - 2, ink());
    }

    // An option of the dropdown being described, drawn in its box when `chosen`; returns
    // true when it is clicked in the open list (the program then chooses it, see `Option` in
    // .ui.sosu files).
    pub bool option(str text, bool chosen) {
        if (dropdown_id < 0) {
            return false;  // not in a dropdown
        }
        if (chosen) {
            surface.push_clip(canvas.Rect{ x: box.x + 2.0, y: box.y + 2.0, w: max(box.w - 32.0, 0.0), h: box.h - 4.0 });
            write(box.x + 8.0, box.y, height, text, ink(), 2);
            surface.pop_clip();
        }
        if (layer_owner != dropdown_id || option_count >= 16) {
            return false;
        }
        canvas.Rect r = canvas.Rect{ x: layer.x, y: layer.y + layer.h, w: layer.w, h: height };
        options[option_count] = text;
        if (chosen) {
            option_chosen = option_count as i32;
        }
        option_count += 1;
        layer = canvas.Rect{ x: layer.x, y: layer.y, w: layer.w, h: layer.h + height };
        if (ui.open == dropdown_id && ui.pressed && contains(r, ui.mouse_x, ui.mouse_y)) {
            ui.open = -1;
            dropdown_pressed = true;
            return true;
        }
        return false;
    }

    pub void end_dropdown() {
        dropdown_id = -1;
    }

    // ---- Menus ----

    // A bar of menus: the `menu`s that follow, until `end_menu_bar()`, side by side.
    pub void menu_bar() {
        open(true, 0.0, 0.0);
    }

    pub void end_menu_bar() {
        end();
    }

    // A menu: its items follow, until `end_menu()`, described at each frame whether it is
    // open or not (their shortcuts work when it is closed). Outside of a menu, its title is
    // placed (in a bar of menus, or alone, as a button), and a click on it opens the menu
    // under it; when a menu opened by its title is open, the mouse over another title opens
    // that one instead. In a menu, it is an entry that opens the submenu beside it, when the
    // mouse is over it. Menus go 4 levels deep; deeper ones are ignored.
    pub void menu(str title) {
        i32 id = take_id();
        if (menu_level >= 4) {
            menu_level += 1;
            return;
        }
        if (menu_level == 0) {
            canvas.Rect r = place(measure(title, 2).w + 24.0, height);
            interactive(r);
            bool hot = over(r);
            if (ui.pressed && hot) {
                bool was_open = ui.menus[0] == id;
                ui.close_menus(0);
                if (!was_open) {
                    ui.menus[0] = id;
                    ui.menu_in_bar = true;
                }
                menu_pressed = true;
            } else if (hot && ui.menus[0] >= 0 && ui.menus[0] != id && ui.menu_in_bar) {
                ui.close_menus(0);  // from one menu of the bar to the next
                ui.menus[0] = id;
            }
            bool open = ui.menus[0] == id;
            if (open || hot) {
                surface.fill(r, open ? face(false, true) : face(true, false));
            }
            write(r.x + 12.0, r.y, height, title, ink(), 2);
            start_popup(id, open, r.x, r.y + r.h);
            return;
        }
        // in a menu: the entry that opens it
        canvas.Rect entry = add_entry(title, "", 2, true);
        menu_popups[menu_level - 1].submenus[min(menu_popups[menu_level - 1].count, 24) - 1] = id;
        bool parent_open = menu_popups[menu_level - 1].open;
        if (parent_open && contains(entry, ui.mouse_x, ui.mouse_y)) {
            if (ui.menus[menu_level] != id) {
                ui.close_menus(menu_level);
                ui.menus[menu_level] = id;
            }
            if (ui.pressed) {
                menu_pressed = true;
            }
        }
        start_popup(id, parent_open && ui.menus[menu_level] == id, entry.x + entry.w - 4.0, entry.y - 4.0);
    }

    pub void end_menu() {
        if (menu_level == 0) {
            return;
        }
        menu_level -= 1;
        if (menu_level < 4 && menu_popups[menu_level].open && shown_count < 4) {
            shown[shown_count] = menu_popups[menu_level];
            shown_count += 1;
        }
    }

    // A context menu for the widget placed just before it (a list: the whole list): its items
    // follow, until `end_context_menu()`. A press of the right button on that widget opens it
    // under the mouse; when context menus are nested (one for an item, one for its list), the
    // first one described opens.
    pub void context_menu() {
        i32 id = take_id();
        if (menu_level > 0) {
            menu_level += 1;  // not in a menu: its items are ignored
            return;
        }
        if (ui.right_pressed && !right_taken && over(last)) {
            ui.close_menus(0);
            ui.menus[0] = id;
            ui.menu_in_bar = false;
            ui.context_x = ui.mouse_x;
            ui.context_y = ui.mouse_y;
            right_taken = true;
        }
        start_popup(id, ui.menus[0] == id, ui.context_x, ui.context_y);
    }

    pub void end_context_menu() {
        end_menu();
    }

    // An item of the menu being described: returns true when it is clicked.
    pub bool menu_item(str text) {
        return menu_item_with(text, "", true);
    }

    // The same, dimmed and never clicked unless `enabled`.
    pub bool menu_item_enabled(str text, bool enabled) {
        return menu_item_with(text, "", enabled);
    }

    // The same, with a shortcut ("Ctrl+S", "Ctrl+Shift+Z", "F5", "Delete"; "" for none), shown at
    // its right, that works even with its menu closed. A shortcut without Ctrl does nothing
    // while a text field has the keyboard, unless it is a function key.
    pub bool menu_item_with(str text, str shortcut, bool enabled) {
        if (menu_level == 0 || menu_level > 4) {
            return false;
        }
        canvas.Rect r = add_entry(text, shortcut, 0, enabled);
        if (!enabled) {
            return false;
        }
        if (menu_popups[menu_level - 1].open && contains(r, ui.mouse_x, ui.mouse_y)) {
            if (ui.released) {
                ui.close_menus(0);
                return true;
            }
            if (ui.pressed) {
                menu_pressed = true;
            }
        }
        if (shortcut.len == 0) {
            return false;
        }
        Shortcut s = parse_shortcut(shortcut);
        if (s.code == 0 || !s.ctrl && ui.editing && s.code < 0x4000003A) {
            return false;
        }
        for (usize i in 0..ui.edit_count) {
            Edit e = ui.edits[i];
            u64 bit = 1 << i as u64;
            if (e.key == s.code && e.ctrl == s.ctrl && e.shift == s.shift && keys_taken & bit == 0) {
                keys_taken = keys_taken | bit;
                ui.close_menus(0);
                return true;
            }
        }
        return false;
    }

    // A line between the items of a menu.
    pub void separator() {
        if (menu_level > 0 && menu_level <= 4) {
            add_entry("", "", 1, false);
        }
    }

    // Opens the description of a menu, at (x, y) when it is open, kept on the surface.
    void start_popup(i32 id, bool open, f32 x, f32 y) {
        usize level = menu_level;
        f32 w = max(ui.menu_w[level], 160.0);
        f32 left = max(min(x, surface.width as f32 - w), 0.0);
        f32 top = max(min(y, surface.height as f32 - ui.menu_h[level]), 0.0);
        menu_popups[level] = Popup{ id: id, open: open, level: level, x: left, y: top, w: w };
        menu_level += 1;
    }

    // An entry of the menu being described; its rectangle. The mouse over an item closes the
    // submenus open beside.
    canvas.Rect add_entry(str label, str key, u8 kind, bool enabled) {
        Popup* p = &menu_popups[menu_level - 1];
        f32 h = kind == 1 ? 9.0 : 28.0;
        canvas.Rect r = canvas.Rect{ x: p.x, y: p.y + 4.0 + p.h, w: p.w, h: h };
        if (p.count < 24) {
            p.labels[p.count] = label;
            p.keys[p.count] = key;
            p.kinds[p.count] = kind;
            p.enabled[p.count] = enabled;
            p.count += 1;
        }
        p.h += h;
        f32 key_w = key.len > 0 ? measure(key, 2).w + 32.0 : 0.0;
        p.widest = max(p.widest, measure(label, 2).w + key_w + (kind == 2 ? 24.0 : 0.0));
        if (p.open && kind != 2 && contains(r, ui.mouse_x, ui.mouse_y)) {
            ui.close_menus(menu_level);
        }
        return r;
    }

    // An open menu, over everything else.
    void draw_popup(Popup p) {
        canvas.Rect frame = canvas.Rect{ x: p.x, y: p.y, w: p.w, h: p.h + 8.0 };
        surface.fill(frame, canvas.Color{ r: 49, g: 50, b: 68 });
        surface.stroke(frame, face(true, false), 1.0);
        mut f32 y = p.y + 4.0;
        for (usize i in 0..p.count) {
            if (p.kinds[i] == 1) {
                surface.fill(canvas.Rect{ x: p.x + 8.0, y: y + 4.0, w: p.w - 16.0, h: 1.0 }, face(true, false));
                y += 9.0;
                continue;
            }
            canvas.Rect r = canvas.Rect{ x: p.x + 4.0, y: y, w: p.w - 8.0, h: 28.0 };
            bool open_beside = p.kinds[i] == 2 && p.level + 1 < 4 && ui.menus[p.level + 1] == p.submenus[i] && p.submenus[i] >= 0;
            if (p.enabled[i] && (contains(r, ui.mouse_x, ui.mouse_y) || open_beside)) {
                surface.fill(r, canvas.Color{ r: 137, g: 180, b: 250, a: 70 });
            }
            canvas.Color color = p.enabled[i] ? ink() : face(true, false);
            write(p.x + 12.0, y, 28.0, p.labels[i], color, 2);
            if (p.keys[i].len > 0) {
                f32 kw = measure(p.keys[i], 2).w;
                write(p.x + p.w - 12.0 - kw, y, 28.0, p.keys[i], face(true, false), 2);
            }
            if (p.kinds[i] == 2) {  // a chevron, pointing right
                i32 cx = (p.x + p.w - 16.0) as i32;
                i32 cy = (y + 14.0) as i32;
                surface.line(cx - 2, cy - 5, cx + 3, cy, ink());
                surface.line(cx + 3, cy, cx - 2, cy + 5, ink());
            }
            y += 28.0;
        }
    }

    // Closes the menus a click elsewhere, a right press elsewhere or Escape closes, or whose
    // menu was not described; draws those still open, and remembers them for the next frame.
    void finish_menus() {
        mut bool inside = false;
        mut bool first_shown = false;
        for (usize i in 0..shown_count) {
            Popup p = shown[i];
            inside = inside || contains(canvas.Rect{ x: p.x, y: p.y, w: p.w, h: p.h + 8.0 }, ui.mouse_x, ui.mouse_y);
            first_shown = first_shown || p.level == 0;
        }
        mut bool escape = false;
        for (usize i in 0..ui.edit_count) {
            escape = escape || ui.edits[i].key == 27;
        }
        if (ui.pressed && !menu_pressed && !inside || ui.right_pressed && !right_taken || escape || !first_shown) {
            ui.close_menus(0);
        }
        ui.popup_count = 0;
        for (usize level in 0..4) {
            for (usize i in 0..shown_count) {
                Popup p = shown[i];
                if (p.level == level && ui.menus[level] == p.id) {
                    draw_popup(p);
                    ui.popups[ui.popup_count] = canvas.Rect{ x: p.x, y: p.y, w: p.w, h: p.h + 8.0 };
                    ui.popup_count += 1;
                    ui.menu_w[level] = max(p.widest + 40.0, 160.0);
                    ui.menu_h[level] = p.h + 8.0;
                }
            }
        }
        ui.right_pressed = false;
        ui.editing = editing;
    }

    // The open list of a dropdown, over everything else.
    void draw_layer() {
        surface.fill(layer, face(false, false));
        for (usize i in 0..option_count) {
            canvas.Rect r = canvas.Rect{ x: layer.x, y: layer.y + i as f32 * height, w: layer.w, h: height };
            if (i as i32 == option_chosen) {
                surface.fill(r, canvas.Color{ r: 137, g: 180, b: 250, a: 70 });
            } else if (contains(r, ui.mouse_x, ui.mouse_y)) {
                surface.fill(r, canvas.Color{ r: 205, g: 214, b: 244, a: 18 });
            }
            write(r.x + 8.0, r.y, height, options[i], ink(), 2);
        }
        surface.stroke(layer, accent(), 2.0);
    }

    // Ends the frame: draws the layer above, and the input it used is consumed.
    pub void finish() {
        if (ui.pressed && !dropdown_pressed || ui.open != layer_owner) {
            ui.open = -1;  // a click elsewhere closes the dropdown, as does its disappearance
        }
        if (ui.open >= 0) {
            draw_layer();
            ui.layer = layer;
        } else {
            ui.layer = nowhere();
        }
        finish_menus();
        if (ui.released) {
            ui.active = -1;
        }
        if (ui.pressed && !focus_taken) {
            ui.focus = -1;  // a click elsewhere takes the keyboard away
        }
        ui.pressed = false;
        ui.released = false;
        ui.typed.len = 0;
        ui.edit_count = 0;
        ui.wheel = 0.0;
    }

    // The size of `text` at `scale`, in the font of `ui`, or else the built-in one.
    canvas.Rect measure(str text, i32 scale) {
        return match (ui.font) {
            some(f) => canvas.Rect{ x: 0.0, y: 0.0, w: f.measure(text, 9.0 * scale as f32), h: f.line_height(9.0 * scale as f32) },
            none => canvas.text_size(text, scale),
        };
    }

    // `text` at `scale`, from x, in the middle of a box `box` high from y.
    void write(f32 x, f32 y, f32 box, str text, canvas.Color color, i32 scale) {
        f32 top = y + (box - measure(text, scale).h) / 2.0;
        match (ui.font) {
            some(f) => {
                surface.text_with(f, 9.0 * scale as f32, x, top, text, color);
            },
            none => {
                surface.text(x, top, text, color, scale);
            },
        }
    }

    i32 take_id() {
        i32 id = next_id;
        next_id += 1;
        return id;
    }

    void open(bool horizontal, f32 gap, f32 padding) {
        if (depth == 15) {
            return;  // too deep: the widgets stay in the current layout
        }
        f32 x = layouts[depth].x + padding;
        f32 y = layouts[depth].y + padding;
        depth += 1;
        layouts[depth] = Layout{ horizontal: horizontal, x: x, y: y, left: x, top: y, right: x, bottom: y, gap: gap, padding: padding };
    }

    // The place of the next widget, of size `w` by `h`, in the current layout.
    canvas.Rect place(f32 w, f32 h) {
        Layout l = layouts[depth];
        canvas.Rect r = canvas.Rect{ x: l.x, y: l.y, w: w, h: h };
        layouts[depth].right = max(l.right, l.x + w);
        layouts[depth].bottom = max(l.bottom, l.y + h);
        if (l.horizontal) {
            layouts[depth].x += w + l.gap;
        } else {
            layouts[depth].y += h + l.gap;
        }
        if (l.list >= 0) {
            item_placed(l, r);
        }
        last = r;
        return r;
    }

    // A widget placed in a list is one of its items: it can be chosen, and is highlighted.
    void item_placed(Layout l, canvas.Rect r) {
        i32 index = l.item;
        layouts[depth].item += 1;
        canvas.Rect row = canvas.Rect{ x: l.frame.x, y: r.y, w: l.frame.w, h: r.h };
        bool inside = over(row) && over(l.frame);
        match (l.selected) {
            some(chosen) => {
                if (ui.pressed && inside) {
                    *chosen = index;
                }
                ListState* state = &ui.lists[l.list as usize];
                if (*chosen == index) {
                    surface.fill(row, canvas.Color{ r: 137, g: 180, b: 250, a: 70 });
                    if (state.reveal) {  // the item chosen with a key comes into view
                        f32 top = r.y - l.frame.y + state.scroll;
                        state.scroll = min(state.scroll, top);
                        state.scroll = max(state.scroll, top + r.h - l.frame.h);
                        state.reveal = false;
                    }
                } else if (inside) {
                    surface.fill(row, canvas.Color{ r: 205, g: 214, b: 244, a: 18 });
                }
            },
            none => { },
        }
    }

    // A list `width` by `height`: the widgets that follow, until `end_list()`, are its items,
    // one under the other, scrolled by the mouse wheel when they are higher than it. With
    // `selected`, a click chooses an item and gives the list the keyboard, Up and Down move
    // the choice, and the item chosen is highlighted.
    pub void list(f32 width, f32 height, i32*? selected) {
        i32 id = take_id();
        canvas.Rect r = place(width, height);
        interactive(r);
        usize slot = list_slot(id);
        ListState* state = &ui.lists[slot];
        if (ui.wheel != 0.0 && over(r)) {
            state.scroll -= ui.wheel * 40.0;
            ui.wheel = 0.0;
        }
        if (ui.pressed && over(r)) {
            ui.focus = id;
            focus_taken = true;
        }
        match (selected) {
            some(chosen) => {
                if (ui.focus == id) {
                    for (usize i in 0..ui.edit_count) {
                        u32 key = ui.edits[i].key;
                        if (key == key_up() || key == key_down()) {
                            *chosen = key == key_up() ? max(*chosen - 1, 0) : min(*chosen + 1, max(state.items - 1, 0));
                            state.reveal = true;
                        }
                    }
                }
            },
            none => { },
        }
        state.scroll = max(min(state.scroll, state.content - height), 0.0);
        surface.fill(r, well());
        surface.stroke(r, ui.focus == id ? accent() : face(false, false), 2.0);
        surface.push_clip(canvas.Rect{ x: r.x + 2.0, y: r.y + 2.0, w: r.w - 4.0, h: r.h - 4.0 });
        if (depth == 15) {
            return;
        }
        f32 top = r.y - state.scroll;
        depth += 1;
        layouts[depth] = Layout{ x: r.x + 8.0, y: top, left: r.x + 8.0, top: top, right: r.x + 8.0, bottom: top, gap: 0.0, list: slot as i32, frame: r, selected: selected };
    }

    pub void end_list() {
        Layout done = layouts[depth];
        if (done.list < 0) {
            return;  // not in a list
        }
        depth -= 1;
        ListState* state = &ui.lists[done.list as usize];
        state.content = done.bottom - done.top;
        state.items = done.item;
        surface.pop_clip();
        canvas.Rect r = done.frame;
        last = r;
        if (state.content > r.h) {  // a bar shows how far the list is scrolled
            f32 bar = max(r.h * r.h / state.content, 16.0);
            f32 y = r.y + (r.h - bar) * state.scroll / (state.content - r.h);
            surface.fill(canvas.Rect{ x: r.x + r.w - 6.0, y: y, w: 4.0, h: bar }, face(true, false));
        }
    }

    // The slot of `Ui.lists` of the list `id`: its own, or a free one.
    usize list_slot(i32 id) {
        for (usize i in 0..8) {
            if (ui.lists[i].id == id) {
                return i;
            }
        }
        for (usize i in 0..8) {
            if (ui.lists[i].id == -1) {
                ui.lists[i].id = id;
                return i;
            }
        }
        ui.lists[0] = ListState{ id: id };  // more than 8 lists: one forgets its scrolling
        return 0;
    }

    // The mouse is over `r`, and not over the open list of a dropdown, which is above it.
    bool over(canvas.Rect r) {
        return contains(r, ui.mouse_x, ui.mouse_y) && !ui.on_layer(ui.mouse_x, ui.mouse_y);
    }

    // Pressed then released over `r`, the press and the release maybe in the same frame.
    bool click(i32 id, canvas.Rect r) {
        if (ui.pressed && over(r)) {
            ui.active = id;
        }
        return ui.released && ui.active == id && over(r);
    }
}

// The widgets of a frame, from (x, y) downwards. End it with `finish()`.
pub Frame begin(Ui* ui, canvas.Canvas* surface, f32 x, f32 y) {
    mut Frame f = Frame{ ui: ui, surface: surface };
    f.layouts[0] = Layout{ x: x, y: y, left: x, top: y, right: x, bottom: y };
    return f;
}

test "text buffer" {
    mut TextBuffer t = TextBuffer{ };
    t.set("h\u{e9}llo");
    assert(t.len == 6 && t.count() == 5);
    t.erase_last();
    t.erase_last();
    t.erase_last();
    assert(t.text().len == 3 && t.count() == 2);  // "hé": é takes 2 bytes
    t.erase_last();
    assert(t.text().len == 1);
    t.set("abcdef");
    assert(t.tail(2).len == 2 && t.tail(10).len == 6);
}

test "a button is clicked by a press and a release over it" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 200, 100);
    mut Ui ui = Ui{ };
    ui.mouse_move(20.0, 20.0);
    ui.mouse_button(true);
    mut Frame f = begin(&ui, &surface, 10.0, 10.0);
    assert(!f.button("OK"));
    f.finish();
    assert(ui.active == 0);
    ui.mouse_button(false);
    f = begin(&ui, &surface, 10.0, 10.0);
    assert(f.button("OK"));
    f.finish();
    assert(ui.active == -1);
    assert(surface.at(12, 12) != 0);  // drawn

    // pressed elsewhere, released over it: not a click
    ui.mouse_move(150.0, 90.0);
    ui.mouse_button(true);
    f = begin(&ui, &surface, 10.0, 10.0);
    assert(!f.button("OK"));
    f.finish();
    ui.mouse_move(20.0, 20.0);
    ui.mouse_button(false);
    f = begin(&ui, &surface, 10.0, 10.0);
    assert(!f.button("OK"));
    f.finish();
}

test "a text field takes the keyboard when clicked" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 300, 100);
    mut Ui ui = Ui{ };
    mut TextBuffer name = TextBuffer{ };
    mut bool done = false;

    ui.type_text("lost");  // no field has the focus yet
    mut Frame f = begin(&ui, &surface, 0.0, 0.0);
    f.text_field(&name, 200.0);
    f.finish();
    assert(name.len == 0);

    ui.mouse_move(10.0, 10.0);
    ui.mouse_button(true);
    ui.mouse_button(false);
    ui.type_text("Ada");
    ui.key(8, true, false, false);
    ui.key(13, true, false, false);
    f = begin(&ui, &surface, 0.0, 0.0);
    assert(f.text_field(&name, 200.0));  // Enter
    f.finish();
    assert(name.len == 2 && ui.focus == 0);

    // a click elsewhere takes the focus away; the checkbox is the second widget
    ui.mouse_move(20.0, 50.0);
    ui.mouse_button(true);
    ui.mouse_button(false);
    f = begin(&ui, &surface, 0.0, 0.0);
    f.text_field(&name, 200.0);
    assert(f.checkbox("Done", &done) && done);
    f.finish();
    assert(ui.focus == -1);
}

test "layouts nest" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 300, 200);
    mut Ui ui = Ui{ };
    mut Frame f = begin(&ui, &surface, 10.0, 10.0);
    f.row_with(4.0, 0.0);
    f.column(2.0, 0.0);
    canvas.Rect a = f.place(16.0, 32.0);
    canvas.Rect b = f.place(20.0, 32.0);
    f.end();  // the column: 20 wide, 66 high
    canvas.Rect c = f.place(10.0, 10.0);
    f.end();
    canvas.Rect d = f.place(10.0, 10.0);
    assert(a.x == 10.0 && a.y == 10.0 && b.x == 10.0 && b.y == 44.0);
    assert(c.x == 34.0 && c.y == 10.0);
    assert(d.x == 10.0 && d.y == 84.0);

    f.column(0.0, 5.0);  // padding on every side
    canvas.Rect e = f.place(10.0, 10.0);
    f.end();
    canvas.Rect g = f.place(10.0, 10.0);
    assert(e.x == 15.0 && e.y == 107.0 && g.y == 130.0);  // the column, 20 high, starts at 102
    f.end();  // nothing open: ignored
    f.finish();
}

test "a disabled button is never clicked" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 200, 100);
    mut Ui ui = Ui{ };
    ui.mouse_move(20.0, 20.0);
    ui.mouse_button(true);
    ui.mouse_button(false);
    mut Frame f = begin(&ui, &surface, 10.0, 10.0);
    assert(!f.button_enabled("OK", false));
    f.finish();
}

test "the widgets use the font of ui" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 300, 100);
    mut Ui ui = Ui{ };
    truetype.Font* noto = match (truetype.load(&arena, "packages/render/fonts/NotoSans-Regular.ttf")) {
        ok(f) => f,
        err(e) => {
            assert(false);
            return;
        },
    };
    defer noto.close();
    mut Frame f = begin(&ui, &surface, 0.0, 0.0);
    canvas.Rect bitmap = f.measure("iiii", 2);  // 8 by 8: every character as wide
    ui.font = some(noto);
    canvas.Rect proportional = f.measure("iiii", 2);
    assert(proportional.w < bitmap.w / 2.0);
    f.label("Hello");
    mut u32 drawn = 0;
    for (mut i32 y = 0; y < 32; y += 1) {
        for (mut i32 x = 0; x < 60; x += 1) {
            drawn += surface.at(x, y) != 0 ? 1 : 0;
        }
    }
    assert(drawn > 50);
    f.finish();
}

// Runs one frame with a text field 200 pixels wide at (0, 0), and the input given so far.
bool field_frame(Ui* ui, canvas.Canvas* surface, TextBuffer* text, Format format) {
    mut Frame f = begin(ui, surface, 0.0, 0.0);
    bool entered = f.text_field_with(text, 200.0, format);
    f.finish();
    return entered;
}

void press(Ui* ui, u32 key, bool shift, bool ctrl) {
    ui.key(key, true, shift, ctrl);
    ui.key(key, false, shift, ctrl);  // released keys are ignored
}

test "editing a text field" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 300, 100);
    mut Ui ui = Ui{ };
    mut TextBuffer t = TextBuffer{ };
    Format any = Format{ };
    // a click gives the keyboard; typing, moving and typing again, in order
    ui.mouse_move(10.0, 10.0);
    ui.mouse_button(true);
    ui.mouse_button(false);
    ui.type_text("held");
    press(&ui, key_left(), false, false);
    press(&ui, key_left(), false, false);
    ui.type_text("\u{e9}");
    field_frame(&ui, &surface, &t, any);
    assert(t.text().len == 6 && ui.cursor == 4);  // "heéld": é is 2 bytes
    // Shift+Home selects to the start, typing replaces the selection
    press(&ui, key_home(), true, false);
    ui.type_text("W");
    field_frame(&ui, &surface, &t, any);
    assert(t.len == 3 && t.bytes[0] == 87 && ui.cursor == 1);  // "Wld"
    // Backspace and Delete, with and without a selection
    press(&ui, key_delete(), false, false);
    press(&ui, key_end(), false, false);
    press(&ui, key_backspace(), false, false);
    field_frame(&ui, &surface, &t, any);
    assert(t.len == 1 && ui.cursor == 1);  // "W"
    ui.type_text("orld");
    press(&ui, 97, false, true);  // Ctrl+A
    press(&ui, 99, false, true);  // Ctrl+C
    press(&ui, key_right(), false, false);  // the selection ends: the cursor at its end
    field_frame(&ui, &surface, &t, any);
    assert(t.len == 5 && ui.cursor == 5 && ui.anchor == 5);
    bool copied = match (ui.take_copied()) {
        some(text) => text.len == 5,
        none => false,
    };
    assert(copied && !ui.has_copied);
    press(&ui, key_left(), true, false);
    press(&ui, key_left(), true, false);
    press(&ui, 120, false, true);  // Ctrl+X: "ld"
    press(&ui, key_enter(), false, false);
    assert(field_frame(&ui, &surface, &t, any));
    assert(t.len == 3 && ui.copied.len == 2);  // "Wor"
}

test "the mouse places the cursor and selects" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 300, 100);
    mut Ui ui = Ui{ };
    mut TextBuffer t = TextBuffer{ };
    t.set("abcdef");  // the built-in font: 16 pixels per character, from x = 8
    ui.mouse_move(8.0 + 2.0 * 16.0 + 3.0, 10.0);  // nearer to the boundary after `b`
    ui.mouse_button(true);
    field_frame(&ui, &surface, &t, Format{ });
    assert(ui.cursor == 2 && ui.anchor == 2);
    ui.mouse_move(8.0 + 5.0 * 16.0 - 2.0, 10.0);  // dragging, the button still held
    field_frame(&ui, &surface, &t, Format{ });
    assert(ui.cursor == 5 && ui.anchor == 2);
    ui.mouse_button(false);
    field_frame(&ui, &surface, &t, Format{ });
    assert(ui.active == -1 && ui.focus == 0);
}

test "formats" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 300, 100);
    mut Ui ui = Ui{ };
    ui.mouse_move(10.0, 10.0);
    ui.mouse_button(true);
    ui.mouse_button(false);

    mut TextBuffer digits = TextBuffer{ };
    ui.type_text("a1-2.3 4");
    field_frame(&ui, &surface, &digits, Format{ accept: Digits, max: 3 });
    assert(digits.len == 3 && digits.bytes[0] == 49 && digits.bytes[2] == 51);  // "123"

    mut TextBuffer integer = TextBuffer{ };
    ui.type_text("-12-3");
    field_frame(&ui, &surface, &integer, Format{ accept: Integer });
    assert(integer.len == 4);  // "-123": the second `-` is refused

    mut TextBuffer decimal = TextBuffer{ };
    ui.type_text("3,14.15");
    field_frame(&ui, &surface, &decimal, Format{ accept: Decimal });
    assert(decimal.len == 6 && decimal.bytes[1] == 44);  // "3,1415": one separator

    mut TextBuffer date = TextBuffer{ };
    ui.type_text("2512x2026/7");
    field_frame(&ui, &surface, &date, Format{ mask: "99/99/9999" });
    assert(date.len == 10 && date.bytes[2] == 47 && date.bytes[5] == 47);  // "25/12/2026"

    mut TextBuffer code = TextBuffer{ };
    ui.type_text("ab12");
    field_frame(&ui, &surface, &code, Format{ mask: "AA-99" });
    assert(code.len == 5 && code.bytes[2] == 45);  // "ab-12"
}

// A list 200 by 100 at (0, 0), of 20 labels 32 high: 640 of content.
void list_frame(Ui* ui, canvas.Canvas* surface, i32* chosen) {
    mut Frame f = begin(ui, surface, 0.0, 0.0);
    f.list(200.0, 100.0, some(chosen));
    for (i32 i in 0..20) {
        f.label("item");
    }
    f.end_list();
    f.finish();
}

test "lists scroll and choose" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 300, 200);
    mut Ui ui = Ui{ };
    mut i32 chosen = -1;
    list_frame(&ui, &surface, &chosen);
    assert(ui.lists[0].content == 640.0 && ui.lists[0].items == 20);

    ui.mouse_move(50.0, 40.0);  // the second item (32 to 64)
    ui.mouse_button(true);
    ui.mouse_button(false);
    list_frame(&ui, &surface, &chosen);
    assert(chosen == 1 && ui.focus == 0);

    ui.scroll_wheel(-2.0);  // towards the user: down, 80 pixels
    list_frame(&ui, &surface, &chosen);
    assert(ui.lists[0].scroll == 80.0);
    ui.scroll_wheel(-100.0);  // no further than the end
    list_frame(&ui, &surface, &chosen);
    list_frame(&ui, &surface, &chosen);
    assert(ui.lists[0].scroll == 540.0);
    ui.mouse_move(250.0, 40.0);  // outside: the wheel does nothing
    ui.scroll_wheel(5.0);
    list_frame(&ui, &surface, &chosen);
    assert(ui.lists[0].scroll == 540.0);

    // Up and Down move the choice; the item chosen comes into view
    ui.key(key_down(), true, false, false);
    ui.key(key_up(), true, false, false);
    ui.key(key_up(), true, false, false);
    list_frame(&ui, &surface, &chosen);
    list_frame(&ui, &surface, &chosen);
    assert(chosen == 0 && ui.lists[0].scroll == 0.0);
    for (i32 i in 0..30) {
        ui.key(key_down(), true, false, false);
    }
    list_frame(&ui, &surface, &chosen);
    list_frame(&ui, &surface, &chosen);
    assert(chosen == 19 && ui.lists[0].scroll == 540.0);
}

// A title bar 40 high holding a label and a button, then a label under it. Returns whether
// the button was clicked.
bool bar_frame(Ui* ui, canvas.Canvas* surface) {
    mut Frame f = begin(ui, surface, 0.0, 0.0);
    f.title_bar(40.0, 8.0, 4.0);
    f.label("App");  // built-in font: 48 wide, from x 4
    bool run = f.button("Run");  // x 60 to 140
    f.end_title_bar();
    f.label("under");
    f.finish();
    return run;
}

void click_at(Ui* ui, f32 x, f32 y) {
    ui.mouse_move(x, y);
    ui.mouse_button(true);
    ui.mouse_button(false);
}

test "a title bar drags the window, except on its widgets and buttons" {
    mut Arena arena = Arena.new(512 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 400, 200);
    mut Ui ui = Ui{ };
    bar_frame(&ui, &surface);
    assert(!ui.is_drag_area(200.0, 20.0));  // the system kept its title bar: a tool bar
    assert(ui.bar_buttons.w == 0.0);

    ui.custom_title_bar = true;
    bar_frame(&ui, &surface);
    assert(ui.is_drag_area(200.0, 20.0));  // empty space
    assert(ui.is_drag_area(10.0, 20.0));  // the label
    assert(!ui.is_drag_area(100.0, 20.0));  // the button
    assert(!ui.is_drag_area(300.0, 20.0));  // the window buttons: x 262 to 400
    assert(!ui.is_drag_area(200.0, 60.0));  // under the bar
    assert(surface.at(1, 1) != 0);  // drawn

    click_at(&ui, 100.0, 20.0);
    assert(bar_frame(&ui, &surface));
    match (ui.take_window_request()) {
        some(r) => assert(false),
        none => { },
    }
    // the window buttons: minimize, maximize, close, 46 wide each
    for (i32 i in 0..3) {
        click_at(&ui, 262.0 + 46.0 * i as f32 + 20.0, 20.0);
        bar_frame(&ui, &surface);
        mut i32 asked = -1;
        match (ui.take_window_request()) {
            some(r) => {
                asked = match (r) {
                    Minimize => 0,
                    ToggleMaximize => 1,
                    Close => 2,
                };
            },
            none => { },
        }
        assert(asked == i);
    }
    match (ui.take_window_request()) {  // given once
        some(r) => assert(false),
        none => { },
    }
}

// A dropdown of three options at the top, and a button under it (y 40 to 72), which its open
// list (y 32 to 128) covers. Returns whether the button was clicked.
bool dropdown_frame(Ui* ui, canvas.Canvas* surface, i32* choice) {
    mut Frame f = begin(ui, surface, 0.0, 0.0);
    f.dropdown(160.0);
    for (i32 i in 0..3) {
        str text = i == 0 ? "Debug" : i == 1 ? "Release" : "Profile";
        if (f.option(text, *choice == i) && *choice != i) {
            *choice = i;
        }
    }
    f.end_dropdown();
    bool under = f.button("Under");
    f.finish();
    return under;
}

test "a dropdown opens above the rest, chooses and closes" {
    mut Arena arena = Arena.new(512 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 400, 200);
    mut Ui ui = Ui{ };
    mut i32 choice = 1;
    dropdown_frame(&ui, &surface, &choice);
    assert(ui.open == -1 && ui.layer.h == 0.0);

    click_at(&ui, 20.0, 10.0);  // the box opens the list
    dropdown_frame(&ui, &surface, &choice);
    assert(ui.open == 0 && ui.layer.y == 32.0 && ui.layer.h == 96.0);

    // the first option, over the button: the option takes the click, and the list closes
    click_at(&ui, 20.0, 50.0);
    assert(!dropdown_frame(&ui, &surface, &choice));
    assert(choice == 0 && ui.open == -1);
    dropdown_frame(&ui, &surface, &choice);
    assert(ui.layer.h == 0.0);
    click_at(&ui, 20.0, 50.0);  // closed: the button gets the click
    assert(dropdown_frame(&ui, &surface, &choice));

    click_at(&ui, 20.0, 10.0);  // a click elsewhere closes it without choosing
    dropdown_frame(&ui, &surface, &choice);
    click_at(&ui, 300.0, 150.0);
    dropdown_frame(&ui, &surface, &choice);
    assert(ui.open == -1 && choice == 0);

    click_at(&ui, 20.0, 10.0);  // and Escape
    dropdown_frame(&ui, &surface, &choice);
    ui.key(27, true, false, false);
    dropdown_frame(&ui, &surface, &choice);
    assert(ui.open == -1 && choice == 0);
}

test "an image is placed as a widget, centered in a row" {
    mut Arena arena = Arena.new(256 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 200, 100);
    mut Ui ui = Ui{ };
    mut u32[] pixels = arena.alloc_slice(u32, 8);
    for (usize i in 0..8) {
        pixels[i] = 0xFFFF0000;
    }
    image.Image img = image.Image{ width: 4, height: 2, pixels: pixels };  // twice as wide as high
    mut Frame f = begin(&ui, &surface, 0.0, 0.0);
    f.image(img, 0.0);  // its own size: 4 by 2, at (0, 0)
    f.row();
    f.image(img, 10.0);  // 20 by 10, centered in a row 32 high, at y 10 + 11
    f.label("x");
    f.end_row();
    f.finish();
    assert(surface.at(3, 1) == 0xFFFF0000 && surface.at(4, 1) == 0);
    assert(surface.at(19, 21) == 0xFFFF0000 && surface.at(19, 20) == 0 && surface.at(19, 31) == 0);
}

// A bar with File (New, a separator, Recent > a.sosu, Quit disabled) and Edit (Undo), then a
// button under it. Each bit of the result is something clicked: 1 New, 2 a.sosu, 4 Quit,
// 8 Undo, 16 the button.
i32 menu_frame(Ui* ui, canvas.Canvas* surface) {
    mut i32 clicked = 0;
    mut Frame f = begin(ui, surface, 0.0, 0.0);
    f.menu_bar();
    f.menu("File");  // the built-in font: x 0 to 88; its menu x 0 to 216 (New and Ctrl+N), y 32 to 133
    if (f.menu_item_with("New", "Ctrl+N", true)) {  // y 36 to 64
        clicked += 1;
    }
    f.separator();  // 64 to 73
    f.menu("Recent");  // 73 to 101; its menu from x 212, y 69
    if (f.menu_item("a.sosu")) {  // y 73 to 101
        clicked += 2;
    }
    f.end_menu();
    if (f.menu_item_with("Quit", "Ctrl+Q", false)) {  // 101 to 129
        clicked += 4;
    }
    f.end_menu();
    f.menu("Edit");  // x 88 to 176
    if (f.menu_item_with("Undo", "Ctrl+Z", true)) {
        clicked += 8;
    }
    f.end_menu();
    f.end_menu_bar();
    if (f.button("Under")) {  // y 40 to 72
        clicked += 16;
    }
    f.finish();
    return clicked;
}

test "menus of a bar: open, switch, submenus, items and shortcuts" {
    mut Arena arena = Arena.new(512 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 400, 300);
    mut Ui ui = Ui{ };
    assert(menu_frame(&ui, &surface) == 0 && ui.menus[0] == -1);

    click_at(&ui, 20.0, 10.0);  // File opens
    assert(menu_frame(&ui, &surface) == 0 && ui.menus[0] == 0 && ui.popup_count == 1);
    ui.mouse_move(120.0, 10.0);  // over Edit, File open: Edit opens instead
    menu_frame(&ui, &surface);
    assert(ui.menus[0] == 2);
    click_at(&ui, 120.0, 10.0);  // a click on the title of the menu open closes it
    menu_frame(&ui, &surface);
    assert(ui.menus[0] == -1);

    click_at(&ui, 20.0, 10.0);
    menu_frame(&ui, &surface);
    ui.mouse_move(20.0, 85.0);  // over Recent: its submenu opens
    menu_frame(&ui, &surface);
    assert(ui.menus[1] == 1 && ui.popup_count == 2);
    ui.mouse_move(20.0, 50.0);  // over New: it closes
    menu_frame(&ui, &surface);
    assert(ui.menus[1] == -1 && ui.menus[0] == 0);
    ui.mouse_move(20.0, 85.0);
    menu_frame(&ui, &surface);
    click_at(&ui, 300.0, 85.0);  // a.sosu, in the submenu: everything closes
    assert(menu_frame(&ui, &surface) == 2 && ui.menus[0] == -1);

    click_at(&ui, 20.0, 10.0);
    menu_frame(&ui, &surface);
    click_at(&ui, 20.0, 115.0);  // Quit, disabled: nothing, the menu stays open
    assert(menu_frame(&ui, &surface) == 0 && ui.menus[0] == 0);
    click_at(&ui, 20.0, 50.0);  // New, over the button: the menu takes the click
    assert(menu_frame(&ui, &surface) == 1 && ui.menus[0] == -1);
    click_at(&ui, 20.0, 50.0);  // closed: the button gets it
    assert(menu_frame(&ui, &surface) == 16);

    ui.key(110, true, false, true);  // Ctrl+N, the menu closed
    assert(menu_frame(&ui, &surface) == 1);
    ui.key(113, true, false, true);  // Ctrl+Q: Quit is disabled
    ui.key(122, true, true, true);  // Ctrl+Shift+Z is not Ctrl+Z
    assert(menu_frame(&ui, &surface) == 0);
    ui.key(122, true, false, true);
    assert(menu_frame(&ui, &surface) == 8);
    ui.key(110, true, false, true);  // Ctrl+N once, Ctrl+Z twice: each press, once
    ui.key(122, true, false, true);
    ui.key(122, true, false, true);
    assert(menu_frame(&ui, &surface) == 9);

    click_at(&ui, 20.0, 10.0);  // Escape closes
    menu_frame(&ui, &surface);
    ui.key(27, true, false, false);
    menu_frame(&ui, &surface);
    assert(ui.menus[0] == -1 && ui.popup_count == 0);
}

// A list of two items, the first with its own context menu (Open), then the context menu of
// the list (Rename, Delete), and a text field. 1 Open, 2 Rename, 4 Delete.
i32 context_frame(Ui* ui, canvas.Canvas* surface, TextBuffer* text) {
    mut i32 clicked = 0;
    mut Frame f = begin(ui, surface, 0.0, 0.0);
    f.list(200.0, 120.0, none);  // y 0 to 120, the items from y 0, 32 high
    f.label("first");
    f.context_menu();
    if (f.menu_item("Open")) {
        clicked += 1;
    }
    f.end_context_menu();
    f.label("second");
    f.end_list();
    f.context_menu();
    if (f.menu_item_with("Rename", "F2", true)) {
        clicked += 2;
    }
    if (f.menu_item_with("Delete", "Delete", true)) {
        clicked += 4;
    }
    f.end_context_menu();
    f.text_field(text, 200.0);  // y 128 to 160
    f.finish();
    return clicked;
}

test "context menus open under the mouse, the innermost first" {
    mut Arena arena = Arena.new(512 * KB);
    defer arena.free();
    mut canvas.Canvas surface = canvas.create(&arena, 400, 300);
    mut Ui ui = Ui{ };
    mut TextBuffer text = TextBuffer{ };
    ui.mouse_move(50.0, 90.0);  // in the list, under its items
    ui.right_button(true);
    ui.right_button(false);
    context_frame(&ui, &surface, &text);
    assert(ui.menus[0] == 2 && ui.context_x == 50.0 && ui.context_y == 90.0);
    click_at(&ui, 60.0, 108.0);  // Rename: y 94 to 122
    assert(context_frame(&ui, &surface, &text) == 2 && ui.menus[0] == -1);

    ui.mouse_move(30.0, 10.0);  // on the first item: its own menu
    ui.right_button(true);
    context_frame(&ui, &surface, &text);
    assert(ui.menus[0] == 1);  // the list is widget 0
    ui.mouse_move(300.0, 250.0);  // a right press elsewhere closes it
    ui.right_button(true);
    context_frame(&ui, &surface, &text);
    assert(ui.menus[0] == -1);

    ui.key(key_delete(), true, false, false);  // the shortcut Delete
    assert(context_frame(&ui, &surface, &text) == 4);
    click_at(&ui, 20.0, 140.0);  // the text field takes the keyboard
    context_frame(&ui, &surface, &text);
    ui.key(key_delete(), true, false, false);  // now Delete edits the text
    ui.key(0x4000003B, true, false, false);  // F2 still works
    assert(context_frame(&ui, &surface, &text) == 2);
}
