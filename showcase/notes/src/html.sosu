// notes.html: renders the tree to HTML. The program draws the tree itself; this form exists
// to compare the parser with the examples of the CommonMark specification.
import std.text;
import std.vec;
import notes.cm;

pub class Out {
    Arena* arena;
    vec.Vec<cm.Node>* nodes;
    mut text.TextBuilder* b;
    mut bool nl;
    mut i32 alt;

    void init(keeps Arena* arena, keeps vec.Vec<cm.Node>* nodes) {
        self.arena = arena;
        self.nodes = nodes;
        b = text.builder(arena);
        nl = true;
        alt = 0;
    }

    cm.Node* at(i32 id) {
        return nodes.at(id as usize);
    }

    void lit(str s) {
        if (s.len > 0) {
            b.push(s);
            nl = cm.ch(s, s.len - 1) == 10;
        }
    }

    void tag(str s) {
        if (alt == 0) {
            lit(s);
        }
    }

    void cr() {
        if (!nl) {
            lit("\n");
        }
    }

    void esc(str s) {
        mut usize start = 0;
        for (usize i in 0..s.len) {
            i32 c = cm.ch(s, i);
            mut str rep = "";
            if (c == 38) {
                rep = "&amp;";
            } else if (c == 60) {
                rep = "&lt;";
            } else if (c == 62) {
                rep = "&gt;";
            } else if (c == 34) {
                rep = "&quot;";
            }
            if (rep.len > 0) {
                lit(text.slice(s, start, i));
                lit(rep);
                start = i + 1;
            }
        }
        lit(text.slice(s, start, s.len));
    }

    str url(str s) {
        text.TextBuilder* o = text.builder(arena);
        mut usize i = 0;
        while (i < s.len) {
            i32 c = cm.ch(s, i);
            bool safe = cm.is_alnum(c) || c == 59 || c == 44 || c == 47 || c == 63 || c == 58 || c == 64 || c == 38 || c == 61 || c == 43 || c == 36 || c == 45 || c == 95 || c == 46 || c == 33 || c == 126 || c == 42 || c == 39 || c == 40 || c == 41 || c == 35;
            if (c == 37 && cm.hexval(cm.ch(s, i + 1)) >= 0 && cm.hexval(cm.ch(s, i + 2)) >= 0) {
                o.push("%");
            } else if (safe) {
                o.push(text.slice(s, i, i + 1));
            } else {
                o.push("%");
                str hex = "0123456789ABCDEF";
                o.push(text.slice(hex, (c / 16) as usize, (c / 16) as usize + 1));
                o.push(text.slice(hex, (c % 16) as usize, (c % 16) as usize + 1));
            }
            i += 1;
        }
        return o.text();
    }

    void children(i32 id) {
        mut i32 c = at(id).first;
        while (c >= 0) {
            node(c);
            c = at(c).next;
        }
    }

    void titled(i32 id) {
        if (at(id).title.len > 0) {
            lit(" title=\"");
            esc(at(id).title);
            lit("\"");
        }
    }

    bool in_tight(i32 id) {
        i32 p = at(id).parent;
        if (p < 0 || at(p).kind != Item) {
            return false;
        }
        i32 g = at(p).parent;
        return g >= 0 && at(g).tight;
    }

    pub str result() {
        return b.text();
    }

    pub void node(i32 id) {
        cm.Kind k = at(id).kind;
        match (k) {
            Document => {
                children(id);
            },
            BlockQuote => {
                cr();
                lit("<blockquote>\n");
                children(id);
                cr();
                lit("</blockquote>\n");
            },
            List => {
                cr();
                if (at(id).ordered) {
                    if (at(id).level != 1) {
                        lit("<ol start=\"");
                        lit(text.format_i64(arena, at(id).level as i64));
                        lit("\">\n");
                    } else {
                        lit("<ol>\n");
                    }
                } else {
                    lit("<ul>\n");
                }
                children(id);
                cr();
                lit(at(id).ordered ? "</ol>\n" : "</ul>\n");
            },
            Item => {
                lit("<li>");
                children(id);
                lit("</li>\n");
            },
            Paragraph => {
                if (in_tight(id)) {
                    children(id);
                } else {
                    cr();
                    lit("<p>");
                    children(id);
                    lit("</p>\n");
                }
            },
            Heading => {
                cr();
                lit(cm.cat(arena, "<h", cm.cat(arena, text.format_i64(arena, at(id).level as i64), ">")));
                children(id);
                lit(cm.cat(arena, "</h", cm.cat(arena, text.format_i64(arena, at(id).level as i64), ">\n")));
            },
            CodeBlock => {
                cr();
                str lang = at(id).info;
                mut usize e = 0;
                while (e < lang.len && !cm.is_ws(cm.ch(lang, e))) {
                    e += 1;
                }
                if (e > 0) {
                    lit("<pre><code class=\"language-");
                    esc(text.slice(lang, 0, e));
                    lit("\">");
                } else {
                    lit("<pre><code>");
                }
                esc(at(id).lit);
                lit("</code></pre>\n");
            },
            HtmlBlock => {
                cr();
                lit(at(id).lit);
                cr();
            },
            ThematicBreak => {
                cr();
                lit("<hr />\n");
            },
            Text => {
                esc(at(id).lit);
            },
            SoftBreak => {
                lit("\n");
            },
            HardBreak => {
                tag("<br />");
                lit("\n");
            },
            Code => {
                tag("<code>");
                esc(at(id).lit);
                tag("</code>");
            },
            Emph => {
                tag("<em>");
                children(id);
                tag("</em>");
            },
            Strong => {
                tag("<strong>");
                children(id);
                tag("</strong>");
            },
            Link => {
                if (alt == 0) {
                    lit("<a href=\"");
                    esc(url(at(id).dest));
                    lit("\"");
                    titled(id);
                    lit(">");
                }
                children(id);
                tag("</a>");
            },
            Image => {
                if (alt == 0) {
                    lit("<img src=\"");
                    esc(url(at(id).dest));
                    lit("\" alt=\"");
                }
                alt += 1;
                children(id);
                alt -= 1;
                if (alt == 0) {
                    lit("\"");
                    titled(id);
                    lit(" />");
                }
            },
            HtmlInline => {
                lit(at(id).lit);
            },
            _ => {
                children(id);
            },
        }
    }
}
