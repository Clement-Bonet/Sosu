// notes.model: a folder of `.md` files, with groups (its subfolders), a directory of the links
// between notes, and the font. The state of the window, and what its buttons do. The interface is
// in screen.ui.sosu; the preview is drawn by main.sosu.
import std.fs;
import std.io;
import std.text;
import std.vec;
import platform.dialogs;
import ui.widgets;
import notes.md;

pub i64 SAVE_AFTER_MS = 700;  // the text has not changed for this long: it is saved
pub ui32 FOLDER_TAG = 1;  // the tag of the dialog that chooses the folder
pub i32 FAMILIES = 3;  // the families that come with the program
pub i32 MAX_DEPTH = 8;  // the groups in groups
pub str LOCATION = "notes-folder.txt";  // the folder chosen last, read at the next start

// A note or a group, by its path in the folder (`Projects/Plan`, without `.md`).
pub struct Entry {
    pub usize at = 0;
    pub usize len = 0;
    pub bool folder = false;
}

pub class Notes {
    pub mut widgets.TextBuffer dir;
    pub mut widgets.TextBuffer search;
    pub mut widgets.TextBuffer title;  // the path of the note open, editable: Enter renames or moves
    pub mut widgets.TextBuffer message;
    pub mut widgets.TextBuffer current;  // the path of the note open
    pub mut widgets.TextBuffer group;  // where a new note or group goes
    pub mut widgets.TextBuffer label;
    pub mut widgets.TextBuffer ren_name;  // the new path of the row being renamed (F2, or the menu)
    pub mut bool renaming;
    mut widgets.TextBuffer ren_from;  // the path it has now
    mut bool ren_group;
    pub mut vec.Vec<i32>* view;  // the rows shown: the entries that match the search, in order
    pub mut i32 chosen;  // the row of `view`, -1: none
    pub mut i32 shown;  // the row that is open
    pub mut bool open;
    pub mut widgets.LongText doc;
    pub mut widgets.LongText backlist;  // the notes that link to the one open, a path per line
    pub mut i32 back_count;
    pub mut widgets.LongText sugg;  // the notes that complete a link being typed, a path per line
    pub mut i32 sugg_count;
    pub mut bool preview;
    pub mut f32 edit_w;  // the width and the rows of the editor, set by main from the window
    pub mut i32 edit_rows;
    pub mut i64 now;
    pub mut widgets.TextBuffer font_label;
    pub mut bool font_dirty;  // main must load the font again
    mut i32 font_at;  // in `font_entries`, -1: the font of the program
    mut widgets.LongText shut;  // the groups folded in the tree, a path per line
    mut widgets.LongText pool;  // the paths of the entries, one after the other
    mut vec.Vec<Entry>* entries;
    mut widgets.LongText links;  // the directory: `source<TAB>target` rows
    mut widgets.LongText font_pool;
    mut vec.Vec<Entry>* font_entries;
    mut ui64 saved_hash;
    mut ui64 seen_hash;
    mut i64 changed_at;
    mut widgets.TextBuffer seen_search;
    mut Arena* arena;

    void init(Arena* arena, str folder) uses io {
        self.arena = arena;
        dir = widgets.TextBuffer{ };
        dir.set(folder);
        search = widgets.TextBuffer{ };
        title = widgets.TextBuffer{ };
        message = widgets.TextBuffer{ };
        current = widgets.TextBuffer{ };
        group = widgets.TextBuffer{ };
        label = widgets.TextBuffer{ };
        ren_name = widgets.TextBuffer{ };
        ren_from = widgets.TextBuffer{ };
        renaming = false;
        ren_group = false;
        seen_search = widgets.TextBuffer{ };
        font_label = widgets.TextBuffer{ };
        view = vec.new<i32>(arena);
        entries = vec.new<Entry>(arena);
        font_entries = vec.new<Entry>(arena);
        pool = widgets.long_text();
        shut = widgets.long_text();
        links = widgets.long_text();
        font_pool = widgets.long_text();
        doc = widgets.long_text();
        backlist = widgets.long_text();
        back_count = 0;
        sugg = widgets.long_text();
        sugg_count = 0;
        chosen = -1;
        shown = -1;
        open = false;
        preview = true;
        edit_w = 400.0;
        edit_rows = 20;
        now = 0;
        saved_hash = 0;
        seen_hash = 0;
        changed_at = 0;
        font_at = -1;
        font_dirty = true;
        scan();
        load_index();
        rebuild();
        scan_fonts();
        load_settings();
        select_font(font_at);
        if (view.len() > 0) {
            chosen = 0;
        }
    }

    pub void free() {
        doc.free();
        pool.free();
        shut.free();
        links.free();
        font_pool.free();
        backlist.free();
        sugg.free();
    }

    pub void say(str text) {
        message.set(text);
    }

    ui64 hash_of(str text) {
        mut ui64 h = 14695981039346656037 as ui64;
        for (ui8 b in text.bytes) {
            h = wrapping_mul(h ^ b as ui64, 1099511628211 as ui64);
        }
        return h;
    }

    str path_of(Arena* scratch, str rel) {
        return fs.join(scratch, dir.text(), md.file_of(scratch, rel));
    }

    str hidden(Arena* scratch, str file) {
        return fs.join(scratch, dir.text(), file);
    }

    // ---- The folder: notes and groups ----

    void add_entry(vec.Vec<Entry>* list, widgets.LongText* store, str path, bool folder) {
        usize at = store.text().len;
        if (store.insert(at, path)) {
            list.push(Entry{ at: at, len: path.len, folder: folder });
        }
    }

    str entry_path(i32 i) {
        Entry e = *entries.at(i as usize);
        return text.slice(pool.text(), e.at, e.at + e.len);
    }

    // The files of the folder and of its groups are read again.
    pub void scan() uses io {
        mut Arena scratch = Arena.new(256 * KB);
        defer scratch.free();
        pool.set("");
        entries.clear();
        scan_dir(&scratch, "", 0);
    }

    void scan_dir(Arena* scratch, str rel, i32 depth) uses io {
        str full = rel.len == 0 ? dir.text() : fs.join(scratch, dir.text(), rel);
        match (fs.list(scratch, full)) {
            ok(files) => {
                for (str file in files) {
                    if (file.len == 0 || file.bytes[0] == 46) {
                        continue;
                    }
                    str child = rel.len == 0 ? file : fs.join(scratch, rel, file);
                    if (fs.is_dir(scratch, fs.join(scratch, dir.text(), child))) {
                        if (depth < MAX_DEPTH && child.len <= 200) {
                            add_path(child, true);
                            scan_dir(scratch, child, depth + 1);
                        }
                    } else if (text.ends_with(file, ".md") && child.len <= 203) {
                        add_path(text.slice(child, 0, child.len - 3), false);
                    }
                }
            },
            err(e) => {
                say("The folder cannot be read.");
            },
        }
    }

    void add_path(str path, bool folder) {
        usize at = pool.text().len;
        if (pool.insert(at, path)) {
            entries.push(Entry{ at: at, len: path.len, folder: folder });
        }
    }

    // The rows that hold the search, in their path or (for a note) in their text, in order.
    pub void rebuild() uses io {
        mut Arena scratch = Arena.new(512 * KB);
        defer scratch.free();
        str needle = search.text();
        view.clear();
        for (usize i in 0..entries.len()) {
            Entry e = *entries.at(i);
            str path = entry_path(i as i32);
            if (needle.len == 0 && under_shut(path)) {
                continue;
            }
            mut bool keep = md.has(path, needle);
            if (!keep && needle.len > 0 && !e.folder) {
                match (io.read_file(&scratch, path_of(&scratch, path))) {
                    ok(body) => {
                        keep = md.has(body, needle);
                    },
                    err(err) => { },
                }
            }
            if (keep) {
                view.push(i as i32);
            }
        }
        for (usize i in 1..view.len()) {  // insertion sort, the list is nearly in order
            i32 held = *view.at(i);
            mut usize j = i;
            while (j > 0 && md.before(entry_path(held), entry_path(*view.at(j - 1)))) {
                view.set(j, *view.at(j - 1));
                j -= 1;
            }
            view.set(j, held);
        }
        seen_search.set(needle);
        point_at_current();
    }

    void point_at_current() {
        chosen = -1;
        if (open) {
            for (usize r in 0..view.len()) {
                i32 idx = *view.at(r);
                if (!entries.at(idx as usize).folder && md.same(entry_path(idx), current.text())) {
                    chosen = r as i32;
                }
            }
        }
        shown = chosen;
    }

    // The first limit notes whose path holds query, in sugg, without the note open.
    pub void suggest(str query, i32 limit) {
        sugg.set("");
        sugg_count = 0;
        for (usize i in 0..entries.len()) {
            if (sugg_count >= limit) {
                break;
            }
            str path = entry_path(i as i32);
            if (entries.at(i).folder || !md.has(path, query) || open && md.same(path, current.text())) {
                continue;
            }
            sugg.insert(sugg.text().len, path);
            sugg.insert(sugg.text().len, "\n");
            sugg_count += 1;
        }
    }

    pub i32 rows() {
        return view.len() as i32;
    }

    // What the tree shows of a row: the name; the depth, the groups and their folds are asked apart.
    pub str name_at(i32 row) {
        label.set(md.base_of(entry_path(*view.at(row as usize))));
        return label.text();
    }

    pub i32 depth_at(i32 row) {
        mut i32 n = 0;
        for (ui8 b in entry_path(*view.at(row as usize)).bytes) {
            if (b == 47) {
                n += 1;
            }
        }
        return n;
    }

    pub bool is_branch(i32 row) {
        return entries.at(*view.at(row as usize) as usize).folder;
    }

    bool is_shut(str path) {
        mut usize n = 0;
        while (true) {
            str line = md.line_at(shut.text(), n);
            if (line.len == 0) {
                return false;
            }
            if (line == path) {
                return true;
            }
            n += 1;
        }
        return false;
    }

    // Whether a group above `path` is folded.
    bool under_shut(str path) {
        for (usize i in 0..path.len) {
            if (path.bytes[i] == 47 && is_shut(text.slice(path, 0, i))) {
                return true;
            }
        }
        return false;
    }

    pub bool is_open_row(i32 row) {
        return is_branch(row) && (search.text().len > 0 || !is_shut(entry_path(*view.at(row as usize))));
    }

    // A click on the triangle of a group.
    pub void toggle(i32 row) uses io {
        str path = entry_path(*view.at(row as usize));
        if (is_shut(path)) {
            mut widgets.LongText rest = widgets.long_text();
            defer rest.free();
            mut usize n = 0;
            while (true) {
                str line = md.line_at(shut.text(), n);
                if (line.len == 0) {
                    break;
                }
                if (line != path) {
                    rest.insert(rest.text().len, line);
                    rest.insert(rest.text().len, "\n");
                }
                n += 1;
            }
            shut.set(rest.text());
        } else {
            shut.insert(shut.text().len, path);
            shut.insert(shut.text().len, "\n");
        }
        rebuild();
    }

    pub i32 find_exact(str path) {
        for (usize i in 0..entries.len()) {
            if (!entries.at(i).folder && md.same(entry_path(i as i32), path)) {
                return i as i32;
            }
        }
        return -1;
    }

    // The note that a link names: the path, or else the name alone.
    pub i32 find_note(str target) {
        i32 exact = find_exact(target);
        if (exact >= 0) {
            return exact;
        }
        for (usize i in 0..entries.len()) {
            if (!entries.at(i).folder && md.link_matches(target, entry_path(i as i32))) {
                return i as i32;
            }
        }
        return -1;
    }

    pub i32 word_count() {
        mut i32 n = 0;
        mut bool inside = false;
        for (ui8 b in doc.text().bytes) {
            bool gap = b == 32 || b == 10 || b == 13 || b == 9;
            if (!gap && !inside) {
                n += 1;
            }
            inside = !gap;
        }
        return n;
    }

    // ---- The directory of the links ----

    // The rows of `links` are kept in the file `.notes-index` of the folder.
    void load_index() uses io {
        mut Arena scratch = Arena.new(256 * KB);
        defer scratch.free();
        match (io.read_file(&scratch, hidden(&scratch, ".notes-index"))) {
            ok(body) => {
                links.set(body);
            },
            err(e) => {
                reindex();
            },
        }
    }

    void write_index() uses io {
        mut Arena scratch = Arena.new(64 * KB);
        defer scratch.free();
        match (io.write_file(&scratch, hidden(&scratch, ".notes-index"), links.text())) {
            ok() => { },
            err(e) => {
                say("The directory of links cannot be saved.");
            },
        }
    }

    // The directory is made again from the text of every note.
    pub void reindex() uses io {
        mut Arena scratch = Arena.new(512 * KB);
        defer scratch.free();
        text.TextBuilder* out = text.builder(&scratch);
        for (usize i in 0..entries.len()) {
            if (entries.at(i).folder) {
                continue;
            }
            str path = entry_path(i as i32);
            mut Arena one = Arena.new(128 * KB);
            match (io.read_file(&one, path_of(&one, path))) {
                ok(body) => {
                    out.push(md.index_lines(&scratch, path, body));
                },
                err(e) => { },
            }
            one.free();
        }
        links.set(out.text());
        write_index();
        find_backlinks();
        say("Links indexed.");
    }

    // The rows of the note `path` are replaced by those of its text (none for an empty text).
    void index_note(str path, str body) uses io {
        mut Arena scratch = Arena.new(128 * KB);
        defer scratch.free();
        text.TextBuilder* out = text.builder(&scratch);
        str old = links.text();
        mut usize at = 0;
        while (at < old.len) {
            mut usize end = old.len;
            match (text.find_from(old, "\n", at)) {
                some(nl) => {
                    end = nl;
                },
                none => { },
            }
            str row = text.slice(old, at, end);
            if (md.src_of(row) != path) {
                out.push(row);
                out.push("\n");
            }
            at = end + 1;
        }
        out.push(md.index_lines(&scratch, path, body));
        if (out.text() != old) {
            links.set(out.text());
            write_index();
        }
    }

    // The notes that link to the note open, read from the directory.
    pub void find_backlinks() {
        backlist.set("");
        back_count = 0;
        if (!open) {
            return;
        }
        mut widgets.TextBuffer last = widgets.TextBuffer{ };
        str all = links.text();
        mut usize at = 0;
        while (at < all.len) {
            mut usize end = all.len;
            match (text.find_from(all, "\n", at)) {
                some(nl) => {
                    end = nl;
                },
                none => { },
            }
            str row = text.slice(all, at, end);
            str source = md.src_of(row);
            if (!md.same(source, current.text()) && !md.same(source, last.text()) && md.link_matches(md.dst_of(row), current.text())) {
                backlist.insert(backlist.text().len, source);
                backlist.insert(backlist.text().len, "\n");
                last.set(source);
                back_count += 1;
            }
            at = end + 1;
        }
    }

    // ---- Opening and saving ----

    // Writes the note open, if it changed since the last time.
    pub void save() uses io {
        if (!open) {
            return;
        }
        ui64 h = hash_of(doc.text());
        if (h == saved_hash) {
            return;
        }
        mut Arena scratch = Arena.new(64 * KB);
        defer scratch.free();
        match (io.write_file(&scratch, path_of(&scratch, current.text()), doc.text())) {
            ok() => {
                saved_hash = h;
                index_note(current.text(), doc.text());
            },
            err(e) => {
                say("The note cannot be saved.");
            },
        }
    }

    // At each frame: the search, the choice in the list, and the saving after a pause.
    pub void update(i64 now_ms) uses io {
        now = now_ms;
        if (search.text() != seen_search.text()) {
            rebuild();
        }
        if (chosen != shown) {
            shown = chosen;
            if (chosen >= 0 && chosen < view.len() as i32) {
                i32 idx = *view.at(chosen as usize);
                mut widgets.TextBuffer pick = widgets.TextBuffer{ };
                pick.set(entry_path(idx));
                if (entries.at(idx as usize).folder) {
                    group.set(pick.text());
                } else {
                    save();
                    load(pick.text());
                }
            }
        }
        if (open) {
            ui64 h = hash_of(doc.text());
            if (h != seen_hash) {
                seen_hash = h;
                changed_at = now;
            } else if (h != saved_hash && now - changed_at >= SAVE_AFTER_MS) {
                save();
            }
        }
    }

    // Opens the note `path`.
    pub void load(str path) uses io {
        mut Arena scratch = Arena.new(512 * KB);
        defer scratch.free();
        match (io.read_file(&scratch, path_of(&scratch, path))) {
            ok(body) => {
                current.set(path);
                group.set(md.parent_of(path));
                title.set(path);
                doc.set(body);
                open = true;
                saved_hash = hash_of(doc.text());
                seen_hash = saved_hash;
                changed_at = now;
                say("");
                index_note(path, body);
                find_backlinks();
                point_at_current();
            },
            err(e) => {
                say("The note cannot be read.");
            },
        }
    }

    // ---- The folder of the notes ----

    // The button Folder: the dialog of the system asks for the folder. Its answer comes later
    // to `on_event` of main, which gives the path to `open_folder`.
    pub void ask_folder() uses io {
        dialogs.choose_folder(FOLDER_TAG, dir.text());
    }

    // The notes of the folder `wanted` replace the ones shown. It is made if needed, and
    // remembered in `notes-folder.txt` for the next start.
    pub void open_folder(str wanted) uses io {
        if (wanted.len == 0 || wanted == dir.text()) {
            return;
        }
        mut Arena scratch = Arena.new(8 * KB);
        defer scratch.free();
        match (fs.create_dirs(&scratch, wanted)) {
            ok() => { },
            err(e) => {
                say("This folder cannot be made.");
                return;
            },
        }
        if (open) {
            save();
        }
        dir.set(wanted);
        open = false;
        current.set("");
        title.set("");
        group.set("");
        search.set("");
        seen_search.set("");
        doc.set("");
        backlist.set("");
        back_count = 0;
        shut.set("");
        renaming = false;
        chosen = -1;
        shown = -1;
        saved_hash = 0;
        seen_hash = 0;
        scan();
        load_index();
        rebuild();
        font_at = -1;
        load_settings();
        select_font(font_at);
        match (io.write_file(&scratch, LOCATION, wanted)) {
            ok() => { },
            err(e) => { },
        }
        say("");
    }

    // ---- New notes and groups, rename, delete ----

    bool valid_path(str path) {
        if (path.len == 0 || path.len > 200 || text.contains(path, "..") || text.contains(path, "//")) {
            return false;
        }
        if (path.bytes[0] == 47 || path.bytes[path.len - 1] == 47 || path.bytes[0] == 46) {
            return false;
        }
        for (ui8 b in path.bytes) {
            if (b < 32 || b == 92 || b == 58 || b == 42 || b == 63 || b == 34 || b == 60 || b == 62 || b == 124) {
                return false;
            }
        }
        return true;
    }

    // `group` without the blanks and the slashes around it.
    void clean_group() {
        mut widgets.TextBuffer g = widgets.TextBuffer{ };
        g.set(text.trim(group.text()));
        while (g.count() > 0 && (g.text().bytes[g.text().len - 1] == 47 || g.text().bytes[g.text().len - 1] == 92)) {
            g.set(text.slice(g.text(), 0, g.text().len - 1));
        }
        group.set(g.text());
    }

    // A note that does not exist yet is made with a first line, and its group if needed.
    pub bool create(str path) uses io {
        if (!valid_path(path) || find_exact(path) >= 0) {
            say("This name cannot be used.");
            return false;
        }
        mut Arena scratch = Arena.new(64 * KB);
        defer scratch.free();
        str parent = md.parent_of(path);
        if (parent.len > 0) {
            match (fs.create_dirs(&scratch, fs.join(&scratch, dir.text(), parent))) {
                ok() => { },
                err(e) => {
                    say("The group cannot be made.");
                    return false;
                },
            }
        }
        mut widgets.TextBuffer first = widgets.TextBuffer{ };
        first.append("# ");
        first.append(md.base_of(path));
        first.append("\n");
        match (io.write_file(&scratch, path_of(&scratch, path), first.text())) {
            ok() => {
                scan();
                return true;
            },
            err(e) => {
                say("The note cannot be created.");
                return false;
            },
        }
    }

    // A click on a link: the note is opened, and made if it is missing.
    pub void follow(str name) uses io {
        save();
        mut widgets.TextBuffer wanted = widgets.TextBuffer{ };
        wanted.set(name);
        if (find_note(wanted.text()) < 0 && !create(wanted.text())) {
            return;
        }
        i32 at = find_note(wanted.text());
        if (at < 0) {
            return;
        }
        mut widgets.TextBuffer pick = widgets.TextBuffer{ };
        pick.set(entry_path(at));
        search.set("");
        load(pick.text());
        rebuild();
    }

    pub void new_note() uses io {
        save();
        clean_group();
        mut Arena scratch = Arena.new(4 * KB);
        defer scratch.free();
        mut widgets.TextBuffer pick = widgets.TextBuffer{ };
        mut i32 n = 1;
        while (n < 10000) {
            text.TextBuilder* b = text.builder(&scratch);
            if (group.count() > 0) {
                b.push(group.text());
                b.push("/");
            }
            b.push("Untitled");
            if (n > 1) {
                b.push(" ");
                b.push_i64(n as i64);
            }
            pick.set(b.text());
            if (find_exact(pick.text()) < 0) {
                break;
            }
            n += 1;
        }
        if (create(pick.text())) {
            search.set("");
            load(pick.text());
            rebuild();
        }
    }

    // A group is made in the group of the row chosen, with a name to replace at once.
    pub void new_folder() uses io {
        clean_group();
        mut Arena scratch = Arena.new(64 * KB);
        defer scratch.free();
        mut widgets.TextBuffer pick = widgets.TextBuffer{ };
        mut i32 n = 1;
        while (n < 10000) {
            text.TextBuilder* b = text.builder(&scratch);
            if (group.count() > 0) {
                b.push(group.text());
                b.push("/");
            }
            b.push("New group");
            if (n > 1) {
                b.push(" ");
                b.push_i64(n as i64);
            }
            pick.set(b.text());
            if (!fs.exists(&scratch, fs.join(&scratch, dir.text(), pick.text()))) {
                break;
            }
            n += 1;
        }
        if (!valid_path(pick.text())) {
            say("This name cannot be used.");
            return;
        }
        match (fs.create_dirs(&scratch, fs.join(&scratch, dir.text(), pick.text()))) {
            ok() => {
                search.set("");
                scan();
                rebuild();
                for (usize r in 0..view.len()) {
                    i32 idx = *view.at(r);
                    if (entries.at(idx as usize).folder && entry_path(idx) == pick.text()) {
                        chosen = r as i32;
                        shown = chosen;
                    }
                }
                begin_rename();
            },
            err(e) => {
                say("The group cannot be made.");
            },
        }
    }
    // Enter in the title: the note takes another path, and the links to it follow.
    pub void rename() uses io {
        if (!open) {
            return;
        }
        mut widgets.TextBuffer wanted = widgets.TextBuffer{ };
        wanted.set(text.trim(title.text()));
        if (wanted.text() == current.text()) {
            return;
        }
        if (!valid_path(wanted.text())) {
            say("This name cannot be used.");
            return;
        }
        if (find_exact(wanted.text()) >= 0 && !md.same(wanted.text(), current.text())) {
            say("A note has this name already.");
            return;
        }
        mut widgets.TextBuffer old = widgets.TextBuffer{ };
        old.set(current.text());
        find_backlinks();
        mut Arena scratch = Arena.new(512 * KB);
        defer scratch.free();
        for (i32 i in 0..back_count) {  // the notes that link to this one
            str source = md.line_at(backlist.text(), i as usize);
            match (io.read_file(&scratch, path_of(&scratch, source))) {
                ok(body) => {
                    str fixed = md.rename_links(&scratch, body, old.text(), wanted.text());
                    if (fixed != body) {
                        match (io.write_file(&scratch, path_of(&scratch, source), fixed)) {
                            ok() => {
                                index_note(source, fixed);
                            },
                            err(e) => {
                                say("A link could not be rewritten.");
                            },
                        }
                    }
                },
                err(e) => { },
            }
        }
        doc.set(md.rename_links(&scratch, doc.text(), old.text(), wanted.text()));
        save();
        str parent = md.parent_of(wanted.text());
        if (parent.len > 0) {
            match (fs.create_dirs(&scratch, fs.join(&scratch, dir.text(), parent))) {
                ok() => { },
                err(e) => {
                    say("The group cannot be made.");
                    return;
                },
            }
        }
        match (fs.rename(&scratch, path_of(&scratch, old.text()), path_of(&scratch, wanted.text()))) {
            ok() => {
                index_note(old.text(), "");
                current.set(wanted.text());
                index_note(current.text(), doc.text());
                scan();
                rebuild();
                find_backlinks();
                say("Renamed, links updated.");
            },
            err(e) => {
                say("The note cannot be renamed.");
            },
        }
    }

    // F2 or the menu: the row chosen can be given another path, in the field above the tree.
    pub void begin_rename() {
        if (chosen < 0 || chosen >= view.len() as i32) {
            return;
        }
        i32 idx = *view.at(chosen as usize);
        ren_from.set(entry_path(idx));
        ren_name.set(entry_path(idx));
        ren_group = entries.at(idx as usize).folder;
        renaming = true;
    }

    pub void cancel_rename() {
        renaming = false;
    }

    // Enter in the field: a note is moved by `rename`; a group moves its notes one by one, so
    // that every link follows, then its empty folders are removed.
    pub void commit_rename() uses io {
        if (!renaming) {
            return;
        }
        renaming = false;
        mut widgets.TextBuffer from = widgets.TextBuffer{ };
        from.set(ren_from.text());
        mut widgets.TextBuffer to = widgets.TextBuffer{ };
        to.set(text.trim(ren_name.text()));
        if (to.text() == from.text()) {
            return;
        }
        if (!ren_group) {
            if (find_exact(from.text()) < 0) {
                return;
            }
            save();
            if (!md.same(current.text(), from.text())) {
                load(from.text());
            }
            title.set(to.text());
            rename();
            return;
        }
        rename_group(from.text(), to.text());
    }

    void rename_group(str from, str to) uses io {
        if (!valid_path(to) || md.same(to, from) || text.starts_with(to, from) && to.bytes[from.len] == 47) {
            say("This name cannot be used.");
            return;
        }
        save();
        mut widgets.TextBuffer was = widgets.TextBuffer{ };
        was.set(open ? current.text() : "");
        mut widgets.LongText moving = widgets.long_text();
        mut widgets.LongText folders = widgets.long_text();
        defer moving.free();
        defer folders.free();
        mut widgets.TextBuffer prefix = widgets.TextBuffer{ };
        prefix.set(from);
        prefix.append("/");
        for (usize i in 0..entries.len()) {
            str path = entry_path(i as i32);
            if (text.starts_with(path, prefix.text())) {
                widgets.LongText* into = entries.at(i).folder ? &folders : &moving;
                into.insert(into.text().len, path);
                into.insert(into.text().len, "\n");
            }
        }
        mut Arena scratch = Arena.new(64 * KB);
        defer scratch.free();
        match (fs.create_dirs(&scratch, fs.join(&scratch, dir.text(), to))) {
            ok() => { },
            err(e) => {
                say("The group cannot be made.");
                return;
            },
        }
        mut widgets.TextBuffer target = widgets.TextBuffer{ };
        mut usize n = 0;
        while (true) {
            str path = md.line_at(moving.text(), n);
            if (path.len == 0) {
                break;
            }
            target.set(to);
            target.append(text.slice(path, from.len, path.len));
            load(path);
            title.set(target.text());
            rename();
            if (md.same(was.text(), path)) {
                was.set(target.text());
            }
            n += 1;
        }
        mut usize j = 0;
        while (md.line_at(folders.text(), j).len > 0) {  // the folders left, the deepest first
            j += 1;
        }
        while (j > 0) {
            j -= 1;
            str sub = md.line_at(folders.text(), j);
            if (sub.len > 0) {
                match (fs.remove_dir(&scratch, fs.join(&scratch, dir.text(), sub))) {
                    ok() => { },
                    err(e) => { },
                }
            }
        }
        match (fs.remove_dir(&scratch, fs.join(&scratch, dir.text(), from))) {
            ok() => { },
            err(e) => { },
        }
        scan();
        if (was.count() > 0) {
            load(was.text());
        } else {
            open = false;
            doc.set("");
            current.set("");
            title.set("");
            back_count = 0;
            backlist.set("");
            saved_hash = hash_of("");
        }
        rebuild();
        say("Group renamed, links updated.");
    }
    pub void remove_note() uses io {
        if (!open) {
            return;
        }
        mut Arena scratch = Arena.new(64 * KB);
        defer scratch.free();
        match (fs.remove_file(&scratch, path_of(&scratch, current.text()))) {
            ok() => {
                index_note(current.text(), "");
                open = false;
                doc.set("");
                current.set("");
                title.set("");
                back_count = 0;
                backlist.set("");
                saved_hash = hash_of("");
                scan();
                rebuild();
                say("Deleted.");
            },
            err(e) => {
                say("The note cannot be deleted.");
            },
        }
    }

    pub void toggle_preview() {
        preview = !preview;
    }

    // ---- The font: one of the families of the program, or any .ttf file of the system ----
    // `font_at` -1, -2, -3: Noto Sans, Noto Serif, JetBrains Mono (each with its bold and italic faces).

    void scan_fonts() uses io {
        mut Arena scratch = Arena.new(256 * KB);
        defer scratch.free();
        font_pool.set("");
        font_entries.clear();
        add_fonts(&scratch, "C:/Windows/Fonts", 0);
        add_fonts(&scratch, "/usr/share/fonts", 0);
        add_fonts(&scratch, "/Library/Fonts", 0);
        add_fonts(&scratch, "/System/Library/Fonts", 0);
    }

    void add_fonts(Arena* scratch, str folder, i32 depth) uses io {
        match (fs.list(scratch, folder)) {
            ok(files) => {
                for (str file in files) {
                    str full = fs.join(scratch, folder, file);
                    if (depth < 4 && fs.is_dir(scratch, full)) {
                        add_fonts(scratch, full, depth + 1);
                    } else if ((text.ends_with(file, ".ttf") || text.ends_with(file, ".TTF")) && !md.has(file, "symbol") && !md.has(file, "wingding") && !md.has(file, "webding")) {
                        add_entry(font_entries, &font_pool, full, false);
                    }
                }
            },
            err(e) => { },
        }
    }

    str font_at_path(i32 i) {
        Entry e = *font_entries.at(i as usize);
        return text.slice(font_pool.text(), e.at, e.at + e.len);
    }

    // The file of the font chosen; nothing for the families of the program.
    pub str font_file() {
        return font_at < 0 ? "" : font_at_path(font_at);
    }

    // Which family of the program is chosen: 0 Noto Sans, 1 Noto Serif, 2 JetBrains Mono.
    pub i32 family() {
        return font_at < 0 ? -font_at - 1 : 0;
    }

    str font_token() {
        if (font_at >= 0) {
            return font_at_path(font_at);
        }
        return font_at == -2 ? "@serif" : font_at == -3 ? "@mono" : "";
    }

    void select_font(i32 at) {
        font_at = at;
        font_dirty = true;
        font_label.set("");
        if (at < 0) {
            font_label.append(at == -2 ? "Noto Serif" : at == -3 ? "JetBrains Mono" : "Noto Sans");
        } else {
            str name = md.base_of(font_at_path(at));
            font_label.append(text.slice(name, 0, name.len - 4));
        }
    }

    pub void font_next() uses io {
        i32 n = font_entries.len() as i32 + FAMILIES;
        mut i32 p = (font_at < 0 ? -font_at - 1 : FAMILIES + font_at) + 1;
        p = p >= n ? 0 : p;
        select_font(p < FAMILIES ? -p - 1 : p - FAMILIES);
        save_settings();
    }

    pub void font_prev() uses io {
        i32 n = font_entries.len() as i32 + FAMILIES;
        mut i32 p = (font_at < 0 ? -font_at - 1 : FAMILIES + font_at) - 1;
        p = p < 0 ? n - 1 : p;
        select_font(p < FAMILIES ? -p - 1 : p - FAMILIES);
        save_settings();
    }

    // The font could not be read: the one of the program comes back.
    pub void drop_font() uses io {
        select_font(-1);
        save_settings();
    }

    // The font is kept in the file `.notes-settings` of the folder.
    void save_settings() uses io {
        mut Arena scratch = Arena.new(8 * KB);
        defer scratch.free();
        match (io.write_file(&scratch, hidden(&scratch, ".notes-settings"), font_token())) {
            ok() => { },
            err(e) => { },
        }
    }

    void load_settings() uses io {
        mut Arena scratch = Arena.new(8 * KB);
        defer scratch.free();
        match (io.read_file(&scratch, hidden(&scratch, ".notes-settings"))) {
            ok(body) => {
                str wanted = text.trim(body);
                if (wanted == "@serif") {
                    font_at = -2;
                } else if (wanted == "@mono") {
                    font_at = -3;
                }
                for (usize i in 0..font_entries.len()) {
                    if (font_at_path(i as i32) == wanted) {
                        font_at = i as i32;
                    }
                }
            },
            err(e) => { },
        }
    }
}
