// The tests of Sozo, without a window nor a GPU: the studio drives the scene of examples/scene as
// the mouse would, in a view of 740 by 712 pixels.
import std.io;
import std.random;
import math.linear;
import scene.scene;
import editor.marks;
import editor.gizmo;
import engine.components;
import testing.fixture;
import sozo.studio;
import render.canvas;
import ui.widgets;

studio.Studio* opened(keeps Arena* arena) uses io, threads {
    str source = fixture.read(arena, "tests/level.json");  // the scene of examples/scene: never saved over by the editor
    return arena.new(studio.Studio, arena, "level.json", source, none, none);
}

marks.View view_of(studio.Studio* s) {
    return marks.view(s.g.camera(), 240.0, 48.0, 740.0, 712.0);
}

test "the list of the scene: each entity after its parent, chosen by a click in the view" {
    mut Arena arena = Arena.new(4 * MB);
    defer arena.free();
    studio.Studio* s = opened(&arena);
    defer s.close();
    s.update(0.0);
    assert(s.rows() == 12 && s.name_at(0) == "ground" && s.name_at(11) == "    crackle");
    // a click on the projection of crate 4 (at 2.5, 1, 1.5): chosen
    marks.View v = view_of(s);
    f32[2] p = match (marks.project(v, linear.vec3(2.5, 1.0, 1.5))) {
        some(x) => x,
        none => [0.0, 0.0],
    };
    s.press(v, p[0], p[1], 0, false);
    s.release();
    assert(s.title() == "crate 4" && s.kinds() == "mesh  body  ");
    // a click on the sky: nothing chosen
    s.press(v, 600.0, 60.0, 0, false);
    assert(s.title() == "Scene");
}

test "the gizmo moves what is chosen along its arrow, and the camera turns" {
    mut Arena arena = Arena.new(4 * MB);
    defer arena.free();
    studio.Studio* s = opened(&arena);
    defer s.close();
    s.update(0.0);
    s.chosen = 5;  // crate 4, at (2.5, 1, 1.5)
    marks.View v = view_of(s);
    linear.Vec3 at = linear.vec3(2.5, 1.0, 1.5);
    f32 length = gizmo.length_at(v, at, s.orbit.position());
    f32[2] tip = match (marks.project(v, at.add(linear.vec3(length * 0.8, 0.0, 0.0)))) {
        some(x) => x,
        none => [0.0, 0.0],
    };
    s.hover(v, tip[0], tip[1]);
    assert(match (s.hovered) {
        some(a) => match (a) {
            X => true,
            _ => false,
        },
        none => false,
    });
    s.press(v, tip[0], tip[1], 0, false);
    f32[2] to = match (marks.project(v, at.add(linear.vec3(length * 0.8 + 1.0, 0.0, 0.0)))) {
        some(x) => x,
        none => [0.0, 0.0],
    };
    s.hover(v, to[0], to[1]);
    s.release();
    linear.Vec3 now = s.position_of(match (s.selected()) {
        some(e) => e,
        none => s.g.world.entities(&arena)[0],
    });
    assert(now.near(linear.vec3(3.5, 1.0, 1.5), 0.02));
    // the right button turns the camera; the wheel brings it nearer
    f32 yaw = s.orbit.yaw;
    s.press(v, 500.0, 400.0, 1, false);
    s.hover(v, 560.0, 400.0);
    s.release();
    f32 distance = s.orbit.distance;
    s.wheel(2.0);
    assert(s.orbit.yaw != yaw && s.orbit.distance < distance);
}

test "played and stopped: the crates fall, then are back where they were" {
    mut Arena arena = Arena.new(4 * MB);
    defer arena.free();
    studio.Studio* s = opened(&arena);
    defer s.close();
    s.update(0.0);
    s.chosen = 4;  // crate 3, at 3.4 m: it falls on the others
    linear.Vec3 before = linear.vec3(-0.2, 3.4, -0.1);
    // paused: it does not fall
    for (i32 i in 0..30) {
        s.update(1.0 / 60.0);
    }
    assert(s.position_of(s.order_at(4)).near(before, 0.001));
    s.toggle_play();
    assert(s.play_label() == "Stop");
    for (i32 i in 0..120) {
        s.update(1.0 / 60.0);
    }
    assert(s.position_of(s.order_at(4)).y < 3.0);
    s.toggle_play();
    s.update(0.0);
    assert(s.play_label() == "Play" && s.rows() == 12 && s.title() == "crate 3");
    assert(s.position_of(s.order_at(4)).near(before, 0.001));
}

test "saved, and read back the same" {
    mut Arena arena = Arena.new(4 * MB);
    defer arena.free();
    str dir = fixture.temp_dir(&arena, "sozo");
    defer fixture.remove(dir);
    studio.Studio* s = opened(&arena);
    defer s.close();
    s.update(0.0);
    s.chosen = 2;
    s.place(s.order_at(2), linear.vec3(0.0, 2.0, 7.0));
    s.path = text_of(&arena, dir, "/moved.json");
    s.save_file();
    str back = match (io.read_bytes(&arena, s.path)) {
        ok(bytes) => match (str.from_bytes(bytes)) {
            ok(text) => text,
            err(e) => "",
        },
        err(e) => "",
    };
    studio.Studio* t = arena.new(studio.Studio, &arena, "moved.json", back, none, none);
    defer t.close();
    t.update(0.0);
    assert(t.rows() == 12 && t.position_of(t.order_at(2)).near(linear.vec3(0.0, 2.0, 7.0), 0.0001));
}

str text_of(Arena* arena, str a, str b) {
    mut ui8[] out = arena.alloc_slice(ui8, a.len + b.len);
    for (usize i in 0..a.len) {
        out[i] = a.bytes[i];
    }
    for (usize i in 0..b.len) {
        out[a.len + i] = b.bytes[i];
    }
    return match (str.from_bytes(out)) {
        ok(s) => s,
        err(e) => "",
    };
}

test "the inspector of every entity drawn: each kind of field through its widget" {
    mut Arena arena = Arena.new(4 * MB);
    defer arena.free();
    studio.Studio* s = opened(&arena);
    defer s.close();
    s.update(0.0);
    mut canvas.Canvas surface = canvas.create(&arena, 300, 900);
    mut widgets.Ui ui = widgets.Ui{ };
    for (i32 row in -1..s.rows()) {
        s.chosen = row;
        for (i32 frame in 0..2) {
            surface.clear(canvas.Color{ r: 0, g: 0, b: 0, a: 0 });
            mut widgets.Frame f = widgets.begin(&ui, &surface, 0.0, 0.0);
            s.inspector(&f, 300.0, 900.0);
            f.finish();
        }
        // something drawn: the title at least
        mut usize lit = 0;
        for (i32 y in 0..60) {
            for (i32 x in 0..300) {
                if (surface.at(x, y) != 0) {
                    lit += 1;
                }
            }
        }
        assert(lit > 20);
    }
}

test "the panels: the view docked in the window of the editor, then drawn in a window of its own" {
    mut Arena arena = Arena.new(4 * MB);
    defer arena.free();
    studio.Studio* s = opened(&arena);
    defer s.close();
    s.update(0.0);
    mut widgets.Ui ui = widgets.Ui{ };
    mut canvas.Canvas surface = canvas.create(&arena, 1280, 760);
    mut widgets.Frame f = widgets.begin(&ui, &surface, 0.0, 0.0);
    studio.Workspace(&f, s, 48.0);
    f.finish();
    // the list on the left, the view in the middle, the inspector on the right
    assert(s.view_in == -1 && s.view.x > 200.0 && s.view.x + s.view.w < 1000.0 && s.view.y > 48.0);
    assert(studio.over_view(s, s.view.x + 10.0, s.view.y + 10.0) && !studio.over_view(s, 20.0, 300.0));
    assert(s.panes.rect_of("entities").x < 10.0 && s.panes.rect_of("inspector").x > 900.0);
    // the view in the window of a floating panel: its title on top, the view under it
    mut widgets.Ui other = widgets.Ui{ };
    mut canvas.Canvas window = canvas.create(&arena, 400, 300);
    mut widgets.Frame g = widgets.begin(&other, &window, 0.0, 0.0);
    i32 k = s.panes.float("view", canvas.Rect{ x: 300.0, y: 200.0, w: 400.0, h: 300.0 });
    studio.Floating(&g, s, k, canvas.Rect{ x: 300.0, y: 200.0, w: 400.0, h: 300.0 });
    g.finish();
    assert(s.view_in == k && s.view.x <= 1.0 && s.view.y > 20.0 && s.view.w >= 398.0);
    assert(studio.over_view_in(s, k, 200.0, 150.0) && !studio.over_view(s, 200.0, 150.0));
    mut i32 holes = 0;  // the hole where the scene shows (the marks drawn into it)
    for (i32 x in 0..400) {
        if (window.at(x, 150) == 0) {
            holes += 1;
        }
    }
    assert(holes > 300);
}
