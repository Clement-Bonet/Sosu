// Sozo: the first draft of the editor of games of Sosu. A scene (the common components of
// `engine`) is seen through the camera of the editor; its entities are chosen in the view or in
// the list, moved by the arrows of a gizmo, played as the game would and stopped, saved.
//
// The window is drawn by the GPU: the interface of `ui` in a canvas, with a hole where the view is
// (`canvas.erase`); the scene is drawn into a texture of the size of the view (`render_into`),
// copied there (`gpu.Frame.blit`), and the canvas over it all (`gpu.overlay`), with the marks of
// the editor (the grid, the box of what is chosen, the arrows) drawn into the hole.
//
//   sosuc run showcase/sozo                       the scene of examples/scene
//   sosuc run showcase/sozo -- path/scene.json    another scene
//   sosuc run showcase/sozo -- --snapshot x.png   the window drawn into a PNG, without a screen
import std.io;
import std.os;
import std.text;
import std.math;
import math.linear;
import platform.app;
import gpu.gpu;
import gpu.overlay;
import render.canvas;
import render.truetype;
import render3d.render3d;
import particles.draw;
import image.png;
import ui.widgets;
import editor.marks;
import sozo.look;
import sozo.studio;
import sozo.screen;
import sozo.checks;  // the tests of checks.sosu, which `sosuc test` finds from here

// The view of the scene where its panel was last drawn (`studio.Workspace`), seen from the camera
// as it is now.
marks.View view_of(studio.Studio* st) {
    marks.View v = st.view;
    return marks.view(st.g.camera(), v.x, v.y, max(v.w, 1.0), max(v.h, 1.0));
}

// A TrueType font from the first of `places` that holds one.
truetype.Font*? read_face(Arena* arena, str[3] places) uses io {
    for (str place in places) {
        match (app.read_asset(arena, place)) {
            some(bytes) => {
                match (truetype.parse(arena, bytes)) {
                    ok(face) => {
                        return some(face);
                    },
                    err(e) => { },
                }
            },
            none => { },
        }
    }
    return none;
}

void load_font(Arena* arena, widgets.Ui* ui) uses io {
    match (read_face(
        arena,
        ["showcase/sozo/assets/NotoSans-Regular.ttf", "assets/NotoSans-Regular.ttf", "NotoSans-Regular.ttf"]
    )) {
        some(noto) => {
            match (read_face(
                arena,
                ["showcase/sozo/assets/fa-solid-900.ttf", "assets/fa-solid-900.ttf", "fa-solid-900.ttf"]
            )) {
                some(icons) => {
                    noto.fallback = some(icons);
                },
                none => { },
            }
            ui.font = some(noto);
        },
        none => { },
    }
}

// The scene to edit: the file given, else that of examples/scene.
str scene_path(str[] args) {
    return args.len == 1 ? args[0] : "showcase/sozo/assets/level.json";
}

str read_scene(Arena* arena, str path) uses io {
    return match (app.read_asset(arena, path)) {
        some(bytes) => match (str.from_bytes(bytes)) {
            ok(s) => s,
            err(e) => "",
        },
        none => match (app.read_asset(arena, "assets/level.json")) {
            some(bytes) => match (str.from_bytes(bytes)) {
                ok(s) => s,
                err(e) => "",
            },
            none => "",
        },
    };
}

// The interface drawn into `surface`; its panel of the view leaves a hole, the marks drawn into it.
void compose(widgets.Ui* ui, canvas.Canvas* surface, keeps studio.Studio* st) uses io, threads {
    surface.clear(canvas.Color{ r: 0, g: 0, b: 0, a: 0 });
    ui.theme = some(look.Night());
    mut widgets.Frame f = widgets.begin(ui, surface, 0.0, 0.0);
    screen.Sozo(&f, st);
    f.finish();
}

// A texture of `w` by `h` for the view, `t` itself when it is of that size (else released).
gpu.Texture? fitted(gpu.Device* d, gpu.Texture? t, ui32 w, ui32 h) uses io {
    match (t) {
        some(x) => {
            if (x.width == w && x.height == h) {
                return t;
            }
            d.release_texture(x);
        },
        none => { },
    }
    return match (d.target(w, h)) {
        ok(x) => some(x),
        err(e) => none,
    };
}

// A floating window of the dock (`ui.dock`, spec §10.13): its own interface and canvas, drawn by
// the device of the editor, with the view of the scene when it holds it.
class Floater {
    i32 key;  // the window of the dock
    app.Window window;
    ui32 wid;
    mut widgets.Ui ui;
    mut Arena keep;  // its overlay
    mut Arena pixels;
    mut canvas.Canvas surface;
    mut overlay.Overlay*? hud;
    mut gpu.Texture? view_target;
    mut f32 mouse_x;
    mut f32 mouse_y;
    mut bool faded;

    void init(i32 key, keeps app.Window window) uses io {
        self.key = key;
        self.window = window;
        wid = window.id();
        ui = widgets.Ui{ };
        keep = Arena.new(16 * KB);
        pixels = Arena.new(1 * KB);
        surface = canvas.create(&pixels, 0, 0);
        hud = none;
        view_target = none;
        mouse_x = 0.0;
        mouse_y = 0.0;
        faded = false;
    }

    void close(gpu.Device* d) uses io {
        match (hud) {
            some(h) => {
                h.release();
            },
            none => { },
        }
        match (view_target) {
            some(t) => {
                d.release_texture(t);
            },
            none => { },
        }
        d.release_window(window);
        window.close();
        keep.free();
        pixels.free();
    }
}

// Where the arrangement of the panels is kept between two runs: in the folder of the data of Sozo.
str layout_path(Arena* arena) uses io {
    mut str[2] parts = [app.data_folder(arena, "sozo"), "layout.json"];
    return text.join(arena, parts[0..2], "");
}

class Editor : app.WindowHandler<uses threads> {
    mut Arena arena;
    mut Arena pixels;
    mut canvas.Canvas surface;
    mut widgets.Ui ui;
    str path;
    mut gpu.Device*? screen;
    mut overlay.Overlay*? hud;
    mut gpu.Texture? view_target;
    mut studio.Studio*? st;
    mut ui64 last;
    mut bool shift;
    mut bool in_view;  // a button was pressed over the view: the moves and its release go there
    mut f32 mouse_x;
    mut f32 mouse_y;
    mut ui32 main_id;
    mut ui32 target;  // the window of the events (`Event.Target`)
    mut Floater*?[4] floaters;

    void init(keeps str path) {
        arena = Arena.new(1 * MB);
        pixels = Arena.new(1 * KB);
        surface = canvas.create(&pixels, 0, 0);
        ui = widgets.Ui{ };
        self.path = path;
        screen = none;
        hud = none;
        view_target = none;
        st = none;
        last = 0;
        shift = false;
        in_view = false;
        mouse_x = 0.0;
        mouse_y = 0.0;
        main_id = 0;
        target = 0;
        floaters = [none, none, none, none];
    }

    override void on_start(app.Window window) uses io, threads {
        gpu.Device* d = match (gpu.open(&arena, window, gpu.Options{ })) {
            ok(x) => x,
            err(e) => {
                io.print("sozo: {} ({})", gpu.message(e), gpu.last_error(&arena));
                app.request_quit();
                return;
            },
        };
        screen = some(d);
        render3d.Renderer*? r = match (render3d.create(&arena, d, render3d.Options{ })) {
            ok(x) => some(x),
            err(e) => none,
        };
        draw.Drawer*? dr = match (draw.drawer(&arena, d)) {
            ok(x) => some(x),
            err(e) => none,
        };
        match (overlay.create(&arena, d)) {
            ok(o) => {
                hud = some(o);
            },
            err(e) => { },
        }
        main_id = window.id();
        target = main_id;
        load_font(&arena, &ui);
        studio.Studio* made = arena.new(studio.Studio, &arena, path, read_scene(&arena, path), r, dr);
        // the panels as the user left them, the last time
        match (io.read_file(&arena, layout_path(&arena))) {
            ok(saved) => {
                made.panes.restore(saved);
            },
            err(e) => { },
        }
        st = some(made);
        last = app.now_ms();
    }

    marks.View current() {
        return match (st) {
            some(s) => view_of(s),
            none => marks.View{ view_projection: linear.identity4(), x: 0.0, y: 0.0, w: 1.0, h: 1.0 },
        };
    }

    bool over_view(f32 x, f32 y) {
        return match (st) {
            some(s) => studio.over_view(s, x, y),
            none => false,
        };
    }

    Floater*? floater_of(ui32 wid) {
        for (Floater*? f in floaters) {
            match (f) {
                some(x) => {
                    if (x.wid == wid) {
                        return f;
                    }
                },
                none => { },
            }
        }
        return none;
    }

    // The mouse of a floating panel held by its title: given to the dock, in the coordinates of the
    // window of the editor; its window follows it.
    void follow(studio.Studio* s, Floater* fl, bool down) uses io {
        f32[2] at = app.mouse_position();
        match (app.window_by_id(main_id)) {
            some(m) => {
                i32[2] origin = m.position();
                s.panes.follow(at[0] - origin[0] as f32, at[1] - origin[1] as f32, down);
            },
            none => { },
        }
        if (down && s.panes.moves_window()) {
            f32[2] grab = s.panes.grab();
            fl.window.move_to((at[0] - grab[0]) as i32, (at[1] - grab[1]) as i32);
        }
    }

    // An event of the window of a floating panel.
    bool float_event(studio.Studio* s, Floater* fl, app.Event e) uses io, threads {
        match (e) {
            Key(code, down, mods) => {
                shift = mods.shift;
                if (down && code == 27) {
                    return false;
                }
                fl.ui.key(code, down, mods.shift, mods.ctrl || mods.command);
            },
            MouseMove(x, y) => {
                fl.mouse_x = x;
                fl.mouse_y = y;
                if (s.panes.held_window() == fl.key) {
                    follow(s, fl, true);
                } else if (in_view || studio.over_view_in(s, fl.key, x, y)) {
                    s.hover(current(), x, y);
                }
                fl.ui.mouse_move(x, y);
            },
            Click(x, y, button) => {
                if (studio.over_view_in(s, fl.key, x, y)) {
                    in_view = true;
                    i32 b = match (button) {
                        Right => 1,
                        Middle => 2,
                        _ => 0,
                    };
                    s.press(current(), x, y, b, shift);
                } else {
                    fl.ui.mouse_move(x, y);
                    fl.ui.mouse_button(true);
                }
            },
            Release(x, y, button) => {
                if (in_view) {
                    in_view = false;
                    s.release();
                } else {
                    if (s.panes.held_window() == fl.key) {
                        follow(s, fl, false);
                    }
                    fl.ui.mouse_move(x, y);
                    fl.ui.mouse_button(false);
                }
            },
            Wheel(x, y) => {
                if (studio.over_view_in(s, fl.key, fl.mouse_x, fl.mouse_y)) {
                    s.wheel(y);
                } else {
                    fl.ui.scroll_wheel(y);
                }
            },
            _ => { },
        }
        return true;
    }

    override bool on_event(app.Event e) uses io, threads {
        studio.Studio* s = match (st) {
            some(x) => x,
            none => {
                return true;
            },
        };
        // the windows of the floating panels: their events go to them
        match (e) {
            Target(w) => {
                target = w;
                return true;
            },
            Closed(w) => {
                match (floater_of(w)) {
                    some(fl) => {
                        s.panes.dock_back(fl.key);
                    },
                    none => { },
                }
                return true;
            },
            _ => { },
        }
        if (target != main_id) {
            match (floater_of(target)) {
                some(fl) => {
                    return float_event(s, fl, e);
                },
                none => {
                    return true;
                },
            }
        }
        match (e) {
            Quit => {
                return false;
            },
            Key(code, down, mods) => {
                shift = mods.shift;
                if (down && code == 27) {
                    return false;
                }
                if (down && (code == 102 || code == 70) && !mods.ctrl) {
                    s.frame_selected();
                    return true;
                }
                ui.key(code, down, mods.shift, mods.ctrl || mods.command);
            },
            MouseMove(x, y) => {
                mouse_x = x;
                mouse_y = y;
                if (in_view || over_view(x, y)) {
                    s.hover(current(), x, y);
                }
                ui.mouse_move(x, y);
            },
            Click(x, y, button) => {
                if (over_view(x, y)) {
                    in_view = true;
                    i32 b = match (button) {
                        Right => 1,
                        Middle => 2,
                        _ => 0,
                    };
                    s.press(current(), x, y, b, shift);
                } else {
                    ui.mouse_move(x, y);
                    ui.mouse_button(true);
                }
            },
            Release(x, y, button) => {
                if (in_view) {
                    in_view = false;
                    s.release();
                } else {
                    ui.mouse_move(x, y);
                    ui.mouse_button(false);
                }
            },
            Wheel(x, y) => {
                if (over_view(mouse_x, mouse_y)) {
                    s.wheel(y);
                } else {
                    ui.scroll_wheel(y);
                }
            },
            _ => { },
        }
        return true;
    }

    override void on_frame(app.Window window) uses io, threads {
        ui64 now = app.now_ms();
        f32 dt = max(0.0, min(0.1, (now - last) as f32 / 1000.0));
        last = now;
        studio.Studio* s = match (st) {
            some(x) => x,
            none => {
                return;
            },
        };
        gpu.Device* d = match (screen) {
            some(x) => x,
            none => {
                return;
            },
        };
        s.update(dt);
        gpu.Frame frame = match (d.begin()) {
            some(f) => f,
            none => {
                return;
            },
        };
        if (surface.width != frame.width as i32 || surface.height != frame.height as i32) {
            pixels.free();
            pixels = Arena.new(1 * KB);
            surface = canvas.create(&pixels, frame.width as i32, frame.height as i32);
        }
        compose(&ui, &surface, s);
        marks.View v = current();
        bool shown = s.view.w >= 16.0;
        ui32 vw = v.w as ui32;
        ui32 vh = v.h as ui32;
        // the texture of the view, made again when the view changes size
        bool fits = match (view_target) {
            some(t) => t.width == vw && t.height == vh,
            none => false,
        };
        if (!fits && shown) {
            match (view_target) {
                some(t) => {
                    d.release_texture(t);
                },
                none => { },
            }
            view_target = match (d.target(vw, vh)) {
                ok(t) => some(t),
                err(e) => none,
            };
        }
        match (shown ? view_target : none) {
            some(t) => {
                s.g.render_into(frame, t);
                frame.blit(t, v.x as ui32, v.y as ui32, vw, vh);
            },
            none => { },
        }
        match (hud) {
            some(h) => {
                match (h.draw(frame, &surface)) {
                    ok => { },
                    err(e) => { },
                }
            },
            none => { },
        }
        frame.submit();
        sync_floats(s, d);
        for (Floater*? f in floaters) {
            match (f) {
                some(fl) => {
                    draw_float(s, d, fl);
                },
                none => { },
            }
        }
        match (ui.take_window_request()) {
            some(request) => {
                match (request) {
                    Minimize => {
                        app.minimize();
                    },
                    ToggleMaximize => {
                        app.toggle_maximize();
                    },
                    Close => {
                        app.request_quit();
                    },
                }
            },
            none => { },
        }
    }

    // A window opened for each floating panel of the dock, and closed when the panel is no longer
    // floating (docked again).
    void sync_floats(keeps studio.Studio* s, keeps gpu.Device* d) uses io {
        mut Arena scratch = Arena.new(1 * KB);
        defer scratch.free();
        i32[] keys = s.panes.windows(&scratch);
        for (usize i in 0..4) {
            match (floaters[i]) {
                some(fl) => {
                    mut bool kept = false;
                    for (i32 k in keys) {
                        kept = kept || k == fl.key;
                    }
                    if (!kept) {
                        fl.close(d);
                        floaters[i] = none;
                    }
                },
                none => { },
            }
        }
        for (i32 key in keys) {
            mut bool open = false;
            mut i32 free = -1;
            for (usize i in 0..4) {
                match (floaters[i]) {
                    some(fl) => {
                        open = open || fl.key == key;
                    },
                    none => {
                        free = free < 0 ? i as i32 : free;
                    },
                }
            }
            if (open) {
                continue;
            }
            canvas.Rect r = s.panes.window_rect(key);
            mut bool made = false;
            if (free >= 0) {
                match (app.open_window(app.Config{
                    title: s.panes.window_title(key),
                    width: r.w as i32,
                    height: r.h as i32
                })) {
                    some(w) => {
                        if (d.claim(w)) {
                            match (app.window_by_id(main_id)) {
                                some(m) => {
                                    i32[2] origin = m.position();
                                    w.move_to(origin[0] + r.x as i32, origin[1] + r.y as i32);
                                },
                                none => { },
                            }
                            Floater* fl = arena.new(Floater, key, w);
                            fl.ui.font = ui.font;
                            fl.hud = match (overlay.create(&fl.keep, d)) {
                                ok(o) => some(o),
                                err(e) => none,
                            };
                            floaters[free as usize] = some(fl);
                            made = true;
                        } else {
                            w.close();
                        }
                    },
                    none => { },
                }
            }
            if (!made) {
                s.panes.dock_back(key);  // no window for it: its panels stay docked
            }
        }
    }

    // A frame of the window of a floating panel.
    void draw_float(keeps studio.Studio* s, gpu.Device* d, keeps Floater* fl) uses io, threads {
        bool held = s.panes.held_window() == fl.key && s.panes.moves_window();
        if (held != fl.faded) {
            fl.faded = held;
            fl.window.set_opacity(held ? 0.6 : 1.0);  // the guides under it show through
        }
        gpu.Frame frame = match (d.begin_on(fl.window)) {
            some(f) => f,
            none => {
                return;
            },
        };
        if (fl.surface.width != frame.width as i32 || fl.surface.height != frame.height as i32) {
            fl.pixels.free();
            fl.pixels = Arena.new(1 * KB);
            fl.surface = canvas.create(&fl.pixels, frame.width as i32, frame.height as i32);
        }
        fl.surface.clear(canvas.Color{ r: 0, g: 0, b: 0, a: 0 });
        fl.ui.theme = some(look.Night());
        mut widgets.Frame f = widgets.begin(&fl.ui, &fl.surface, 0.0, 0.0);
        // where it is, in the coordinates of the window of the editor (those of the dock)
        i32[2] at = fl.window.position();
        mut i32[2] origin = [0, 0];
        match (app.window_by_id(main_id)) {
            some(m) => {
                origin = m.position();
            },
            none => { },
        }
        canvas.Rect place = canvas.Rect{
            x: (at[0] - origin[0]) as f32,
            y: (at[1] - origin[1]) as f32,
            w: fl.surface.width as f32,
            h: fl.surface.height as f32
        };
        studio.Floating(&f, s, fl.key, place);
        f.finish();
        if (s.view_in == fl.key && s.view.w >= 16.0 && s.view.h >= 16.0) {
            marks.View v = s.view;
            fl.view_target = fitted(d, fl.view_target, v.w as ui32, v.h as ui32);
            match (fl.view_target) {
                some(t) => {
                    s.g.render_into(frame, t);
                    frame.blit(t, v.x as ui32, v.y as ui32, v.w as ui32, v.h as ui32);
                },
                none => { },
            }
        }
        match (fl.hud) {
            some(h) => {
                match (h.draw(frame, &fl.surface)) {
                    ok => { },
                    err(e) => { },
                }
            },
            none => { },
        }
        frame.submit();
    }

    override void on_stop(app.Window window) uses io, threads {
        match (st) {
            some(s) => {
                // the panels as they are, for the next time
                mut Arena scratch = Arena.new(4 * KB);
                defer scratch.free();
                match (io.write_file(&scratch, layout_path(&scratch), s.panes.save(&scratch))) {
                    ok => { },
                    err(e) => { },
                }
                s.close();
            },
            none => { },
        }
        match (screen) {
            some(d) => {
                for (usize i in 0..4) {
                    match (floaters[i]) {
                        some(fl) => {
                            fl.close(d);
                            floaters[i] = none;
                        },
                        none => { },
                    }
                }
                match (view_target) {
                    some(t) => {
                        d.release_texture(t);
                    },
                    none => { },
                }
                match (hud) {
                    some(h) => {
                        h.release();
                    },
                    none => { },
                }
                d.close();
            },
            none => { },
        }
        pixels.free();
        arena.free();
    }
}

// The window drawn into a PNG, on a GPU without a window: the second crate chosen, seen from the
// camera of the editor.
i32 snapshot(str path) uses io, threads {
    mut Arena arena = Arena.new(4 * MB);
    defer arena.free();
    gpu.Device* d = match (gpu.open_headless(&arena, gpu.Options{ })) {
        ok(x) => x,
        err(e) => {
            io.print("sozo: no GPU ({})", gpu.last_error(&arena));
            return 77;
        },
    };
    defer d.close();
    render3d.Renderer*? r = match (render3d.create(&arena, d, render3d.Options{ })) {
        ok(x) => some(x),
        err(e) => none,
    };
    draw.Drawer*? dr = match (draw.drawer(&arena, d)) {
        ok(x) => some(x),
        err(e) => none,
    };
    overlay.Overlay* hud = match (overlay.create(&arena, d)) {
        ok(o) => o,
        err(e) => {
            return 1;
        },
    };
    str scene_file = "showcase/sozo/tests/level.json";  // the scene of examples/scene as it is
    studio.Studio* s = arena.new(studio.Studio, &arena, scene_file, read_scene(&arena, scene_file), r, dr);
    defer s.close();
    mut widgets.Ui ui = widgets.Ui{ };
    ui.custom_title_bar = true;
    load_font(&arena, &ui);
    s.chosen = 3;  // crate 2
    for (i32 i in 0..3) {
        s.update(1.0 / 60.0);
    }
    ui32 w = 1280;
    ui32 h = 760;
    mut canvas.Canvas c = canvas.create(&arena, w as i32, h as i32);
    for (i32 i in 0..3) {
        compose(&ui, &c, s);  // a few frames: the sizes of Auto come from the one before
    }
    marks.View v = view_of(s);
    // the mouse over the x arrow: lit
    linear.Vec3 at = s.position_of(match (s.selected()) {
        some(e) => e,
        none => s.g.world.entities(&arena)[0],
    });
    match (marks.project(v, at.add(linear.vec3(0.6, 0.0, 0.0)))) {
        some(p) => {
            s.hover(v, p[0], p[1]);
            s.hover(v, p[0], p[1]);
        },
        none => { },
    }
    compose(&ui, &c, s);
    mut i32 code = 1;
    match (d.target(w, h)) {
        ok(window) => {
            match (d.target(v.w as ui32, v.h as ui32)) {
                ok(view) => {
                    match (d.commands()) {
                        ok(frame) => {
                            s.g.render_into(frame, view);
                            frame.blit_into(view, window, v.x as ui32, v.y as ui32, v.w as ui32, v.h as ui32);
                            match (hud.draw_into(frame, window, &c)) {
                                ok => { },
                                err(e) => { },
                            }
                            match (frame.submit_and_wait()) {
                                ok => {
                                    match (d.read_texture(&arena, window)) {
                                        ok(img) => {
                                            match (png.save(&arena, path, img)) {
                                                ok => {
                                                    io.print("written to {}", path);
                                                    code = 0;
                                                },
                                                err(e) => { },
                                            }
                                        },
                                        err(e) => { },
                                    }
                                },
                                err(e) => { },
                            }
                        },
                        err(e) => { },
                    }
                },
                err(e) => { },
            }
        },
        err(e) => { },
    }
    hud.release();
    return code;
}

i32 main() uses io, threads {
    mut Arena arena = Arena.new(4 * KB);
    defer arena.free();
    str[] args = os.args(&arena);
    if (args.len == 2 && args[0] == "--snapshot") {
        return snapshot(args[1]);
    }
    Editor* ed = arena.new(Editor, scene_path(args));
    widgets.Window window = screen.SozoConfig();
    return app.run_window(
        app.Config{ title: window.title, width: window.width, height: window.height },
        ed as app.WindowHandler<uses threads>*
    );
}
