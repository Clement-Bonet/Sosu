// The window of Sozo (spec §10.2, §10.5): its title bar holds play and save; below, the panels
// (studio.Workspace, docked by `ui.dock`): the list of the entities, the view of the scene (drawn by
// the GPU through a hole of the canvas: main.sosu), the inspector (its fields depend on the
// components, studio.inspector). Its state is studio.sosu.
import sozo.look;
import sozo.studio;

window Sozo(keeps studio.Studio* s) uses io, threads {
    title: "Sozo"
    width: 1280
    height: 760

    TitleBar(height: 48, gap: 8, padding: 6) {
        Text("Sozo")
        Button(s.play_label(), on_click: s.toggle_play, style: look.Play)
        Button("Save", on_click: s.save_file)
        Button("Frame", on_click: s.frame_selected)
        Text(s.message, style: look.Muted)
    }
    studio.Workspace(s, 48.0)  // the panels, docked as the user arranges them (ui.dock)
}
