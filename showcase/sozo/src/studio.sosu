// sozo.studio: what the editor edits and how, without a window (checks.sosu drives it): the scene,
// its engine (paused while editing: nothing falls nor plays), the camera of the editor, the entity
// chosen, the gizmo that moves it, and playing (the scene saved, run as the game would, then read
// back as it was when stopped).
import std.io;
import std.vec;
import std.text;
import math.linear;
import math.geometry;
import scene.scene;
import scene.save;
import render.canvas;
import render3d.render3d;
import particles.draw;
import engine.components;
import engine.engine;
import editor.camera;
import editor.pick;
import editor.gizmo;
import editor.marks;
import editor.inspect;
import engine.describe;
import ui.widgets;
import ui.dock;

pub class Studio {
    Arena* keep;
    mut Arena level;  // the world, its components and its engine: made again by `load`
    pub mut engine.Engine* g;
    pub camera.Orbit* orbit;
    render3d.Renderer*? renderer;
    draw.Drawer*? drawer;
    pub mut str path;  // the file of the scene
    vec.Vec<scene.Entity>* order;  // the entities as the list shows them: each after its parent
    vec.Vec<str>* labels;
    pub mut i32 chosen;  // the row chosen in the list, -1: none
    pub mut bool playing;
    mut str before;  // the scene when it was played: what stopping brings back
    pub mut str message;
    pub mut f32 room;  // the height of the column of the inspector, in pixels
    pub dock.Dock* panes;  // the panels of the window: the list, the view, the inspector
    pub mut marks.View view;  // where the view is this frame (its size 0 when it is not shown)
    pub mut i32 view_in;  // the window it is in: -1 that of the editor, else a floating one (`ui.dock`)
    pub mut gizmo.Axis? hovered;
    mut gizmo.Drag? dragging;
    mut bool orbiting;
    mut bool panning;
    mut f32 last_x;
    mut f32 last_y;
    mut Arena words;

    void init(
        keeps Arena* keep,
        keeps str path,
        str source,
        keeps render3d.Renderer*? renderer,
        keeps draw.Drawer*? drawer
    ) keeps self uses io, threads {
        self.keep = keep;
        self.path = path;
        self.renderer = renderer;
        self.drawer = drawer;
        level = Arena.new(1 * MB);
        orbit = camera.orbit(keep);
        order = vec.new<scene.Entity>(keep);
        labels = vec.new<str>(keep);
        chosen = -1;
        playing = false;
        before = "";
        message = "";
        room = 600.0;
        panes = dock.dock(keep);
        panes.add("view", "Scene");
        panes.add("entities", "Entities");
        panes.add("inspector", "Inspector");
        panes.place("view", none, dock.Edge.Center, 1.0);
        panes.place("entities", some("view"), dock.Edge.Left, 0.19);
        panes.place("inspector", some("view"), dock.Edge.Right, 0.33);
        view = marks.View{ view_projection: linear.identity4(), x: 0.0, y: 0.0, w: 0.0, h: 0.0 };
        view_in = -1;
        panes.can_float = true;
        hovered = none;
        dragging = none;
        orbiting = false;
        panning = false;
        last_x = 0.0;
        last_y = 0.0;
        words = Arena.new(4 * KB);
        g = made(&level, source, renderer, drawer);
        list();
    }

    // ---- The scene ----

    // An engine of the scene `source` (an empty world when it cannot be read), with what the
    // scenes of the examples name made here.
    engine.Engine* made(
        keeps Arena* arena,
        str source,
        keeps render3d.Renderer*? r,
        keeps draw.Drawer*? d
    ) uses io, threads {
        scene.World* w = scene.world(arena);
        components.Components* c = components.components(arena, w);
        match (components.load_scene(arena, c, source)) {
            ok(reader) => { },
            err(e) => {
                message = text.repeat(keep, save.message(e), 1);
            },
        }
        engine.Engine* e = engine.engine(arena, c, none, r, d, none);
        e.adopt_model("crate", render3d.cube(arena, [0.72, 0.52, 0.3, 1.0]));
        e.adopt_model("ground", render3d.ground(arena, 20.0, [0.34, 0.4, 0.3, 1.0]));
        e.paused = true;
        e.update(0.0);
        return e;
    }

    // The scene `source` in place of the one edited.
    pub void load(str source) keeps self uses io, threads {
        g.close();
        level.free();
        level = Arena.new(1 * MB);
        g = made(&level, source, renderer, drawer);
        list();
    }

    // The rows of the list: each entity after its parent, indented by its depth.
    void list() {
        order.clear();
        labels.clear();
        mut Arena scratch = Arena.new(16 * KB);
        defer scratch.free();
        for (scene.Entity e in g.world.entities(&scratch)) {
            match (g.world.parent_of(e)) {
                some(p) => { },
                none => {
                    add_row(e, 0);
                },
            }
        }
    }

    void add_row(scene.Entity e, usize depth) {
        order.push(e);
        text.TextBuilder* t = text.builder(keep);
        for (usize i in 0..depth) {
            t.push("    ");
        }
        t.push(match (g.world.names.get(e)) {
            some(n) => *n,
            none => "(entity)",
        });
        labels.push(t.text());
        mut Arena scratch = Arena.new(4 * KB);
        defer scratch.free();
        for (scene.Entity child in g.world.children(&scratch, e)) {
            add_row(child, depth + 1);
        }
    }

    pub i32 rows() {
        return labels.len() as i32;
    }

    pub str name_at(i32 i) {
        return i >= 0 && i as usize < labels.len() ? labels.items()[i as usize] : "";
    }

    // The entity of the row `i` (that of the first row when there is none).
    pub scene.Entity order_at(i32 i) {
        return i >= 0 && i as usize < order.len() ? order.items()[i as usize] : order.items()[0];
    }

    // The entity chosen.
    pub scene.Entity? selected() {
        if (chosen < 0 || chosen as usize >= order.len()) {
            return none;
        }
        scene.Entity e = order.items()[chosen as usize];
        return g.world.alive(e) ? some(e) : none;
    }

    void choose(scene.Entity? e) {
        chosen = -1;
        match (e) {
            some(x) => {
                for (usize i in 0..order.len()) {
                    if (order.items()[i].same(x)) {
                        chosen = i as i32;
                    }
                }
            },
            none => { },
        }
    }

    // ---- Each frame ----

    pub void update(f32 dt) uses io, threads {
        words.free();
        words = Arena.new(4 * KB);
        g.paused = !playing;
        g.looking = playing ? none : some(orbit.camera());
        g.update(dt);
    }

    // ---- The mouse over the view ----

    // A button pressed at (x, y) of the canvas, in the view `v`: the left takes an arrow of the gizmo,
    // or chooses what is under it; the right turns the camera, the middle (or Shift and the right)
    // slides it.
    pub void press(marks.View v, f32 x, f32 y, i32 button, bool shift) uses io, threads {
        last_x = x;
        last_y = y;
        if (button == 1) {
            orbiting = !shift;
            panning = shift;
            return;
        }
        if (button == 2) {
            panning = true;
            return;
        }
        geometry.Ray r = match (marks.ray_at(v, x, y)) {
            some(found) => found,
            none => {
                return;
            },
        };
        if (!playing) {
            match (hovered) {
                some(a) => {
                    match (selected()) {
                        some(e) => {
                            dragging = gizmo.begin(a, position_of(e), r);
                            return;
                        },
                        none => { },
                    }
                },
                none => { },
            }
        }
        choose(match (pick.pick(g, r)) {
            some(h) => some(h.entity),
            none => none,
        });
    }

    pub void release() {
        dragging = none;
        orbiting = false;
        panning = false;
    }

    // The mouse moved to (x, y): it drags, turns, slides, or shows the arrow under it.
    pub void hover(marks.View v, f32 x, f32 y) {
        f32 dx = x - last_x;
        f32 dy = y - last_y;
        last_x = x;
        last_y = y;
        if (orbiting) {
            orbit.orbit(dx, dy);
            return;
        }
        if (panning) {
            orbit.pan(dx, dy, v.h);
            return;
        }
        match (dragging) {
            some(d) => {
                match (marks.ray_at(v, x, y)) {
                    some(r) => {
                        match (selected()) {
                            some(e) => {
                                place(e, gizmo.moved(d, r));
                            },
                            none => { },
                        }
                    },
                    none => { },
                }
                return;
            },
            none => { },
        }
        hovered = none;
        if (playing) {
            return;
        }
        match (selected()) {
            some(e) => {
                linear.Vec3 at = position_of(e);
                hovered = gizmo.hover(v, at, gizmo.length_at(v, at, orbit.position()), x, y);
            },
            none => { },
        }
    }

    pub void wheel(f32 steps) {
        orbit.zoom(steps);
    }

    // Where `e` is in the world.
    pub linear.Vec3 position_of(scene.Entity e) {
        return g.matrix_of(e).transform_point(linear.vec3(0.0, 0.0, 0.0));
    }

    // `e` moved so that it is at `at` in the world (its transform is in the space of its parent).
    pub void place(scene.Entity e, linear.Vec3 at) {
        linear.Vec3 local = match (g.world.parent_of(e)) {
            some(p) => match (g.matrix_of(p).inverse()) {
                some(inv) => inv.transform_point(at),
                none => at,
            },
            none => at,
        };
        mut linear.Transform t = match (g.world.transforms.get(e)) {
            some(x) => *x,
            none => linear.transform(),
        };
        t.position = local;
        g.world.transforms.set(e, t);
        g.world.propagate();
    }

    // The camera looking at what is chosen (F).
    pub void frame_selected() uses io, threads {
        match (selected()) {
            some(e) => {
                mut Arena scratch = Arena.new(16 * KB);
                defer scratch.free();
                linear.Vec3 at = position_of(e);
                geometry.Aabb box = match (pick.local_box(&scratch, g, e)) {
                    some(b) => b.transformed(g.matrix_of(e)),
                    none => geometry.aabb(at.sub(linear.vec3(0.5, 0.5, 0.5)), at.add(linear.vec3(0.5, 0.5, 0.5))),
                };
                orbit.frame(box);
            },
            none => { },
        }
    }

    // ---- Playing, saving ----

    // Played as the game would, or stopped: the scene as it was before it played.
    pub void toggle_play() keeps self uses io, threads {
        if (!playing) {
            before = text.repeat(keep, components.save_scene(&words, g.c), 1);
            playing = true;
            hovered = none;
            dragging = none;
            return;
        }
        playing = false;
        i32 kept = chosen;
        load(before);
        chosen = kept < rows() ? kept : -1;
    }

    pub str play_label() {
        return playing ? "Stop" : "Play";
    }

    // The scene written to its file.
    pub void save_file() uses io {
        if (playing) {
            message = "stop playing to save";
            return;
        }
        str written = components.save_scene(&words, g.c);
        text.TextBuilder* t = text.builder(keep);
        match (io.write_file(&words, path, written)) {
            ok => {
                t.push("saved to ");
            },
            err(e) => {
                t.push("cannot write ");
            },
        }
        t.push(path);
        message = t.text();
    }

    // ---- What the interface shows ----

    // What the entity chosen is, a line each: its name, where it is, its components.
    pub str details() {
        scene.Entity e = match (selected()) {
            some(x) => x,
            none => {
                return "Nothing chosen: click an entity in the view or the list.";
            },
        };
        text.TextBuilder* t = text.builder(&words);
        linear.Vec3 at = position_of(e);
        t.push("At ");
        t.push_f64(at.x as f64, 2);
        t.push(", ");
        t.push_f64(at.y as f64, 2);
        t.push(", ");
        t.push_f64(at.z as f64, 2);
        return t.text();
    }

    pub str kinds() {
        scene.Entity e = match (selected()) {
            some(x) => x,
            none => {
                return "";
            },
        };
        components.Components* c = g.c;
        text.TextBuilder* t = text.builder(&words);
        if (c.meshes.has(e)) {
            t.push("mesh  ");
        }
        if (c.bodies.has(e)) {
            t.push("body  ");
        }
        if (c.lights.has(e)) {
            t.push("light  ");
        }
        if (c.views.has(e)) {
            t.push("view  ");
        }
        if (c.sounds.has(e)) {
            t.push("sound  ");
        }
        if (c.emitters.has(e)) {
            t.push("emitter  ");
        }
        if (c.animators.has(e)) {
            t.push("animator  ");
        }
        return t.text();
    }

    pub str title() {
        return match (selected()) {
            some(e) => match (g.world.names.get(e)) {
                some(n) => *n,
                none => "(entity)",
            },
            none => "Scene",
        };
    }

    // The inspector, in a column `height` pixels high: where the entity chosen is, then the fields
    // of each of its components, changed at once (while it plays, what it was given is made again).
    pub void inspector(widgets.Frame* f, f32 width, f32 height) keeps self uses io, threads {
        f.scroll(width, height);
        f.column(12.0, 14.0);
        scene.Entity e = match (selected()) {
            some(x) => x,
            none => {
                f.title("Scene");
                f.label("Nothing chosen: click an entity");
                f.label("in the view or the list.");
                f.space(12.0);
                f.label("Left: choose; an arrow: move");
                f.label("Right drag: turn");
                f.label("Shift + right, middle: slide");
                f.label("Wheel: nearer, farther");
                f.label("F: frame what is chosen");
                f.end();
                f.end_scroll();
                return;
            },
        };
        f.title(title());
        mut bool changed = false;
        match (g.world.transforms.get(e)) {
            some(t) => {
                if (inspect.transform(f, t)) {
                    g.world.propagate();
                    changed = true;
                }
            },
            none => { },
        }
        components.Components* c = g.c;
        match (c.meshes.get(e)) {
            some(x) => {
                changed = inspect.fields(f, "Mesh", c.mesh_fields as describe.Describe<components.Mesh>*, x, 1, keep)
                        || changed;
            },
            none => { },
        }
        match (c.lights.get(e)) {
            some(x) => {
                changed = inspect.fields(f, "Light", c.light_fields as describe.Describe<components.Light>*, x, 2, keep)
                        || changed;
            },
            none => { },
        }
        match (c.views.get(e)) {
            some(x) => {
                changed = inspect.fields(f, "View", c.view_fields as describe.Describe<components.View>*, x, 3, keep)
                        || changed;
            },
            none => { },
        }
        match (c.bodies.get(e)) {
            some(x) => {
                changed = inspect.fields(f, "Body", c.body_fields as describe.Describe<components.Body>*, x, 4, keep)
                        || changed;
            },
            none => { },
        }
        match (c.sounds.get(e)) {
            some(x) => {
                changed = inspect.fields(f, "Sound", c.sound_fields as describe.Describe<components.Sound>*, x, 5, keep)
                        || changed;
            },
            none => { },
        }
        match (c.emitters.get(e)) {
            some(x) => {
                changed = inspect.fields(
                    f,
                    "Emitter",
                    c.emitter_fields as describe.Describe<components.Emitter>*,
                    x,
                    6,
                    keep
                ) || changed;
            },
            none => { },
        }
        match (c.animators.get(e)) {
            some(x) => {
                changed = inspect.fields(
                    f,
                    "Animator",
                    c.animator_fields as describe.Describe<components.Animator>*,
                    x,
                    7,
                    keep
                ) || changed;
            },
            none => { },
        }
        if (changed && playing) {
            g.refresh(e);
        }
        f.end();
        f.end_scroll();
    }

    // What is drawn over the view: the grid, the places of what has no mesh, the box of what is
    // chosen and its arrows.
    pub void marks_over(canvas.Canvas* c, marks.View v) uses io, threads {
        if (!playing) {
            marks.grid(c, v, 10.0, 1.0);
        }
        mut Arena scratch = Arena.new(16 * KB);
        defer scratch.free();
        components.Components* k = g.c;
        for (scene.Entity e in g.world.entities(&scratch)) {
            if (!k.meshes.has(e) && (k.lights.has(e) || k.views.has(e) || k.sounds.has(e) || k.emitters.has(e))) {
                canvas.Color color = k.lights.has(e) ? canvas.Color{ r: 250, g: 210, b: 90 }
                        : k.views.has(e) ? canvas.Color{ r: 120, g: 200, b: 250 }
                        : canvas.Color{ r: 200, g: 160, b: 250 };
                marks.marker(c, v, position_of(e), color);
            }
        }
        match (selected()) {
            some(e) => {
                match (pick.local_box(&scratch, g, e)) {
                    some(b) => {
                        mut linear.Mat4 m = g.matrix_of(e);
                        if (!k.meshes.has(e) && k.bodies.has(e)) {
                            linear.Transform t = linear.decompose(m);
                            m = linear.translation(t.position).mul(t.rotation.to_mat4());
                        }
                        if (!k.meshes.has(e) && !k.bodies.has(e)) {
                            m = linear.translation(position_of(e));
                        }
                        marks.box(c, v, b, m, canvas.Color{ r: 255, g: 190, b: 60 });
                    },
                    none => { },
                }
                if (!playing) {
                    linear.Vec3 at = position_of(e);
                    gizmo.draw(c, v, at, gizmo.length_at(v, at, orbit.position()), match (dragging) {
                        some(d) => some(d.axis),
                        none => hovered,
                    });
                }
            },
            none => { },
        }
    }

    pub void close() {
        g.close();
        level.free();
        words.free();
    }
}

// The inspector as a component of the interface (screen.ui.sosu calls it as one): written in code,
// since its fields depend on the components of what is chosen.
pub void Inspector(widgets.Frame* ui_frame, keeps Studio* s, f32 width, f32 height) uses io, threads {
    s.inspector(ui_frame, width, height);
}

// The view of the scene at (x, y) and the mouse not on a panel over it: a click there is for the
// view.
pub bool over_view(Studio* s, f32 x, f32 y) {
    marks.View v = s.view;
    return v.w > 0.0 && s.view_in < 0 && x >= v.x && y >= v.y && x < v.x + v.w && y < v.y + v.h
            && !s.panes.covers(x, y);
}

// The same in the window of the floating panel `window`.
pub bool over_view_in(Studio* s, i32 window, f32 x, f32 y) {
    marks.View v = s.view;
    return v.w > 0.0 && s.view_in == window && x >= v.x && y >= v.y && x < v.x + v.w && y < v.y + v.h
            && s.panes.held_window() < 0;
}

// What the panel `id` shows, in `r` of the frame `f` (in the window `window`: "" that of the
// editor, else the floating panel's own).
void panel(widgets.Frame* f, keeps Studio* s, str id, canvas.Rect r, i32 window) uses io, threads {
    canvas.Canvas* c = f.drawing();
    if (id == "entities") {
        f.list(r.w, r.h, some(&s.chosen));
        for (i32 i in 0..s.rows()) {
            f.label(s.name_at(i));
        }
        f.end_list();
    } else if (id == "inspector") {
        s.room = r.h;
        s.inspector(f, r.w, r.h);
    } else if (id == "view" && r.w >= 16.0 && r.h >= 16.0) {
        marks.View v = marks.view(s.g.camera(), r.x, r.y, r.w, r.h);
        s.view = v;
        s.view_in = window;
        c.erase(r);
        s.marks_over(c, v);
    }
}

// The floating window `k` (`ui.dock`), at `place` of the window of the editor: its panels, as
// the user arranged them there (held by a tab or its strip, they go where the guides say), its pin.
pub void Floating(widgets.Frame* ui_frame, keeps Studio* s, i32 k, canvas.Rect place) uses io, threads {
    dock.Dock* d = s.panes;
    dock.begin_window(ui_frame, d, k, place);
    while (dock.next(ui_frame, d)) {
        str id = d.current();
        panel(ui_frame, s, id, d.rect_of(id), k);
    }
    dock.end_window(ui_frame, d);
}

// The panels of the window, below its title bar (`top` points high), as the user arranged them
// (`ui.dock`): the list of the entities, the view of the scene, the inspector. The view leaves a
// hole in the canvas, where the scene drawn by the GPU shows, and the marks of the editor are drawn
// into it, under what the dock draws after (a panel that slides out, the guides of a drag).
pub void Workspace(widgets.Frame* ui_frame, keeps Studio* s, f32 top) uses io, threads {
    widgets.Frame* f = ui_frame;
    canvas.Canvas* c = f.drawing();
    f32 y = top * f.ui_scale();
    dock.Dock* d = s.panes;
    dock.begin(f, d, canvas.Rect{ x: 0.0, y: y, w: c.width as f32, h: max(0.0, c.height as f32 - y) });
    // the view is placed again by whichever window shows it this frame (this one first)
    s.view = marks.View{ view_projection: linear.identity4(), x: 0.0, y: 0.0, w: 0.0, h: 0.0 };
    s.view_in = -1;
    while (dock.next(f, d)) {
        str id = d.current();
        panel(f, s, id, d.rect_of(id), -1);
    }
    dock.end(f, d);
}
