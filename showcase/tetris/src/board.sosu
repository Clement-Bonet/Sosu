// tetris.board: the rules of the game, with no window: the pieces and their turns, the walls,
// the lines that go, the score, the next pieces and the hold. Time is given by the caller, who
// calls `tick` as often as gravity wants.
pub i32 COLS = 10;
pub i32 ROWS = 20;
pub i32 KINDS = 7;

// The seven pieces in a box of 4 by 4, row by row: I O T S Z J L.
str shape(i32 kind) {
    str[7] shapes = [
        "....####........",
        ".##..##.........",
        ".#..###.........",
        ".##.##..........",
        "##...##.........",
        "#...###.........",
        "..#.###.........",
    ];
    return shapes[kind as usize];
}


// Is the square `i` (0 to 15, row by row) of the piece `kind` turned `rot` quarters filled?
pub bool filled(i32 kind, i32 rot, i32 i) {
    return shape(kind).bytes[back(i % 4, i / 4, rot & 3) as usize] == 35;
}

// Where the square (x, y) of a piece turned `rot` quarters comes from in the shape: a quarter
// turn sends (x, y) to (3 - y, x), so it is undone `rot` times.
i32 back(i32 x, i32 y, i32 rot) {
    mut i32 sx = x;
    mut i32 sy = y;
    for (i32 turn in 0..rot) {
        i32 nx = sy;
        sy = 3 - sx;
        sx = nx;
    }
    return sy * 4 + sx;
}

pub class Game {
    pub mut ui8[200] cells;  // 0: empty, else the kind of the piece + 1
    pub mut i32 kind;  // the piece that falls
    pub mut i32 rot;
    pub mut i32 px;  // the corner of its box
    pub mut i32 py;
    pub mut i32 hold;  // -1: nothing held
    pub mut bool held;  // the hold was used for this piece
    pub mut i32[14] bag;
    pub mut i32 taken;
    pub mut i64 score;
    pub mut i32 lines;
    pub mut i32 level;
    pub mut bool over;
    pub mut bool paused;
    pub mut i32 flash;  // lines cleared by the last lock, for the display
    mut ui64 state;

    void init(ui64 seed) {
        cells = [0; 200];
        bag = [0; 14];
        restart(seed);
    }

    pub void restart(ui64 seed) {
        cells = [0; 200];
        bag = [0; 14];
        state = wrapping_add(wrapping_mul(seed, 2862933555777941757 as ui64), 3037000493 as ui64);
        hold = -1;
        held = false;
        taken = 0;
        score = 0;
        lines = 0;
        level = 1;
        over = false;
        paused = false;
        flash = 0;
        kind = 0;
        rot = 0;
        px = 3;
        py = 0;
        fill_bag(0);
        fill_bag(7);
        spawn();
    }

    i32 random(i32 below) {
        state = wrapping_add(wrapping_mul(state, 6364136223846793005 as ui64), 1442695040888963407 as ui64);
        return ((state >> 33) % below as ui64) as i32;
    }

    // Seven pieces, each once, shuffled: no long drought of any piece.
    void fill_bag(i32 at) {
        for (i32 i in 0..7) {
            bag[(at + i) as usize] = i;
        }
        mut i32 i = 6;
        while (i > 0) {
            i32 j = random(i + 1);
            i32 t = bag[(at + i) as usize];
            bag[(at + i) as usize] = bag[(at + j) as usize];
            bag[(at + j) as usize] = t;
            i -= 1;
        }
    }

    // The piece that comes after the one falling, `ahead` = 0 for the next.
    pub i32 upcoming(i32 ahead) {
        return bag[(taken + ahead) as usize];
    }

    pub i32 cell(i32 x, i32 y) {
        return cells[(y * COLS + x) as usize] as i32;
    }

    // Does the piece fit at this place: inside the walls, on empty squares?
    pub bool fits(i32 k, i32 r, i32 x, i32 y) {
        for (i32 i in 0..16) {
            if (!filled(k, r, i)) {
                continue;
            }
            i32 cx = x + i % 4;
            i32 cy = y + i / 4;
            if (cx < 0 || cx >= COLS || cy >= ROWS) {
                return false;
            }
            if (cy >= 0 && cell(cx, cy) != 0) {
                return false;
            }
        }
        return true;
    }

    void spawn() {
        kind = bag[taken as usize];
        taken += 1;
        if (taken == 7) {  // the second bag becomes the first
            for (i32 i in 0..7) {
                bag[i as usize] = bag[(i + 7) as usize];
            }
            taken = 0;
            fill_bag(7);
        }
        rot = 0;
        px = 3;
        py = kind == 0 ? -1 : 0;
        held = false;
        if (!fits(kind, rot, px, py)) {
            over = true;
        }
    }

    pub bool step(i32 dx) {
        if (over || paused || !fits(kind, rot, px + dx, py)) {
            return false;
        }
        px += dx;
        return true;
    }

    // A turn of `dir` (1 or -1), pushed aside by one or two squares if it hits a wall.
    pub bool turn(i32 dir) {
        if (over || paused) {
            return false;
        }
        i32 r = (rot + dir + 4) & 3;
        for (i32 k in 0..5) {
            i32 shift = k == 0 ? 0 : (k % 2 == 1 ? -((k + 1) / 2) : k / 2);
            if (fits(kind, r, px + shift, py)) {
                rot = r;
                px += shift;
                return true;
            }
        }
        return false;
    }

    // One row down; false when the piece rests.
    pub bool fall() {
        if (over || paused || !fits(kind, rot, px, py + 1)) {
            return false;
        }
        py += 1;
        return true;
    }

    // One tick of gravity: down, or locked when it rests.
    pub void tick() {
        if (over || paused) {
            return;
        }
        if (!fall()) {
            lock();
        }
    }

    pub void soft_drop() {
        if (fall()) {
            score += 1;
        }
    }

    pub i32 ghost() {
        mut i32 y = py;
        while (fits(kind, rot, px, y + 1)) {
            y += 1;
        }
        return y;
    }

    pub void hard_drop() {
        if (over || paused) {
            return;
        }
        i32 y = ghost();
        score += (y - py) as i64 * 2;
        py = y;
        lock();
    }

    pub void swap() {
        if (over || paused || held) {
            return;
        }
        i32 old = hold;
        hold = kind;
        if (old < 0) {
            spawn();
        } else {
            kind = old;
            rot = 0;
            px = 3;
            py = kind == 0 ? -1 : 0;
        }
        held = true;
    }

    // The piece joins the cells; full rows go; the next piece comes.
    void lock() {
        for (i32 i in 0..16) {
            if (filled(kind, rot, i)) {
                i32 cx = px + i % 4;
                i32 cy = py + i / 4;
                if (cy < 0) {
                    over = true;
                    return;
                }
                cells[(cy * COLS + cx) as usize] = (kind + 1) as ui8;
            }
        }
        mut i32 gone = 0;
        mut i32 y = ROWS - 1;
        while (y >= 0) {
            mut bool full = true;
            for (i32 x in 0..COLS) {
                if (cell(x, y) == 0) {
                    full = false;
                }
            }
            if (full) {
                gone += 1;
                mut i32 r = y;
                while (r > 0) {
                    for (i32 x in 0..COLS) {
                        cells[(r * COLS + x) as usize] = cells[((r - 1) * COLS + x) as usize];
                    }
                    r -= 1;
                }
                for (i32 x in 0..COLS) {
                    cells[x as usize] = 0;
                }
            } else {
                y -= 1;
            }
        }
        flash = gone;
        if (gone > 0) {
            i64[5] worth = [0, 100, 300, 500, 800];
            score += worth[gone as usize] * level as i64;
            lines += gone;
            level = lines / 10 + 1;
        }
        spawn();
    }

    // The time between two ticks of gravity, in ms.
    pub i64 interval() {
        i64 ms = 800 - (level as i64 - 1) * 70;
        return ms < 80 ? 80 : ms;
    }
}
