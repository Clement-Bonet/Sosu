import testing.check;
import tetris.board;

i32 count(i32 kind, i32 rot) {
    mut i32 n = 0;
    for (i32 i in 0..16) {
        if (board.filled(kind, rot, i)) {
            n += 1;
        }
    }
    return n;
}

test "every piece has four squares in each turn" {
    for (i32 k in 0..7) {
        for (i32 r in 0..4) {
            assert(count(k, r) == 4);
        }
    }
}

test "four turns come back" {
    mut Arena arena = Arena.new(16 * KB);
    defer arena.free();
    board.Game* g = new_game(&arena);
    for (i32 i in 0..4) {
        assert(g.turn(1));
    }
    assert(g.rot == 0);
}

test "a piece stays inside the walls" {
    mut Arena arena = Arena.new(16 * KB);
    defer arena.free();
    board.Game* g = new_game(&arena);
    for (i32 i in 0..20) {
        g.step(-1);
    }
    assert(g.fits(g.kind, g.rot, g.px, g.py));
    assert(!g.step(-1));
    for (i32 i in 0..20) {
        g.step(1);
    }
    assert(!g.step(1));
    assert(g.fits(g.kind, g.rot, g.px, g.py));
}

test "a hard drop locks the piece on the floor" {
    mut Arena arena = Arena.new(16 * KB);
    defer arena.free();
    board.Game* g = new_game(&arena);
    i32 first = g.kind;
    g.hard_drop();
    mut i32 filled = 0;
    for (i32 x in 0..board.COLS) {
        if (g.cell(x, board.ROWS - 1) == first + 1) {
            filled += 1;
        }
    }
    assert(filled > 0);
    assert(g.score > 0);
    assert(!g.over);
}

test "a full row goes, and the score follows" {
    mut Arena arena = Arena.new(16 * KB);
    defer arena.free();
    board.Game* g = new_game(&arena);
    for (i32 x in 0..board.COLS) {
        g.cells[(19 * board.COLS + x) as usize] = x == 0 ? 0 : 1;
    }
    for (i32 x in 0..board.COLS) {
        g.cells[(18 * board.COLS + x) as usize] = x == 0 ? 0 : 2;
    }
    g.kind = 0;
    g.rot = 1;  // an I, upright
    g.px = -2;  // its column is the first square of the box + 2
    g.py = 16;
    assert(g.fits(g.kind, g.rot, g.px, g.py));
    g.hard_drop();
    assert(g.lines == 2);
    assert(g.score >= 300);
}

test "the hold swaps once per piece" {
    mut Arena arena = Arena.new(16 * KB);
    defer arena.free();
    board.Game* g = new_game(&arena);
    i32 first = g.kind;
    g.swap();
    assert(g.hold == first);
    i32 second = g.kind;
    g.swap();
    assert(g.hold == first && g.kind == second);
    g.hard_drop();
    g.swap();
    assert(g.hold != first);
}

test "the pieces come in bags of seven" {
    mut Arena arena = Arena.new(16 * KB);
    defer arena.free();
    board.Game* g = new_game(&arena);
    mut i32[7] seen = [0; 7];
    seen[g.kind as usize] += 1;
    for (i32 i in 0..6) {
        seen[g.upcoming(i) as usize] += 1;
    }
    for (i32 k in 0..7) {
        assert(seen[k as usize] == 1);
    }
}

test "the stack reaches the top: game over" {
    mut Arena arena = Arena.new(16 * KB);
    defer arena.free();
    board.Game* g = new_game(&arena);
    for (i32 i in 0..200) {
        if (!g.over) {
            g.hard_drop();
        }
    }
    assert(g.over);
    assert(!g.step(1));
}

test "gravity speeds up with the level" {
    mut Arena arena = Arena.new(16 * KB);
    defer arena.free();
    board.Game* g = new_game(&arena);
    i64 slow = g.interval();
    g.level = 6;
    assert(g.interval() < slow);
    g.level = 99;
    assert(g.interval() == 80);
}

board.Game* new_game(Arena* arena) {
    return arena.new(board.Game, 7);
}
