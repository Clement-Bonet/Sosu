// Tetris: left and right move, Up or X turn, Z turns back, Down drops faster, Space drops at once,
// C holds a piece, P pauses, Enter starts again, Escape quits.
// On Windows: run Sosu/packages/platform/fetch-sdl3.ps1 once, then `sosuc run Tetris`.
// `--snapshot out.png` writes a game in progress in a picture, without opening a window.
import std.io;
import std.os;
import std.text;
import std.time;
import platform.app;
import render.canvas;
import render.truetype;
import image.png;
import tetris.board;
import tetris.checks;

f32 CELL = 28.0;
f32 LEFT = 30.0;
f32 TOP = 50.0;

canvas.Color color_of(i32 kind) {
    if (kind == 0) {
        return canvas.Color{ r: 64, g: 200, b: 220 };
    }
    if (kind == 1) {
        return canvas.Color{ r: 240, g: 210, b: 64 };
    }
    if (kind == 2) {
        return canvas.Color{ r: 170, g: 90, b: 210 };
    }
    if (kind == 3) {
        return canvas.Color{ r: 90, g: 200, b: 100 };
    }
    if (kind == 4) {
        return canvas.Color{ r: 220, g: 80, b: 80 };
    }
    if (kind == 5) {
        return canvas.Color{ r: 80, g: 110, b: 220 };
    }
    return canvas.Color{ r: 240, g: 150, b: 60 };
}

class App : app.Handler {
    board.Game* game;
    mut truetype.Font*? face;
    mut i64 last_tick;
    mut i64 best;
    mut i64 seed;
    mut bool started;

    void init(keeps board.Game* game, i64 seed) {
        self.game = game;
        face = none;
        last_tick = 0;
        best = 0;
        self.seed = seed;
        started = false;
    }

    void restart(i64 now) {
        if (game.score > best) {
            best = game.score;
        }
        seed += 1;
        game.restart(seed as ui64);
        last_tick = now;
    }

    override bool on_event(app.Event e) uses io {
        match (e) {
            Quit => {
                return false;
            },
            Key(code, down, mods) => {
                if (!down) {
                    return true;
                }
                if (code == 27) {
                    return false;
                }
                if (code == 13) {
                    restart(app.now_ms() as i64);
                } else if (code == 112) {  // p
                    game.paused = !game.paused;
                    last_tick = app.now_ms() as i64;
                } else if (code == 1073741904) {
                    game.step(-1);
                } else if (code == 1073741903) {
                    game.step(1);
                } else if (code == 1073741906 || code == 120) {  // Up, x
                    game.turn(1);
                } else if (code == 122) {  // z
                    game.turn(-1);
                } else if (code == 1073741905) {
                    game.soft_drop();
                } else if (code == 32) {
                    game.hard_drop();
                    last_tick = app.now_ms() as i64;
                } else if (code == 99) {  // c
                    game.swap();
                }
            },
            _ => { },
        }
        return true;
    }

    override void on_frame(canvas.Canvas* surface) uses io {
        i64 now = app.now_ms() as i64;
        if (!started) {
            started = true;
            last_tick = now;
        }
        while (now - last_tick >= game.interval() && !game.over && !game.paused) {
            last_tick += game.interval();
            game.tick();
        }
        if (game.paused || game.over) {
            last_tick = now;
        }
        paint(surface);
    }

    void say(canvas.Canvas* surface, f32 x, f32 y, f32 size, str words, canvas.Color color) {
        match (face) {
            some(font) => {
                surface.text_with(font, size, x, y, words, color);
            },
            none => {
                surface.text(x, y, words, color, 1);
            },
        }
    }

    void square(canvas.Canvas* surface, f32 x, f32 y, f32 size, canvas.Color color) {
        surface.fill(canvas.Rect{ x: x + 1.0, y: y + 1.0, w: size - 2.0, h: size - 2.0 }, color);
        surface.fill(canvas.Rect{ x: x + 1.0, y: y + 1.0, w: size - 2.0, h: 3.0 }, canvas.Color{ r: 255, g: 255, b: 255, a: 70 });
    }

    // A piece alone in a box, for the next one and the hold.
    void preview(canvas.Canvas* surface, i32 kind, f32 x, f32 y) {
        if (kind < 0) {
            return;
        }
        for (i32 i in 0..16) {
            if (board.filled(kind, 0, i)) {
                square(surface, x + (i % 4) as f32 * 20.0, y + (i / 4) as f32 * 20.0, 20.0, color_of(kind));
            }
        }
    }

    void number(canvas.Canvas* surface, f32 y, str label, i64 value) {
        say(surface, 340.0, y, 13.0, label, canvas.Color{ r: 140, g: 146, b: 170 });
        mut Arena scratch = Arena.new(1 * KB);
        defer scratch.free();
        text.TextBuilder* b = text.builder(&scratch);
        b.push_i64(value);
        say(surface, 340.0, y + 16.0, 24.0, b.text(), canvas.Color{ r: 238, g: 240, b: 248 });
    }

    void paint(canvas.Canvas* surface) {
        surface.clear(canvas.Color{ r: 20, g: 22, b: 32 });
        f32 w = COLS_W();
        surface.fill(canvas.Rect{ x: LEFT - 4.0, y: TOP - 4.0, w: w + 8.0, h: CELL * 20.0 + 8.0 }, canvas.Color{ r: 60, g: 66, b: 90 });
        surface.fill(canvas.Rect{ x: LEFT, y: TOP, w: w, h: CELL * 20.0 }, canvas.Color{ r: 12, g: 13, b: 20 });
        for (i32 y in 0..board.ROWS) {
            for (i32 x in 0..board.COLS) {
                i32 c = game.cell(x, y);
                if (c != 0) {
                    square(surface, LEFT + x as f32 * CELL, TOP + y as f32 * CELL, CELL, color_of(c - 1));
                }
            }
        }
        if (!game.over) {
            i32 low = game.ghost();
            for (i32 i in 0..16) {
                if (!board.filled(game.kind, game.rot, i)) {
                    continue;
                }
                f32 x = LEFT + (game.px + i % 4) as f32 * CELL;
                f32 gy = TOP + (low + i / 4) as f32 * CELL;
                surface.stroke(canvas.Rect{ x: x + 2.0, y: gy + 2.0, w: CELL - 4.0, h: CELL - 4.0 }, color_of(game.kind), 1.0);
                f32 y = TOP + (game.py + i / 4) as f32 * CELL;
                if (y >= TOP) {
                    square(surface, x, y, CELL, color_of(game.kind));
                }
            }
        }
        say(surface, LEFT, 12.0, 26.0, "Tetris", canvas.Color{ r: 238, g: 240, b: 248 });
        say(surface, 340.0, 50.0, 13.0, "Next", canvas.Color{ r: 140, g: 146, b: 170 });
        preview(surface, game.upcoming(0), 340.0, 70.0);
        say(surface, 340.0, 160.0, 13.0, "Hold", canvas.Color{ r: 140, g: 146, b: 170 });
        preview(surface, game.hold, 340.0, 180.0);
        number(surface, 280.0, "Score", game.score);
        number(surface, 350.0, "Level", game.level as i64);
        number(surface, 420.0, "Lines", game.lines as i64);
        number(surface, 490.0, "Best", best > game.score ? best : game.score);
        say(surface, 340.0, 570.0, 11.0, "Arrows move, X Z turn", canvas.Color{ r: 110, g: 116, b: 140 });
        say(surface, 340.0, 586.0, 11.0, "Space drops, C holds", canvas.Color{ r: 110, g: 116, b: 140 });
        say(surface, 340.0, 602.0, 11.0, "P pauses, Enter restarts", canvas.Color{ r: 110, g: 116, b: 140 });
        if (game.over || game.paused) {
            surface.fill(canvas.Rect{ x: LEFT, y: TOP + 230.0, w: w, h: 90.0 }, canvas.Color{ r: 0, g: 0, b: 0, a: 190 });
            say(surface, LEFT + 60.0, TOP + 244.0, 28.0, game.over ? "Game over" : "Paused", canvas.Color{ r: 238, g: 240, b: 248 });
            say(surface, LEFT + 56.0, TOP + 286.0, 14.0, game.over ? "Enter to play again" : "P to go on", canvas.Color{ r: 140, g: 146, b: 170 });
        }
    }
}

f32 COLS_W() {
    return CELL * 10.0;
}

i32 main() uses io, time {
    mut Arena arena = Arena.new(64 * KB);
    defer arena.free();
    i64 seed = time.unix_seconds();
    board.Game* game = arena.new(board.Game, seed as ui64);
    App* handler = arena.new(App, game, seed);
    match (app.read_asset(&arena, "assets/NotoSans-Regular.ttf")) {
        some(bytes) => {
            match (truetype.parse(&arena, bytes)) {
                ok(font) => {
                    handler.face = some(font);
                },
                err(e) => {
                    io.print("Noto Sans is not readable: the built-in font is used");
                },
            }
        },
        none => {
            io.print("Noto Sans not found: the built-in font is used");
        },
    }
    str[] args = os.args(&arena);
    if (args.len >= 2 && args[0] == "--snapshot") {
        return snapshot(&arena, handler, game, args[1]);
    }
    return app.run(app.Config{ title: "Tetris", width: 480, height: 640 }, handler as app.Handler*);
}

// A game in progress, played by a fixed pattern, in a picture.
i32 snapshot(Arena* arena, App* handler, board.Game* game, str file) uses io {
    for (i32 n in 0..14) {
        i32 dx = (n * 4) % 9 - 4;
        for (i32 s in 0..9) {
            game.step(dx < 0 ? -1 : 1);
            if (s + 1 >= (dx < 0 ? -dx : dx)) {
                break;
            }
        }
        for (i32 r in 0..(n % 4)) {
            game.turn(1);
        }
        game.hard_drop();
    }
    game.swap();
    game.fall();
    game.fall();
    game.score = 4200;
    game.lines = 12;
    game.level = 2;
    handler.best = 9800;
    mut canvas.Canvas surface = canvas.create(arena, 480, 640);
    handler.paint(&surface);
    match (png.save(arena, file, surface.image())) {
        ok() => {
            io.print("written to {}", file);
            return 0;
        },
        err(e) => {
            io.print("cannot write {}", file);
            return 1;
        },
    }
}
