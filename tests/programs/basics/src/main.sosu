// Covers the language that code generation supports: run with `sosuc run`.
import std.io;

enum Shape {
    Circle(f32 radius),
    Rect(f32 w, f32 h),
    Empty,
}

f32 area(Shape s) {
    return match (s) {
        Circle(r) => 3.0 * r * r,
        Rect(w, h) => w * h,
        Empty => 0.0,
    };
}

struct Point {
    mut f32 x;
    f32 y;

    f32 length_squared() { return x * x + y * y; }
}

enum ParseError { Empty, NotADigit }

i32!ParseError digit(str s) {
    if (s.len == 0) { return err(Empty); }
    u8 c = s.bytes[0];
    if (c < 48 || c > 57) { return err(NotADigit); }
    return ok((c - 48) as i32);
}

i32!ParseError twice(str s) {
    i32 n = try digit(s);
    return ok(n * 2);
}

i32 clamp(i32 x, i32 lo, i32 hi)
    requires lo <= hi
    ensures result >= lo && result <= hi
{
    if (x < lo) { return lo; }
    if (x > hi) { return hi; }
    return x;
}

void count_down(i32 n) uses io {
    defer io.print("lift-off");
    for (i32 i in 0..n) {
        io.print("{}", n - i);
    }
}

i32? find(u8[] bytes, u8 target) {
    for (mut usize i = 0; i < bytes.len; i += 1) {
        if (bytes[i] == target) { return some(i as i32); }
    }
    return none;
}

void show(i32!ParseError r) uses io {
    match (r) {
        ok(v) => io.print("ok {}", v),
        err(e) => match (e) {
            Empty => io.print("error: empty"),
            NotADigit => io.print("error: not a digit"),
        },
    }
}

i32 main() uses io {
    io.print("Hello, Sosu!");
    io.print("area = {}", area(Shape.Rect(2.0, 3.5)));
    io.print("circle = {}", area(Circle(1.0)));

    mut Point p = Point{ x: 3.0, y: 4.0 };
    p.x = 6.0;
    io.print("length² = {}", p.length_squared());

    show(twice("7"));
    show(twice(""));
    show(twice("x"));
    io.print("clamp = {}", clamp(15, 0, 10));
    count_down(3);

    match (find("hello".bytes, 108)) {
        some(i) => io.print("found at {}", i),
        none => io.print("not found"),
    }

    mut i32 total = 0;
    mut i32 k = 0;
    while (true) {
        k += 1;
        if (k > 10) { break; }
        if (k % 2 == 0) { continue; }
        total += k;
    }
    io.print("odd sum = {}", total);
    for (i32 i in 1..=3) {
        io.print("i = {}", i);
    }

    u8 mask = (0xF0 >> 4) as u8;
    io.print("{} {} {} {}", mask, -7 / 2, 'é', true && !false);
    i64 big = 3000000000;
    io.print("big = {}", big * 2);
    io.print("{}", total > 20 ? "large" : "small");
    return 0;
}
