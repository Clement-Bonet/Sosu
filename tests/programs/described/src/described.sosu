// What describes `tree.FruitTree` and saves it.
pub class FruitTreeFields : describe.Describe<tree.FruitTree>, save.Codec<tree.FruitTree> {
    str[] choices_1;
    str[] choices_4;
    Arena* arena;  // where its lists are made

    void init(keeps Arena* arena) {
        self.arena = arena;
        mut str[] made_1 = arena.alloc_slice(str, 3);
        made_1[0] = "mist";
        made_1[1] = "jet";
        made_1[2] = "wide_fan";
        choices_1 = made_1;
        mut str[] made_4 = arena.alloc_slice(str, 3);
        made_4[0] = "mist";
        made_4[1] = "jet";
        made_4[2] = "wide_fan";
        choices_4 = made_4;
    }

    override str name() {
        return "fruit_tree";
    }

    override tree.FruitTree fresh() {
        return tree.FruitTree{ };
    }

    override usize count() {
        return 7;
    }

    override describe.Field field(usize i) {
        if (i == 0) {
            return describe.Field{
                name: "height",
                label: "Height",
                kind: describe.Kind.Number,
                low: 0.5,
                high: 40.0,
                unit: "m"
            };
        }
        if (i == 1) {
            return describe.Field{
                name: "watered_by",
                label: "Watered by",
                kind: describe.Kind.Choice,
                choices: some(choices_1)
            };
        }
        if (i == 2) {
            return describe.Field{
                name: "hours",
                label: "Hours",
                kind: describe.Kind.List,
                item: describe.Kind.Number,
                low: 0.0,
                high: 24.0,
                unit: "h"
            };
        }
        if (i == 3) {
            return describe.Field{
                name: "fruits",
                label: "Fruits",
                kind: describe.Kind.List,
                item: describe.Kind.Asset
            };
        }
        if (i == 4) {
            return describe.Field{
                name: "sprays",
                label: "Sprays",
                kind: describe.Kind.List,
                item: describe.Kind.Choice,
                choices: some(choices_4)
            };
        }
        if (i == 5) {
            return describe.Field{
                name: "growth",
                label: "Growth over the years",
                kind: describe.Kind.Curve,
                item: describe.Kind.Key
            };
        }
        return describe.Field{
            name: "leaves",
            label: "Leaves",
            kind: describe.Kind.Gradient,
            item: describe.Kind.Stop
        };
    }

    override describe.Value get(tree.FruitTree* c, usize i) {
        if (i == 0) {
            return describe.Value.Number(c.height);
        }
        if (i == 1) {
            return describe.Value.Choice(parts_spray_index(c.watered_by));
        }
        if (i == 2) {
            return describe.Value.Whole(c.hours.len as i64);
        }
        if (i == 3) {
            return describe.Value.Whole(c.fruits.len as i64);
        }
        if (i == 4) {
            return describe.Value.Whole(c.sprays.len as i64);
        }
        if (i == 5) {
            return describe.Value.Whole(c.growth.keys.len as i64);
        }
        return describe.Value.Whole(c.leaves.stops.len as i64);
    }

    override void set(tree.FruitTree* c, usize i, describe.Value v) {
        if (i == 0) {
            c.height = describe.number_of(v, c.height);
        } else if (i == 1) {
            c.watered_by = parts_spray_at(describe.choice_of(v, parts_spray_index(c.watered_by)));
        } else if (i == 2) {
            // its items: given by `set_items`
        } else if (i == 3) {
            // its items: given by `set_items`
        } else if (i == 4) {
            // its items: given by `set_items`
        } else if (i == 5) {
            // its items: given by `set_items`
        } else {
            // its items: given by `set_items`
        }
    }

    override usize items(tree.FruitTree* c, usize i) {
        if (i == 2) {
            return c.hours.len;
        }
        if (i == 3) {
            return c.fruits.len;
        }
        if (i == 4) {
            return c.sprays.len;
        }
        if (i == 5) {
            return c.growth.keys.len;
        }
        if (i == 6) {
            return c.leaves.stops.len;
        }
        return 0;
    }

    override describe.Value item(tree.FruitTree* c, usize i, usize j) {
        if (i == 2) {
            return describe.Value.Number(c.hours[j]);
        }
        if (i == 3) {
            return describe.Value.Text(c.fruits[j]);
        }
        if (i == 4) {
            return describe.Value.Choice(parts_spray_index(c.sprays[j]));
        }
        if (i == 5) {
            return describe.key_value(c.growth.keys[j]);
        }
        if (i == 6) {
            return describe.stop_value(c.leaves.stops[j]);
        }
        return describe.Value.Flag(false);
    }

    override void set_items(tree.FruitTree* c, usize i, describe.Value[] values) keeps self {
        if (i == 2) {
            f32[] made = arena.alloc_slice(f32, values.len);
            for (usize j in 0..values.len) {
                made[j] = describe.number_of(values[j], 0.0);
            }
            c.hours = made;
        }
        if (i == 3) {
            str[] made = arena.alloc_slice(str, values.len);
            for (usize j in 0..values.len) {
                made[j] = text.repeat(arena, describe.text_of(values[j], ""), 1);
            }
            c.fruits = made;
        }
        if (i == 4) {
            parts.Spray[] made = arena.alloc_slice(parts.Spray, values.len);
            for (usize j in 0..values.len) {
                made[j] = parts_spray_at(describe.choice_of(values[j], 0));
            }
            c.sprays = made;
        }
        if (i == 5) {
            c.growth = curve.Curve{ keys: describe.keys_of(arena, values), mode: c.growth.mode };
        }
        if (i == 6) {
            c.leaves = curve.Gradient{ stops: describe.stops_of(arena, values) };
        }
    }

    override void write(text.TextBuilder* out, tree.FruitTree* value) {
        describe.write_object(out, self as describe.Describe<tree.FruitTree>*, value);
    }

    override tree.FruitTree? read(Arena* arena, json.Value v) {
        return describe.read_object(arena, self as describe.Describe<tree.FruitTree>*, v);
    }
}

