// The index of a variant of `parts.Spray`, and the variant of an index.
usize parts_spray_index(parts.Spray x) {
    return match (x) {
        Mist => 0,
        Jet => 1,
        WideFan => 2,
    };
}

parts.Spray parts_spray_at(usize i) {
    if (i == 1) {
        return parts.Spray.Jet;
    }
    if (i == 2) {
        return parts.Spray.WideFan;
    }
    return parts.Spray.Mist;
}

// Every component of the package, a kind of the editor saved with the scene: what `sozo_setup`
// gives `host.on_world`.
pub void add_all(host.Level* l) {
    SprinklerKind* k0 = sprinkler_kind(l.arena, l.world);
    l.add(k0 as kinds.Kind*);
    l.add_saved(k0 as host.Saved*);
    l.add_source("sprinkler", "src/parts.sosu", 13);
    FenceKind* k1 = fence_post_kind(l.arena, l.world);
    l.add(k1 as kinds.Kind*);
    l.add_saved(k1 as host.Saved*);
    l.add_source("fence_post", "src/parts.sosu", 37);
    FruitTreeKind* k2 = fruit_tree_kind(l.arena, l.world);
    l.add(k2 as kinds.Kind*);
    l.add_saved(k2 as host.Saved*);
    l.add_source("fruit_tree", "src/plants/tree.sosu", 6);
}
