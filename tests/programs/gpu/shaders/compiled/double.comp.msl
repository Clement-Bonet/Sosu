#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_RWStructuredBuffer_uint
{
    uint _m0[1];
};

struct type_Extra
{
    uint extra;
};

kernel void main0(constant type_Extra& Extra [[buffer(0)]], device type_RWStructuredBuffer_uint& numbers [[buffer(1)]], uint3 gl_GlobalInvocationID [[thread_position_in_grid]])
{
    numbers._m0[gl_GlobalInvocationID.x] = (numbers._m0[gl_GlobalInvocationID.x] * 2u) + Extra.extra;
}

