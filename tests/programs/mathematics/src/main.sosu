import std.io;
import std.math;

void show(i64? value) uses io {
    match (value) {
        some(v) => io.print("{}", v),
        none => io.print("none"),
    }
}

i32 main() uses io {
    io.print("{} {} {}", math.sqrt(2.0), math.cbrt(-27.0), math.pow(2.0, 10.0));
    io.print("{} {} {}", math.exp(0.0), math.log(math.E), math.log2(1024.0));
    io.print("{} {}", math.log10(1000.0), math.hypot(3.0, 4.0));
    io.print("{} {}", math.sin(math.PI / 2.0), math.cos(0.0));
    io.print("{} {}", math.round(math.atan2(1.0, 1.0) * 1000.0), math.to_degrees(math.PI));
    io.print("{} {} {} {}", math.floor(-2.5), math.ceil(-2.5), math.round(2.5), math.trunc(-2.7));
    io.print("{} {}", math.fmod(7.5, 2.0), math.lerp(10.0, 20.0, 0.25));
    f64 nan = math.nan();
    io.print("{} {} {}", math.is_nan(nan), nan == nan, math.is_nan(math.sqrt(-1.0)));
    io.print("{} {} {}", math.is_infinite(-math.infinity()), math.is_finite(1.0e300), math.is_finite(nan));
    io.print("{} {}", math.clamp(5.0, 0.0, 1.0), math.clamp(-5.0, 0.0, 1.0));
    io.print("{} {} {}", math.gcd(12, 18), math.gcd(-12, 18), math.gcd(0, 0));
    show(math.lcm(4, 6));
    show(math.lcm(-4, 6));
    show(math.lcm(9223372036854775807, 2));
    show(math.pow_i64(3, 4));
    show(math.pow_i64(-2, 63));
    show(math.pow_i64(2, 63));
    show(math.pow_i64(-1, 4000000001));
    show(math.pow_i64(10, 18));
    show(math.pow_i64(10, 19));
    show(math.pow_i64(7, 0));
    return 0;
}
