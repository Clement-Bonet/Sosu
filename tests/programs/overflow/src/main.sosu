// Integer overflow stops the program (spec §5.1): `sosuc run` exits with the code 101.
// With `--release`, the addition is modulo 2^32 (spec §7.7).
import std.io;

i32 add(i32 a, i32 b) {
    return a + b;
}

i32 main() uses io {
    io.print("before");
    i32 x = add(2147483647, 1);
    io.print("after {}", x);
    return 0;
}
