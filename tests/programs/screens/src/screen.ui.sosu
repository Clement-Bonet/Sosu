// The screen of this test, described in an interface file (spec §10.2).
import screens.state;

component Greeting(str text) {
    Text(text)
}

window Greeter(state.Form* form) {
    title: "Greeter"
    width: 400
    height: 320

    Column(gap: 8, padding: 16) {
        Title("Hello")
        Text("Your name:")
        TextField(bind: form.name, on_enter: form.greet)
        Checkbox("Shout", bind: form.shout)
        Row(gap: 8) {
            Button("Clear", on_click: form.clear)
            Button("Greet", on_click: form.greet, enabled: form.name.count() > 0)
        }
        if (form.message.count() > 0) {
            Greeting(form.message.text())
        } else {
            Text("Nobody greeted yet")
        }
        TextField(bind: form.age, width: 80, accept: Digits, max: 3)
        Row(gap: 2) {
            for (i32 i in 0..form.greeted) {
                Text("*")
            }
        }
    }
}
