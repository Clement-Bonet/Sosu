// Draws one frame, checks a pixel of it, then asks to close: `run` must return 0 after `Quit`.
import std.io;
import platform.app;
import render.canvas;

class Once : app.Handler {
    mut i32 frames;
    mut bool drawn;

    void init() {
        frames = 0;
        drawn = false;
    }

    override bool on_event(app.Event e) uses io {
        return match (e) {
            Quit => false,
            _ => true,
        };
    }

    override void on_frame(canvas.Canvas* surface) uses io {
        surface.clear(canvas.Color{ r: 30, g: 30, b: 46 });
        surface.fill(canvas.Rect{ x: 10.0, y: 10.0, w: 100.0, h: 50.0 }, canvas.Color{ r: 255, g: 140, b: 0 });
        drawn = surface.width == 320 && surface.at(20, 20) == 0xFFFF8C00;
        frames += 1;
        app.request_quit();
    }
}

i32 main() uses io {
    mut Arena arena = Arena.new(1 * KB);
    defer arena.free();
    Once* once = arena.new(Once);
    i32 status = app.run(app.Config{ title: "Sosu test", width: 320, height: 240 }, once as app.Handler*);
    io.print("window closed ({}), frames: {}, drawn: {}", status, once.frames, once.drawn);
    return once.drawn && once.frames == 1 ? status : 1;
}
